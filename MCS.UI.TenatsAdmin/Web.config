<configuration>
  <configSections>
    <section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection, Microsoft.Practices.Unity.Configuration" />
    <section name="DbResourceProvider" type="MCS.Framework.Localization.DbResourceProviderSection,MCS.Framework" requirePermission="false" />
    <section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=6.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />

    <sectionGroup name="CustomUserManagerSectionGroup">
      <section name="CustomUserManager" type="MCS.Business.ASPNETIdentity.Configuration.CustomUserManagerConfiguration" allowLocation="true" allowDefinition="Everywhere" />
    </sectionGroup>

    <sectionGroup name="NotificationConfiguration">
      <section name="NotificationSections" type="MCS.Framework.Notifications.NotificationSections, MCS.Framework" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" restartOnExternalChanges="true" />
    </sectionGroup>

  </configSections>

  <CustomUserManagerSectionGroup>
    <CustomUserManager EmailBodyFormat="Your Email Body is {0}" PhoneNumberMessageFormat="Your Phone Number Message is {0}" RequireUniqueEmail="true" UserLockoutEnabledByDefault="true" AllowOnlyAlphanumericUserNames="true" MaxFailedAccessAttemptsBeforeLockout="5" DefaultAccountLockoutTimeSpan="5" PasswordRequiredLength="6" PasswordRequireNonLetterOrDigit="true" PasswordRequireDigit="true" PasswordRequireLowercase="false" PasswordRequireUppercase="false" PhoneCode="Phone Code" EmailCode="Email Code">
    </CustomUserManager>
  </CustomUserManagerSectionGroup>

  <NotificationConfiguration>
    <NotificationSections configSource="CONFIG\Notification.config" />
  </NotificationConfiguration>
  <unity xmlns="http://schemas.microsoft.com/practices/2010/unity">
    <typeAliases>
      <typeAlias alias="perRequest" type="Microsoft.Practices.Unity.PerRequestLifetimeManager, Microsoft.Practices.Unity.Mvc" />
      <typeAlias alias="singlton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity" />
    </typeAliases>
