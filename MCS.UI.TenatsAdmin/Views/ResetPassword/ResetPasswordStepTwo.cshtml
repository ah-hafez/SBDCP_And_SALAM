@using MCS.Framework.Localization
@model MCS.UI.TenantsAdmin.Models.Account.ResetPasswordVM
@{
    ViewBag.Title = "ResetPasswordStepTwo";
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
}
<div class="login-container">

    <div class="page-content-wrap">
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="login-logo"></div>
                <button type="button" onclick="ReturnToLoginPage();" class="btn btn-save pull-left">@DbRes.TResource("Global.ResetPasswordStepTwo.Cancel")</button>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>

    <div class="login-box animated fadeInDown">
        <div id="warningMessage" class="col-md-10 col-md-offset-1 col-xs-10 col-xs-offset-1 massage_login">

        </div>
        <div class="login-body">
            <div class="login-title"><strong>@DbRes.TResource("Tenant.ResetPasswordStepTwo.Reset") </strong> @DbRes.TResource("Tenant.ResetPasswordStepTwo.Password")</div>
            @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmReset", @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.TextBoxGroupFor(model => model.UserName, "ResetStepTwo", new { @disabled = "true", @class = "form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.PasswordGroupFor(model => model.NewPassword, "ResetStepTwo", new { placeholder = DbRes.TResource("Tenant.ResetPasswordStepTwo.NewPassword"), @class = "form-control", autofocus = "autofocus", @autocomplete = "off" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.PasswordGroupFor(model => model.ConfirmPassword, "ResetStepTwo", new { placeholder = DbRes.TResource("Tenant.ResetPasswordStepTwo.ReWritePassword"), @class = "form-control", @autocomplete = "off" })
                        @Html.ValidationMessage("ResetPasswordDTO", new { id = "spnValidationUserAndPassword" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.TextBoxGroupFor(model => model.Code, "ResetStepTwo", new { placeholder = DbRes.TResource("Tenant.ResetPasswordStepTwo.Code"), @class = "form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-6">
                        @Html.StickyHiddenFor(model => model.IdentityId)
                        @Html.StickyHiddenFor(model => model.Token)
                        @Html.StickyHiddenFor(model => model.UserName)
                        @Html.StickyHiddenFor(model => model.PhoneNumber)
                        @Html.StickyHiddenFor(model => model.Email, new { @id = "hdnEmail" })
                    </div>
                    <div class="col-md-6">
                        @Html.ActionButton(DbRes.TResource("Tenant.ResetPasswordStepTwo.Reset"), "ResetPasswordTwo", null, null, null, "OnSuccess", null, "post", "ResetStepTwo", "btnEnter", "frmReset", "btn btn-info btn-block")
                    </div>
                </div>
            }
        </div>

    </div>

</div>
<script>
    $(document).ready(function () {
        $("#hdnEmail").val("example");
    });
    function OnSuccess(data) {
        if (data.MessageType == 0) {
            ShowSuccesMessage(data.MessageText, "Redirect");

        }

        if (data.MessageType == 2) {
            $("#warningMessage").html("<span class='fa fa fa-warning'></span>" + data.MessageText)
        }
    }
    function Redirect() {
        window.location.href = '@Url.Action("Login", "Login")';
    }
    $(document).on('keypress', function (e) {
        if (e.keyCode == 13 || e.which == 13) {
            $('#btnEnter').click();
        }
    });
    function ReturnToLoginPage() {
        window.location.href = '@Url.Action("Login", "Login")';
    }
</script>