        var isValidType = extFile != "" && $.inArray(extFile, arrayType) == -1;
        if (isValidType) {
            ShowErrorMessage('حدث خطأ ما, يرجى التاكد من تحميل ملف واحد مطابق للمعايير في المرة الواحدة');
            return false;
        }
        //Convert Byte to Kilobytes => (fileOption.size / 1024) =
        var isValidSize = Math.round(fileOption.size / 1024) >= 200;
        if (isValidSize) {
            ShowErrorMessage('حجم الملف يجب ان لا يتجاوز 200 كيلوبايت')
            return false;
        }
        return true;
