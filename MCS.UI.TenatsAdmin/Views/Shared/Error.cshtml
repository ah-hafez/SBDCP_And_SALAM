@using MCS.Framework.Localization;
@{
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
}
<div class="error-container">

    <div class="error-subtext">
        @TempData["Exception"]
    </div>
    <div class="error-actions">
        <div class="row">
            @if (Request.UrlReferrer == null)
            {
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    <button class="btn btn-info btn-block btn-lg btn-error_01" onclick="document.location.href = @Request.UrlReferrer">@DbRes.TResource("Shared.Error.BackToMainPage")</button>
                </div>
                <div class="col-md-3"></div>
            }
            else
            {
                <div class="col-md-3"></div>

                <div class="col-md-6">
                    <button class="btn btn-info btn-block btn-lg btn-error_02" onclick="document.location.href='@Request.UrlReferrer.AbsolutePath'">@DbRes.TResource("Shared.Error.PreviousPage")</button>
                </div>
                <div class="col-md-3"></div>
            }
        </div>
    </div>
    <div class="clear"></div>
</div>
