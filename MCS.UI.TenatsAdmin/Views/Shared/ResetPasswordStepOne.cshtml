@using MCS.Framework.Localization
@model MCS.UI.TenantsAdmin.Models.Account.ResetPasswordVM
@{
    ViewBag.Title = DbRes.TResource("User.Login.Title");
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
}
<div class="login-container">
    <div class="page-content-wrap">
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="login-logo"></div>
                <button type="button" onclick="ReturnToLoginPage();" class="btn btn-save pull-right">@DbRes.TResource("Tenant.ResetPasswordStepOne.Cancel")</button>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>

    <div class="login-box animated fadeInDown">

        <div class="login-body">
            <div class="login-title"><strong>@DbRes.TResource("Tenant.ResetPasswordStepOne.Request") </strong>@DbRes.TResource("Tenant.ResetPasswordStepOne.ResetPassword")</div>
            @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmReset", @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.TextBoxGroupFor(model => model.UserName, "ResetStepOne", new { placeholder = DbRes.TResource("Tenant.ResetPasswordStepOne.Username"), @class = "form-control", autofocus = "autofocus" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12">
                        @Html.TextBoxGroupFor(model => model.Email, "ResetStepOne", new { placeholder = DbRes.TResource("Tenant.ResetPasswordStepOne.Email"), @class = "form-control" })
                        @Html.ValidationMessage("ResetPasswordDTO", new { id = "spnValidationUserAndPassword" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-6">

                    </div>
                    <div class="col-md-6">
                        @Html.ActionButton(DbRes.TResource("Tenant.ResetPasswordStepOne.Reset"), "ResetPassword", null, null, null, "OnSuccess", null, "post", "ResetStepOne", "btnEnter", "frmReset", "btn btn-info btn-block")
                    </div>
                </div>
            }
        </div>

    </div>

</div>
<script>
    function OnSuccess(data) {
       
        if (data.MessageType == 0) {

            //show success message 
            ShowSuccesMessage(data.MessageText);          
        }
      
        if (data.MessageType == 2) {

            $("#spnValidationUserAndPassword").html(data.MessageText);
            $("#spnValidationUserAndPassword").removeClass("field-validation-valid");

            if (!$("#spnValidationUserAndPassword").hasClass("field-validation-error")) {
                $("#spnValidationUserAndPassword").addClass("field-validation-error");

            }
        } 
    }

    $(document).on('keypress', function (e) {
        if (e.keyCode == 13 || e.which == 13) {
            $('#btnEnter').click();
        }
    });
    function ReturnToLoginPage()
    {
        window.location.href = '@Url.Action("Login", "Login")';
    }
</script>