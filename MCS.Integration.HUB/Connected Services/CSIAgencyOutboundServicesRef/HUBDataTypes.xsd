  <xs:simpleType name="Identifier_Type">
    <xs:annotation>
      <xs:documentation>Sender or Receiver identifier</xs:documentation>
    </xs:annotation>
    <xs:restriction base="Id_Structure" />
  </xs:simpleType>
  <xs:simpleType name="Id_Structure">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9][0-9][0-9][0-9][0-9][0-9]" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UUID_Type">
    <xs:annotation>
      <xs:documentation>A UUID is an identifier that is unique across both space and time, with respect to the space of all UUIDs.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value=".{8}-.{4}-.{4}-.{4}-.{12}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="NC32_Type">
    <xs:annotation>
      <xs:documentation>32 character ISO Latin-1 string</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
      <xs:maxLength value="32" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OSId_Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9][0-9][0-9]" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="HUB.DateTime">
    <xs:annotation>
      <xs:documentation>A Custom Data Time Type</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:dateTime">
      <xs:pattern value="\d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\d" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="HDate_Type">
    <xs:annotation>
      <xs:documentation>Hijri date type</xs:documentation>
    </xs:annotation>
    <xs:restriction base="Hijri_Structure" />
  </xs:simpleType>
  <xs:simpleType name="Hijri_Structure">
    <xs:restriction base="xs:string">
      <xs:pattern value="[1-1][4-4][0-9][0-9]/.[1-12]/.[1-30]" />
    </xs:restriction>
  </xs:simpleType>
