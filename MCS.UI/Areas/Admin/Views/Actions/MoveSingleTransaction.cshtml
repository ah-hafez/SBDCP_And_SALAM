</div>

<div class="mx-3 mx-md-5 mb-4 d-flex">
    <div class="ml-auto">
        @Html.ActionButton(DbRes.TResource("Admin.MoveTransaction.Save"),Url.Action("MoveSingleTransactionPost", "Actions"),"", null,"", "onMoveSingleTransactionSuccess", "","Post",
                                     "moveSingleTransaction","btnMoveTrans", "frmMoveSingleTransaction", "btn btn-lg btn-st3 mx-1")
        @Html.ResetButton("ResetForm()","","btn btn-lg btn-st3 mx-1")
    </div>
</div>

<script type="text/javascript">

    function ResetForm() {
        ClearInputs('frmMoveSingleTransaction');
        $('#tblTransactionDetails').css('display', 'none');
    }

    function onMoveSingleTransactionSuccess(data) {
        var errors = [];
        if (data.errors.length > 0) {
            for (var counter = 0; counter < data.errors.length; counter++) {
                switch (data.errors[counter].Key) {
                    case "TransId":
                        errors.unshift('<li>' + '@DbRes.TValidation("Admin.MoveSingleTransaction.TransId")' + '</li>');
                        break;
                     @*case "TransNumber":
                        errors.unshift('<li>'+'@DbRes.TValidation("Admin.MoveTransaction.TransactionNumber.Validation")'+'</li>');
                        break;*@
                    case "EntityToId":
                        errors.unshift('<li>' + '@DbRes.TResource("Admin.MoveTransaction.to.Required")' + '</li>');
                        break;
                    case "DirectedToId":
                        errors.unshift('<li>' + '@DbRes.TResource("Admin.MoveTransaction.DirectedToId.Required")' + '</li>');
                        break;
                }
            }
            var listOfErrors = '<ul style="list-style:none;">';
            for (var counter = 0; counter < errors.length; counter++) {
                listOfErrors += errors[counter];
            }
            listOfErrors += '</ul>';
            ShowErrorMessage(listOfErrors);
        }

        else {
            if (data.MessageType != 0) {
                ShowErrorMessage('@DbRes.TResource("Admin.MoveTransaction.CantMove")');
            }
            else {
                ShowSuccesMessage('@DbRes.TResource("Admin.MoveSingleTransaction.Success")', redirect());

            }
        }
    }
    function redirect() {
        setTimeout(function () {
            window.location.href = '@Url.Action("MoveSingleTransaction", "Actions",new { area="Admin"})';
        }, 3000);
    }
    function GetDirectedToUsersByOrgUnitId02() {
        var EntityToId = $('#EntityToId').val();
       // var EntityToId = $('#EntityToId').val();
        var token = $('#frmMoveSingleTransaction').find("input[name='__RequestVerificationToken']").val();
        if (EntityToId != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId","Actions")',
                data: { id: EntityToId, __RequestVerificationToken: token },
                success: function (data) {
                    $("#ddlDirectedToId").val("");
                    $("#hdnDirectedToId").val("");
                    AutoCompleteChangeList("ddlDirectedToId", data);
                    $("#ddlDirectedToId").prop('disabled', false);
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
            return false;
        }
        else {
            $("#ddlDirectedToId").prop('disabled', true);
            $("#ddlDirectedToId").val("");
            $("#hdnDirectedToId").val("");
            AutoCompleteChangeList("ddlDirectedToId", "[]");
        }
    }
    function GetDirectedToUsersByOrgUnitId() {
        var EntityFromId = $('#EntityFromId').val();
        if (EntityFromId != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId","Actions")',
                data: { id: EntityFromId },
                success: function (data) {
                    $("#ddlDirectedFromId").val("");
                    $("#hdnDirectedFromId").val("");
                    AutoCompleteChangeList("ddlDirectedFromId", data);
                    $("#ddlDirectedFromId").prop('disabled', false);
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
            return false;
        }
        else {
            $("#ddlDirectedFromId").prop('disabled', true);
            $("#ddlDirectedFromId").val("");
            $("#hdnDirectedFromId").val("");
            AutoCompleteChangeList("ddlDirectedFromId", "[]");
        }

    }
    document.getElementById('btnCheckTransaction').addEventListener('click', function () {

        var ddlYear = $.trim($('#ddlYear').val());
        var ddlTransactionType = $.trim($('#hdnTransactionTypeId').val());
        var TransNumber = $.trim($('#TransNumber').val());
        if (ddlYear == '' & TransNumber == '' & ddlTransactionType == "") {
            $("#TransYearGlyphicon").removeClass("hide");
            $("#TransYearGlyphicon").show();
            $("#TransNumberGlyphicon").removeClass("hide");
            $("#TransNumberGlyphicon").show();
            $("#TransYearMessage").html('@Html.Raw(DbRes.TValidation("Admin.MoveTransaction.TransactionYear.Required"))');
            $("#TransNumberMessage").html('@Html.Raw(DbRes.TValidation("User.Transaction.Open.InboundNumberRequired"))');
            $("#TransactionTypeGlyphicon").removeClass("hide");
            $("#TransactionTypeGlyphicon").show();
            $("#TransactionTypeMessage").html('@Html.Raw(DbRes.TValidation("User.Transaction.Link.TransactionTypeRequired"))');
            return false;
        }
        if (ddlTransactionType == '' & TransNumber == '') {
            $("#TransYearGlyphicon").hide();
            $("#TransYearMessage").html('');
            $("#TransactionTypeGlyphicon").removeClass("hide");
            $("#TransactionTypeGlyphicon").show();
            $("#TransactionTypeMessage").html('@Html.Raw(DbRes.TValidation("User.Transaction.Link.TransactionTypeRequired"))');
            $("#TransNumberGlyphicon").removeClass("hide");
            $("#TransNumberGlyphicon").show();
            $("#TransNumberMessage").html('@Html.Raw(DbRes.TValidation("User.Transaction.Open.InboundNumberRequired"))');
            return false;
        }
        if (ddlYear == '') {
            $("#TransNumberGlyphicon").hide();
            $("#TransNumberMessage").html('');
            $("#TransactionTypeGlyphicon").hide();
            $("#TransactionTypeMessage").html('');
            $("#TransYearGlyphicon").removeClass("hide");
            $("#TransYearGlyphicon").show();
            $("#TransYearMessage").html('@Html.Raw(DbRes.TValidation("Admin.MoveTransaction.TransactionYear.Required"))');
            @*ShowErrorMessage('@DbRes.TValidation("Admin.MoveTransaction.TransactionYear.Required")');*@
            return false;
        }
        if (ddlTransactionType == '') {
            $("#TransNumberGlyphicon").hide();
            $("#TransNumberMessage").html('');
            $("#TransYearGlyphicon").hide();
            $("#TransYearMessage").html('');
            $("#TransactionTypeGlyphicon").removeClass("hide");
            $("#TransactionTypeGlyphicon").show();
            $("#TransactionTypeMessage").html('@Html.Raw(DbRes.TValidation("User.Transaction.Link.TransactionTypeRequired"))');
            return false;
        }
        if (TransNumber == '') {
            $("#TransactionTypeGlyphicon").hide();
            $("#TransactionTypeMessage").html('');
            $("#TransYearGlyphicon").hide();
            $("#TransYearMessage").html('');
            $("#TransNumberGlyphicon").removeClass("hide");
            $("#TransNumberGlyphicon").show();
            $("#TransNumberMessage").html('@Html.Raw(DbRes.TValidation("User.Transaction.Open.InboundNumberRequired"))');
            @*ShowErrorMessage('@DbRes.TValidation("User.Transaction.Open.InboundNumberRequired")');*@
            return false;
        }
        else if (!(/^\d+$/.test(TransNumber))) {
            $("#TransNumberGlyphicon").removeClass("hide");
            $("#TransNumberGlyphicon").show();
            $("#TransNumberMessage").html('@Html.Raw(DbRes.TValidation("Admin.MoveTransaction.TransactionNumber.MustNumber.JavascriptValidation"))');
            @*ShowErrorMessage('@DbRes.TValidation("Admin.MoveTransaction.TransactionNumber.MustNumber.JavascriptValidation")');*@
            return false;
        }
        else {
            $("#TransNumberGlyphicon").hide();
            $("#TransNumberMessage").html('');
            $("#TransYearGlyphicon").hide();
            $("#TransYearMessage").html('');
            $("#TransactionTypeGlyphicon").hide();
            $("#TransactionTypeMessage").html('');
            var token = $('#frmMoveSingleTransaction').find("input[name='__RequestVerificationToken']").val();
            $.ajax({
                type: 'post',
                url: '@Url.Action("CheckIfTransActionExist", "Actions")',
                data: { year: ddlYear, transNum: TransNumber, transactionType: ddlTransactionType, __RequestVerificationToken: token},
                success: function (response) {
                    if (response.result) {
                        $('#TransId').val(response.transactionBasicInfo.Id);
                        $('#tblTransactionDetails').css('display','block');
                        $('#CurrentOrgUnit').html(response.transactionBasicInfo.CurrentOrgUnit);
                        $('#Status').html(response.transactionBasicInfo.StatusName);
                        $('#Subject').html(response.transactionBasicInfo.Subject);
                    }
                    else {
                        $('#tblTransactionDetails').css('display', 'none');
                        ShowErrorMessage('@DbRes.TResource("User.Transaction.Open.TransactionNotFound")');
                    }
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
        });}
    });
    document.getElementById('TransNumber').addEventListener('change', function () {
        if (/^\d+$/.test($('#TransNumber').val())) {
            //its valid input , do nothing ....!
        } else {
             $("#TransNumberGlyphicon").removeClass("hide");
            $("#TransNumberGlyphicon").show();
            $("#TransNumberMessage").html('@Html.Raw(DbRes.TValidation("Admin.MoveTransaction.TransactionNumber.MustNumber.JavascriptValidation"))');
            @*ShowErrorMessage('@DbRes.TValidation("Admin.MoveTransaction.TransactionNumber.MustNumber.JavascriptValidation")');*@
            return false;
        }
    });
</script>
