<div class="white-container mx-3 mx-md-5">
    @using (Html.BeginForm("", "", FormMethod.Post, new { @class = "", id = "frmMoveSingleTransaction" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenGroupFor(m => m.TransId, null, "moveSingleTransaction")
        <div class="form-row">
            <div class="form-group col-lg-6 col-md-8 col-sm-12 col-xs-12">
                @Html.LabelFor(model => model.TransYear, new { @class = " control-label" })<span class="stark">*</span>
                <div class="">
                    @Html.AutoCompleteBuilder("ddlYear", "hdnYear", LookupCategory.Year, DateTimeUtility.GetHijriYear(DateTime.Now).ToString(), true, "form-control", null, null, false)
                    @Html.HiddenGroupFor(model => model.TransYear, new { @Value = "", id = "hdnYear" }, "moveSingleTransaction")
                </div>
                <div>
                    <i id="TransYearGlyphicon" style="color:red" class="glyphicon glyphicon-exclamation-sign hide"></i>
                    <span id="TransYearMessage" style="color:red"></span>
                </div>
            </div>
            <div class="form-group col-lg-6 col-md-8 col-sm-12 col-xs-12">
                @Html.LabelFor(m => m.TransNumber)<span class="stark">*</span>
                <div class="">
                    @Html.TextBoxFor(m => m.TransNumber, new { @class = "form-control" })
                </div>
                <div>
                    <i id="TransNumberGlyphicon" style="color:red" class="glyphicon glyphicon-exclamation-sign hide"></i>
                    <span id="TransNumberMessage" style="color:red"></span>
                </div>
            </div>
            <div class="form-group col-lg-6 col-md-8 col-sm-12 col-xs-12">
                @Html.LabelFor(model => model.TransactionTypeId, new { @class = " control-label" })<span class="stark">*</span>
                <div class="">
                    @Html.AutoCompleteBuilder("ddlTransactionType", "hdnTransactionTypeId", ViewData["TransactionCategory"].ToString(), null, true, "form-control", "", "", "", false)
                    @Html.HiddenGroupFor(model => model.TransactionTypeId, new { @Value = "", id = "hdnTransactionTypeId" }, "moveSingleTransaction")
                </div>
                <div>
                    <i id="TransactionTypeGlyphicon" style="color:red" class="glyphicon glyphicon-exclamation-sign hide"></i>
                    <span id="TransactionTypeMessage" style="color:red"></span>
                </div>
            </div>
            <div class="form-group col-lg-6 col-md-8 col-sm-12 col-xs-12">
                <div>
                    <a href="javascript:;" id="btnCheckTransaction" class="btn btn-site">@DbRes.TResource("Admin.MoveTransaction.Btn.GetTransaction")</a>
                </div>
            </div>
        </div>

        <div class="form-row" style="padding-top:1%;padding-bottom:1%;display:none;" id="tblTransactionDetails">
            <div class="">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th class="table-trans">@DbRes.TResource("Admin.Actions.MoveTransaction.CurrentOrgUnit")</th>
                                <th class="table-trans">@DbRes.TResource("Admin.Actions.MoveTransaction.Status")</th>
                                <th class="table-trans">@DbRes.TResource("Admin.Actions.MoveTransaction.Subject")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td id="CurrentOrgUnit" class="table-trans"></td>
                                <td id="Status" class="table-trans"></td>
                                <td id="Subject" class="table-trans"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <hr class="mb-4">
        <div class="form-row">
            <div class="form-group col-lg-6 col-md-8 col-sm-12 col-xs-12">
                <div id="dvDepartmentsTree02">
                    <fieldset class="field-set" id="dvEntityToDepartmentsTree">
                        @Html.DepartmentsTree(ViewData["orgUnitDataInfo"] as TreeViewModel, model => model.EntityToId, TreeMode.Single, "treeDirectedToOrgUnit02", true, "GetDirectedToUsersByOrgUnitId02", "moveSingleTransaction", "dvDepartmentsTree02")
                    </fieldset>
                    @*<label>@DbRes.TResource("Admin.Actions.MoveUser.ToEntity")<span class="stark">*</span></label>
        @Html.EditorFor(model => model.EntityToId, "OrgHierarchyCaller", additionalViewData: new { treeId = "treeDirectedToOrgUnit02", GetChildrenActionURL = @Url.Action("GetInternalPartyChildren", "Common"), GetNodeInfoByIdActionURL = @Url.Action("GetInternalPartyInfoById", "Common"), GetNodeInfoByNumActionURL = @Url.Action("GetInternalPartyInfoByNumber", "Common"), onClickfunction = "GetDirectedToUsersByOrgUnitId02", ValidationGroup = "moveSingleTransaction", ShowAddPartyButton = false })*@
                    @Html.HiddenGroupFor(model => model.EntityToId, null, "moveSingleTransaction")
                </div>
                <div>
                    <i id="EntityToGlyphicon" style="color:red" class="glyphicon glyphicon-exclamation-sign hide"></i>
                    <span id="EntityToMessage" style="color:red"></span>
                </div>
            </div>
            <div class="form-group col-lg-6 col-md-8 col-sm-12 col-xs-12">
                <fieldset>
                    <div class="">
                        @Html.LabelFor(model => model.DirectedToId, new { @class = "control-label" })<span class="stark">*</span>
                        <div>
                            @Html.AutoCompleteBuilder("ddlDirectedToId", "hdnDirectedToId", ViewData["OrgUnitsUsersData"] != null ? ViewData["OrgUnitsUsersData"].ToString() : null, Model != null ? Model.DirectedToId.ToString() : null, true, "form-control")
                            @Html.HiddenGroupFor(model => model.DirectedToId, new { @Value = "", id = "hdnDirectedToId" }, "moveSingleTransaction")
                        </div>
                        <div>
                            <i id="DirectedToGlyphicon" style="color:red" class="glyphicon glyphicon-exclamation-sign hide"></i>
                            <span id="DirectedToMessage" style="color:red"></span>
                        </div>
                    </div>
                </fieldset>
