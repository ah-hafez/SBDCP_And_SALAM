@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@using MCS.Common
@model MCS.UI.Areas.Admin.Models.Actions.AddActionVM

@{
    ViewBag.Title = "_ActionAddPartial";
    Layout = null;
}

<div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
    <h3 class="site-color mb-4">@DbRes.TResource("Admin.Actions.AddAction")</h3>
</div>
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmAddAction" }))
{
    @Html.AntiForgeryToken()
    <div id="AddActionContent" class="form-row">
        @{List<MCS.UI.Areas.User.Models.Lookups.CultureVM> cultureVMs = ViewData["Culture"] as List<MCS.UI.Areas.User.Models.Lookups.CultureVM>;}
        @if (cultureVMs != null)
        {
            for (int m = 0; m < cultureVMs.Count; m++)
            {
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    @Html.CustomLabelFor(model => model.Description[m].CultureName, new { @class = "" }, DbRes.TResource(string.Format("Admin.Lookups.Actions.Name.{0}", cultureVMs[m].ShortName)))<span class="stark">*</span>
                    @Html.StickyHiddenFor(model => model.Description[m].CultureId, new { Value = cultureVMs[m].Id, id = "AddDescription" })
                    @Html.TextBoxGroupFor(model => model.Description[m].Text, "", new { @class = "form-control",id = "AddText" }, DbRes.TValidation("Admin.Actions.NameRequired." + cultureVMs[m].ShortName))
                </div>
            }
        }
        @*<div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
            @Html.Label(@DbRes.TResource("Admin.Lookups.Actions.AssignmentType"), new { @class = "w-100" })
            <div class="form-check form-check-inline">
                @Html.RadioButtonFor(model => model.IsAsCopy, false, new { @class = "form-check-input", id = "IsTransaction" })
                @Html.Label(DbRes.TResource("Admin.Lookups.Actions.IsTransaction"), new { @class = "form-check-label" })
            </div>
            <div class="form-check form-check-inline">
                @Html.RadioButtonFor(model => model.IsAsCopy, true, new { @class = "form-check-input",id= "IsCopy" })
                @Html.Label(DbRes.TResource("Admin.Lookups.Actions.IsCopy"), new { @class = "form-check-label" })
            </div>
        </div>*@
    </div>
    List<LookupVM> ActionTypes = ViewData["ActionTypes"] as List<LookupVM>;
    @Html.HiddenFor(model => model.TypeId, new { @Value = ActionTypes[0].Id, id = "hdnAddTypeId" })
    <div class="mx-3 mx-md-5 mb-4 d-flex">
        <div class="ml-auto">
            @Html.ActionButton(DbRes.TResource("Admin.Actions.Save"), "AddAction", "dvGrid", null, null, "OnAddSuccess", null, "post", null, "btnAdd", "frmAddAction", "btn btn-lg btn-st3 mx-1")
            @Html.ResetButton("ClearInputs('AddActionContent')")
        </div>
    </div>
}



