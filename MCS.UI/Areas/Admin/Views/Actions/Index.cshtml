@using MCS.UI.Areas.Admin.Models.Actions
@using MCS.GridMvc.Ajax.GridExtensions
@using MCS.Framework.Localization
@model ActionViewModel
@{
    ViewBag.Title = DbRes.TResource("Admin.Actions.Actions");
    Layout = "~/Areas/Admin/Views/Shared/_LookupsLayout.cshtml";
}




<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
    <div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
        <h3 class="site-color mb-4">@DbRes.TResource("Admin.Actions.Actions")</h3>
    </div>
</div>
<div class="white-container mx-3 mx-md-5">
    <div id="divAddAction" style="display:block;">
        @Html.Partial("_AddActionPartial", Model.AddAction)
    </div>
    <div id="divEditAction" style="display:none;">
        @Html.Partial("_EditActionPartial", Model.EditAction)
    </div>
    <div class="table-responsive mt-3" id="dvGrid">
        <div class="w-100 d-flex align-items-center mt-2 mb-2">
            <h3 class="white-c-title">@DbRes.TResource("Admin.Grid.Actions")</h3>
            <span class="roundedred ml-3">@(((AjaxGrid<ActionVM>)ViewData["GridData"]).ItemsCount)</span>
            <span class="pl-2 gray4">@DbRes.TResource("Admin.Grid.Records")</span>
        </div>
        @Html.Partial("~/Areas/Admin/Views/Actions/_GridActionPartial.cshtml", ViewData["GridData"])
    </div>
</div>





<script>
    function ShowEditDiv(data, div) {
        $("#divEditAction").css("display", "block");
        $("#divAddAction").css("display", "none");
    }

    function HideEditDiv() {
        $("#divEditAction").css("display", "none");
        $("#divAddAction").css("display", "block");
    }

    function OnAddSuccess(data,div) {
        if (data.MessageType != 2) {
            $("#" + div).html("");
            $("#" + div).html(data.Html);
          /*  jQuery.validator.unobtrusive.parse('#' + div);*/
            ShowSuccesMessage(data.MessageText);
            ClearInputs('AddActionContent');
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnEditSuccess(data,div) {
        if (data.MessageType != 2) {
            $("#" + div).html("");
            $("#" + div).html(data.Html);
          /*  jQuery.validator.unobtrusive.parse('#' + div);*/
            ClearInputs('EditActionContent');
            ShowSuccesMessage(data.MessageText)
            $("#divEditAction").css("display", "none");
            $("#divAddAction").css("display", "block");
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnDeleteSuccess(data, divUpdatData, deletedList) {
        if (data.ActionsUsedList.length == 0) {
            ShowSuccesMessage(data.MessageText);
        }
        else {
            var msg = '';
            for (var i = 0; i < data.ActionsUsedList.length; i++) {
                if (msg == '')
                    msg = data.ActionsUsedList[i];
                else
                    msg = msg + '</br>' + data.ActionsUsedList[i];
            }
            msg = '@DbRes.TResource("Admin.Actions.DeleteActionsErrorMsg")' + '</br>' + msg;
            ShowErrorMessage(msg);
        }

        var deletedArray = deletedList.split(',');

        for (var i = 0; i < deletedArray.length; i++) {
            var deleted = true;
            for (var y = 0; y < data.ActionsUsedList.length; y++) {
                if (deletedArray[i] == data.ActionsUsedList[y]) {
                    deleted = false;
                }
            }
            if (deleted)
                if (deletedArray[i] == $('#hdnEditId').val())
                    HideEditDiv();
        }
    }

     function LockUnlockLookup(LookupType, LookupOperationType, FormId) {
         var token = $("#divAddAction input[name='__RequestVerificationToken']").val()
        var data = { lookupType: LookupType, lookupOperationType: LookupOperationType, lookUpId: FormId, __RequestVerificationToken: token};
        $.ajax({
            type: "post",
            url: '@Url.Action("LockUnlockLookup", "Lookups")',
            data: data,
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        $("#dvGrid").html("");
                        $("#dvGrid").html(data.Html);
                        //ShowInformationMessage("OK");
                    }
                    else {
                        ShowErrorMessage(data.MessageType);
                    }
                },
            error: function (data) {
            }
        });
    }

    function ActiveDeactiveLookup(LookupType, LookupOperationType, FormId) {
        var token = $("#divAddAction input[name='__RequestVerificationToken']").val()
        var data = { lookupType: LookupType, lookupOperationType: LookupOperationType, lookUpId: FormId, __RequestVerificationToken: token};
        $.ajax({
            type: "post",
            url: '@Url.Action("ActiveDeactiveLookup", "Lookups")',
            data: data,
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        $("#dvGrid").html("");
                        $("#dvGrid").html(data.Html);
                        //ShowInformationMessage("OK");
                    }
                    else {
                        ShowErrorMessage(data.MessageType);
                    }
                },
            error: function (data) {
            }
        });
    }
</script>