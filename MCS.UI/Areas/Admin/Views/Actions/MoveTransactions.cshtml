<div class="mx-3 mx-md-5 mb-4 d-flex">
    <div class="ml-auto">
        @Html.ActionButton(DbRes.TResource("Admin.MoveTransaction.Save"),Url.Action("MoveTransactionsPost", "Actions"),"", null,"", "onMoveTransactionSuccess", "","Post",
                                 "moveTransactions","btnMoveTransactions", "frmTransactions", "btn btn-lg btn-st3 mx-1")
        @Html.ResetButton("ResetForm()","","btn btn-lg btn-st3 mx-1")
    </div>
</div>

<script type="text/javascript">

    function ResetForm() {
        ClearInputs('frmTransactions');
    }

    function onMoveTransactionSuccess(data) {
        var errors = [];
        if (data.errors.length > 0) {
            for (var counter = 0; counter < data.errors.length; counter++) {
                switch (data.errors[counter].Key) {
                    case "EntityFromId":
                        errors.push('<li>' + '@DbRes.TResource("Admin.MoveTransactions.EntityFromId")' + '</li>');
                        break;
                    case "DirectedFromId":
                        errors.push('<li>' + '@DbRes.TResource("Admin.MoveTransactions.DirectedFromId")' + '</li>');
                        break;
                    case "EntityToId":
                        errors.push('<li>' + '@DbRes.TResource("Admin.MoveTransactions.EntityToId")' + '</li>');
                        break;
                    case "DirectedToId":
                    errors.push('<li>' + '@DbRes.TResource("Admin.MoveTransactions.DirectedToId")' + '</li>');
                      break;
                }
            }
            var listOfErrors = '<ul style="list-style:none;">';
            for (var counter = 0; counter < errors.length; counter++) {
                listOfErrors += errors[counter];
            }
            listOfErrors += '</ul>';
            ShowErrorMessage(listOfErrors);
        }
        else {
            if (data.MessageType != 0) {
                ShowErrorMessage('@DbRes.TResource("Admin.MoveTransactions.CantMove")');
            }
            else {
                ShowSuccesMessage('@DbRes.TResource("Admin.MoveTransactions.Success")', redirect());

            }

        }
    };
    function redirect() {
        setTimeout(function () {
            window.location.href = '@Url.Action("MoveTransactions", "Actions",new { area = "Admin" })';
        }, 3000);
    };
    function GetDirectedToUsersByOrgUnitId02() {
   
        var EntityToId = $('#EntityToId').val();
        var token = $('#frmTransactions').find("input[name='__RequestVerificationToken']").val();
        if (EntityToId != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId","Actions")',
                data: { id: EntityToId, __RequestVerificationToken: token },
                success: function (data) {
                    $("#ddlDirectedToId").val("");
                    $("#hdnDirectedToId").val("");
                    AutoCompleteChangeList("ddlDirectedToId", data);
                    $("#ddlDirectedToId").prop('disabled', false);
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
            return false;
        }
        else {
            $("#ddlDirectedToId").prop('disabled', true);
            $("#ddlDirectedToId").val("");
            $("#hdnDirectedToId").val("");
            AutoCompleteChangeList("ddlDirectedToId", "[]");
        }

    }

    function GetDirectedToUsersByOrgUnitId() {
  
        var EntityFromId = $('#EntityFromId').val();
        var token = $('#frmTransactions').find("input[name='__RequestVerificationToken']").val();
        if (EntityFromId != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId","Actions")',
                data: { id: EntityFromId, __RequestVerificationToken: token },
                success: function (data) {
                    $("#ddlDirectedFromId").val("");
                    $("#hdnDirectedFromId").val("");
                    AutoCompleteChangeList("ddlDirectedFromId", data);
                    $("#ddlDirectedFromId").prop('disabled', false);
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
            return false;
        }
        else {
            $("#ddlDirectedFromId").prop('disabled', true);
            $("#ddlDirectedFromId").val("");
            $("#hdnDirectedFromId").val("");
            AutoCompleteChangeList("ddlDirectedFromId", "[]");
        }
    }

</script>
