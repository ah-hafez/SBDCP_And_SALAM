@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models
@using MCS.GridMvc.Ajax.GridExtensions


@model List<UserPendingGroupVM>
@{
    ViewBag.Title = DbRes.TResource("Admin.UserManagement.UserManagement");
    Layout = "~/Areas/Admin/Views/Shared/_UsersTraysLayout.cshtml";
}

<div class="content_container site_border">
    <div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center ">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center flex-grow-1 mb-3 mb-lg-0">
            <h3 class="site-color mb-2 mb-lg-4">@DbRes.TResource("Global.admin.RoleRequest") </h3>
         
        </div>
  
    </div>






    <div class="boxes px-md-1 mx-aut">
        <div class="flex-wrap mx-auto mx-md-4" >
            <div style="margin-bottom:50px;">
                <div class="boxes px-md-2 grid-mvc" data-lang="ar" data-gridname="UsersGrid" data-selectable="true" data-multiplefilters="false">
                    <div class="tbody">
                        <div class="d-flex flex-wrap mx-auto mx-md-4">
                            <input type="hidden" name="UserProfileVMs.index" autocomplete="off" value="50ffa560-adca-48a0-a1ed-b7bf653afd8e">
                            @foreach (var item in Model)
                            {
                                <div class="box-grid">

                                    <div class="box no_sorting animated zoomIn buttons-action">
                                        <div class="correspondence-b d-flex flex-wrap">
                                            <div class="correspondence-h">
                                                <div class="title">

                                                    @item.GroupName
                                                </div>
                                            </div>
                                            <div class="f-line w-full contact">
                                                <div class="heading">المستخدم </div>
                                                <div class="ml-2">     @item.UserName</div>

                                            </div>
                                            <div class="correspondence-icon d-flex" style="width:100%">
                                                <div>
                                                    <a class="btn btn-site p-1 pr-2 pl-2" title="قبول" onclick="ShowCustomConfirmMessage('@DbRes.TValidation("Admin.Confirm.Activation")', 'ApproveRoleRequested',  @item.Id)">
                                                        قبول
                                                    </a>
                                                    <a class="btn btn-site  p-1 pr-2 pl-2" title="قبول" onclick="ShowCustomConfirmMessage('@DbRes.TValidation("Admin.Confirm.Activation")', 'RejectRoleRequested',  @item.Id)">
                                                        رفض
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    
                                </div>
                            }

                            </div>

                    </div>
               

                </div>

            </div>
        </div>
    </div>
</div>
<script>

    function ApproveRoleRequested(id) {
     
        $.ajax({
            type: 'get',
            data: { id: id },
            url: '@Url.Action("ApproveRoleRequest", "User")',
            success: function (data) {
                if (data.MessageType != 2) {
                    // ShowInformationMessage('تمت العملية')
                    redirect();
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }

    function RejectRoleRequested(id) {
     
        $.ajax({
            type: 'get',
            data: { id: id },
            url: '@Url.Action("RejectRoleRequest", "User")',
            success: function (data) {
                if (data.MessageType != 2) {
                    ShowInformationMessage(data.MessageText, redirect());
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }


    
    function redirect() {
        setTimeout(location.reload(), 2000);

    }



</script>










