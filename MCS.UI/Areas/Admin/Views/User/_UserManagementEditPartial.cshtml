@using MCS.Framework.Localization
@using MCS.Common
@using MCS.UI.Areas.User.Models.Lookups
@model MCS.UI.Areas.Admin.Models.EditUserProfileVM

@{
    ViewBag.Title = "_UserEditPartial";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content_all">
    <div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center flex-grow-1 mb-3 mb-lg-0">
            <h3 class="site-color mb-2 mb-lg-4">تعديل المستخدم </h3>
        </div>

        <div class="close-icon pl-2 mt-0 ml-auto">
            <a class="circle-icon color-white" href="@Url.Action("Index", "User")" data-bs-toggle="tooltip" data-placement="bottom" title="إغلاق"><i class="la la-close"></i></a>
        </div>
    </div>



    <div class="content_container">
        <div class="row white-container  mx-3 mx-md-5">
            @using (Html.BeginForm("", "", FormMethod.Post, new { id = "formEditUser" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12 disable">
                        @Html.LabelFor(model => model.UserName)<span class='red-color ml-1 ml-1'>*</span>
                        @Html.TextBoxGroupFor(model => model.UserName, "EditUser", new { @class = "form-control" })
                    </div>

                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12 disable">
                        @Html.LabelFor(model => model.UserNationalId)<span class='red-color ml-1 ml-1'>*</span>
                        @Html.NumericTextBoxFor(model => model.UserNationalId, new { placeholder = DbRes.TResource("Admin.User.Exam") + " 0123456789", @class = "form-control", maxlength = "10" }, "EditUser")
                    </div>
                    @Html.StickyHiddenFor(model => model.CategoryId, new { @Value = 1 })
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        @Html.LabelFor(model => model.TitleId, new { id = "TitleId" })<span class='red-color ml-1 ml-1'>*</span>
                        @Html.AutoCompleteBuilder("ddlAddTitle", "hdnAddTitleId", LookupCategory.Title, Model != null ? Model.TitleName : null, true, "form-control")
                        @Html.HiddenGroupFor(model => model.TitleId, new { @Value = "", id = "hdnAddTitleId" }, "EditUser")
                        @Html.HiddenGroupFor(model => model.TitleName, new { @Value = "", id = "hdnTitleName" }, "EditUser")

                        @Html.HiddenFor(model => model.TitleName)

                    </div>

                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12 disable">
                        @Html.Label(DbRes.TResource("Admin.User.Name.ar"))<span class='red-color ml-1 ml-1'>*</span>
                        @Html.TextBoxGroupFor(model => model.Names[0].Text, "EditUser", new { @class = "form-control", maxlength = "150" })
                        @Html.StickyHiddenFor(model => model.Names[0].CultureId, new { @Value = (int)CultureType.Arabic })
                        @Html.HiddenGroupFor(model => model.Names[0].Id, new { id = "hdnLocalizationId" }, "EditUser")

                    </div>

                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12 disable">
                        @Html.Label(DbRes.TResource("Admin.User.Name.en"))<span class='red-color ml-1 ml-1'>*</span>
                        @Html.TextBoxGroupFor(model => model.Names[1].Text, "EditUser", new { @class = "form-control", maxlength = "150" })
                        @Html.StickyHiddenFor(model => model.Names[1].CultureId, new { @Value = (int)CultureType.English })
                        @Html.HiddenGroupFor(model => model.Names[1].Id, new { id = "hdnLocalizationId" }, "EditUser")

                    </div>
                    <div class="form-group col-lg-3 col-md-12  col-sm-6 col-xs-12 disable">
                        @Html.LabelFor(model => model.Email)<span class='red-color ml-1 ml-1'>*</span>
                        @Html.TextBoxGroupFor(model => model.Email, "EditUser", new { id = "EmailEdit", @class = "form-control", type = "Email", maxlength = "150" })
                    </div>
                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12">
                        <label>رسالة تأكيد عند الدخول</label><span class='red-color ml-1 ml-1'></span>
                        <div class="form-check form-check-inline col-xs-12">
                            @Html.CheckBoxFor(model => model.SMSNotifications, new { @class = "form-check-input" })
                            <label class="dark-color p-0">
                                @DbRes.TResource("User.UserPreferences.Yes")
                            </label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12 disable">
                        @Html.LabelFor(model => model.PhoneNumber)<span class='red-color ml-1 ml-1'>*</span>
                        @Html.TextBoxGroupFor(model => model.PhoneNumber, "EditUser", new { placeholder = DbRes.TResource("Admin.User.Exam") + " 0599999999", @class = "form-control", maxlength = "15" })
                    </div>
                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12">
                        <label>رقم التحويلة</label><span class='ml-1 ml-1'></span>
                        @Html.TextBoxGroupFor(model => model.InternalNumber, "EditUser", new { @class = "form-control", maxlength = "15" })

                    </div>
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                        <label>@DbRes.TResource("User.Transaction.Name.Gender") </label><span class='red-color ml-1 ml-1'>*</span>
                        @Html.AutoCompleteBuilder("ddlGender", "Gender", LookupCategory.Gender, Model != null ? Model.Gender.ToString() : null, true, "form-control")
                        @Html.HiddenGroupFor(model => model.Gender, new { @Value = "", id = "Gender" }, "EditUser")
                    </div>

                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12">
                        <div class=" col-xs-12">
                            @Html.LabelFor(model => model.TransactionProcessingPeriod)<span class='red-color ml-1 ml-1'>*</span>
                        </div>
                        <div class=" col-xs-11">
                            @Html.NumericTextBoxFor(model => model.TransactionProcessingPeriod, new { @class = "form-control" }, validationGroup: "EditUser")
                        </div>
                        <span class="input-group-prepend bg-none">
                            <span class="input-group-text">يوم</span>
                        </span>
                    </div>
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        @Html.LabelFor(model => model.RoleId)<span class='red-color ml-1 ml-1'>*</span>
                        @Html.AutoCompleteBuilder("Roles", "hdnRoles", ViewData["Roles"].ToString(), Model != null ? Model.RoleId.ToString() : null, true, "form-control", "", "", "", false, "EditUser", onChangeCallback: "GetGroupPermissionsByGroupId")
                        @Html.HiddenGroupFor(model => model.RoleId, new { @Value = "", id = "hdnRoles" }, "EditUser")
                    </div>
                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12">
                        <label>مخول باستلام المتابعة</label><span class='red-color ml-1 ml-1'></span>
                        <div class="form-check form-check-inline col-xs-12">
                            @Html.CheckBoxFor(model => model.IsFollowUpUser, new { @class = "form-check-input" })
                            <label class="dark-color p-0">
                                @DbRes.TResource("User.UserPreferences.Yes")
                            </label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3 col-md-4  col-sm-6 col-xs-12">
                        <label>مخول باستخدام التطبيق</label><span class='red-color ml-1 ml-1'></span>
                        <div class="form-check form-check-inline col-xs-12">
                            @Html.CheckBoxFor(model => model.AllowMobile, new { @class = "form-check-input", id = "ChkAllowMobile" })
                            <label class="dark-color p-0">
                                @DbRes.TResource("User.UserPreferences.Yes")
                            </label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12" id="dvUsermobileClass" style="@(Model.AllowMobile ? "display:block" : "display:none")">
                        @Html.LabelFor(model => model.UserMobileClassId, new { id = "UsermobileClassId" })<span class='red-color ml-1 ml-1'>*</span>
                        @Html.AutoCompleteBuilder("ddlUsermobileClass", "hdnUsermobileClassId", LookupCategory.UserMobileClass, Model != null ? Model.UserMobileClassName : null, true, "form-control")
                        @Html.HiddenGroupFor(model => model.UserMobileClassId, new { @Value = "", id = "hdnUsermobileClassId" }, "EditUser")
                        @Html.HiddenGroupFor(model => model.UserMobileClassName, new { @Value = "", id = "hdnUsermobileClassName" }, "EditUser")

                        @Html.HiddenFor(model => model.UserMobileClassName)

                    </div>
                    <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-12 disable">
                        <fieldset class="field-set" id="dvMainDepartmentsTree">
                            @Html.DepartmentsTree(ViewData["orgUnitDataInfo"] as TreeViewModel, model => model.MainOrgUnitId, TreeMode.Single, "MainDepartmentsTree", true, null, "EditUser", "dvMainDepartmentsTree")
                        </fieldset>
                        @*<label>@Html.DisplayNameFor(model => model.MainOrgUnitId)<span class="stark"></span></label>
                            @Html.EditorFor(model => model.MainOrgUnitId, "OrgHierarchyCaller", additionalViewData: new { treeId = "MainDepartmentsTree", GetChildrenActionURL = @Url.Action("GetInternalPartyChildren", "Common"), GetNodeInfoByIdActionURL = @Url.Action("GetInternalPartyInfoById", "Common"), GetNodeInfoByNumActionURL = @Url.Action("GetInternalPartyInfoByNumber", "Common"), onClickfunction = "", ValidationGroup = "EditUser", ShowAddPartyButton = false })*@
                    </div>
                    <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <fieldset class="field-set" id="dvOthersDepartmentsTree">
                            @Html.DepartmentsTree(ViewData["orgUnitDataInfo"] as TreeViewModel, model => model.OrgUnits, TreeMode.Single, "OthersDepartmentsTree", true, null, "EditUser", "dvOthersDepartmentsTree")
                        </fieldset>
                        @*<label>@Html.DisplayNameFor(model => model.OrgUnits)<span class="stark"></span></label>
                            @Html.EditorFor(model => model.OrgUnits, "OrgHierarchyCaller", additionalViewData: new { treeId = "OthersDepartmentsTree", GetChildrenActionURL = @Url.Action("GetInternalPartyChildren", "Common"), GetNodeInfoByIdActionURL = @Url.Action("GetInternalPartyInfoById", "Common"), GetNodeInfoByNumActionURL = @Url.Action("GetInternalPartyInfoByNumber", "Common"), onClickfunction = "", ValidationGroup = "EditUser", ShowAddPartyButton = false })*@
                    </div>
                    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.GeneralPermissions.GenerateKeyAPI))
                    {
                        <div class="col-lg-3">
                            @Html.LabelFor(model => model.ApiKey)
                            @Html.TextBoxGroupFor(model => model.ApiKey, "EditUser", new { @class = "form-control" })
                        </div>
                        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 pl-3 mt-4">
                            <button type="button" class="btn btn-lg btn-st1 w-xs-100" onclick="generateKey()">generate Key</button>
                        </div>
                    }

                    <div class="d-flex ml-auto mt-2">
                        <div class="form-group col-lg-5 col-md-4 col-sm-6 col-xs-12 pl-3 align-self-end mang-button">
                            <button type="button" class="btn btn-lg btn-st1 w-xs-100" onclick="AddEntityBox()">@DbRes.TResource("Admin.User.AddEntity")</button>
                        </div>
                        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 pl-3 align-self-end mang-button d-flex ml-2">
                            <button type="button" class="btn btn-lg btn-st1 w-xs-100" onclick="AddRoleBox()">إضافة الادوار</button>
                            @Html.ActionButton(DbRes.TResource("Admin.User.RemoveSignaturePassword"), "RemoveSignaturePassword", "divGrid", null, null, "OnSuccessRemoveSignaturePassword", null, "post", null, "btnRemoveSignaturePassword", "formEditUser", "btn btn-lg btn-st1 ml-2", "")
                        </div>
                    </div>

                    <div class="row col-lg-12 ml-2 mb-2">
                        <h3>الادوار</h3>
                    </div>
                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-0">
                        <div class="added_departments d-flex flex-wrap" id="dvAddedRoles">
                            @{Html.RenderPartial("_UserRolesList", Model.UserGroups ?? new List<MCS.DTO.UserGroupDTO>());}
                        </div>
                    </div>
                    <div class="row col-lg-1 ml-2 mb-2">
                        <h3>الادارات</h3>
                    </div>

                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-0">
                        <div class="added_departments d-flex flex-wrap" id="dvAddedDepartments">
                            @{Html.RenderPartial("_UserManagementOtherDepartmentsList", Model.OrgUnitList ?? new List<MCS.DTO.OrgUnitDTO>());}
                        </div>
                    </div>

                    <div class="col-xs-12 hidden_">
                        <p class="stark">@DbRes.TResource("Admin.User.MustFill") * </p>
                    </div>
                    @*<hr class="mb-3 mt-2">*@

                </div>
                @Html.StickyHiddenFor(model => model.IsManager, new { id = "hdnIsManager" })
                @Html.HiddenFor(model => model.Id, new { id = "hdnEditId" })
                @Html.HiddenFor(model => model.IdentifierId)
                @Html.HiddenFor(model => model.MainOrgUnitName)
                @Html.HiddenFor(model => model.MainOrgUnitId)
                @Html.HiddenGroupFor(model => model.TitleId, new { id = "hdnEditTitleId" }, "EditUser")
                @Html.StickyHiddenFor(model => model.SelectedOrgUnitsIds, new { id = "selectedEntities" })
                @Html.StickyHiddenFor(model => model.UserGroupsList, new { id = "selectedRoles" })
                @Html.HiddenFor(model => model.ExternalId, new { id = "hdnExternalId" })
                @Html.HiddenFor(model => model.InternalNumber, new { id = "hdnInternalNumber" })


            }
            @*<div id="PermissionsTree">
                    @Html.PermissionsTree(ViewData["PermissionsGroups"] as TreeViewModel, model => model.Permissions, TreeMode.Multiple, "PermissionsTree", Request.IsAjaxRequest())

                </div>*@
        </div>
    </div>
</div>
<div class="mx-3 mx-md-5 mb-4 d-flex">
    @Html.ActionButton(DbRes.TResource("Admin.User.Edit"), "EditUserProfile", "divGrid", null, null, "OnEditSuccess", null, "post", null, "btnEdit", "formEditUser", "btn btn-lg btn-st3 ml-auto", "GetOrganizationUnitIds")
    <a class="btn btn-lg btn-st3 mx-1" id="btnCancel" href="@Url.Action("Index", "User")">@DbRes.TResource("Admin.User.Cancel")</a>
</div>



<script>

    $(document).on("change", "#ChkAllowMobile", function ()
    {
        debugger;
        if ($(this).is(':checked'))
        {

            $('#dvUsermobileClass').show();
        } else
        {
            $('#dvUsermobileClass').hide();
        }
    });

    function OnEditSuccess(data, div) {

        $("#divEditUser").css("display", "none");
        $("#divAddUser").css("display", "block");
        if (data.MessageType != 2) {
            $("#" + div).html("");
            $("#" + div).html(data.Html);
            ShowSuccesMessage(data.MessageText, redirect());

        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
    function generateKey()
    {
        debugger;
               $.ajax({
                 url: '@Url.Action("GenerateHashKey", "User")',
                 type: 'Get',
                 success: function (data) {
                    if (data.MessageType != 2) {
                        $('#ApiKey').val(data.Key);
                    }

                 }
               });

    }

    function checkInputs() {

        $("#selectedRoles").val(selectedRoles);
    }

       function redirect() {
          setTimeout(function () {
            window.location.href = '@Url.Action("Index", "User", new { area="Admin"})';
        }, 2000);
    }
    $(document).ready(function () {

        if ($("#hdnIsManager").val() == "True") {
            $("#IsManagerCheck").attr('checked', 'checked');
        }
        //GetGroupPermissionsByGroupId();

        //AddEntityBox();
        $("#selectedEntities").val(selectedEntities.join(','));
        $("#selectedRoles").val(selectedRoles.join(','));

        if ($('#hdnExternalId').val() != '') {
            $('.disable').find(':input').attr('readonly', 'true');
            $('.disable').find('.ShowHideOrgHierarchyDialog').hide();
        }
    });
    function GetOrganizationUnitIds() {
        if (selectedRoles.length == 0) {

            ShowErrorMessage("@DbRes.TValidation("Admin.User.RoleRequired")");
            return false;

        }
        $('#OrgUnitContent').empty();
        $("[data-name='OrgUnits']").find('.tag').each(function (index) {

            $('#OrgUnitContent').append("<input name='OrgUnitList[" + index + "].Id' value=" + this.id + " type='hidden'/>");
        });
        $("#selectedEntities").val(selectedEntities.join(','));
        $("#selectedRoles").val(selectedRoles);
        return true;
    }
    function GetGroupPermissionsByGroupId() {
        var groupId = $("#hdnRoles").val();
        $.ajax({
            url: '@Url.Action("GetGroupPermissionsByGroupId", "User")',
            type: 'get',
            data: { groupId: groupId },
            success: function (data) {
                if (data.MessageType != 2) {
                    $("#PermissionsTree").html("");
                    $("#PermissionsTree").html(data.Html);
                }
                else {
                    // ShowErrorMessage(data.MessageText);
                }
            }
        });
    }

    $(function () {
        var hml = $('<div>').append($('#usernameDiv').find(".field-validation-valid").clone()).html();
        $("#usernameDiv").find(".field-validation-valid").remove();
        $("#usernameDiv").after(hml);
    })
    function UserSearch() {
        if ($("#UserNameEdit").val() != "")
            $.ajax({
                cache: false,
                type: "GET",
                url: '@Url.Action("CheckUserName", "User")',
                data: { "username": $("#UserNameEdit").val() },
                success: function (response) {
                    if (response.UsersList.length == 1) {
                        $("#formEditUser").find("#EmailEdit").val(response.UsersList[0].Email);
                        $("#formEditUser").find("#Names_1__Text").val(response.UsersList[0].EmployeeName);
                    } else {
                        ShowDialogAjax('@Url.Action("GetActiveDirectoryUsers")', { users: response.UsersList, type: 2,username:$("#UserNameEdit").val() }, 'ActiveDirectoryUsersSuccess');
                    }
                }
            });
    }

    function OpenUserTitleEdit() {

        ShowDialogAjax('@Url.Action("OpenAddUserTitle")', { mode: 'Edit' }, 'OpenUserTitleEditSuccess');
    }

    function OpenUserTitleEditSuccess(data, $obj) {
        $obj.setContent(data.Html);
        jQuery.validator.unobtrusive.parse('#frmUserTitle');
    }
    var selectedEntities = [];
    function checkIfExist(entityId) {

        var exist = false;
        selectedEntities.forEach(function (item) {
            if (item == entityId) {
                exist = true
                return;
            }
        });
        return exist;
    }
    var selectedRoles = [];
    function checkRoleIfExist(roleId) {

        var exist = false;
        selectedRoles.forEach(function (item) {
            if (item == roleId) {
                exist = true
                return;
            }
        });
        return exist;
    }

    function AddRoleBox() {
        var roleId = $("#hdnRoles").val();
        var roleName = $("#Roles").val();

        if (roleId == "" && roleName == "") {
            return false;
        }
        var box = "<div class='added_item mr-4 mb-3' id='RoleBox_" + roleId + "'>";
        box += "<span class='added-class d-flex'>";
        box += "<span>" + roleName + "</span>";
        box += "<a onclick='deleteRoleBox(" + roleId + ")' class='color-burgundy ml-2'><i class='icon-tables-delete'></i></a>";

        box += "</span>";
        box += "</div>";

        if (checkRoleIfExist(roleId)) {
            ShowErrorMessage("لقد تم ادخال هذا الدور من قبل ، اختر دور اخر");

        }
        else {
            selectedRoles.push(roleId);
            $("#dvAddedRoles").append(box);
        }

    }


        function GetGroupPermissionsByGroupId() {
        var groupId = $("#hdnRoles").val();
        $.ajax({
            url: '@Url.Action("GetGroupPermissionsByGroupId", "User")',
            type: 'get',
            data: { groupId: groupId },
            success: function (data) {
                if (data.MessageType != 2) {
                    $("#PermissionsTree").html("");
                    $("#PermissionsTree").html(data.Html);
                }
                else {
                    // ShowErrorMessage(data.MessageText);
                }
            }
        });
    }
    function AddEntityBox() {

        var entityId = $("#OrgUnits").val();
        var entityName = $("#leftOthersDepartmentsTree").val();
        var MainentityId = $("#MainOrgUnitId").val();
        var MainentityName = $("#leftMainDepartmentsTree").val();

        if (entityId == "" && entityName == "") {
            return false;
        }
        if (entityId == MainentityId && entityName == MainentityName) {
            ShowErrorMessage("@DbRes.TResource("Admin.User.alreadyAddedEntity")");
            return false;
        }

        if (checkIfExist(entityId)) {
            ShowErrorMessage("@DbRes.TValidation("User.Transaction.AssignmentAlreadyAdded")");
        } else {

            $.ajax({
                url: '@Url.Action("GetUserOtherDepartment", "User")',
                type: 'get',
                data: { id: entityId },
                success: function (data) {
                    if (data.MessageType != 2) {
                        $("#dvAddedDepartments").append(data.Html);
                        ClearInputs("OthersDepartmentsTree");
                    }
                    else {
                        // ShowErrorMessage(data.MessageText);
                    }
                }
            });
        }
    }

    function deleteEntityBox(boxId) {

        var index = selectedEntities.indexOf(boxId + "");
        if (index > -1) {
            selectedEntities.splice(index, 1);
        }
        $("#EntityBox_" + boxId).remove();
    }

    function deleteRoleBox(boxId) {
        var index = selectedRoles.indexOf(boxId + "");
        if (index > -1) {
            selectedRoles.splice(index, 1);
        }
        $("#RoleBox_" + boxId).remove();
    }

    function OnSuccessRemoveSignaturePassword(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
        }
        else {
             ShowErrorMessage(data.MessageText);
        }
    }
</script>
