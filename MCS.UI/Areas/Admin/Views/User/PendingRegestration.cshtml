@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models
@using MCS.GridMvc.Ajax.GridExtensions


@model AjaxGrid<UserProfileVM>
@{
    ViewBag.Title = DbRes.TResource("Admin.UserManagement.UserManagement");
    Layout = "~/Areas/Admin/Views/Shared/_UsersTraysLayout.cshtml";
}

<div class="content_container site_border">
    <div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center ">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center flex-grow-1 mb-3 mb-lg-0">
            <h3 class="site-color mb-2 mb-lg-4">@DbRes.TResource("Admin.UsersTraysPermissionsReport.Users") </h3>
            <div class="ml-lg-auto d-flex flex-column flex-md-row">
                <div class="filter-link ml-lg-auto mr-lg-3 my-2 mt-lg-auto ">
                    <a class="dashed-circle search-target" href="#">
                        <i class="fas fa-search"></i>
                        @DbRes.TResource("User.File.Search")
                    </a>
                    <div class="toggling-menu">
                        <a href="#" class="active system_1"><i class="icon-grid"></i></a>
                        <a href="#" class="grid_system"><i class="icon-list"></i></a>
                    </div>
                </div>
              
            </div>
        </div>
        <!-- close
            <div class="close-icon pl-2 mt-0 ml-auto">
                <a class="circle-icon color-white" href="#" data-bs-toggle="tooltip" data-placement="bottom" title="إغلاق"><i class="la la-close"></i></a>
            </div>
        -->
    </div>



    <div class="filter-box search mx-3 mx-md-5 white-container mt-2">
        <form id="frmUsersSearch">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-group col-lg-3 col-sm-6 col-xs-12">
                    <label for="">@DbRes.TResource("Admin.User.UserName")</label>
                    @Html.TextBox("hdnUserName", "", new { id = "hdnUserName", @class = "form-control" })

                </div>
                <div class="form-group col-lg-3 col-sm-6 col-xs-12">
                    <label for="">@DbRes.TResource("Admin.User.Email") </label>
                    <input type="Email" class="form-control" id="hdnEmail" , maxlength="150">

                </div>
                <div class="form-group col-lg-3 col-sm-6 col-xs-12">
                    <label for="">@DbRes.TResource("Admin.ExternalParty.Phone")</label>
                    <input type="text" class="form-control" id="hdnPhoneNumber" onkeypress="return IsNumeric(event);" maxlength="15">

                </div>

                <div class="form-group col-lg-3 col-sm-6 col-xs-12">
                    <label for="">المستخدمين المحذوفين</label>
                    <div class="form-check form-check-inline w-100 ">
                        <input id="IsdeleteUsers" type="checkbox"  name="IsdeleteUsers" class="form-check-input" />
                    </div>
                </div>



                <div class="form-group col-lg-3 col-md-4 col-sm-4 col-xs-12 align-self-end">
                    <div class="form-group col-lg-3 col-md-4 col-sm-4 col-xs-12 align-self-end">

                        @Html.ClientButton(@DbRes.TResource("User.File.Search"), "btnSearch", "btn btn-st1 w-xs-100", "UsersProfileSearch")
                    </div>
                </div>

            </div>
        </form>
    </div>


    <div class="boxes px-md-1 mx-aut">
        <div class="flex-wrap mx-auto mx-md-4" id="dvUsersGrid">
            @Html.Partial("~/Areas/Admin/Views/User/PendingUsersRegestrationGridPartial.cshtml", Model)
        </div>
    </div>
</div>
<script>

    function ApproveRequestedUser(UserId) {
        $.ajax({
            type: 'get',
            data: { id: UserId },
            url: '@Url.Action("ApproveRequestedUser", "User")',
            success: function (data) {
                if (data.MessageType != 2) {
                    ShowInformationMessage(data.MessageText, redirect());
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }


    function RejectRequestedUser(UserId) {
        $.ajax({
            type: 'get',
            data: { id: UserId },
            url: '@Url.Action("RejectRequestedUser", "User")',
            success: function (data) {
                if (data.MessageType != 2) {
                    redirect();
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }


    function UsersProfileSearch() {
        var filter = "";
        var token = $("#frmUsersSearch input[name='__RequestVerificationToken']").val();

        if ($("#hdnPhoneNumber").val() != "" && $("#hdnPhoneNumber").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "PhoneNumber__1__" + $("#hdnPhoneNumber").val();
        }

        if ($("#hdnUserName").val() != "" && $("#hdnUserName").val() != null) {

            filter += "UserName__1__" + $("#hdnUserName").val();
        }

        if ($("#hdnEmail").val() != "" && $("#hdnEmail").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Email__1__" + $("#hdnEmail").val();
        }
        $("#filterData").val(filter);

        var isDeleted =$('#IsdeleteUsers').is(":checked")
        $.ajax({
            type: 'post',
            data: { filter: filter, __RequestVerificationToken: token, isDeleted: isDeleted },
            url: '@Url.Action("UsersProfileSearch", "User")',
            success: function (data) {
                if (data.MessageType != 2) {
                    $("#dvUsersGrid").html("");
                    $("#dvUsersGrid").html(data.Html);
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }

    function AddUser() {
        window.location.href = '@Url.Action("AddUserProfile", "User")';
    }




    $(function () {
        $(".grid_system").click(function () {
            $(".boxes").addClass("full");
                        });
        $(".system_1").click(function () {
            $(".boxes").removeClass("full");
                        });
    });

    function OnAddSuccess(data, div) {
                        if (data.MessageType != 2) {
            $("#" + div).html("");
            $("#" + div).html(data.Html);
                            jQuery.validator.unobtrusive.parse('#' + div);
                            ShowSuccesMessage(data.MessageText)
                            Clear('dvAddTreeContainer');
                        }
                        else {
                            ShowErrorMessage(data.MessageText);
                        }
                    }

                    function Clear(formId) {
        $(".removeTag").trigger("click");
        $(".removeDepartmentTag").trigger("click");
                        ClearInputs(formId);
        $("#" + formId).formReset();
                    }

                    function redirect() {
                        setTimeout(function () {
                            window.location.href = '@Url.Action("PendingRegestration", "User", new { area="Admin"})';
                        }, 2000);
                    }


    $(document).ready(function () {

        $('.search-target').click(function () {
            $('.filter-box.search').slideToggle('fast');
            $('.sort-target').removeClass("active");
            $('.filter-target').removeClass("active");
            $(this).toggleClass("active");
            $('.filter-box.filter').hide();
            $('.filter-box.sort').hide();

                        });
                    });


</script>










