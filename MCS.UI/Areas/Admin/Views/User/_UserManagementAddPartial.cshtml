    <script type="text/javascript">
        function GetOrganizationUnitIdsAddMode() {
            $('#OrgUnitAddContent').empty();
            $("[data-name='OrgUnits']").find('.tag').each(function (index) {
                $('#OrgUnitAddContent').append("<input name='OrgUnitList[" + index + "].Id' value=" + this.id + " type='hidden'/>");
            });
            return true;
        }

        $(function () {
            var hml = $('<div>').append($('#userDiv').find(".field-validation-valid").clone()).html();
            $("#userDiv").find(".field-validation-valid").remove();
            $("#userDiv").after(hml);
        })

        $.validator.unobtrusive.adapters.add(
            'validatenames',
            ['validationgroup'],
            function (options) {
                options.rules['validatenames'] = {
                    validationgroup: options.params['validationgroup']
                };
                options.messages['validatenames'] = options.message;
            });

        $.validator.addMethod('validatenames',
            function (value, element, parameters) {
                if (value != "") {
                    if (keyDepartment.indexOf(value) == -1) {
                        return false;
                    }
                }
                return true;
            }
        );

        function SearchUsers() {
            if ($("#UserName").val() != "")
                $.ajax({
                    cache: false,
                    type: "GET",
                    url: '@Url.Action("CheckUserName", "User")',
                    data: { "username": $("#UserName").val() },
                    success: function (response) {
                        if (response.UsersList.length == 1) {
                            $("#Email").val(response.UsersList[0].Email);
                            $("#Names_1__Text").val(response.UsersList[0].EmployeeName);
                        } else {
                            ShowDialogAjax('@Url.Action("GetActiveDirectoryUsers")', { users: response.UsersList, type: 1, username: $("#UserName").val() }, 'ActiveDirectoryUsersSuccess');
                        }
                    }
                });
        }
        function ActiveDirectoryUsersSuccess(data, $obj) {
            $obj.setContent(data.View);
        }

        function OpenUserTitleAdd() {

            ShowDialogAjax('@Url.Action("OpenAddUserTitle")', { mode: 'Add' }, 'OpenUserTitleAdduccess');
        }

        function OpenUserTitleAdduccess(data, $obj) {

            $obj.setContent(data.Html);
            jQuery.validator.unobtrusive.parse('#frmUserTitle');
        }
    </script>*@
