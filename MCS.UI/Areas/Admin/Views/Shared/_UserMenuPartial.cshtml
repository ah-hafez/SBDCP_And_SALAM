@using MCS.UI.Areas.User.Models.Shared;


<li class="xn-profile">
    <a href="#" class="profile-mini" title="@DbRes.TResource("Admin.Layout.Admin")">
        <img src="~/Content/Admin/lib/assets/images/users/no-image.png" alt="" />
    </a>
    <div class="profile">
        <div class="profile-image">
            <a>
                <img src="~/Content/Admin/lib/assets/images/users/no-image.png" alt="" />
            </a>
        </div>
        <div class="profile-data">
            @{UserVM userDTO = SessionInfo.GetObjectFromSession(Constants.LoggedInUserKey) as UserVM;}
            <div class="profile-data-name">@userDTO.LoclizationName.Where(l => l.CultureName == SessionInfo.CultureShortName).FirstOrDefault().Text</div>
            <div class="profile-data-title">@DbRes.TResource("Admin.Layout.Admin")</div>
            @*<div class="profile-data-title icon">
                    <a class="change_your_password" data-bs-toggle="tooltip" data-placement="top" title="@DbRes.TResource("Admin.Layout.ChangePassword")"><i class="fa fa-lock"></i></a>
                </div>*@
        </div>
    </div>
</li>
