        function setMenuState() {
            if ($("body").hasClass("menu-expanded")) {
                $.cookie('currentMenuState', 'invisible', { path: '/' });
            }
            else {
                $.cookie('currentMenuState', 'visible', { path: '/' });
            }
        }

        function getMenuState() {
            if ($.cookie('currentMenuState') === 'invisible') {
                $.app.menu.collapse();
            }
            else {
                $.app.menu.expand();
            }
        }

    function CallHomePage(id) {
        var token = $("#frmOrgUnitsList").find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            url: '@Url.Action("SetOrgUnit", "Home")',
            type: 'POST',
            data: { 'orgUnitId': id, __RequestVerificationToken: token },
            success: function (data) {
                location.reload();
            },
            error: function (a) {
            }
        });
    }

    function ChangeCulture(name) {
        $.ajax({
            url: '@Url.Action("SetCultureName", "Home")',
            type: 'POST',
            data: { 'cultureName': name },
            success: function (data) {
                window.location.href = data.ReturnUrl;
            },
            error: function (a) {
            }
        });
    }
    function OpenUrlMenu(Url) {
        window.location.href = Url;
