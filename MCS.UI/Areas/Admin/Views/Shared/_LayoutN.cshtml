            case "SystemSettings":
                $("#li_2").addClass("active");
                break;
            case "Lookups":
                $("#li_3").addClass("active");
                break;
            case "Actions":
                $("#li_4").addClass("active");
                break;
            case "User":
                $("#li_5").addClass("active");
                break;
            case "Permissions":
                $("#li_6").addClass("active");
                break;
            case "ExternalParties":
                $("#li_7").addClass("active");
                break;
            case "Paths":
                $("#li_8").addClass("active");
                break;
            default:
                $("#li_1").addClass("active");
                break;
        }
    });
</script>

