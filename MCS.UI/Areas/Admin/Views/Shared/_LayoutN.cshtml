    var AllUsers =new Array();

    GetChatNotifications();

    GetAllUsers();

    HideNotificationChat();

    HideNotificationChat();

    $(document).on("keyup","#ChatSearch",function(message) {

        var searchedText=$(this).val();
        ClearChatSection();

        for(i=0; i < AllUsers.length ; i++){
            var userName=$(AllUsers[i]).attr("data-online-userName");
            if(userName.indexOf(searchedText) != -1){
                AddToChatSection(AllUsers[i]);
            }
        }

    });

    function AppearOnlineUser(userId)
    {
        $('.appear[data-online-userid="' + userId + '"]').addClass("online").addClass("onlineUser");
    }

    function ResetChatBinding()
    {
        IsBindingWithTransaction= false;
    }

    function SetChatBinding(userId, transactionId)
    {
        var element=$('.messageRow[data-userid-chat-window="' + userId + '"]');
        element.addClass("TransactionRowMessage");
        element.removeClass("messageRow");
        element.data("transactionId",transactionId)
        element.attr('data-transactionId', transactionId);
        $('.TransactionRowMessage[data-userid-chat-window="' + userId + '"]').data("transactionId",transactionId);
        $('.TransactionRowMessage[data-userid-chat-window="' + userId + '"]').attr('data-transactionId', transactionId);
    }

    function GetChatNotifications()
    {
        if(pageIndex==0)
            return false;

        $.ajax({
            type: 'get',
            url: '@Url.Action("GetChatNotifications")',
            data: { },
            Async:true,
            global: false,
            success:
               function (data)
               {
                   if (data.ChatNotifications && data.ChatNotifications.Result && data.ChatNotifications.Result.TotalChatNotifications) {
                       if (data.ChatNotifications.Result.TotalChatNotifications > 0) {
                           UpdateChatNotification(data.ChatNotifications.Result.TotalChatNotifications);
                       }
                   }
                   return null;
               }
        });
    }


    function GetAllUsers() {
        $.ajax({
            type: 'get',
            url: '@Url.Action("GetCollaborationUsers")',
            data: {},
            Async: true,
            global: false,
            success:
                function (data) {
                    if (data && data.Users && data.Users.Result) {
                        data.Users.Result.forEach(function (entry) {
                            var id = @userVM.Id;

                            if (entry.UserId != id) {

                                if ($("#User" + entry.UserId).length < 1) {
                                    CreateNewUserOffline(entry.UserName, entry.UserId, entry.NotificationCount);

                                    AllUsers.push($('.onlineUser[data-online-userid="' + entry.UserId + '"]'));

                                }

                                InitializeUserNotifysCount(entry.UserId, entry.NotificationCount);
                            }

                        });
                    }
                }
        });

    }
    function showSuccessToast(message) {
        $().toastmessage('showToast', {
            text: message,
            sticky: false,
            stayTime: 10000,
            position: 'top-right',
            type: 'success',
            closeText: '',
            close: function () {
                console.log("toast is closed ...");
            }
        });
    }
</script>
