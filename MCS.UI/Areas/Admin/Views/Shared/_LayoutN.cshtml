<script>

    $("#navigation_minimize").click(function () {
        if (localStorage.getItem('navigation') == undefined) {
            localStorage.setItem('navigation', "1");
        }
        else {
            if (localStorage.getItem('navigation') == "0")
                localStorage.setItem('navigation', "1");
            else
                localStorage.setItem('navigation', "0");
        }
    });

    $(function () {
        if (localStorage.getItem('navigation') != undefined && localStorage.getItem('navigation') == "1") {
            $(".page-container").removeClass("page-navigation-toggled");
            x_navigation_minimize("open");

        }
        else {
            $(".page-container").addClass("page-navigation-toggled");
        }

        if (!$(".page-container").hasClass("page-navigation-toggled")) {
            $(".x-navigation").find('a.active_ok').parent().addClass('active_ok');
            $(".x-navigation").find('li.active_ok').parents('li:first').addClass('active');
        }

    });
</script>

