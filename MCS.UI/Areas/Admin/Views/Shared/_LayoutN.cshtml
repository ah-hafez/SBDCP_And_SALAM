<script>
    function ChangeCulture(name) {
        $.ajax({
            url: '@Url.Action("SetCultureName", "Home")',
            type: 'POST',
            data: { 'cultureName': name },
            success: function (data) {
                window.location.href = '@(MCS.UI.UrlHelper.GetBaseUri() + "/Admin/OrgUnitStructure/Index")';
            },
            error: function (a) {
            }
        });
    }

    var custom_templatePlugins = function () {

        var custom_tp_clock = function () {

            function custom_tp_clock_time() {
                var now = new Date();
                var hour = now.getHours();
                var minutes = now.getMinutes();
                var suffix = (hour >= 12) ? '@DbRes.TResource("Global.Time.PM")' : '@DbRes.TResource("Global.Time.AM")';

                hour = ((hour + 11) % 12 + 1);
                hour = hour < 10 ? '0' + hour : hour;
                minutes = minutes < 10 ? '0' + minutes : minutes;

                $(".timeplugin-clock").html(hour + "<span>:</span>" + minutes + " " + suffix);
            }
            if ($(".timeplugin-clock").length > 0) {

                custom_tp_clock_time();

                window.setInterval(function () {
                    custom_tp_clock_time();
                }, 10000);

            }
        }

        return {
            init: function () {
                custom_tp_clock();
            }
        }
    }();

    $(function () {
        custom_templatePlugins.init();
    });
</script>
<script>
    $(document).ready(function () {
        $("input.form-control:text,textarea").each(function () {
            var attr = $(this).attr('maxlength');
            if (typeof attr == typeof undefined) {
                $(this).attr('maxlength', '200');
            }
        });
        encodeForm();
    });

    function encodeForm() {
        var potentialError = false;
        $('form').submit(function (e) {
            $("input.form-control:text,textarea").each(function () {
                var txt = $(this).val();
                if (txt != '' && (txt.indexOf('<') > -1 || txt.indexOf('>') > -1 || txt.indexOf('&') > -1 || txt.indexOf('\'') > -1 || txt.indexOf('\"') > -1)) {
                    potentialError = true
                    return;
                }
            });
            if (potentialError) {
                alert('A potentially dangerous form value was detected, please review your inputs');
            }
        });
    }

