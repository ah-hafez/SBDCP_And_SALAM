@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Lookups
@model MCS.UI.Areas.Admin.Models.Groups.AddGroupVM

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmAddGroup", @class = "content_container" }))
{
    <div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center flex-grow-1 mb-3 mb-lg-0">
            <h3 class="site-color mb-2 mb-lg-4">@DbRes.TResource("Admin.Permissions.CreateGroup") </h3>
        </div>
        <div class="close-icon pl-2 mt-0 ml-auto" onclick="window.location.reload();">
            <a class="circle-icon color-white" href="@Url.Action("Index" , "Permissions")" data-bs-toggle="tooltip" data-placement="bottom" title="إغلاق"><i class="la la-close"></i></a>
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div id="AddGroupContent" class="row white-container mx-3 mx-md-5">
        <div class="">
            <button class="example-p-01 btn btn-primary dialog_but" type="button">@DbRes.TResource("Admin.Permissions.EditPermissionsName")</button>
            <script type="text/javascript">
                $('.example-p-01').on('click', function () {
                    EditPermissionsName();
                });
            </script>
        </div>
        <div class="form-row">
            @{List<CultureVM> Culture = (List<CultureVM>)ViewData["Culture"];}
            @for (int i = 0; i < Culture.Count; i++)
            {
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    @Html.CustomLabelFor(model => model.Name.Localizations[i].CultureName, new { @class = "" }, DbRes.TResource("Admin.Permissions.GroupName." + Culture[i].ShortName))
                    @Html.StickyHiddenFor(model => model.Name.Localizations[i].CultureId, new { Value = Culture[i].Id })
                    <div class="">
                        @Html.TextBoxGroupFor(model => model.Name.Localizations[i].Text, null, new { @class = "form-control empty" }, DbRes.TValidation("Admin.Permissions.NameRequired." + Culture[i].ShortName))
                    </div>
                </div>
            }
            <div class="col-xs-12">
                <p class="stark">@DbRes.TResource("Admin.User.MustFill") * </p>
            </div>

            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12" id="PermissionsRequired" style="display:none;">
                <p class="stark">الرجاء ادخال الصلاحيات </p>
            </div>
            <hr class="mb-3 mt-2">
            <div id="AddTree">
                @Html.Partial("_PermissionTreePartial", Model)
            </div>
        </div>
    </div>
    <div class="mx-3 mx-md-5 mb-4 d-flex">
        @Html.ActionButton(DbRes.TResource("Admin.Permissions.Save"), Url.Action("AddGroup", "Permissions"), "divGrid", null, null, "OnAddSuccess", null, "post", null, "btnAddGroup", "frmAddGroup", "btn btn-lg btn-st3 ml-auto", "CheckPermissions")
        @Html.ResetButton("Clear('AddGroupContent')")
    </div>
}

<script>
    function CheckPermissions() {
         
        if ($('#divTags').is(':empty')) {
            $('#PermissionsRequired').show();
            return false;
        }
        else {
            $('#PermissionsRequired').hide();
            return true;
        }

    }
    function OpenDialogSuccess(data, $obj) {
        $obj.setContent(data.Html);
    }
    function EditPermissionsName() {
        var token = $('#frmAddGroup').find("input[name='__RequestVerificationToken']").val();
        ShowDialogAjax('@Url.Action("EditPermissionsName", "Permissions")',
            {
                __RequestVerificationToken: token
            }, 'OpenDialogSuccess');
    }
     function redirect() {
          setTimeout(function () {
            window.location.href = '@Url.Action("Index", "Permissions", new { area="Admin"})';
        }, 2000);
    }
    function OnAddSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#" + div).html("");
            $("#" + div).html(data.Html);
            jQuery.validator.unobtrusive.parse('#' + div);
            ShowSuccesMessage(data.MessageText, redirect());
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
</script>
