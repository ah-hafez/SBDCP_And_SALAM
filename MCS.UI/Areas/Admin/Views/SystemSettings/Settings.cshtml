@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Shared
@using MCS.Common

@model SuperSettingVM
@{
    ViewBag.Title = DbRes.TResource("Admin.GeneralSettings.Title");
    Layout = "~/Areas/Admin/Views/Shared/_SettingsLayout.cshtml";
    var rowStartTag = "<div class='form-row'>";
    var rowEndTag = "</div>";
}

<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
    <div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
        <h3 class="site-color mb-4">@Model.SubTitle</h3>
    </div>
    <div class="close-icon pl-2 mt-0 ml-auto">
        <a class="circle-icon color-white" href="@Url.Action("GeneralSettings","SystemSettings")" data-bs-toggle="tooltip" data-placement="bottom" title="العوده للإعدادات العامة"><i class="la la-close"></i></a>
    </div>
</div>

<div class="white-container mx-3 mx-md-5">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmSetting", @class = "form-horizontal form-row" }))
    {

        @Html.AntiForgeryToken()
        <div class="form-row w-100" id="SettingContent">
            @for (int i = 0; i < Model.SettingVMs.Count; i++)
            {
            <div class="form-group  col-sm-6 col-xs-12">
                @if (Model.SettingVMs[i].ResourceId != "Agency.Setting.Logo")
                {
                    <label for="">@DbRes.TResource(Model.SettingVMs[i].ResourceId, SessionInfo.CultureShortName)<span class="red-color ml-1">*</span></label>
                }
                else
                { <label for="" class="w-100">@DbRes.TResource(Model.SettingVMs[i].ResourceId, SessionInfo.CultureShortName)</label>
            }
                @if (Model.SettingVMs[i].IsReadOnly)
                {
                    @Html.Hidden("SubTitle", Model.SubTitle, new { id = "SubTitle" })
                    @Html.Hidden("SettingVMs[" + @i + "].Id", Model.SettingVMs[i].Id)
                    @Html.Hidden("SettingVMs[" + @i + "].Value", Model.SettingVMs[i].Value)
                    <input type="text" class="form-control" value="@Model.SettingVMs[i].Value" disabled />
                }
                else
                {
                    if (Model.SettingVMs[i].Type != null && Model.SettingVMs[i].Type.Value == (int)ControlType.ImageUpload)
                    {
                        @Html.Hidden("SubTitle", Model.SubTitle, new { id = "SubTitle" })
                        @Html.Hidden("SettingVMs[" + @i + "].Id", Model.SettingVMs[i].Id)
                        @Html.SettingControlWithValidation("SettingVMs[" + @i + "].BLOBValue", Model.SettingVMs[i].BLOBValue, Model.SettingVMs[i].SettingConfigVM)
                        string message = string.Format("SettingVMs[{0}].BLOBValue", i);
                        <span class="field-validation-valid" data-valmsg-for="@message" data-valmsg-replace="true"></span>
                    }
                    else if (Model.SettingVMs[i].Type != null && Model.SettingVMs[i].Type.Value == (int)ControlType.Dropdown && Model.SettingVMs[i].Key == "SelectAction")
                    {

                        @Html.AutoCompleteBuilder("ddlActions", "hdnActionsData", ViewData["AllActionsData"].ToString(), Model != null ? Model.SettingVMs[i].Value.ToString() : null, true, "form-control", "", "", "", false, null, onChangeCallback: "RemoveValAction")
                        @Html.Hidden("SettingVMs[" + @i + "].Id", Model.SettingVMs[i].Id)
                        @Html.HiddenGroupFor(model => Model.SettingVMs[i].Value, new { @Value = "", id = "hdnActionsData" })
                        <div id="divActionVal" style="display:none;color:#fe0000;">هذا الحقل مطلوب</div>

                    }
                    else if (Model.SettingVMs[i].Type != null && Model.SettingVMs[i].Type.Value == (int)ControlType.Dropdown && Model.SettingVMs[i].Key == "DefaultRole")
                    {
                        @Html.AutoCompleteBuilder("ddlRoles", "hdnRoles", ViewData["Roles"].ToString(), Model != null ? Model.SettingVMs[i].Value : null, true, "form-control", "", "", "", false, null,  onChangeCallback: "RemoveValRole")
                        @Html.Hidden("SettingVMs[" + @i + "].Id", Model.SettingVMs[i].Id)
                        @Html.HiddenGroupFor(model => Model.SettingVMs[i].Value, new { @Value = "", id = "hdnRoles" })
                        <div id="divRoleVal" style="display:none;color:#fe0000;">هذا الحقل مطلوب</div>
                    }
                    else if (Model.SettingVMs[i].Key == "DateType")
                    {

                        @Html.AutoCompleteBuilder("DateType", "hdnDateType", ViewData["DateType"].ToString(), Model != null ? Model.SettingVMs[i].Value : null, true, "form-control", "", "", "", false, null, null)
                        @Html.Hidden("SettingVMs[" + @i + "].Id", Model.SettingVMs[i].Id)
                        @Html.HiddenGroupFor(model => Model.SettingVMs[i].Value, new { @Value = "", id = "hdnDateType" })
                        string message = string.Format("SettingVMs[{0}].BLOBValue", i);
                        <span class="field-validation-valid" data-valmsg-for="@message" data-valmsg-replace="true"></span>


                    }
                    else if (Model.SettingVMs[i].Key == "NumberFormat")
                    {

                        @Html.AutoCompleteBuilder("NumberFormat", "hdnNumberFormat", ViewData["NumberFormat"].ToString(), Model != null ? Model.SettingVMs[i].Value : null, true, "form-control", "", "", "", false, null, null)
                        @Html.Hidden("SettingVMs[" + @i + "].Id", Model.SettingVMs[i].Id)
                        @Html.HiddenGroupFor(model => Model.SettingVMs[i].Value, new { @Value = "", id = "hdnNumberFormat" })
                        string message = string.Format("SettingVMs[{0}].BLOBValue", i);
                        <span class="field-validation-valid" data-valmsg-for="@message" data-valmsg-replace="true"></span>



                    }
                    else
                    {
                        @Html.Hidden("SubTitle", Model.SubTitle, new { id = "SubTitle" })
                        @Html.Hidden("SettingVMs[" + @i + "].Id", Model.SettingVMs[i].Id)
                        @Html.SettingControlWithValidation("SettingVMs[" + @i + "].Value", Model.SettingVMs[i].Value, Model.SettingVMs[i].SettingConfigVM)
                        string message = string.Format("SettingVMs[{0}].Value", i);
                        <span class="field-validation-valid" data-valmsg-for="@message" data-valmsg-replace="true"></span>
                    }
                }
            </div>
            }
        </div>
        @Html.StickyHidden("SubTitle", Model.SubTitle.Trim(), new { id = "SubTitle" })
    }
</div>

@if (Model.EnableSave)
{
    <div class="mx-3 mx-md-5 mb-4 d-flex">
        <div class="ml-auto">
            @Html.ActionButton(DbRes.TResource("Admin.UserCategory.Save"), "UpdateSetting", "dvGrid", null, null, "OnEditSuccess", null, "post", "", "btnEditSetting",
                   "frmSetting", "btn btn-lg btn-st3 mx-1", "checkFileValidationBeforeSave")
            <a class="btn btn-lg btn-st3 mx-1" id="aCancel" onclick="ClearInputsServiceSetting(); return false;">@DbRes.TResource("Global.ResetButton")</a>
        </div>
    </div>
}

<script>
    function RemoveValAction() {
        $("#divActionVal").css("display", "none");
    }
    function RemoveValRole() {
        $("#divRoleVal").css("display", "none");
    }
    function OnDeleteSuccess(data, divUpdatData, deletedList) {
        ShowSuccesMessage(data.MessageText);
        var deletedArray = deletedList.split(',');
        for (var i = 0; i < deletedArray.length; i++) {
        }
    }

    var isValidFile = true;
    function OnEditSuccess(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function ClearInputsServiceSetting() {
        var Title = $("#SubTitle").val()
        ClearInputs('frmSetting');
        $("#SubTitle").val(Title);
        $('#SettingContent').find('input[type=checkbox]').trigger("change");
    }

    function CopyOnSuccess(data) {
        if (data.MessageType != 2) {
            $("#grid-table-grdCopies > tbody > .grid-empty-text").remove();
            $("#grid-table-grdCopies > tbody:last").append(data.Html);
            ClearInputs('frmSetting');
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function validateFileType() {
        var arrayType = ['jpg', 'jpeg', 'png'];
        var fileName = $("#SettingContent input[type='file']").val();
        if (fileName != undefined) {
            var idxDot = fileName.lastIndexOf(".") + 1;
            var extFile = fileName.substr(idxDot, fileName.length).toLowerCase();
            if (extFile != "" && $.inArray(extFile, arrayType) == -1) {
                ShowErrorMessage('@DbRes.TValidation("User.Setting.ValidateFileType")');
                isValidFile = false;
                return isValidFile;
            }
            else
                isValidFile = true;
            return isValidFile;
        }
        return isValidFile;
    }
    function checkFileValidationBeforeSave() {
        if ('@ViewData["Roles"]' != '') {
            var check = true;
            if ($('#ddlActions').val() == "") {
                $("#divActionVal").css("display", "block");
                check=false;
            }
            if ($('#ddlRoles').val()=="") {
                $("#divRoleVal").css("display", "block");
                check=false;
            }
            if (check == false) {
                return false;
            }
        }
        if (!isValidFile) {
            ShowErrorMessage('@DbRes.TValidation("User.Setting.ValidateFileType")');
        }
        return isValidFile;
    }


    var handleFileSelect = function (evt) {
        var files = evt.target.files;
        var file = files[0];

        if (files && file) {
            var reader = new FileReader();

            reader.onload = function (readerEvt) {
                var binaryString = readerEvt.target.result;
                var Base64Image = btoa(binaryString);
                $(".hdnBase64File").val(Base64Image);
                $("#img").attr("src", "data:image/png;base64," + Base64Image);
            };

            reader.readAsBinaryString(file);
        }
    };

    if (window.File && window.FileReader && window.FileList && window.Blob) {
        if (document.getElementById('file') != null) {
            document.getElementById('file').addEventListener('change', handleFileSelect, false);
        }
    } else {
        ShowErrorMessage('@DbRes.TValidation("User.Setting.ValidateFileType")');
    }
</script>
