@using MCS.UI.Areas.Admin.Models.Lookups
@using MCS.Common
@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.BarcodeDesigner
@model BarcodeDesignerVM
@{
    ViewBag.Title = DbRes.TResource("Admin.BarcodeDesigner.BarcodeSettings");
    Layout = "~/Areas/Admin/Views/Shared/_SettingsLayout.cshtml"; 
}

<style>
    .FitBox {
        position: absolute;
    }
</style>
<script>
    var contianerDesign
    var Design
    var PosX;
    var PosY;

    $.validator.unobtrusive.adapters.add(
                'CheckIfDepartmentSelected',
                ['validationgroup'],
                function (options) {
                    options.rules['CheckIfDepartmentSelected'] = {
                        validationgroup: options.params['validationgroup']
                    };
                    options.messages['CheckIfDepartmentSelected'] = options.message;
                });

    $.validator.addMethod('CheckIfDepartmentSelected',
        function (value, element, parameters) {
            if (!$("#IsGeneral").is(':checked') && value == "") {

                return false;
            }
            return true;
        }
);

    function MouseMoveContainer(containerId,barcodeId) {

        $('#' + containerId).mousemove(function (event) {
            $('#' + barcodeId).children().each(function () {
                var childOffest = $(this).css('top');
                var childLeft = $(this).css('left');
                var childWidth = $(this).width();
                var childHeight = $(this).height();
                var barcodHight = $('#' + barcodeId).height();
                var barcodWidth = $('#' + barcodeId).width();

                if (parseInt(childOffest) < 0) {
                    $(this).css('top', '0');
                }

                if ((parseInt(childOffest) + parseFloat(childHeight)) > parseInt(barcodHight)) {
                    $(this).css('top', parseFloat(barcodHight) - parseFloat(childHeight));
                }

                if (parseInt(childLeft) < 0) {
                    $(this).css('left', '0');
                }

                if ((parseFloat(childLeft) + parseFloat(childWidth)) > parseInt(barcodWidth)) {
                    $(this).css('left', parseFloat(barcodWidth) - parseFloat(childWidth));
                }
            });
        });

    }

    function EnableChildrenDraggable(barCodeId) {
        $('#' + barCodeId).children().each(function () {
            $(this).removeClass('draggable2');
            $(this).draggable({ containment: barCodeId });
        });
    }

    $(document).ready(function () {
        EnableChildrenDraggable('barCode');

        EnableChildrenDraggable('barCodeAttachment');

        //SetStyles();
        GetDesign(@(BarcodeDesignType.Inbound.LookupIdentity(LookupCategory.BarcodeDesignType,SessionInfo.CultureShortName)), true);
        SetSelectedSetting();

        SetBarcodeImagesSize();
        MouseMoveContainer('mainDiv', 'barCode');

        MouseMoveContainer('mainDiv', 'barCodeAttachment');

        var $container = $("#barCode");

        $container.children().each(function () {

            $(this).css("marginLeft", "");
            $(this).css("width", "");
            $(this).css({ left: $(this).attr("data-Left") });
        });

        $container = $("#barCodeAttachment");

        $container.children().each(function () {

            $(this).css("marginLeft", "");
            $(this).css("width", "");
            $(this).css({ left: $(this).attr("data-Left") });
        });
    });

    var items = [
          {
              label: "Delete",
              action: function (element) {
                  $("#hdnSelected").val($(element.currentTarget).data("id"));
                  Delete();
              }
          }
    ];


    function GetDesign(typeId, isGeneral) {
        
        $("#typeID").val(typeId);
        $(".dialog_but").removeClass("select");
        $("#btn_" + typeId).addClass("select");
        $(".buts_toolbar .dialog_but").removeClass("bg");
        $("#btn_" + typeId).addClass("bg");
        $.ajax({
            cache: false,
            type: "GET",
            url: '@Url.Action("GetDesign", "BarcodeDesigner")',
            data: { "isGeneral": isGeneral, "typeId": typeId },
            success: function (response) {
                $("#container").html(response.Html);

                $('#barCode').children().each(function () {
                    $(this).removeClass('draggable2');

                    $(this).draggable({ containment: 'barCode' });
                });
              
                //SetStyles();
                SetSelectedSetting();

                setBarcodeChildern()

                jQuery.validator.unobtrusive.parse('#frmAddDesign');
            }
        });
    }


    function getXY(evt) {
        var element = document.getElementById('barCode');
        var rect = element.getBoundingClientRect();
        var scrollTop = document.documentElement.scrollTop ?
                        document.documentElement.scrollTop : document.body.scrollTop;
        var scrollLeft = document.documentElement.scrollLeft ?
                        document.documentElement.scrollLeft : document.body.scrollLeft;
        var elementLeft = rect.left + scrollLeft;
        var elementTop = rect.top + scrollTop;

        if (document.all) {
            PosX = event.clientX + scrollLeft - elementLeft;
            PosY = event.clientY + scrollTop - elementTop;
        }
        else {
            PosX = evt.pageX - elementLeft;
            PosY = evt.pageY - elementTop;
        }
    }

    function SetStyles() {
        $(".draggable2").draggable({ containment: 'barCode', helper: 'clone' });

        //$("#barCode>div[data-id]").contextPopup({
        //    items: items
        //});

        //$("#barCodeAttachment>div[data-id]").contextPopup({
        //    items: items
        //});

        if ($("#IsGeneral").is(':checked')) {
            $("#treeDiv").hide();
        } else {
            $("#treeDiv").show();
        }

        $(".draggable").draggable({ containment: 'barCode', helper: 'clone' });

        $(".draggable").draggable({ containment: 'barCodeAttachment', helper: 'clone' });

        $(".droppable").droppable({
            activeClass: "ui-state-default",
            hoverClass: "ui-state-hover",
            drop: function (event, ui) {

                var html;

                var id = $(ui.helper).data("id");

                var droppableId = $(this).attr("id");

                var menuId = GetMenuIdbyContainer(droppableId);

                var $menu = $("#" + menuId).clone();

                switch (id) {
                    case 1:
                    case 'attachment3DImage':
                        $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().html("<img class='imag3D' src='" + '@Url.Content("~/Content/Admin/Lib/images/morasalat/code_3d_v.png")' + "'  alt=''>");
                        $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().children().first().width(parseFloat($(".droppable").width()) * 0.195);
                        $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().children().first().height(parseFloat($(".droppable").height()) * 0.3);

                        html = $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().html();
                        break;
                    case 3:
                    case 'attachment2DImage':
                        $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().html("<img class='imag2D' src='" + '@Url.Content("~/Content/Admin/Lib/images/morasalat/code_2d_v.png")' + "'  alt=''>");

                        $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().children().first().width(parseFloat($(".droppable").width()) * 0.6);
                        $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().children().first().height(parseFloat($(".droppable").height()) * 0.2);
                        html = $menu.find("[data-id='" + id + "']:first").find('a').children().first().next().html();
                        break;
                    default:
                        html = $($menu.find("[data-id='" + id + "']:first").find('a')[0]).text();
                }

                var controlelm;
                var xcxc
                var dropPositionX = event.pageX - $(this).offset().left;
                var dropPositionY = event.pageY - $(this).offset().top;
                var dragItemOffsetX = event.offsetX;
                var dragItemOffsetY = event.offsetY;
                var dragItemPositionX = dropPositionX - dragItemOffsetX;
                var dragItemPositionY = dropPositionY - dragItemOffsetY;
                var $newPosX = ui.offset.left - $(this).offset().left;
                var $newPosY = ui.offset.top - $(this).offset().top;
                ui.draggable.draggable('disable');
                ui.draggable.children().addClass("disabled");
                controlelm = ui.draggable.clone();

                if (ui.draggable.attr('data-info') == '1') {
                    ui.draggable.remove();
                }
                else {

                    $(controlelm).html('');
                    $(controlelm).append(html);
                    $(controlelm).css("left", dragItemPositionX);
                    $(controlelm).css("top", dragItemPositionY);
                }

                controlelm.attr('data-info', '1');
                $(controlelm).addClass("FitBox");
                $('#' + droppableId).append(controlelm);
                $(controlelm).draggable();
                $(controlelm).contextPopup({
                    items: items
                });
                SetPosition($(controlelm));
            }
        });


        function GetMenuIdbyContainer(id) {
            if (id == "barCode")
                return "menu";

            return "attachmentMenu";
        }

        $("#BarcodeSize").change(function () {
            $('#barCode').removeClass("size_a");
            $('#barCode').removeClass("size_b");
            $('#barCode').removeClass("size_c");
            $('#barCode').addClass($(this).val());
            $('#barCodeAttachment').removeClass("size_a");
            $('#barCodeAttachment').removeClass("size_b");
            $('#barCodeAttachment').removeClass("size_c");
            $('#barCodeAttachment').addClass($(this).val());

            SetBarcodeImagesSize();

            $('#barCode').children().each(function () {
                var childOffest = $(this).css('top');
                var childLeft = $(this).css('left');
                var childWidth = $(this).width();
                var childHeight = $(this).height();
                var barcodHight = $("#barCode").height();
                var barcodWidth = $("#barCode").width();

                if (parseInt(childOffest) < 0) {
                    $(this).css('top', '0');
                }

                if ((parseInt(childOffest) + parseFloat(childHeight)) > parseInt(barcodHight)) {
                    $(this).css('top', parseFloat(barcodHight) - parseFloat(childHeight));
                }

                if (parseInt(childLeft) < 0) {
                    $(this).css('left', '0');
                }

                if ((parseFloat(childLeft) + parseFloat(childWidth)) > parseInt(barcodWidth)) {
                    $(this).css('left', parseFloat(barcodWidth) - parseFloat(childWidth));
                }
            });


            $('#barCodeAttachment').children().each(function () {
                var childOffest = $(this).css('top');
                var childLeft = $(this).css('left');
                var childWidth = $(this).width();
                var childHeight = $(this).height();
                var barcodHight = $("#barCodeAttachment").height();
                var barcodWidth = $("#barCodeAttachment").width();

                if (parseInt(childOffest) < 0) {
                    $(this).css('top', '0');
                }

                if ((parseInt(childOffest) + parseFloat(childHeight)) > parseInt(barcodHight)) {
                    $(this).css('top', parseFloat(barcodHight) - parseFloat(childHeight));
                }

                if (parseInt(childLeft) < 0) {
                    $(this).css('left', '0');
                }

                if ((parseFloat(childLeft) + parseFloat(childWidth)) > parseInt(barcodWidth)) {
                    $(this).css('left', parseFloat(barcodWidth) - parseFloat(childWidth));
                }
            });

        });

        $("#SizeUnit").change(function () {
            ValidateSize();
        });

        function ConvertToPixel(value, unit) {

            if (unit == "cm") {
                return 37.795276 * value;
            }

            return 96 * value
        }
        function ValidateSize() {


            if ($("#SizeUnit").val() == "in" && $("#txtSizeWidthValue").val() != "" && parseFloat($("#txtSizeWidthValue").val()) >= parseFloat(@SystemConfigurations.BarcodeInchMinWidth) && parseFloat($("#txtSizeWidthValue").val()) <= parseFloat(@SystemConfigurations.BarcodeInchMaxWidth) && $("#txtSizeHeightValue").val() != "" && parseFloat($("#txtSizeHeightValue").val()) >= parseFloat(@SystemConfigurations.BarcodeInchMinHeight) && parseFloat($("#txtSizeHeightValue").val()) <= parseFloat(@SystemConfigurations.BarcodeInchMaxHeight)) {
                RefreshBarcodeSetting()
                $("#errorMessage").text("");
                return;
            }

            if ($("#SizeUnit").val() == "cm" && $("#txtSizeHeightValue").val() != "" && parseFloat($("#txtSizeWidthValue").val()) >= parseFloat(@SystemConfigurations.BarcodeCmMinWidth) && parseFloat($("#txtSizeWidthValue").val()) <= parseFloat(@SystemConfigurations.BarcodeCmMaxWidth) && $("#txtSizeHeightValue").val() != "" && parseFloat($("#txtSizeHeightValue").val()) >= parseFloat(@SystemConfigurations.BarcodeCmMinHeight) && parseFloat($("#txtSizeHeightValue").val()) <= parseFloat(@SystemConfigurations.BarcodeCmMaxHeight)) {

                RefreshBarcodeSetting()
                $("#errorMessage").text("");
                return;
            }

            if ($("#SizeUnit").val() == "in") {

                if (parseFloat($("#txtSizeWidthValue").val()) < parseFloat(@SystemConfigurations.BarcodeInchMinWidth))
                    $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMinSize"))' + @SystemConfigurations.BarcodeInchMinHeight +"-" +@SystemConfigurations.BarcodeInchMinWidth +" inch");
                else
                    $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMaxSize"))' + @SystemConfigurations.BarcodeInchMaxHeight +"-" +@SystemConfigurations.BarcodeInchMaxWidth +" inch");

                return;
            }
            if ($("#SizeUnit").val() == "cm") {
                if (parseFloat($("#txtSizeWidthValue").val()) < parseFloat(@SystemConfigurations.BarcodeCmMinWidth))
                    $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMinSize"))' + @SystemConfigurations.BarcodeCmMinHeight.ToString() +"-" +@SystemConfigurations.BarcodeCmMinWidth.ToString() +" cm");
                else
                    $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMaxSize"))' + @SystemConfigurations.BarcodeCmMaxHeight.ToString() +"-" +@SystemConfigurations.BarcodeCmMaxWidth.ToString() +" cm");

                return;
            }
        }

        $("#txtSizeWidthValue").on('focusout', function (e) {
            if ($("#SizeUnit").val() == "in")
                if ($("#txtSizeHeightValue").val() != "" && $("#txtSizeWidthValue").val() != "" && parseFloat($("#txtSizeWidthValue").val()) >= parseFloat(@SystemConfigurations.BarcodeInchMinWidth) && parseFloat($("#txtSizeWidthValue").val()) <= parseFloat(@SystemConfigurations.BarcodeInchMaxWidth)) {
                    ValidateSize()
                } else {
                    if (parseFloat($("#txtSizeWidthValue").val()) < parseFloat(@SystemConfigurations.BarcodeInchMinWidth))
                        $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMinSize"))' + @SystemConfigurations.BarcodeInchMinHeight +"-" +@SystemConfigurations.BarcodeInchMinWidth +" inch");
                    else
                        $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMaxSize"))' + @SystemConfigurations.BarcodeInchMaxHeight +"-" +@SystemConfigurations.BarcodeInchMaxWidth +" inch");
                }
            if ($("#SizeUnit").val() == "cm")
                if ($("#txtSizeHeightValue").val() != "" && $("#txtSizeWidthValue").val() != "" && parseFloat($("#txtSizeWidthValue").val()) >= parseFloat(@SystemConfigurations.BarcodeCmMinWidth) && parseFloat($("#txtSizeWidthValue").val()) <= parseFloat(@SystemConfigurations.BarcodeCmMaxWidth)) {
                    ValidateSize()
                } else {
                    if (parseFloat($("#txtSizeWidthValue").val()) < parseFloat(@SystemConfigurations.BarcodeCmMinWidth))
                        $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMinSize"))' + @SystemConfigurations.BarcodeCmMinHeight.ToString() +"-" +@SystemConfigurations.BarcodeCmMinWidth.ToString() +" cm");
                    else
                        $("#errorMessage").text('@Html.Raw(DbRes.TResource("Admin.BarcodeDesigner.InvalidMaxSize"))' + @SystemConfigurations.BarcodeCmMaxHeight.ToString() +"-" +@SystemConfigurations.BarcodeCmMaxWidth.ToString() +" cm");
                }
        });


        function RefreshBarcodeSetting() {

            $("#barCode").css("width", ConvertToPixel($("#txtSizeWidthValue").val(), $("#SizeUnit").val()));

            $("#barCode").css("height", ConvertToPixel($("#txtSizeHeightValue").val(), $("#SizeUnit").val()));

            $("#barCodeAttachment").css("width", ConvertToPixel($("#txtSizeWidthValue").val(), $("#SizeUnit").val()));

            $("#barCodeAttachment").css("height", ConvertToPixel($("#txtSizeHeightValue").val(), $("#SizeUnit").val()));

            SetBarcodeImagesSize();

            $('#barCode').children().each(function () {
                var childOffest = $(this).css('top');
                var childLeft = $(this).css('left');
                var childWidth = $(this).width();
                var childHeight = $(this).height();
                var barcodHight = $("#barCode").height();
                var barcodWidth = $("#barCode").width();

                if (parseInt(childOffest) < 0) {
                    $(this).css('top', '0');
                }

                if ((parseInt(childOffest) + parseFloat(childHeight)) > parseInt(barcodHight)) {
                    $(this).css('top', parseFloat(barcodHight) - parseFloat(childHeight));
                }

                if (parseInt(childLeft) < 0) {
                    $(this).css('left', '0');
                }

                if ((parseFloat(childLeft) + parseFloat(childWidth)) > parseInt(barcodWidth)) {
                    $(this).css('left', parseFloat(barcodWidth) - parseFloat(childWidth));
                }
            });


            $('#barCodeAttachment').children().each(function () {
                var childOffest = $(this).css('top');
                var childLeft = $(this).css('left');
                var childWidth = $(this).width();
                var childHeight = $(this).height();
                var barcodHight = $("#barCodeAttachment").height();
                var barcodWidth = $("#barCodeAttachment").width();

                if (parseInt(childOffest) < 0) {
                    $(this).css('top', '0');
                }

                if ((parseInt(childOffest) + parseFloat(childHeight)) > parseInt(barcodHight)) {
                    $(this).css('top', parseFloat(barcodHight) - parseFloat(childHeight));
                }

                if (parseInt(childLeft) < 0) {
                    $(this).css('left', '0');
                }

                if ((parseFloat(childLeft) + parseFloat(childWidth)) > parseInt(barcodWidth)) {
                    $(this).css('left', parseFloat(barcodWidth) - parseFloat(childWidth));
                }
            });
            SetBarcodeImagesSize();
        }

        $("#fs").change(function () {

            $('#barCode').css("font-family", $(this).val());

            $('#barCodeAttachment').css("font-family", $(this).val());
        });

        $("#size").change(function () {
            $('#barCode').css("font-size", $(this).val() + "px");

            $('#barCodeAttachment').css("font-size", $(this).val() + "px");

            SetBarcodeImagesSize()
        });

        $("#barCode>div[data-id]").each(function () {
            $('#menu>div[data-id=' + $(this).data("id") + ']').draggable('disable');
            $('#menu>div[data-id=' + $(this).data("id") + ']>a').addClass("disabled");
        });

        $("#barCodeAttachment>div[data-id]").each(function () {
            $('#attachmentMenu>div[data-id=' + $(this).data("id") + ']').draggable('disable');
            $('#attachmentMenu>div[data-id=' + $(this).data("id") + ']>a').addClass("disabled");
        });

        $('#barCode').css("font-size", $('#barCode').attr('data-Font-Size') + "px");

        $('#barCodeAttachment').css("font-size", $('#barCodeAttachment').attr('data-Font-Size') + "px");

        $('#barCode').css("font-family", $('#barCode').attr('data-Font-Name'));

        $('#barCodeAttachment').css("font-family", $('#barCodeAttachment').attr('data-Font-Name'));
    }

    function SetSelectedSetting() {
        //$('#size').prop('selectedIndex', 0)
        $("#txtSizeWidthValue").val($('#barCode').attr('data-Width-Value'))
        $("#txtSizeHeightValue").val($('#barCode').attr('data-Height-Value'))
        $("#SizeUnit").val($('#barCode').attr('data-Size-Unit'))
        $("#fs").val($('#barCode').attr('data-Font-Name'))
        $("#size").val($('#barCode').attr('data-Font-Size'))
        $('#barCode').css('width', $('#barCode').attr('data-Width-Value') + $('#barCode').attr('data-Size-Unit'));
        $('#barCode').css('height', $('#barCode').attr('data-Height-Value') + $('#barCode').attr('data-Size-Unit'));
        $("#txtSizeWidthValue").val($('#barCodeAttachment').attr('data-Width-Value'))
        $("#txtSizeHeightValue").val($('#barCodeAttachment').attr('data-Height-Value'))
        $("#SizeUnit").val($('#barCodeAttachment').attr('data-Size-Unit'))
        $("#fs").val($('#barCodeAttachment').attr('data-Font-Name'))
        $("#size").val($('#barCodeAttachment').attr('data-Font-Size'))
        $('#barCodeAttachment').css('width', $('#barCodeAttachment').attr('data-Width-Value') + $('#barCodeAttachment').attr('data-Size-Unit'));
        $('#barCodeAttachment').css('height', $('#barCodeAttachment').attr('data-Height-Value') + $('#barCodeAttachment').attr('data-Size-Unit'));
        SetBarcodeImagesSize();
    }

    function setBarcodeChildern() {
        $("#barCode").children().each(function () {
            $(this).css("marginLeft", "");
            $(this).css("left", $(this).attr('data-Left'));
            $(this).css("width", "");

        });
    }

    function SetBarcodeImagesSize() {
        var $containerWidth = $("#barCode").width();
        var $containerheight = $("#barCode").height();
        $(".imag2D").width(parseFloat($containerWidth) * 0.6);
        $(".imag2D").height(parseFloat($containerheight) * 0.2);
        $(".imag3D").width(parseFloat($containerheight) * 0.3);
        $(".imag3D").height(parseFloat($containerheight) * 0.3);
    }

    function SetPosition(element) {
        var childOffest = element.css('top');
        var childLeft = element.css('left');
        var barcodHight = $("#barCode").height();
        var barcodWidth = $("#barCode").width();
        if (parseInt(childOffest) < 0) {
            element.css('top', '0');
        }
        if (parseInt(childOffest) > parseInt(barcodHight)) {
            element.css('top', barcodHight);
        }
        if (parseInt(childLeft) < 0) {
            element.css('left', '0');
        }
        if (parseInt(childLeft) > parseInt(barcodWidth)) {
            element.css('left', barcodWidth);
        }
    }
    function CheckIfHasContent() {
        if ($("#barCode").children().length < 1) {
            $("#dvNoItemsAddedValidationMessage").show();
            window.scrollTo(0, 0);
            return false;
        }
        else {
            $("#dvNoItemsAddedValidationMessage").hide();
            return UpdateHTML();
        }

    }

    function UpdateHTML() {
        var $container = $("#barCode").clone();
        var $containerWidth = $("#barCode").width()
        var elemntBarCode = document.getElementById("barCode");
        $container.attr('data-Width-Value', $("#txtSizeWidthValue").val());
        $container.attr('data-Height-Value', $("#txtSizeHeightValue").val());
        $container.attr('data-Size-Unit', $("#SizeUnit").val());
        $container.attr('data-Font-Name', $("#fs").val());
        $container.attr('data-Font-Size', $("#size").val());
        $container.css('width', "");
        $container.css('height', "");
        $container.children().each(function () {

            var child = elemntBarCode.getElementsByClassName("dataid" + $(this).data("id"));

            var newWidth = parseInt($(this).css('left'));

            var newHeight = parseInt(child[0].offsetHeight);
            $(this).attr('data-Left', $(this).css('left'));
            $(this).css('position', 'absolute');
            $(this).css("marginLeft", "0px");
            $(this).css("left", "");
            newWidth = newWidth + parseInt(child[0].offsetWidth);
            $(this).width(newWidth);
            $(this).height(newHeight);
            var id = parseInt($(this).data("id")) + 1;
            $(this).css("direction", 'rtl')
            $(this).text("{" + $(this).data("id") + "} {" + id + "}")
        });

        $("#hdnHtml").val($container[0].outerHTML);
        $("#hdnWidth").val($('#barCode').width());
        $("#hdnHeight").val($('#barCode').height());
        UpdateHTMLAttachment();
        return true;
    }

    function UpdateHTMLAttachment() {

        var $container = $("#barCodeAttachment").clone();
        var $containerWidth = $("#barCodeAttachment").width()
        var elemntBarCode = document.getElementById("barCodeAttachment");

        $container.attr('data-Width-Value', $("#txtSizeWidthValue").val());
        $container.attr('data-Height-Value', $("#txtSizeHeightValue").val());
        $container.attr('data-Size-Unit', $("#SizeUnit").val());
        $container.attr('data-Font-Name', $("#fs").val());
        $container.attr('data-Font-Size', $("#size").val());
        $container.css('width', "");
        $container.css('height', "");

        $container.children().each(function () {

            var child = elemntBarCode.getElementsByClassName($(this).data("id"));
            var newWidth = parseInt($(this).css('left'));
            var newHeight = parseInt(child[0].offsetHeight);
            $(this).attr('data-Left', $(this).css('left'));
            $(this).css('position', 'absolute');
            $(this).css("marginLeft", "0px");
            $(this).css("left", "");
            newWidth = newWidth + parseInt(child[0].offsetWidth);
            $(this).width(newWidth);
            $(this).height(newHeight);
            var id = $(this).data("id") + "Value";
            $(this).css("direction", 'rtl')
            $(this).text("{" + $(this).data("id") + "} {" + id + "}")
        });

        $("#hdnHtmlAttachment").val($container[0].outerHTML);
        $("#hdnWidth").val($('#barCode').width());
        $("#hdnHeight").val($('#barCode').height());
        return true;
    }

    function OnAdd(data) {

        if (data.MessageType != 2) {

            jQuery.validator.unobtrusive.parse('#frmAddDesign');
            ShowSuccesMessage(data.MessageText)
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function DeleteContainerElement(containerId, menuId) {
        $("#" + containerId).html("");

        $('#' + menuId + ' .draggable2').each(function () {
            $(this).draggable('enable');

            $('#' + menuId + '>div[data-id=' + $(this).data("id") + ']>a').removeClass("disabled");
        });

    }

    function DeleteAll() {
        DeleteContainerElement("barCode", "menu");
        DeleteContainerElement("barCodeAttachment", "attachmentMenu");
    }

    function Select(id) {

        $("#hdnSelected").val(id);
    }

    function DeleteItemFromMenu(elementId, menuId) {

        var id = $("#hdnSelected").val();
        $('#' + elementId + '>div[data-id=' + id + ']').remove();
        $('#' + menuId + '>div[data-id=' + id + ']').draggable('enable');
        $('#' + menuId + '>div[data-id=' + id + ']>a').removeClass("disabled");
    }

    function Delete() {
        DeleteItemFromMenu("barCode", "menu");
        DeleteItemFromMenu("barCodeAttachment", "attachmentMenu");
    }
</script>
<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
    <div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
        <h3 class="site-color mb-4">@DbRes.TResource("Admin.BarcodeDesigner.BarcodeSettings")</h3>
    </div>
    <div class="close-icon pl-2 mt-0 ml-auto">
        <a class="circle-icon color-white" href="@Url.Action("GeneralSettings","SystemSettings")" data-bs-toggle="tooltip" data-placement="bottom" title="الرجوع للإعدادات العامة"><i class="la la-close"></i></a>
    </div>
</div>

<div class="page-content-wrap">
    <div class="white-container mx-3 mx-md-5 form-horizontal form-row">
        <div id="mainDiv">
                <div class="toolbar_structure panel-body">

                    <div class="buts_toolbar col-xs-12">
                        @{List<TransactionCategoryVM> TransactionsCategories = (List<TransactionCategoryVM>)ViewData["TransactionCategory"];}
                        <button id="btn_@TransactionsCategories[0].Id" class="example-p-01 btn btn-primary dialog_but select bg" onclick="GetDesign(@TransactionsCategories[0].Id,true);">@TransactionsCategories[0].Text</button>
                        @for (int i = 1; i < TransactionsCategories.Count; i++)
                        {
                            <button id="btn_@TransactionsCategories[i].Id" class="example-p-01 btn btn-primary dialog_but" onclick="GetDesign(@TransactionsCategories[i].Id,true);">@TransactionsCategories[i].Text</button>
                        }
                    </div>

                </div>
            <div id="container">
                @Html.Partial("_OutboundBarcodeDesignerPartial", Model)
            </div>
        </div>
    </div>
    <div class="mx-3 mx-md-5 mb-4 d-flex">
        <div class="ml-auto">
            @Html.ConfirmAction(OperationType.Save, "btnAddDesign", DbRes.TResource("Admin.BarcodeDesigner.Save"), "AddDesign", null, null, null, "OnAdd", null, "", "post", "frmAddDesign", null, "btn btn-lg btn-st3 mx-1", "CheckIfHasContent")
            <button type="button" onclick="DeleteAll();" class="btn btn-lg btn-st3 mx-1 ">@DbRes.TResource("Admin.BarcodeDesigner.Delete")</button>
        </div>
    </div>
</div>
