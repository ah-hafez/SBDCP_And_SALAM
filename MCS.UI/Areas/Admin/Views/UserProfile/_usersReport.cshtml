@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models;
@using MCS.GridMvc.Helpers;
@using MCS.GridMvc.Html;
@using MCS.Common;

@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<UserProfileVM>
@{
    //ViewBag.Title = "_AttachmentTypeGridPartial";
    Layout = "~/Areas/Admin/Views/Shared/_UsersTraysLayout.cshtml";
}

<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
    <div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
        <h3 class="site-color mb-4">@DbRes.TResource("تقرير المستخدمين")</h3>
    </div>
</div>
<div class="white-container mx-3 mx-md-5">
    @Html.Grid(Model).Named("UserGroup").Columns(columns =>
{
columns.Add(model => model.UserName).Titled(DbRes.TResource("اسم المستخدم"));
columns.Add(model => model.MainOrgUnitName).Titled(DbRes.TResource("الادارة"));
columns.Add(model => model.LoginTime).Titled(DbRes.TResource("وقت الدخول"));
columns.Add(model => model.LastLogout).Titled(DbRes.TResource("وقت الخروج"));

})
    <button class="btn btn-st1 btn-lg" onclick="ExportUsersWithGroupsReportToPdf()">@DbRes.TResource("User.Transaction.Reports.Export")</button>

</div>





<script>
    var token = $("#FormPerformanceSearch").find("input[name='__RequestVerificationToken']").val();

    function ExportUsersWithGroupsReportToPdf() {
        debugger;
        event.preventDefault();
        var searchCriteriaData = [];
        searchCriteriaData.push({ name: 'TotalCount', value: $('#TotalCount').val() });
        searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });
        $.ajax({
            type: "post",
            url: '@Url.Action("UsersReportExportToPdf", "Reports", new { Area = "user" })',
            cache: false,
            success: function (data) {
                if (data) {
                    if (data.MessageType != 2) {

                        var url = '@Url.Action("Download", "Reports", new { Area = "user" })';
                        // window.location.href = url + '?fileGuid=' + data.FileGuid + '&filename=' + data.FileName;
                        //var url1 = url + '?fileGuid=' + data.FileGuid + '&filename=' + data.FileName;
                        window.open(url + '?FileGuid=' + data.FileGuid + '&filename=' + data.FileName, '_blank').focus()
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
            }
        });
    }


    function ExportTransactionReportToExcel() {
        debugger;
        event.preventDefault();
        var searchCriteriaData = [];
        searchCriteriaData.push({ name: 'TotalCount', value: $('#TotalCount').val() });
        searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });
        $.ajax({
            type: "post",
            url: '@Url.Action("ExportUsersWithGroupsReportToExcel", "Reports", new { Area = "user" })',
            cache: false,
            success: function (data) {
                if (data) {
                    if (data.MessageType != 2) {
                        var url = '@Url.Action("Download", "Reports", new { Area = "user" })';
                        window.open(url + '?FileGuid=' + data.FileGuid + '&filename=' + data.FileName, '_blank').focus()
                    }
                    else {

                        ShowErrorMessage(data.MessageText);

                    }
                }
            }
        });
    }

