@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.UserProfile

@model ChangePasswordVM
@{
    Layout = "~/Views/Shared/_AdminDialogLayout.cshtml";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmChangePassword", @class = "form-horizontal form-row" }))
{
    @Html.AntiForgeryToken()
    <div class="content-rtl panel panel-default dialogbox_panel">
        <div class="panel-heading">
            <h3 class="panel-title">@DbRes.TResource("Admin.UserProfile.ChangePassword")</h3>
        </div>
        <div class="editor">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        @Html.CustomLabelFor(model => model.OldPassword, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            <div class="">
                                @Html.PasswordGroupFor(model => model.OldPassword, "ResetPassword", new { @class = "form-control", @autocomplete = "off" })
                            </div>
                            <span class="help-block"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.CustomLabelFor(model => model.NewPassword, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            <div class="">
                                @Html.PasswordGroupFor(model => model.NewPassword, "ResetPassword", new { @class = "form-control", @autocomplete = "off" })
                            </div>
                            <span class="help-block"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.CustomLabelFor(model => model.ReNewPassword, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            <div class="">
                                @Html.PasswordGroupFor(model => model.ReNewPassword, "ResetPassword", new { @class = "form-control", @autocomplete = "off" })
                            </div>
                            <span class="help-block"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            @Html.ActionButton(DbRes.TResource("Admin.UserProfile.ChangePassword"), "ChangePassword", null, null, null, "OnSuccess", null, "post", "ResetPassword", "btnSave", "frmChangePassword", "btn btn-primary pull-right")
            <button type="button" onclick="__dialog.close(); return false;" class="btn btn-default" id="BtnClose">@DbRes.TResource("Admin.UserProfile.Close")</button>
        </div>
    </div>
}
<script>
    function OnSuccess(data, div) {
        if (data.MessageType != 2) {

            ShowSuccesMessage(data.MessageText)

            __dialog.close();
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
</script>