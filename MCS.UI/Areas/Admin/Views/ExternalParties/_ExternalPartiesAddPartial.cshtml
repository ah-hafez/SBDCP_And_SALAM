    function OnAddSuccess(data) {
            if (data.MessageType != 2) {

                ShowSuccesMessage(data.MessageText, redirect(data.Id));



            }
            else {
                ShowErrorMessage(data.MessageText);
            }
    }

    function redirect(data) {
        setTimeout(function () {
              window.location.href = '@Url.Action("GetPartyById", "ExternalParties")?id=' + data;
        }, 3000);
    }

    function CheckPartyNumberForAdd() {
        var number = $('#AddExternalParty_PartyNumber').val();
        var valid = false;
        $.ajax({
            type: 'Get',
            url: '@Url.Action("CheckPartyNumber")',
            data: { Number: number, partyId: -1 },
            async: false,
            success:
                function (data) {
                    if (data.Exists) {
                        valid = true;
                    }
                    else {
                        $('#frmAddParty #dvpartyNumberMessage').html('رقم الجهة مدخل مسبقا');
                        valid = false;
                    }
                }
        });

        return valid;
    }
</script>
