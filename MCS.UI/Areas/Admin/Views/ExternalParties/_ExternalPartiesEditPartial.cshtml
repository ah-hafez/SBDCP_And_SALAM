    function OnEditSuccess(data) {
            if (data.MessageType != 2) {

                ShowSuccesMessage(data.MessageText, redirect(data.Id));



            }
            else {
                ShowErrorMessage(data.MessageText);
            }
    }

    function redirect(data) {
        setTimeout(function () {
            url = '@Url.Action("GetPartyById", "ExternalParties")'+ "?id=" + data + " ";
              window.location.href = url
        }, 3000);
    }

    function CheckPartyNumber() {

        var number = $('#frmEditParty #PartyNumber').val();
        var partyId = $('#hdnParty').val();
        var valid = false;
        $.ajax({
            type: 'Get',
            url: '@Url.Action("CheckPartyNumber")',
            data: { Number: number, partyId: partyId },
            async: false,
            success:
                function (data) {
                    if (data.Exists) {
                        valid = true;
                    }
                    else {
                        $('#frmEditParty #dvpartyNumberMessage').html('رقم الجهة مدخل مسبقا');
                        valid = false;
                    }
                }
        });

        return valid;
    }

</script>
