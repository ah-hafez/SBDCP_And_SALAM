<script>
function UsersProfileSearch() {
        var filter = "";
        var token = $("#frmUsersSearch input[name='__RequestVerificationToken']").val();

    if ($("#hdnExternalPartiesNumber").val() != "" && $("#hdnExternalPartiesNumber").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
        filter += "ExternalPartiesNumber__1__" + $("#hdnExternalPartiesNumber").val();
        }

    if ($("#hdnExternalPartiesName").val() != "" && $("#hdnExternalPartiesName").val() != null) {

        filter += "ExternalPartiesName__1__" + $("#hdnExternalPartiesName").val();
        }

        $("#filterData").val(filter);
        $.ajax({
            type: 'post',
            data: { filter: filter, __RequestVerificationToken: token},
            url: '@Url.Action("UsersProfileSearch", "User")',
            success: function (data) {
                if (data.MessageType != 2) {
                    $("#dvUsersGrid").html("");
                    $("#dvUsersGrid").html(data.Html);
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }
    function redirect() {
                        setTimeout(function () {
                            window.location.href = '@Url.Action("Index", "ExternalParties", new { area="Admin"})';
                        }, 2000);
                    }

    function DeleteNode(id) {

        var nodeId = id;

        if (nodeId != null && nodeId != "root") {

            if (nodeId.length != 0) {
                $.ajax({
                    cache: false,
                    type: "Post",
                    url: '@Url.Action("DeleteExternalParty", "ExternalParties")',
                    data: { "ids": nodeId },
                    success: function (data) {

                        if (data.MessageType != 2) {

                            if (data.ExteralPartyUsedList.length == 0) {
                                ShowSuccesMessage(data.MessageText, redirect());
                            }
                            else {

                                var treeData = data.ExteralPartyList;

                                var msg = '';

                                for (var i = 0; i < data.ExteralPartyUsedList.length; i++) {

                                    for (var y = 0; y < treeData.length; y++) {

                                        if (treeData[y].Id == data.ExteralPartyUsedList[i]) {

                                            if (msg == '')
                                                msg = treeData[y].LocalName;
                                            else
                                                msg = msg + '</br>' + treeData[y].LocalName;
                                        }
                                    }
                                }

                                msg = '@DbRes.TResource("Admin.ExternalParty.DeleteExternalPartiesErrorMsg")' + '</br>' + msg;

                                ShowErrorMessage(msg);
                            }
                        }
                    }
                });
            }
        }
    }
    $(document).ready(function () {

        $('.search-target').click(function () {
            $('.filter-box.search').slideToggle('fast');
            $('.sort-target').removeClass("active");
            $('.filter-target').removeClass("active");
            $(this).toggleClass("active");
            $('.filter-box.filter').hide();
            $('.filter-box.sort').hide();

        });
    });

</script>