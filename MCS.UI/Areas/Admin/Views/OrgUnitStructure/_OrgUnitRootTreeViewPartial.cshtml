<script>



    function UpdateOrgunit()
    {
        $("#UpdateOrgunitBtn").attr("disabled", true);
        debugger;
               $.ajax({
                 url: '@Url.Action("UpdateOrgUnitHierarchy", "User")',
                 type: 'Get',
                 success: function (data) {
                     if (data.MessageType != 2)
                     {
                         $("#UpdateOrgunitBtn").attr("disabled", false);
                          ShowSuccesMessage('@DbRes.TResource("Admin.User.Success")', reloadPage());
                     } else
                     {
                         $("#UpdateOrgunitBtn").attr("disabled", false);
                         ShowErrorMessage(data.MessageText);
                     }

                 }
               });
    }

    function reloadPage()
    {
        setTimeout(function ()
        {
            window.location.reload();
        }, 2000);
    }
</script>