<script>



    $('.search-target').click(function () {
        $('.filter-box.search').slideToggle('fast');
        $('.sort-target').removeClass("active");
        $('.filter-target').removeClass("active");
        $(this).toggleClass("active");
        $('.filter-box.filter').hide();
        $('.filter-box.sort').hide();

    });
    function GetOrgStructureSearchById() {

        var filter = "";
        var token = $("#frmExternalPartiesSearch input[name='__RequestVerificationToken']").val();

        if ($("#divContainerOrgParties .hdnDepartmentId").val() != "" && $("#divContainerOrgParties .hdnDepartmentId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            $("#divContainerOrgParties .hdnDepartmentId").val();
        }

        $("#filterData").val(filter);
        $.ajax({
            type: 'post',
            data: { id: $("#divContainerOrgParties .hdnDepartmentId").val()},
            url: '@Url.Action("GetOrgStructureSearchById", "OrgUnitStructure")',
            success: function (data) {
                if (data.MessageType != 2) {
                    $("#divOrgUnit").html("");
                    $("#divOrgUnit").html(data.Html);
                }
                
            }
        });
    }

  
    function GetDestinationUsersByOrgUnitId() {

        $("#InboundBasicInfo_DestinationId").val($("#DestinationId_hdnDepartmentId").val());

        if ($("#DestinationId_hdnDepartmentId").val() != "") {
            $.ajax({
                cache: false,
                type: 'get',
                url: '@Url.Action("GetManagersByPartyId")',
                data: { id: $("#DestinationId_hdnDepartmentId").val() },
                success:
                    function (data) {
                        var isChecked = $('#Individual:checked').val() ? true : false;
                        if (isChecked) {
                         return false;
                        }
               }
            });
            return false;
        }

    }
</script>