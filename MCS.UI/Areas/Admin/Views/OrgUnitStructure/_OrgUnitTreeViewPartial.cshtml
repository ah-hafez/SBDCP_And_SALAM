@using MCS.Framework.Localization
@model MCS.Common.TreeViewModel

<div id="dvTreeContenar">
    <div class="panel panel-tree">
        <div class="panel-body">
            <div class="tree-control">
                <div class="row">
                    <span class="control-add"><a onclick="AddNode(1)" data-bs-toggle="tooltip" data-placement="top" title="@DbRes.TResource("Admin.ExternalParty.AddUnit")" href="#"></a></span>
                    <span class="control-add_in"><a onclick="AddNode(0)" data-bs-toggle="tooltip" data-placement="top" title="@DbRes.TResource("Admin.ExternalParty.AddSubUnit")" href="#"></a></span>
                    <span class="control-remove"><a onclick="DeleteNode()" data-bs-toggle="tooltip" data-placement="top" title="@DbRes.TResource("Admin.ExternalParty.Delete")" href="#"></a></span>
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-12">
                    <div class="">
                        <input id="treeSearch" class="form-control" type="text" value="">
                    </div>
                    <span class="help-block"></span>
                </div>
            </div>
            <div class="clear"></div>
            <div id="jstree_default" class="tree jstree_scroll push-down-20">
            </div>
        </div>
    </div>
</div>
