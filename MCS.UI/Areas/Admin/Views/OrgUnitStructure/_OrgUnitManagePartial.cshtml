            url: '@Url.Action("ActivateDeactivateUser", "User")',
            success: function (data) {
                if (data.MessageType != 2) {
                    ShowInformationMessage(data.MessageText, redirectToPage());
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }



    function redirectToPage() {
        setTimeout(function () {
            window.location.href = '@Url.Action("OrgUnitInfo", "OrgUnitStructure", new { orgUnitKey = Request.QueryString["orgUnitKey"] })';
       }, 2000);
    }




    function DeleteUserProfile(UserId) {

        $.ajax({
            type: 'Post',
            data: { ids: UserId, __RequestVerificationToken: token},
            url: '@Url.Action("CheckIfUserCanDeleted", "User")',
            success: function (data) {
                if (data.MessageType != 2)//good
                {
                    $.ajax({
                        type: 'Post',
                        data: { ids: data.id, __RequestVerificationToken: token},
                        url: '@Url.Action("DeleteUsers", "User")',
                        success: function (data) {
                            if (data.MessageType != 2) {
                                ShowSuccesMessage(data.MessageText, redirectToPage());
                            }
                            else {
                                ShowErrorMessage(data.MessageText);
                            }
                        }
                    });
                }

                else {
                    ShowCustomConfirmMessage(data.MessageText, 'DeleteUserAndMoveTransaction', data.id);
                }
            }
        });
    }


function DeleteUserAndMoveTransaction(UserId) {

        $.ajax({
            type: 'Post',
            data: { ids: UserId },
            url: '@Url.Action("DeleteUserAndMoveTransaction", "User")',
            success: function (data) {

                if (data.MessageType != 2) {
                    ShowSuccesMessage(data.MessageText, redirectToPage());
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }

        });
    }


    function CheckOrgUnitNumberForAdd() {

        var number = $('#txtAddNumber').val();
        var OrgUnitKey;
        if ('@ViewData["OrgUnitKey"]' != '') {
            var OrgUnitKey =    $('#@ViewData["OrgUnitKey"]').val()
        } else {
            var OrgUnitKey = -1;
        }

        var valid = false;
        $.ajax({
            type: 'Get',
            url: '@Url.Action("CheckOrgUnitNumber")',
            data: { Number: number, OrgUnitKey:OrgUnitKey},
            async: false,
            success:
                function (data) {
                    if (data.Exists) {
                        valid = true;
                    }
                    else {
                        $('#dvOrgUnitNumberMessage').html('رقم الادارة مدخل مسبقا');
                        valid = false;
                    }
                }
        });

        return valid;
        }


