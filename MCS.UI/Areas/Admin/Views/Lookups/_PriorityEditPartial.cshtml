@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@using UserLookups = MCS.UI.Areas.User.Models.Lookups
@model PriorityEditVM
@{
    ViewBag.Title = "_PriorityLookupEditPartial";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmEditProirity", @class = "form-horizontal form-row" }))
{
    @Html.AntiForgeryToken()
    <div id="EditProirityContent" class="panel-body">
        <p>@DbRes.TResource("Global.Forms.MandatoryFields")</p>
        <div class="row">
            <div class="col-md-6">
                @{List<UserLookups.CultureVM> cultureVMs = ViewData["Culture"] as List<UserLookups.CultureVM>;}
                @if (cultureVMs != null)
                {
                    for (int i = 0; i < cultureVMs.Count; i++)
                    {
                        <div class="form-group">
                            @Html.CustomLabelFor(model => model.Description[i].CultureName, new { @class = "col-md-4 control-label" }, DbRes.TResource("Admin.Priority.Description." + cultureVMs[i].ShortName))
                            @Html.StickyHiddenFor(model => model.Description[i].CultureId, new { Value = cultureVMs[i].Id })
                            @Html.HiddenFor(model => model.Description[i].Id)
                            <div class="col-md-8">
                                <div class="">
                                    @Html.TextBoxGroupFor(model => model.Description[i].Text, null, new { @class = "form-control" }, DbRes.TValidation("Admin.Priority.DescriptionRequired." + cultureVMs[i].ShortName))
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.CustomLabelFor(model => model.TransactionCategories, new { @class = "col-md-4 control-label" })
                    <div class="col-md-8">
                        @Html.Partial("~/Areas/Admin/Views/Lookups/_TransactionSourcePartial.cshtml", Model.TransactionCategories, new ViewDataDictionary { TemplateInfo = new TemplateInfo { HtmlFieldPrefix = Html.NameFor(model => model.TransactionCategories).ToString() } })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-4">
                    </div>
                    <div class="col-md-8 border_top_input">
                        <div class="col-md-4">
                            <label class="check">
                                @Html.CheckBoxFor(model => model.HasDate)
                                @Html.LabelFor(model => model.HasDate, new { @style = "padding-right:0" })
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(model => model.Id, new { id = "hdnEditId" })
}
<div class="panel-footer middle">
    @Html.ActionButton(DbRes.TResource("Admin.Priority.Edit"), "EditPriority", "dvGrid", null, null, "OnEditSuccess", null, "post", null, "btnEdit", "frmEditProirity", "btn btn-save pull-right")
    <a class="btn-link pull-right" id="btnCancel" onclick="HideEditDiv()">@DbRes.TResource("Admin.Priority.Cancel")</a>
</div>