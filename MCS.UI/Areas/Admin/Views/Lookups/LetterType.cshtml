@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups;
@using MCS.GridMvc.Ajax.GridExtensions
@model LetterTypeViewModel
@{
    ViewBag.Title = DbRes.TResource("Admin.LetterType.LetterType");
    Layout = "~/Areas/Admin/Views/Shared/_LookupsLayout.cshtml";
}
<script src="~/Scripts/gridmvc.customwidgetscheckbox.js"></script>
<script>
    $(function () {
        pageGrids.LetterType.addFilterWidget(new CustomCheckBoxFilterWidget('@Newtonsoft.Json.JsonConvert.SerializeObject(Model.AddLetterType.TransactionCategories)'));
    });
</script>


<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
    <div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
        <h3 class="site-color mb-4">@DbRes.TResource("Admin.LetterType.LetterType")</h3>
    </div>
</div>
<div class="white-container mx-3 mx-md-5">
    <div id="dvAdd">
        @*@Html.Partial("~/Areas/Admin/Views/Lookups/_LetterTypeAddPartial.cshtml", Model.AddLetterType)*@
    </div>
    <div id="dvEdit" style="display:none;">
        @*@Html.Partial("~/Areas/Admin/Views/Lookups/_LetterTypeEditPartial.cshtml", Model.EditLetterType)*@
    </div>
    <div id="dvLetterTypeGrid">
        <div class="w-100 d-flex align-items-center mt-2 mb-2">
            <h3 class="white-c-title">@DbRes.TResource("Admin.LetterType.LetterType")</h3>
            <span class="roundedred ml-3">@(((AjaxGrid<LetterTypeVM>)ViewData["GridData"]).ItemsCount)</span>
            <span class="pl-2 gray4">@DbRes.TResource("Admin.Grid.Records")</span>
        </div>
        @Html.Partial("~/Areas/Admin/Views/Lookups/_LetterTypeGridPartial.cshtml", ViewData["GridData"])
    </div>
</div>

<script>
    function ShowEditDiv() {
        $("#dvEdit").css("display", "block");
        $("#dvAdd").css("display", "none");
    }

    function HideEditDiv() {
        $("#dvEdit").css("display", "none");
        $("#dvAdd").css("display", "block");
    }

    function OnEditSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#dvEdit").css("display", "none");
            $("#dvAdd").css("display", "block");
            $("#dvLetterTypeGrid").html("");
            $("#dvLetterTypeGrid").html(data.Html);
            jQuery.validator.unobtrusive.parse('#dvLetterTypeGrid');
            ClearInputs('EditLetterTypeContent');
            ShowSuccesMessage(data.MessageText);
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnAddSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#dvLetterTypeGrid").html("");
            $("#dvLetterTypeGrid").html(data.Html);
            jQuery.validator.unobtrusive.parse('#dvLetterTypeGrid');
            ShowSuccesMessage(data.MessageText);
            ClearInputs('AddLetterTypeContent');
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnDeleteSuccess(data, divUpdatData, deletedList) {
        if (data.MessageType != 2) {
            $("#dvLetterTypeGrid").html("");
            $("#dvLetterTypeGrid").html(data.Html);
            jQuery.validator.unobtrusive.parse('#dvLetterTypeGrid');
        }
        if (data.LetterTypesUsedList.length == 0) {

            ShowSuccesMessage(data.MessageText);
        }
        else {

            var msg = '';

            for (var i = 0; i < data.LetterTypesUsedList.length; i++) {

                if (msg == '')
                    msg = data.LetterTypesUsedList[i];
                else
                    msg = msg + '</br>' + data.LetterTypesUsedList[i];
            }

            msg = '@DbRes.TResource("Admin.LetterType.DeleteLetterTypesErrorMsg")' + '</br>' + msg;

            ShowErrorMessage(msg);
        }

        var deletedArray = deletedList.split(',');

        for (var i = 0; i < deletedArray.length; i++) {

            var deleted = true;

            for (var y = 0; y < data.LetterTypesUsedList.length; y++) {

                if (deletedArray[i] == data.LetterTypesUsedList[y]) {

                    deleted = false;
                }
            }

            if (deleted)
                if (deletedArray[i] == $('#hdnEditId').val())
                    HideEditDiv();
        }
    }
    $(".ckSourceAdd").find("#TransactionSources_2__IsSelected").change(function () {
        if (this.checked) {
            if (!$(".ckSourceAdd").find("#TransactionSources_0__IsSelected").is(':checked') && !$(".ckSourceAdd").find("#TransactionSources_1__IsSelected").is(':checked'))
                $("#dvPopularization").show();
        } else
            $("#dvPopularization").hide();
        $(".ckIsPopAdd").attr('checked', false);
    });
    $(".ckSourceAdd").find("#TransactionSources_0__IsSelected").change(function () {
        if (this.checked) {
            $("#dvPopularization").hide();
            $(".ckIsPopAdd").attr('checked', false);
        }
        else
            if (!$(".ckSourceAdd").find("#TransactionSources_1__IsSelected").is(':checked') && $(".ckSourceAdd").find("#TransactionSources_2__IsSelected").is(':checked'))
                $("#dvPopularization").show();
    });
    $(".ckSourceAdd").find("#TransactionSources_1__IsSelected").change(function () {
        if (this.checked) {
            $("#dvPopularization").hide();
            $(".ckIsPopAdd").attr('checked', false);
        }
        else
            if (!$(".ckSourceAdd").find("#TransactionSources_0__IsSelected").is(':checked') && $(".ckSourceAdd").find("#TransactionSources_2__IsSelected").is(':checked'))
                $("#dvPopularization").show();
    });
</script>
