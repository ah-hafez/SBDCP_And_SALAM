@using MCS.UI.Areas.Admin.Models.Lookups
@using MCS.Framework.Localization
@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<AttachmentExtensionVM>

@{
    Layout = "~/Areas/Admin/Views/Shared/_LookupsLayout.cshtml";
    ViewBag.Title = @DbRes.TResource("Admin.Lookups.AttachmentEctension.Title");
}


<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
    <div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
        <h3 class="site-color mb-4">@DbRes.TResource("Admin.Lookups.AttachmentEctension.Title")</h3>
    </div>
</div>
<div class="white-container mx-3 mx-md-5">
    <div id="dvGrid">
        <div class="w-100 d-flex align-items-center mt-2 mb-2">
            <h3 class="white-c-title">@DbRes.TResource("Admin.Lookups.AttachmentEctension.Grid")</h3>
            <span class="roundedred ml-3">@Model.ItemsCount</span>
            <span class="pl-2 gray4">@DbRes.TResource("Admin.Grid.Records")</span>
        </div>
        @Html.Partial("~/Areas/Admin/Views/Lookups/_AttachmentExtensionsGridPartial.cshtml", Model)
    </div>
</div>
