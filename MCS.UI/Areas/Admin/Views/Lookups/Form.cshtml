@using MCS.Framework.Localization
@using MCS.GridMvc.Ajax.GridExtensions
@using MCS.UI.Areas.Admin.Models.Lookups;
@using MCS.Common;
@using TXTextControl.Web
@using TXTextControl.Web.MVC
@model FormViewModel
@{
    ViewBag.Title = DbRes.TResource("Admin.Form.Forms");
    Layout = "~/Areas/Admin/Views/Shared/_LookupsLayout.cshtml";
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
}

<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center">
    <div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
        <h3 class="site-color mb-4">@DbRes.TResource("Admin.Form.Forms")</h3>
    </div>
</div>
<div class="white-container mx-3 mx-md-5">
    <div id="dvAdd">
        @Html.Partial("~/Areas/Admin/Views/Lookups/_FormAddPartial.cshtml", Model.AddForm)
    </div>
    <div id="dvEdit" style="display:none;">

    </div>
    <hr />
    <br />

    <br />

    <div id="dvGrid">
        <div class="w-100 d-flex align-items-center mt-2 mb-2">
            <h3 class="white-c-title">@DbRes.TResource("Admin.Grid.FormTypes")</h3>
            <span class="roundedred ml-3">@(((AjaxGrid<FormVM>)ViewData["GridData"]).ItemsCount)</span>
            <span class="pl-2 gray4">@DbRes.TResource("Admin.Grid.Records")</span>
        </div>
        @Html.Partial("~/Areas/Admin/Views/Lookups/_FormGridPartial.cshtml", ViewData["GridData"])
    </div>
</div>


<script>
    const addContentDiv = $("#dvAdd").html();
    $(document).ready(function ()
    {



    });


     function SaveTransactionAttachements(obj) {
       // showname();
        //var name = document.getElementById('TransactionFiles');

         var parent = $(obj).closest('form');
         var name =  parent.find('#TransactionFiles')[0];
         parent.find('#uploadContainer .uploaded-files').children('.newAdded').remove();
         console.log(parent);
        var fileExist = false;
        for (i = 0; i < name.files.length; i++) {
            parent.find('#uploadContainer .uploaded-files').find('.attachment_name').each(function () {

                var S = $(this).html();
                if (S.includes(name.files.item(i).name)) {
                    fileExist = true;
                }
            });
            if (!fileExist) {
                parent.find("#FileName").val(name.files.item(i).name);
                $("#hdnFileName").val(name.files.item(i).name);
                parent.find('#uploadContainer .uploaded-files').append('<div class="file newAdded"><i class="uicon icon_attachments"></i><span class="attachment_name">' + name.files.item(i).name + '</span><a href="javascript:removeMainDocAttachemntPhysically()" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>');
            }
         }


         parent.find('.col-uploadeed-files').fadeIn(200);

         var files = parent.find('#uploadContainer').find(parent.find("input:file")).get(0).files;
        if (files.length <= 0) {
            return;
        }

        if (window.FormData !== undefined) {
            var data = new FormData();
            var fileExist = false;
            for (i = 0; i < files.length; i++) {
                parent.find('#uploadContainer .uploaded-files').find('.attachment_name').each(function () {
                    if ($(this).html() == files[i].name) {
                        fileExist = true;
                    }
                });
                if (fileExist) {
                    data.append("file" + i, files[i], files[i].name);
                }
            }
            data.append('TransactionArchiveVM', parent.find("#dvAttachmentsBody :input").serializeArray());
            data.append('AttachmentTypeId', parent.find("#hdnAttachmentType").val());
            var jqXHR = $.ajax({
                type: "post",
                url: '@Url.Action("UploadAttachments", controller)',
                data: data,
                contentType: false,
                processData: false,
                dataType: 'json',
                async: false,
            }).done(function (data) {
                if (data.MessageType != 2) {
                    parent.find("#JFile").val(data.AddedFilesJson);
                }
            }).fail(function (jqXHR, textStatus) {
                alert("error");
            });
        } else {
            alert("Your browser doesn't support HTML5 multiple file uploads! Please use some decent browser.");
            return;
        }

        return;
    }







    function GetOrganizationUnitIdsToForm() {
        $('#OrgUnitContentToForm').empty();
        $("[data-name='DepartmentIds']").find('.tag').each(function (index) {
            if ($('#frmAddForm').is(":visible")) {
                $('#frmAddForm').find('#OrgUnitContentToForm').append("<input name='OrgUnitIds[" + index + "]' value=" + this.id + " type='hidden'/>");
            }
            else if ($('#frmEditForm').is(":visible")) {
                $('#frmEditForm').find('#OrgUnitContentToForm').append("<input name='OrgUnitIds[" + index + "]' value=" + this.id + " type='hidden'/>");
            }
        });
    }

    function ShowEditDiv(data) {
        var form1 = $("input").closest("form").attr("action");
        $("#dvEdit").css("display", "block");
        $("#dvAdd").css("display", "none");
        $("#dvAdd").html('');
        if (data.AllOrgUnitsSelected) {
            $("#dvDepartmentsTreeEdit .txtDepartmentNumber").attr("disabled", true);
            $("#dvDepartmentsTreeEdit .txtDepartmentName").attr("disabled", true);
            $("#dvOrgUnitItemsEdit").html("");
        }
        AddedOrgunitsIds = $("#addedOrgUnits").val().split(',');
        ClearInputs("dvDepartmentsTreeEdit");

        //if ($("#FileContent").val() != '')
        //{
        //    FillDocument($("#FileContent").val());
        //}

    }

    function HideEditDiv() {
        $("#dvEdit").css("display", "none");
        $("#dvAdd").css("display", "block");
        $("#dvOrgUnitItems").html("");
        $("#dvEdit").html('');
        $("#dvAdd").html(addContentDiv);

        AddedOrgunitsIds = [];
        $("#dvDepartmentsTree input").attr("disabled", false);
        $("#btnAddOrgUnit").attr("disabled", false);
    }

    function OnEditSuccess(data, div) {
        if (data.MessageType != 2) {

            $("#dvEdit").css("display", "none");
            $("#dvAdd").css("display", "block");
            $("#dvGrid").html("");
            $("#dvGrid").html(data.Html);
            jQuery.validator.unobtrusive.parse('#dvGrid');
            $("#dvOrgUnitItems").html("");
            AddedOrgunitsIds = [];
            $("#FileContent").val('')
          /*  FillDocument('');*/
            $("#dvAdd").html(addContentDiv);
            ShowSuccesMessage(data.MessageText);

        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnAddSuccess(data, div) {
        if (data.MessageType != 2) {

            $("#dvGrid").html("");
            $("#dvGrid").html(data.Html);
            jQuery.validator.unobtrusive.parse('#dvGrid');
            $("#dvOrgUnitItems").html("");
            AddedOrgunitsIds = [];
          /*  FillDocument('');*/
            $("#dvAdd").html(addContentDiv);
            ShowSuccesMessage(data.MessageText);
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function DeleteDocument(documentId, formId) {
        $.confirm({
            title: '',
            content: '<div class="mb-title"><span class="fa fa-question"></span></div><p>' + '@Html.Raw(DbRes.TResource("Admin.Form.DeleteDocumentMessage"))' + '</p>',
            cancelButton: __dialogNoText,
            cancelButtonClass: 'btn-default',
            confirmButton: __dialogYesText,
            confirmButtonClass: 'btn-primary',

            animation: 'scale',
            columnClass: 'alert_normal alert_new col-md-6 col-md-offset-3 col-xs-6 col-xs-offset-3',
            backgroundDismiss: false,
            closeIcon: false,
            confirm: function () {
                $.ajax({
                    type: "post",
                    url: '@Url.Action("DeleteFormDocument", "Lookups")',
                    data: { documentId: documentId, formId: formId },
                    success:
                        function (data) {

                       if (data.MessageType != 2) {

                           $("#dvEdit").html("");
                           $("#dvEdit").html(data.Html);
                           jQuery.validator.unobtrusive.parse("#dvEdit");
                           ShowSuccesMessage(data.MessageText);
                       }
                       else {
                           ShowErrorMessage(data.MessageText);
                       }
                   },
                    error: function (data) {
                    }
                });

            },
            cancel: function () {

            }
        });
        return false;
    }
    function SelectMultiTreeNode(treeName, nodeIds) {
    $('#divDir__' + treeName).find('div.selectable_node').each(function () {
        var id = $(this).find('.multiple_select_dept').data('value');
        var text = $(this).find(".multiple_select_dept").html();
        var number = $(this).find(".hdnDepartmentNumber").val();
        if (nodeIds != "" && nodeIds != undefined) {
            var str_array = nodeIds.split(',');
            for (var nodeId in str_array) {
                if (str_array[nodeId] == id) {
                    $(this).addClass('selected');
                    $("#divForm__" + treeName).find(".txtDepartmentName").val(text);
                    $("#divForm__" + treeName).find('.txtDepartmentNumber').val(number);
                    $("#divForm__" + treeName).find('.hdnDepartmentId').val(id);
                }
            }
        }
    });
    var funtion = $("#divContainer__" + treeName).attr("data-func");
    if (funtion != '' && funtion != undefined) {
        window[funtion]();
    }
}

    function OnDeleteSuccess(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
            $("#dvGrid").html("");
            $("#dvGrid").html(data.Html);
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function LockUnlockLookup(LookupType, LookupOperationType, FormId) {
        var token = $("#dvAdd input[name='__RequestVerificationToken']").val()
        var data = { lookupType: LookupType, lookupOperationType: LookupOperationType, lookUpId: FormId, __RequestVerificationToken: token};
        $.ajax({
            type: "post",
            url: '@Url.Action("LockUnlockLookup", "Lookups")',
            data: data,
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        $("#dvGrid").html("");
                        $("#dvGrid").html(data.Html);
                        //ShowInformationMessage("OK");
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                },
            error: function (data) {
            }
        });
    }

    function ActiveDeactiveLookup(LookupType, LookupOperationType, FormId) {
        var token = $("#dvAdd input[name='__RequestVerificationToken']").val()
        var data = { lookupType: LookupType, lookupOperationType: LookupOperationType, lookUpId: FormId, __RequestVerificationToken: token};
        $.ajax({
            type: "post",
            url: '@Url.Action("ActiveDeactiveLookup", "Lookups")',
            data: data,
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        $("#dvGrid").html("");
                        $("#dvGrid").html(data.Html);
                        //ShowInformationMessage("OK");
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                },
            error: function (data) {
            }
        });
    }


</script>
