@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@model List<SuggestedTopicVM>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmTreeTopics", @class = "form-horizontal form-row" }))
{
    @Html.AntiForgeryToken()
    @Html.StickyHidden("hdnSuggestedTopics", ViewData["SuggestedTopics"] != null ? ViewData["SuggestedTopics"].ToString() : null)


    <div class="panel-body">
        <h3 class="push-up-20">@DbRes.TResource("Admin.SuggestedTopic.AllSubjects")</h3>
        <p>@DbRes.TResource("Admin.SuggestedTopic.SortGroups")</p>
        <div class="row">
            <div class="col-md-12">

                <div class="dd" id="nestable3">

                    @if (Model != null)
                    {

                        <ol class="dd-list">
                            @RenderTree(Model)
                        </ol>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="panel-footer">
        @Html.ActionButton(DbRes.TResource("Admin.SuggestedTopic.Save"), "SaveSuggestedTopic", "dvSave", null, null, "OnSaveSuccess", null, "post", null, "btnSave", "frmTreeTopics", "btn btn-save pull-right")
    </div>
}
<script>
    function OnSaveSuccess(data, div) {
        if (data.MessageType != 2) {

            $("#" + div).html("");
            $("#" + div).html(data.Html);
            ShowSuccesMessage(data.MessageText);
        }
        else {
            ShowErrorMessage(data.MessageText);
        }

    }

    $(".dd3-content").click(function () {
        $(this).parents("li:first").toggleClass("select_dd");
    });


    var item;

    $(function () {
        $.contextMenu({
            selector: '.dd-item',
            build: function ($trigger, e) {
                if (!$($trigger).hasClass("select_dd")) {
                    $(".select_dd").toggleClass("select_dd");
                }

                if ($(".select_dd").length > 1) {
                    item = {
                        "delete": { name: "@DbRes.TResource("Admin.SuggestedTopic.Delete")" },
                    };
                }
                else {
                    item = {
                        "edit": { name: "@DbRes.TResource("Admin.SuggestedTopic.Edit")" },
                        "delete": { name: "@DbRes.TResource("Admin.SuggestedTopic.Delete")" },
                    };
                }
                return {
                    callback: function (key, options) {
                        switch (key) {
                            case "edit":
                                GetSuggestedTopic(options.$trigger);
                                break;

                            case "delete":
                                if ($(".select_dd").length > 1) {
                                    DeleteSuggestedTopics($(".select_dd"));
                                }
                                else {
                                    DeleteSuggestedTopics(options.$trigger);
                                }
                        }
                    },
                    items: item
                };
            }
        });




        $('#nestable3').nestable({ dropCallback: CheckType });
    });

    function DeleteSuggestedTopics(elements) {

        var deletedList = new Array();
        $(elements).each(function () {
            deletedList.push(parseInt($(this).data("id")));
        });

        $.ajax({
            cache: false,
            type: 'post',
            url: '@Url.Action("DeleteSuggestedTopics")',
            data: { suggestedTopics: $("#hdnSuggestedTopics").val(), ids: deletedList },
            success:
               function (data) {

                   if (data.MessageType != 2) {
                       $("#dvSave").html("");
                       $("#dvSave").html(data.Html);
                       $("#hdnSuggestedTopics").val(data.Data);
                       $("#hdnAddSuggestedTopics").val(data.Data);
                       $("#hdnEditSuggestedTopics").val(data.Data);
                       CloseEditMode();
                   }
               },
            error: function (data) {
            }

        });
    }

    function GetSuggestedTopic(element) {
        var id = $(element).data("id");
        var items = $("#hdnSuggestedTopics").val();
        $.ajax({
            type: "post",
            url: '@Url.Action("GetSuggestedTopic")',
            cache: false,
            data: { id: id, suggestedTopics: items },
            success:
               function (data) {

                   if (data.MessageType != 2) {
                       $("#dvEdit").html("");
                       $("#dvEdit").html(data.Html);
                       $("#hdnEditSuggestedTopics").val(items);
                       jQuery.validator.unobtrusive.parse('#dvEdit');
                       $("#dvAdd").hide();
                       $("#dvEdit").show();
                   }
                   else {
                       ShowErrorMessage(data.MessageText);
                   }
               }
        });
    }

    function CheckType(details) {
        var data = $.parseJSON($("#hdnSuggestedTopics").val());

        jQuery.each(data, function (i, val) {
            if (val.Id == details.sourceId) {
                data[i].ParentId = details.destId;
            }
        });

        $("#hdnSuggestedTopics").val(JSON.stringify(data));
        $("#hdnAddSuggestedTopics").val(JSON.stringify(data));
        $("#hdnEditSuggestedTopics").val(JSON.stringify(data));
    }


</script>




@helper RenderTree(List<SuggestedTopicVM> suggestedTopicVMs)
{
    for (int i = 0; i < suggestedTopicVMs.Count; i++)
    {
        string itemClass = string.Empty;

        if (!suggestedTopicVMs[i].IsDeleted)
        {

            if (!suggestedTopicVMs[i].IsGroup)
            {
                itemClass = "item_confirm dd-nodrop";
            }

            if (suggestedTopicVMs[i].Childs != null && suggestedTopicVMs[i].Childs.Count > 0)
            {
                <li class="dd-item dd3-item @itemClass" data-id="@suggestedTopicVMs[i].Id">
                    <div class="dd-handle dd3-handle">Drag</div><div class="dd3-content">@suggestedTopicVMs[i].Description.Where(l => l.CultureName == SessionInfo.CultureShortName).FirstOrDefault().Text</div>
                    <ol class="dd-list">
                        @RenderTree(suggestedTopicVMs[i].Childs)
                    </ol>
                </li>
            }
            else
            {
                <li class="dd-item dd3-item @itemClass" data-id="@suggestedTopicVMs[i].Id">
                    <div class="dd-handle dd3-handle">Drag</div><div class="dd3-content">@suggestedTopicVMs[i].Description.Where(l => l.CultureName == SessionInfo.CultureShortName).FirstOrDefault().Text</div>
                </li>
            }
        }

    }
}