@model FormEditVM
@using MCS.UI.Areas.Admin.Models.Lookups
@using UserLookups = MCS.UI.Areas.User.Models.Lookups
@using MCS.Common;
@using MCS.Framework.Localization;

@{
    ViewBag.Title = "_FormEditParial";
    Layout = null;
    var addedOrgUnits = "";

}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmEditForm", @class = "" }))
{
    @Html.AntiForgeryToken()

<div id="formEdit" class="form-row">
    @{List<UserLookups.CultureVM> cultureVMs = ViewData["Culture"] as List<UserLookups.CultureVM>;}

    @if (cultureVMs != null)
    {
        for (int m = 0; m < cultureVMs.Count; m++)
        {
            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                @Html.CustomLabelFor(model => model.Description[m].CultureName, new { @class = "" }, DbRes.TResource(string.Format("Admin.Form.TemplateName.{0}", cultureVMs[m].ShortName)))<span class="stark">*</span>
                @Html.StickyHiddenFor(model => model.Description[m].CultureId, new { Value = cultureVMs[m].Id })
                @Html.HiddenFor(model => model.Description[m].Id)
                @Html.TextBoxGroupFor(model => model.Description[m].Text, "", new { @class = "form-control" }, DbRes.TValidation("Admin.Forms.TemplateNameRequired." + cultureVMs[m].ShortName))
            </div>
        }
    }

    <div class="form-group col-lg-6 col-md-4 col-sm-6 col-xs-12" id="TransTypesEdit" hidden>
        @Html.CustomLabelFor(model => model.TransactionCategories, new { @class = "w-100" }, DbRes.TResource("Admin.Form.TransactionType"))
        @Html.Partial("~/Areas/Admin/Views/Lookups/_TransactionSourcePartial.cshtml", Model.TransactionCategories, new ViewDataDictionary { TemplateInfo = new TemplateInfo { HtmlFieldPrefix = Html.NameFor(model => model.TransactionCategories).ToString() } })
        <label id="noTransTypeselectedValidationMessageEdit" style="display:none; color:red">@DbRes.TValidation("Admin.Form.AtLeastOneTransactionTypeValidation")</label>
    </div>

    @Html.HiddenFor(model => model.FileName, new { id = "hdnFileName" })

    <div class="form-group col-lg-6 col-md-8 col-sm-12 col-xs-12">
        <div>
            <fieldset class="field-set" id="dvDepartmentsTreeEdit">
                @Html.DepartmentsTree(ViewData["orgUnitDataInfo"] as TreeViewModel, model => model.OrgUnitIds, TreeMode.Single, "frmEditForm", false, "", "BasicInformation", "dvDepartmentsTreeEdit")
            </fieldset>
            @*<label>@Html.DisplayNameFor(model => model.OrgUnitIds)<span class="stark">*</span></label>
                @Html.EditorFor(model => model.SelectedOrgUnitsIds, "OrgHierarchyCaller", additionalViewData: new { treeId = "dvDepartmentsTreeEdit", GetChildrenActionURL = @Url.Action("GetInternalPartyChildren", "Common"), onClickfunction = "", ValidationGroup = "BasicInformation", ShowAddPartyButton = false })*@

            <label id="OrgUnitValidationMessage" style="display:none; color:red">@DbRes.TValidation("Admin.Form.OrgUnitValidation")</label>
            <label id="AtLeastOneOrgUnitValidationMessageEditMode" style="display:none; color:red">@DbRes.TValidation("Admin.Form.AtLeastOneOrgUnitValidation")</label>
        </div>
    </div>

    @Html.HiddenFor(x => x.FileContent)

    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
        @Html.CustomLabelFor(model => model.AllOrgUnitsSelected, new { @class = "w-100" }, DbRes.TResource("الإدارات"))
        <div class="form-check form-check-inline">
            @Html.CheckBoxFor(model => model.AllOrgUnitsSelected, new { id = "AllOrgUnitsEdit", @class = "form-check-input" })
            @Html.StickyHidden("hdnIsSelected")
            @Html.Label(DbRes.TResource("Admin.Form.AllDepartment"), new { @class = "form-check-label" })
        </div>
    </div>
    <div class="form-group col-lg-2 col-md-4 col-sm-6 col-xs-12 align-self-end mang-button">
        <button type="button" id="btnAddOrgUnitEditMode" class="btn btn-st1 btn-lg w-xs-100">
            @DbRes.TResource("Admin.Form.AddDepartment")
        </button>
    </div>
    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-0">
        <div id="dvOrgUnitItemsEdit" class="added_departments d-flex flex-wrap">
            @if (Model.OrgUnitsKeyValue != null)
            {
                foreach (var item in Model.OrgUnitsKeyValue)
                {
                    <div id="div_@item.Key" class="added_item mr-4 mb-3">
                        <span class="added-class d-flex">
                            <span>@item.Value</span>
                            <a onclick="DeleteOrgUnitItem(@item.Key)" class="color-burgundy ml-2"><i class="icon-tables-delete"></i></a>
                        </span>
                        <input type="hidden" name="OrgUnitIds" value="@item.Key" />
                    </div>
                    { addedOrgUnits += item.Key + ","; }
                }
            }
        </div>
    </div>
    @Html.StickyHidden("addedOrgUnits", addedOrgUnits != "" ? addedOrgUnits.Remove(addedOrgUnits.Length - 1) : addedOrgUnits)
</div>

    @*@Html.Partial("~/Areas/Admin/Views/Lookups/_FormTextEditorPartial.cshtml", Model.FormContentVM, new ViewDataDictionary { TemplateInfo = new TemplateInfo { HtmlFieldPrefix = Html.NameFor(model => model.FormContentVM).ToString() } })*@
    @*@Html.Partial("~/Areas/User/Views/Transaction/_UploadFile.cshtml")*@
    <div id="uploadContainer">
        @Html.Partial("~/Areas/Admin/Views/Lookups/_UploadFile.cshtml")
        <br /><br />
    </div>
    @Html.HiddenFor(model => model.Id, new { id = "hdnEditId" })

    <br />
    <br />
    <br />
    <div class="mx-3 mx-md-5 mb-4 d-flex">
        <br />
        <div class="ml-auto">

            @Html.ActionButton(DbRes.TResource("Admin.Form.Edit"), "EditForm", "dvGrid", null, null, "OnEditSuccess", null, "post", null, "btnEdit", "frmEditForm", "btn btn-lg btn-st3 mx-1", "")
            <a class="btn btn-lg btn-st3 mx-1" id="btnCancel" onclick="HideEditDiv()">@DbRes.TResource("Admin.Form.Cancel")</a>
        </div>
    </div>

}

<script>
    
    $(document).ready(function () {
        if ($(this).prop("checked") == true) {
            $("#dvDepartmentsTreeEdit .txtDepartmentNumber").attr("disabled", true);
            $("#dvDepartmentsTreeEdit .txtDepartmentName").attr("disabled", true);
            $("#btnAddOrgUnitEditMode").attr("disabled", true);
            $("#dvOrgUnitItemsEdit").html("");
            AddedOrgunitsIds = [];
        } else {
            $("#dvDepartmentsTreeEdit input").attr("disabled", false);
            $("#btnAddOrgUnitEditMode").attr("disabled", false);
        }
    });
    $("#AllOrgUnitsEdit").on("change", function () {

        if ($(this).prop("checked") == true) {
            $("#dvDepartmentsTreeEdit .txtDepartmentNumber").attr("disabled", true);
            $("#dvDepartmentsTreeEdit .txtDepartmentName").attr("disabled", true);
            $("#btnAddOrgUnitEditMode").attr("disabled", true);
            $("#dvOrgUnitItemsEdit").html("");
            AddedOrgunitsIds = [];
        } else {
            $("#dvDepartmentsTreeEdit input").attr("disabled", false);
            $("#btnAddOrgUnitEditMode").attr("disabled", false);
        }
    });
    function CheckContentOnEdit() {
        var hdnEditorContentId = "";
        var noOfSelectedCheckedBoxes = $("#TransTypesEdit input[type=checkbox]:checked").length;
        var NoMissingData = true;
        $('#frmEditForm input[id^="hdnContent"]').filter(
           function () {

               hdnEditorContentId = this.id;
           })
        if ($("#AllOrgUnitsEdit").prop("checked") == false && $(".added_item").length < 1) {
            $("#OrgUnitValidationMessage").hide();
            $("#AtLeastOneOrgUnitValidationMessageEditMode").show();
            return false;
        }

        if (noOfSelectedCheckedBoxes == 0) {
            $("#noTransTypeselectedValidationMessageEdit").show();
            NoMissingData = false;
        } else {
            $("#noTransTypeselectedValidationMessageEdit").hide();
        }
        if ($("#" + hdnEditorContentId).length > 0) {

            if ($("#" + hdnEditorContentId).val() == "") {
                ShowErrorMessage('@Html.Raw(DbRes.TValidation("Admin.Form.ContentRequired"))');
                NoMissingData = false;
            }
            GetOrganizationUnitIdsToForm();

            return NoMissingData;
        }
        else {
            ShowErrorMessage('@Html.Raw(DbRes.TValidation("Admin.Form.ContentRequired"))');
            return false;
        }

    }

    var AddedOrgunitsIds = [];
    $('#btnAddOrgUnitEditMode').on('click', function () {
        var id = $('#dvDepartmentsTreeEdit_hdnDepartmentId').val();
        var orgunitName = $('#dvDepartmentsTreeEdit_txtDepartmentName').val();
        var exist = false;

        if (id == "" && orgunitName == "") {
            $("#OrgUnitValidationMessage").show();
            return;
        }
        $("#OrgUnitValidationMessage").hide();
        $("#AtLeastOneOrgUnitValidationMessageEditMode").hide();
        AddedOrgunitsIds.forEach(function (item) {
            if (item == id) {
                ShowErrorMessage("Already exist");
                exist = true;
                return false;
            }
        });


        if (!exist) {
            var itemsCount = $(".added_item").length;
            var OrgUnitItem = "<div id='div_" + id + "' class='added_item mr-4 mb-3'>";
            OrgUnitItem += "<span class='added-class d-flex'>";
            OrgUnitItem += "<span>" + orgunitName + "</span>";
            OrgUnitItem += "<a onclick='DeleteOrgUnitItem(" + id + ")' class='color-burgundy ml-2'><i class='icon-tables-delete'></i></a>";
            OrgUnitItem += "</span>";
            OrgUnitItem += "<input type='hidden' name='OrgUnitIds' value='" + id + "'/>";
            OrgUnitItem += "</div>";

            $("#dvOrgUnitItemsEdit").append(OrgUnitItem);
            AddedOrgunitsIds.push(id);

            ClearInputs("dvDepartmentsTreeEdit");
        }
    });

    function DeleteOrgUnitItem(OrgUnitItemId) {

        var index = AddedOrgunitsIds.indexOf(OrgUnitItemId + "");
        if (index > -1) {
            AddedOrgunitsIds.splice(index, 1);
        }

        $("#div_" + OrgUnitItemId).remove();
    }

    $("#AllOrgUnitsEdit").on("change", function () {
        if ($(this).prop("checked") == true) {
            $("#dvDepartmentsTreeEdit_txtDepartmentNumber").attr("disabled", true);
            $("#dvDepartmentsTreeEdit_txtDepartmentName").attr("disabled", true);
            $("#btnAddOrgUnit").attr("disabled", true);

            $("#dvOrgUnitItemsEdit").html("");
            AddedOrgunitsIds = [];
        } else {
            $("#dvDepartmentsTreeEdit input").attr("disabled", false);
            $("#btnAddOrgUnit").attr("disabled", false);
        }
    });
</script>