@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@using MCS.GridMvc.Helpers;
@using MCS.GridMvc.Html;
@using MCS.Common;

@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<SubjectClassificationVM>
@{
    ViewBag.Title = "_SubjectClassificationGridParial";
}


@Html.Grid(Model).Named("SubjectClassification").Columns(columns =>
{
    columns.Add(model => model.Id).Titled(DbRes.TResource("Admin.SubjectClassification.Id")).Css("hidden_");
    columns.Add(model => model.Description[0].Text, "DescriptionAr").Titled(DbRes.TResource("الاسم بالعربية"));
    columns.Add(model => model.Description[1].Text, "DescriptionEn").Titled(DbRes.TResource("الاسم بالانجليزية"));
    //columns.Add().Titled(DbRes.TResource("Admin.SubjectClassification.Status")).RenderValueAs(model => MvcHtmlString.Create(model.IsActive ? DbRes.TResource("Admin.SubjectClassification.Status.Active") : DbRes.TResource("Admin.SubjectClassification.Status.Deactive")));

    columns.Add().Encoded(false).Sanitized(false).Css("").RenderValueAs(model =>

       MvcHtmlString.Create(
           "<div class='table-icon d-flex align-items-center'>" +
               @Html.GridImageButton("GetSubjectClassification", "SubjectClassification", 0, OperationType.Update, "dvEdit", null, null, "ShowEditDiv", "", "get")) +
            "</div>");
}).WithPaging(GridHelper.PageSize)



<script>
    var token = $("#dvAdd input[name='__RequestVerificationToken']").val()
    var mySubjectClassificationGridEventHandler = "@Url.Action("UpdateSubjectClassificationGrid", "Lookups")?__RequestVerificationToken=" + token;
        function prepareSubjectClassificationReportGrid() {
            $(".grid-mvc").gridmvc();
            pageGrids.SubjectClassification.ajaxify({
                getPagedData: mySubjectClassificationGridEventHandler,
                requestType: "get",
                getData: mySubjectClassificationGridEventHandler
            });
        }

        $(document).ready(function () {
            prepareSubjectClassificationReportGrid();
        });
</script>

