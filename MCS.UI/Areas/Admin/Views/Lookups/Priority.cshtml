    }

    function ShowEditDiv() {
        $("#dvEdit").css("display", "block");
        $("#dvAdd").css("display", "none");
    }

    function HideEditDiv() {
        $("#dvEdit").css("display", "none");
        $("#dvAdd").css("display", "block");
    }

    function OnEditSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#dvEdit").css("display", "none");
            $("#dvAdd").css("display", "block");
            $("#" + div).html("");
            $("#" + div).html(data.Html);
            jQuery.validator.unobtrusive.parse('#' + div);
            ClearInputs('EditProirityContent');
            ShowSuccesMessage(data.MessageText);
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnAddSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#" + div).html("");
            $("#" + div).html(data.Html);
            jQuery.validator.unobtrusive.parse('#' + div);
            ShowSuccesMessage(data.MessageText);
            ClearInputs('AddProirityContent');
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnDeleteSuccess(data, divUpdatData, deletedList) {
        if (data.PrioritiesUsedList.length == 0) {
            ShowSuccesMessage(data.MessageText);
        }
        else {
            var msg = '';
            for (var i = 0; i < data.PrioritiesUsedList.length; i++) {
                if (msg == '')
                    msg = data.PrioritiesUsedList[i];
                else
                    msg = msg + '</br>' + data.PrioritiesUsedList[i];
            }
            msg = '@DbRes.TResource("Admin.Priority.DeletePrioritiesErrorMsg")' + '</br>' + msg;
            ShowErrorMessage(msg);
        }
        var deletedArray = deletedList.split(',');
        for (var i = 0; i < deletedArray.length; i++) {
            var deleted = true;
            for (var y = 0; y < data.PrioritiesUsedList.length; y++) {

                if (deletedArray[i] == data.PrioritiesUsedList[y]) {

                    deleted = false;
                }
            }
            if (deleted)
                if (deletedArray[i] == $('#hdnEditId').val())
                    HideEditDiv();
        }
    }
</script>
