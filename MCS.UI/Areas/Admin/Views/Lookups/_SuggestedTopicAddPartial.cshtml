@model  SuggestedTopicVM
@using MCS.Common;
@using MCS.Framework.Localization;
@using MCS.UI.Areas.Admin.Models.Lookups
@using UserLookups = MCS.UI.Areas.User.Models.Lookups
@{
    ViewBag.Title = "_TopicAddPartial";
    Layout = null;
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmAddTopic", @class = "form-horizontal form-row" }))
{
    @Html.AntiForgeryToken()
    <div id="AddTopicContent">
        @Html.StickyHidden("hdnAddSuggestedTopics", ViewData["SuggestedTopics"] != null ? ViewData["SuggestedTopics"].ToString() : null)
        <div class="panel-body">
            <p>@DbRes.TResource("Global.Forms.MandatoryFields")</p>
            <div class="row" id="dvGroupContainer">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="col-md-3 ">
                            @Html.RadioButtonFor(model => model.IsGroup, true, new { @class = "", @checked = "" })
                            @DbRes.TResource("Admin.SuggestedTopic.Group")
                        </label>
                        <label class="col-md-3">
                            @Html.RadioButtonFor(model => model.IsGroup, false, new { @class = "" })
                            @DbRes.TResource("Admin.SuggestedTopic.Item")
                        </label>
                    </div>
                </div>
            </div>

        </div>
        <div class="panel-body">
            <div class="row">
                @{List<UserLookups.CultureVM> cultureVMs = ViewData["Culture"] as List<UserLookups.CultureVM>;}
                @if (cultureVMs != null)
                {
                    for (int m = 0; m < cultureVMs.Count; m++)
                    {
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.CustomLabelFor(model => model.Description[m].CultureName, new { @class = "col-md-4 control-label" }, DbRes.TResource(string.Format("Admin.SuggestedTopic.Description.{0}", cultureVMs[m].ShortName)))
                                @Html.StickyHiddenFor(model => model.Description[m].CultureId, new { Value = cultureVMs[m].Id })
                                @Html.StickyHiddenFor(model => model.Description[m].CultureName, new { Value = cultureVMs[m].ShortName })
                                <div class="col-md-8">
                                    <div class="">
                                        @Html.TextBoxGroupFor(model => model.Description[m].Text, "SuggestedTopic", new { @class = "form-control" }, DbRes.TValidation("Admin.SuggestedTopic.DescriptionRequired." + cultureVMs[m].ShortName))
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="panel-body">
            @Html.DepartmentsTree(ViewData["OrgUnits"] as TreeViewModel, model => model.OrgUnits, TreeMode.Multiple, "AddtreeOrgUnits", true)
        </div>
    </div>
    <div class="panel-footer middle">
        @Html.ActionButton(DbRes.TResource("Admin.SuggestedTopic.Add"), "AddSuggestedTopic", "dvSave", null, null, "OnAddSuccess", null, "post", "SuggestedTopic", "btnAdd", "frmAddTopic", "btn btn-save pull-right")
        @Html.ResetButton("ClearInputs('frmAddTopic')")
    </div>
}

<script>
    function OnAddSuccess(data, div) {
        $("#" + div).html("");
        $("#" + div).html(data.Html);
        jQuery.validator.unobtrusive.parse('#' + div);
        ClearInputs('AddTopicContent');
        $("#hdnSuggestedTopics").val(data.Data);
        $("#hdnAddSuggestedTopics").val(data.Data);
        $("#hdnEditSuggestedTopics").val(data.Data);
    }
</script>