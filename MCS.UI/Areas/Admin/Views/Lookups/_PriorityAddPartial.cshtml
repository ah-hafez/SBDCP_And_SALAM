@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@using UserLookups = MCS.UI.Areas.User.Models.Lookups
@model PriorityAddVM
@{
    ViewBag.Title = "_PriorityLookupAddPartial";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmAddProirity", @class = "form-horizontal form-row" }))
{
    @Html.AntiForgeryToken()
    <div id="AddProirityContent" class="panel-body">
        <p>@DbRes.TResource("Global.Forms.MandatoryFields")</p>
        <div class="row">
            <div class="col-md-6">
                @{List<UserLookups.CultureVM> cultureVM = ViewData["Culture"] as List<UserLookups.CultureVM>;}
                @if (cultureVM != null)
                {
                    for (int i = 0; i < cultureVM.Count; i++)
                    {
                        <div class="form-group">
                            @Html.CustomLabelFor(model => model.Description[i].CultureName, new { @class = "col-md-4 control-label" }, DbRes.TResource("Admin.Priority.Description." + cultureVM[i].ShortName))
                            @Html.StickyHiddenFor(model => model.Description[i].CultureId, new { Value = cultureVM[i].Id })
                            <div class="col-md-8">
                                <div class="">
                                    @Html.TextBoxGroupFor(model => model.Description[i].Text, null, new { @class = "form-control" }, DbRes.TValidation("Admin.Priority.DescriptionRequired." + cultureVM[i].ShortName))
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.CustomLabelFor(model => model.TransactionCategories, new { @class = "col-md-4 control-label" })
                    <div class="col-md-8">
                        @Html.Partial("~/Areas/Admin/Views/Lookups/_TransactionSourcePartial.cshtml", Model.TransactionCategories, new ViewDataDictionary { TemplateInfo = new TemplateInfo { HtmlFieldPrefix = Html.NameFor(model => model.TransactionCategories).ToString() } })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-4">
                    </div>
                    <div class="col-md-8 border_top_input">
                        <div class="col-md-4">
                            <label class="check">
                                @Html.CheckBoxFor(model => model.HasDate)
                                @Html.LabelFor(model => model.HasDate, new { @style = "padding-right:0" })
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="panel-footer middle">
        @Html.ActionButton(DbRes.TResource("Admin.Priority.Save"), "AddPriority", "dvGrid", null, null, "OnAddSuccess", null, "post", null, "btnAddPriority", "frmAddProirity", "btn btn-save pull-right")
        @Html.ResetButton("ClearInputs('AddProirityContent')")
    </div>
}
