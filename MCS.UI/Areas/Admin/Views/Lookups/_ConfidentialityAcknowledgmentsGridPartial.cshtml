@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@using MCS.GridMvc.Helpers;
@using MCS.GridMvc.Html;
@using MCS.Common;

@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<ConfidentialityAcknowledgmentsVM>
@{
    ViewBag.Title = "_ConfidentialityAcknowledgmentsGridPartial";
    Layout = null;
}


@Html.Grid(Model).Named("ConfidentialityAcknowledgments").Columns(columns =>
{
    columns.Add(model => model.Id).Css("hidden_");
    columns.Add(model => model.Description[0].Text, "DescriptionAr").Titled(DbRes.TResource("Admin.Lookups.ConfidentialityAcknowledgments.Name.ar"));
    columns.Add(model => model.Description[1].Text, "DescriptionEn").Titled(DbRes.TResource("Admin.Lookups.ConfidentialityAcknowledgments.Name.en"));
    columns.Add().Titled(DbRes.TResource("Admin.Link.Status")).RenderValueAs(model => MvcHtmlString.Create(model.IsActive ? DbRes.TResource("Admin.Link.Status.Active") : DbRes.TResource("Admin.Link.Status.Deactive")));
    columns.Add().Encoded(false).Sanitized(false).Css("").RenderValueAs(model =>
       MvcHtmlString.Create(
           "<div class='table-icon d-flex align-items-center'>" +
               (!model.IsLocked ?
               @Html.GridImageButton("GetConfidentialityAcknowledgments", "ConfidentialityAcknowledgments", 0, OperationType.Update, "dvEdit", null, null, "ShowEditDiv", "", "get") : MvcHtmlString.Empty) +
               (!model.IsLocked ?
               @Html.GridImageButton("DeleteConfidentialityAcknowledgments", "ConfidentialityAcknowledgments", 0, OperationType.Delete, "dvGrid", "EditConfidentialityAcknowledgmentsContent", null, "OnDeleteSuccess") : MvcHtmlString.Empty) +
            "</div>"));
}).WithPaging(GridHelper.PageSize)




<script>
    var token = $("#dvAdd input[name='__RequestVerificationToken']").val()
    var ConfidentialityAcknowledgmentsGridEventHandler = '@Url.Action("UpdateConfidentialityAcknowledgmentsGrid", "Lookups")';
    function prepareConfidentialityAcknowledgmentsGrid() {
            $(".grid-mvc").gridmvc();
            pageGrids.ConfidentialityAcknowledgments.ajaxify({
                getPagedData: ConfidentialityAcknowledgmentsGridEventHandler,
                requestType: "GET",
                getData: ConfidentialityAcknowledgmentsGridEventHandler
            });
        }

        $(document).ready(function () {
            prepareConfidentialityAcknowledgmentsGrid();
        });
</script>
