@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@using UserLookups = MCS.UI.Areas.User.Models.Lookups
@using MCS.Common
@model TransactionTypeEditVM
@{
    ViewBag.Title = "_TransactionSourceLookupAddPartial";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmEditTransactionType", @class = "form-horizontal form-row" }))
{
    @Html.AntiForgeryToken()
    <div id="EditTransactionTypeContent" class="panel-body">
        <p>@DbRes.TResource("Global.Forms.MandatoryFields")</p>

        <div class="row">
            <div class="col-md-4">

                @{List<UserLookups.CultureVM> cultureVMs = ViewData["Culture"] as List<UserLookups.CultureVM>;}

                @if (cultureVMs != null)
                {
                    for (int i = 0; i < cultureVMs.Count; i++)
                    {
                        <div class="form-group">
                            @Html.CustomLabelFor(model => model.Description[i].CultureName, new { @class = "col-md-4 control-label" }, DbRes.TResource("Admin.TransactionType.Description." + cultureVMs[i].ShortName))
                            @Html.StickyHiddenFor(model => model.Description[i].CultureId, new { Value = cultureVMs[i].Id })
                            @Html.HiddenFor(model => model.Description[i].Id)
                            <div class="col-md-8">
                                <div class="">
                                    @Html.TextBoxGroupFor(model => model.Description[i].Text, null, new { @class = "form-control" }, DbRes.TValidation("Admin.TransactionType.DescriptionRequired." + cultureVMs[i].ShortName))
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>
            <div class="col-md-4">
                @if (cultureVMs != null)
                {
                    for (int i = 0; i < cultureVMs.Count; i++)
                    {
                        <div class="form-group">
                            @Html.CustomLabelFor(model => model.Abbreviation[i].CultureName, new { @class = "col-md-4 control-label" }, DbRes.TResource("Admin.TransactionType.Abbreviation." + cultureVMs[i].ShortName))
                            @Html.StickyHiddenFor(model => model.Abbreviation[i].CultureId, new { Value = cultureVMs[i].Id })
                            @Html.HiddenFor(model => model.Abbreviation[i].Id)
                            <div class="col-md-8">
                                <div class="">
                                    @Html.TextBoxGroupFor(model => model.Abbreviation[i].Text, null, new { @class = "form-control" }, DbRes.TValidation("Admin.TransactionType.AbbreviationRequired." + cultureVMs[i].ShortName))
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>

            <div class="col-md-4" id="dvEditTreeContainer">
                <div class="form-group">
                    @Html.CustomLabelFor(model => model.ColorId, new { @class = "col-md-4 control-label" })
                    <div class="col-md-8">
                        @Html.AutoCompleteBuilder("ddlEditColor", "hdnEditColor", LookupCategory.Color, Model.ColorId.ToString(), true, "form-control")
                        @Html.HiddenGroupFor(model => model.ColorId, new { id = "hdnEditColor" })
                    </div>
                </div>
                @Html.PermissionsTree(ViewData["PermissionsGroups"] as TreeViewModel, model => model.PermissionId, TreeMode.Single, "frmEditTransactionType", Request.IsAjaxRequest())
            </div>
        </div>
    </div>
    @Html.HiddenFor(model => model.Id, new { id = "hdnEditId" })
    <div class="panel-footer middle">
        @Html.ActionButton(DbRes.TResource("Admin.TransactionType.Edit"), "EditTransactionType", "dvGrid", null, null, "OnEditSuccess", null, "post", null, "EditAdd", "frmEditTransactionType", "btn btn-save pull-right")
        <a class="btn-link pull-right" id="btnCancel" onclick="HideEditDiv()">@DbRes.TResource("Admin.TransactionType.Cancel")</a>
    </div>
}