@using MCS.Framework.Localization
@using MCS.UI.Areas.Admin.Models.Lookups
@using MCS.GridMvc.Helpers;
@using MCS.GridMvc.Html;
@using MCS.Common;

@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<SpecificLevelVM>
@{
    ViewBag.Title = "_TransactionTypeLookupGridPartial";
}

@Html.Grid(Model).Named("SpecificLevel").Columns(columns =>
{
    columns.Add(model => model.Id).Titled(DbRes.TResource("Admin.SpecificLevel.Id")).Css("hidden_");
    columns.Add(model => model.Description[0].Text, "DescriptionAr").Titled(DbRes.TResource("Admin.Lookups.PrivecyLevel.Name.ar"));
    columns.Add(model => model.Description[1].Text, "DescriptionEn").Titled(DbRes.TResource("Admin.Lookups.PrivecyLevel.Name.en"));
    //columns.Add(model => model.LocalName, "LocalizationIdentifier").Titled(DbRes.TResource("Admin.SpecificLevel.Description"));
    //columns.Add(model => model.TransactionCategory, "TransactionCategory").Titled(DbRes.TResource("Admin.SpecificLevel.TransactionCategories")).SetFilterWidgetType("CheckBoxFilterWidget");
    //columns.Add(model => model.Notify).Titled("مع اشعار").Encoded(false).Sanitized(false).Css("fixed_col notifyCheckBox").RenderValueAs(model => @Html.CheckBox("", model.Notify));
    //columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").RenderValueAs(model => @Html.GridImageButton("DeleteSpecificLevel", "SpecificLevel", 1, OperationType.Delete, "dvGrid", "", null, "OnDeleteSuccess"));
    //columns.Add().Encoded(false).Sanitized(false).Css("").RenderValueAs(model =>
    // MvcHtmlString.Create(
    //        "<div class='table-icon d-flex align-items-center'>" +
    //           @Html.GridImageButton("GetSpecificLevel", "SpecificLevel", 0, OperationType.Update, "dvEdit", null, null, "ShowEditDiv", "", "get")  +
    //           @Html.GridImageButton("DeleteSpecificLevel", "SpecificLevel", 0, OperationType.Delete, "dvGrid", "", null, "OnDeleteSuccess")  +
    //        "</div>")
    // );
}).WithPaging(GridHelper.PageSize)
<script>
     var token = $("#dvAdd input[name='__RequestVerificationToken']").val()
    var mySpecificLevelGridEventHandler = "@Url.Action("UpdateSpecificLevelGrid", "Lookups")?__RequestVerificationToken=" + token;
    function prepareSpecificLevelReportGrid() {
            $(".grid-mvc").gridmvc();
        pageGrids.SpecificLevel.ajaxify({
            getPagedData: mySpecificLevelGridEventHandler,
                requestType: "get",
            getData: mySpecificLevelGridEventHandler
            });
        }

        $(document).ready(function () {
            prepareSpecificLevelReportGrid();
        });

    $('.notifyCheckBox').click(function () {
        
        var specificLevelId = $($(event.currentTarget).closest('tr')[0]).find('.hidden_')[0].innerText;
        var operationType = $(event.currentTarget.childNodes[0]).is(":checked");
        $.ajax({
                type: 'get',
                url: '@Url.Action("UpdateSpecificLevelNotifyOption")',
            data: { specificLevelId: specificLevelId, operationType: operationType },
                success:
                    function (data) {
                        if (data.MessageType != 2) {
                            
                            ShowInformationMessage('تم التعديل');
                        } else {
                            
                            ShowErrorMessage('حدث خطأ');
                            event.preventDefault();
                        }
                    }
            });
    });
</script>

