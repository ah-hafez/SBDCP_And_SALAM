@using MCS.Framework.Localization;
@using MCS.UI.Areas.Admin.Models.Lookups
@using UserLookups = MCS.UI.Areas.User.Models.Lookups
@model FollowUpLookUpsEditVM
@{
    ViewBag.Title = "_FollowUpMethodEditPartial";
    Layout = null;
}

<div class="d-flex flex-column flex-md-row align-items-md-center flex-grow-1">
    <h3 class="site-color mb-4">تعديل وسائل المتابعة</h3>
</div>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmEditFollowUpMethod" }))
{
    @Html.AntiForgeryToken()
    <div id="EditFollowUpMethodContent" class="form-row">
        @{List<UserLookups.CultureVM> cultureVMs = ViewData["Culture"] as List<UserLookups.CultureVM>;}
        @if (cultureVMs != null)
        {
            for (int m = 0; m < cultureVMs.Count; m++)
            {
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    @Html.CustomLabelFor(model => model.Description[m].CultureName, new { @class = "" }, DbRes.TResource(string.Format("Admin.FollowUpMethod.Method.{0}", cultureVMs[m].ShortName)))<span class="stark">*</span>
                    @Html.StickyHiddenFor(model => model.Description[m].CultureId, new { Value = cultureVMs[m].Id })
                    @Html.HiddenFor(model => model.Description[m].Id)
                    @Html.TextBoxGroupFor(model => model.Description[m].Text, "", new { @class = "form-control" }, DbRes.TValidation("Admin.FollowUpMethod.FollowUpMethodRequired." + cultureVMs[m].ShortName))
                </div>
            }
        }
    </div>
    for (int i = 0; i < Model.TransactionCategories.Count(); i++)
    {
        @Html.StickyHiddenFor(model => model.TransactionCategories[i].Id)
        @Html.StickyHiddenFor(model => model.TransactionCategories[i].IsSelected, new { @Value = true })
    }
    @Html.HiddenFor(model => model.Id, new { id = "hdnEditId" })
}
<div class="mx-3 mx-md-5 mb-4 d-flex">
    <div class="ml-auto">
        @Html.ActionButton(DbRes.TResource("Admin.FollowUpMethod.Edit"), "EditFollowUpMethod", "dvGrid", null, null, "OnEditSuccess", null, "post", null, "btnEdit", "frmEditFollowUpMethod", "btn btn-lg btn-st3 mx-1")
        <a class="btn btn-lg btn-st3 mx-1" id="btnCancel" onclick="HideEditDiv()">@DbRes.TResource("Admin.TransactionLink.Cancel")</a>
    </div>
</div>