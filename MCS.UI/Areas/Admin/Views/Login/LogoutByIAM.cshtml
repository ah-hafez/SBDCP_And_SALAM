@model YESSER.NCS.MCS.UI.Areas.User.Models.Shared.LoginInfoVM
@using YESSER.NCS.Framework.Localization

@{
    ViewBag.Title = DbRes.TResource("User.Login.Title");
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
}

<div id="dvUserLoginContainer" class="login-container">
    @using (Html.BeginForm("Login", "Login", new { returnUrl = "" }, FormMethod.Get, new { id = "frmLogin", @class = "tab-content" }))
    {
        <div id="warningMessage" class="col-md-10 col-md-offset-1 col-xs-10 col-xs-offset-1 massage_login">

        </div>
        <div class="login-box animated fadeInDown">

            <div class="login-body">
                <div class="login-title"><strong>@DbRes.TResource("User.Login.Welcome")</strong>@DbRes.TResource("User.Login.PleaseEnter")</div>

                <div class="form-group">
                    <div class="col-md-4">
                    </div>
                    <div class="col-md-4">
                        <input type="submit" id="loginSubmit" class="btn btn-info btn-block" value="@DbRes.TResource("User.Login.Enter")" />
                    </div>
                </div>
            </div>
            <div class="login-footer">
                <div class="pull-right">
                    <a>@DbRes.TResource("User.Login.CopyRight")</a>  &copy; 1440
                </div>
            </div>
        </div>
    }
</div>
<script>
    $(document).on('keypress', function (e) {
        if (e.keyCode == 13 || e.which == 13) {
            $('#btnEnter').click();
        }
    });
</script>

