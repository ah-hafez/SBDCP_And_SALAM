@using MCS.UI.Areas.Admin.Models.UserCategories
@using MCS.Framework.Localization
@model UserCategoryTrayVM

<div class="row">
    <div class="title_intab">
        @DbRes.TResource("Admin.UsersTrays.Trays")
    </div>
    <div class="col-md-6">
        @if (Model != null)
        {
            for (var i = 0; i < Model.Trays.Count; i++)
            {
                <div class="row type" id="@Model.Id@Model.Trays[i].Id">
                    <label>
                        @*onclick="RemoveTag(@Model.Id@Model.Trays[i].Id,@Model.Id)"    icheckbox*@
                        @Html.CheckBoxFor(model => model.Trays[i].IsSelected, new { @class = "", @id = "check_" + @Model.Id + @Model.Trays[i].Id, @onchange = "RemoveTag(" + @Model.Id + @Model.Trays[i].Id + "," + @Model.Id + ")" })
                        @Html.HiddenFor(model => model.Trays[i].Id)
                        <span id="span_@Model.Id@Model.Trays[i].Id">@Model.Trays[i].LocalName</span>
                    </label>
                </div>
            }
        }
    </div>
    <div class="col-md-6">
        @if (Model != null)
        {
            <div id="tags_@Model.Id" class="list-tags">
                @for (var i = 0; i < Model.Trays.Count; i++)
                {
                    if (Model.Trays[i].IsSelected)
                    {
                        <span id="tag_@Model.Id@Model.Trays[i].Id" class="tag"><span>@Model.Trays[i].LocalName</span><a href="#" onclick="RemoveItem('@Model.Id@Model.Trays[i].Id')"></a></span>
                    }
                }
            </div>
        }
    </div>
</div>
