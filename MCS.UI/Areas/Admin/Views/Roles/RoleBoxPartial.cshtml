@using MCS.UI.Areas.Admin.Models.Groups
@model GroupVM
@using MCS.Framework.Localization


<div class="box-grid" id="box_@Model.Id">
    <div class="box no_sorting animated zoomIn buttons-action">
        <div class="correspondence-b d-flex flex-wrap">
            <div class="f-line w-full w-f-50">
                <div class="heading">اسم الدور</div>
                <div>@Model.LocalName</div>
            </div>
            @*<div class="f-line w-full w-f-50">
                    <div class="heading">مستخدمين الدور</div>
                    <div>لا يوجد مستخدمين</div>
                </div>*@
        </div>
        <div class="correspondence-icon d-flex">
            <div>
                <a class="circle color-blue" title=" @DbRes.TResource("Admin.User.Edit")" href="@(Url.Action("GetGroup" , "Permissions") + "?id=" + Model.Id)">
                    <i class="icon-outline-edit"></i>
                </a>
                @if (Model.IsActive)
                {
                    <a class="circle color-red" title=" @DbRes.TResource("Admin.User.Deactivate")" onclick="ShowCustomConfirmMessage('@DbRes.TValidation("Admin.Confirm.Activation")', 'ActivateDeactivateRole', '@Model.Id')">
                        <i class="icon-lamp-off"></i>
                    </a>
                }
                else
                {
                    <a class="circle color-orange" title=" @DbRes.TResource("Admin.User.Activate")" onclick="ShowCustomConfirmMessage('@DbRes.TValidation("Admin.Confirm.Activation")', 'ActivateDeactivateRole', '@Model.Id')">
                        <i class="icon-lamp"></i>
                    </a>
                }
                <a class="circle color-gray" title=" @DbRes.TResource("Admin.User.Delete")" onclick="ShowCustomConfirmMessage('@DbRes.TResource("Admin.Lookups.PriorityExceptions.ConfirmDelete")', 'DeleteRole', '@Model.Id')">
                    <i class="icon-delete"></i>
                </a>
            </div>
            <div class="ml-auto">
                @if (!Model.IsActive)
                {
                    <div class="text-danger">
                        <i class="icon-inactive "></i>
                        <span>@DbRes.TResource("Admin.Link.Status.Deactive")</span>
                    </div>
                }
                else
                {
                    <div class="text-success">
                        <i class="icon-check-right"></i>
                        <span>@DbRes.TResource("Admin.Link.Status.Active")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
