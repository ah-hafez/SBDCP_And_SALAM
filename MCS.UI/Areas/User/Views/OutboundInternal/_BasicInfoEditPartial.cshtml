                $('.RecordNumber').show();
            }
            else {
                $('.RecordNumber').hide();
            }
        });
    });

     $(document).ready(function () {
        if ($("#LetterNumber").val() != '') {
            $('.LetterNumber').show();
        }

        $("#ddlTypeId").change(function () {

            $.ajax({
                type: 'get',
                url: '@Url.Action("GetLetterTypeById")',
