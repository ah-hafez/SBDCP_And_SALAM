<script>
    var EditorPartialStorage;


    function PrepareEditorContainer() {
        $("#dvDocumentViewerEditorContainer").html($("#dvEditorPartialContainer").html());
        $("#dvEditorPartialContainer").html("");
        if (EditorPartialStorage == "" || EditorPartialStorage === undefined) {
            EditorPartialStorage = $("#dvDocumentViewerEditorContainer").html();
        }
        else {
            $("#dvDocumentViewerEditorContainer").html(EditorPartialStorage);
        }
    }

    $(document).on("BarcodeButtonPopupClicked", function (event, param) {
        ShowPrintDialog();
    });

    $(document).on("AddArchiveButtonPopupClicked", function (event, param) {

        editUrl = "@Url.Action("Edit", "OutboundInternal")";

        if (!(/\d/.test(editUrl))) {
            editUrl += "?id=" + $("#EncryptedModelId").val();
        }

        window.location.href = editUrl;
    });
        function CheckUserHasPermission()
    {
        debugger;
        var form = $("#frmEditorAssignment").serialize();
         $.ajax({
                type: 'post',
                url: '@Url.Action("CheckUserHasPermission", "File")',
               data: form,
               success:
                   function (data)
                   {
                       switch (data.MessageType)
                       {
                           case 0:
                               return true;
                           case 1:
                               return ShowConfirmMessage(data.MessageText,"ContinueAssigneTransaction");
                               break;
                           case 1:
                               // code block
                               ShowErrorMessage(data.MessageText);
                               return false;
                           default:
                               ShowErrorMessage(data.MessageText);
                               return false;
                       }

               }
            });
    }

    $(document).on("MoveToAssignmenPopupClicked", function (event, param) {
        debugger;
        var DirectedToId;
        if ($("#hdnDirectedToId").val() == '' || $("#hdnDirectedToId").val() == undefined)
            DirectedToId = '-1'
        else
            DirectedToId = $("#hdnDirectedToId").val()

        var outboundExternalId = $("#hdnOutboundInternalId").val();
        var token = $("input[name='__RequestVerificationToken']").val();

                    $.ajax({

                    url: '@Url.Action("SendAssignmentByTransaction")',
                    data: {
                        hdnTransactionId: outboundExternalId,
                        DirectedToOrgUnitId: $("#OutboundInternalBasicInfoEdit_DirectedToOrgUnitId").val() ,
                        DirectedToId: DirectedToId,
                        DeliveryMethodId: $("#hdnBasicDeliveryMethod").val(),
                        isConfirmed: $("#isConfirmedId").val(),
                        __RequestVerificationToken: token,
                    },
                        success: function (data)
                        {
                            debugger;
                            switch (data.MessageType) {
                                case 0:
                                    break;
                                case 1:
                                    return ShowConfirmMessage(data.MessageText, "ContinueAssigneTransaction");
                                    break;
                                default:
                                    return ShowErrorMessage(data.MessageText);

                            }

                            if (data.MessageType != 2) {
                               window.location.href = '@Url.Action("MyTransactions", "File")';
                            }
                            else {
                              debugger;
                            ShowErrorMessage(data.MessageText);
                            }
                        }
                    });
                });


    function ContinueAssigneTransaction()
    {

        $("#isConfirmedId").val(true);
        MoveToAssignmenTransaction();

    }
    function ReturnToMyTransactionTray() {
        window.location.href = '@Url.Action("MyTransactions", "File")';
    }

        $(document).on("NewButtonPopupClicked", function (event, param) {
        window.location.href = '@Url.Action("Add", "OutboundInternal")';
    });
    $(document).on("RedirectToTrayButtonPopupClicked", function (event, param) {
        window.location.href = '@Url.Action("MyTransactions", "File")';
    });
    $(document).on("AssignButtonPopupClicked", function (event, param) {
        assignTransAjax();
    });
    $(document).on("GetPreviousPopupClicked", function (event, param) {
        getPreviousTransaction();
    });

    var _url = null;
    var urlDeliveryReport;

    function getPreviousTransaction() {
        window.location.href = '@Url.Action("AddPrevious","OutboundInternal")';
    }

    function assignTransAjax() {
        var data = $('#dvBasicInfo :input').serializeArray();
        var token = $("#frmAddOutboundInternal").find("input[name='__RequestVerificationToken']").val();
        data.push({ name: 'hdnTransactionId', value: $('#hdnOutboundInternalId').val() });
        data.push({ name: 'type', value: '@TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)' });
        data.push({ name: 'chkboxFollowUp', value: $('#chkboxFollowUp').prop('checked') });
        data.push({ name: '__RequestVerificationToken', value: token });
        $.ajax({
            type: 'post',
            cache: false,
            url: '@Url.Action("AssignTrans", "OutboundInternal")',
            data: data,
            success:
                function (data, textStatus, request) {
                    if (typeof data.errorOccurred != "undefined") {
                        if (data.errorOccurred == true && data.url != null) {
                            window.location.href = data.url;
                            return;
                        }
                    }
                    else {

                        if (data.ReportsIds) {
                            PrintTransactionsDeliveryReport(data.ReportsIds);
                        }
                        else {
                            reloadPage();
                        }
                    }
                },
            error: function (data) { }
        });
    }

    function Reload() {
        location.reload();
    }

    //$(function () {
    //    $("#ddlDirectedToId").prop('disabled', true);
    //});

    function OnGetPreviousSuccess(data, div) {
        if (data.MessageType != 2) {
            if (data.UserHasTransactions) {
                $("#" + div).html(data.Html);
                jQuery.validator.unobtrusive.parse('#' + div);
                if ($("#HasDateCal").val() != "") {
                    $('#datePicker').show();
                }
                if ($('#hdnPriorityHasDate').val() === "true") {
                    $("#dvHasDateContainer").show();
                    $('#ddlHour').val($('#hdnHour').val());
                    $('#ddlHour').trigger("focusout");
                    if ($('#hdnMinute').val().length == 1) {

                        $('#ddlMinute').val("0" + $('#hdnMinute').val());
                        $('#ddlMinute').trigger("focusout");
                    }
                    else {
                        $('#ddlMinute').val($('#hdnMinute').val());
                        $('#ddlMinute').trigger("focusout");
                    }
                }
                PrepareEditorContainer();
                isCopyPrevious = true;
                tinymce.remove();
                InitTinymce();
            }
            else {
                ShowInformationMessage(data.MessageText);
            }
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }


    function ResetAutoCompleteDeliveryMethod() {
        AutoCompleteChangeList("ddlBasicDeliveryMethod", "[]");
        ShowHideReporterContent(false);
    }

    function PrintTransactionsDeliveryReport(ReportsIds) {
        var reporterName = $('#ddlBasicReporter').val();
        var deliveryReportArray = [];
        var newTransactionId = $('#hdnOutboundInternalId').val();
        var result = JSON.parse(ReportsIds);

        for (var i = 0; i < result.length; i++) {
             deliveryReportArray.push({ TransactionId: newTransactionId, ReportsIds: [result[i]] });
        }
        var reportType = @((int)DeliveryReportType.DeliveryReport);
        var parameters = '?transactionReportInfo=' + JSON.stringify(deliveryReportArray) + '&isPerTransaction=true&group=false&reportType=' + reportType + '&reporterName=' + reporterName;
        urlDeliveryReport = '@Url.Action("PrintDeliveryReportsByIds", "Reports")' + parameters
        PrintReport(urlDeliveryReport, '', reloadPage);
    }

    function reloadPage() {
        setTimeout(function () {
            window.location.href = '@Url.Action("MyTransactions", "File")';
        }, 3000);
    }

</script>
