@{


    Layout = "~/Areas/User/Views/Shared/_SearchLayout.cshtml";
    var attachmentVM = new TransactionAttachmentVM
    {
        Attachments = (AjaxGrid<TransactionAttachmentVM>)new AjaxGridFactory()
        .CreateAjaxGrid(Model.Attachments, 1, Model.Attachments.Count, false)
    };
    var nameVM = new TransactionNameVM
    {
        Names = (AjaxGrid<TransactionNameVM>)new AjaxGridFactory()
        .CreateAjaxGrid(Model.Names, 1, Model.Names.Count, false)
    };
    var linkVM = new TransactionLinkVM
    {
        Links = (AjaxGrid<TransactionLinkVM>)new AjaxGridFactory().
        CreateAjaxGrid(Model.Links, 1, Model.Links.Count, false)
    };
    var followUpVM = new TransactionFollowUpVM()
    {
        FollowUps = (AjaxGrid<TransactionFollowUpVM>)new AjaxGridFactory()
        .CreateAjaxGrid(Model.FollowUps, 1, Model.FollowUps.Count, false)
    };
    var assignmentVM = new TransactionAssignmentVM { ToOrgUnitId = SessionInfo.OrgUnitId };

    var EditMode = SessionInfo.CurrentUser.Claims.Contains(UserClaims.Outbound.EditInternalOutbound);
    ViewBag.Title = DbRes.TResource("User.OutboundInternal.EditTitle");
    bool barCodePermission = SessionInfo.CurrentUser.Claims
        .Contains(UserClaims.PopUpWindowData.Internal_PrintBarCode) &&
                  SessionInfo.CurrentUser.Claims.Contains(UserClaims.GeneralPermissions.PrintEncryptionCode);

    string transactionId = ViewData["TransactionId"].ToString();
    bool isEditMode = true;
    Session["IsEditMode"] = isEditMode;

    List<ExplanationVM> explanations = ViewData["ExplanationsData"] as List<ExplanationVM>;
    var tasks = ViewData["Tasks"] as TaskAddVM;


    var LinkCount = Model.Links.Count;
    var FollowupCount = Model.FollowUps.Count;
    var ExplaintionCount = explanations.Count;
    var TasksCount = tasks.TasksGrid.ItemsCount;
    var NameCount = Model.Names.Count;
    string controllerName = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();


}
