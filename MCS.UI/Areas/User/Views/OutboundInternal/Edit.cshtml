<script>
    $(document).ready(function () {
        window.textEditorSingature = '@Session["textEditorSignature"]';
        $("#dvDocumentViewerEditorContainer").html($("#dvEditorPartialContainer").html());
        $("#dvEditorPartialContainer").html("");
        $("#hdnOutboundInternalId").val('@Model.Id');

        @*if ('@Model.defaultTabId' != null) {
            $("#@Model.defaultTabId").click();
        }*@

        $('#draftAnchor').click(function () {
            var trxId = EncryptionKey('@Model.Id');

            @*var outboundUlr = '@Url.Action("Add", "OutboundExternal")?baseTransactionId =' + trxId + '&isOutboundInternal = true")';
            window.open("@Html.Raw(outboundUlr)", '_self').focus();*@
            window.open("@Url.Action("Add", "OutboundExternal")?baseTransactionId=" + trxId + "&isOutboundInternal=true", '_self').focus();
        })

        $('#navigateToEditor').click(function () {
             var trxId = EncryptionKey('@Model.Id');
            window.open("@Url.Action("Editor", "OutboundInternal")?id" + trxId, '_blank').focus();
        })

        $('#btnDirectReply').click(function () {
            var token = $('form:first').find("input[name='__RequestVerificationToken']").val();

            var replyTxtAreaContent = $('#replyTxtArea').val();
            if (replyTxtAreaContent.length == 0) {
                $('#replyValidationlabel').show();
            } else {
                $('#replyValidationlabel').hide();

                $.ajax({
                    type: 'Post',
                    url: '@Url.Action("TransactionDirectReply", "OutboundInternal")',
                    data: { transactionId: @Model.Id, remarks: replyTxtAreaContent, __RequestVerificationToken: token },
                    success: function (data) {
                        if (data.MessageType != 2) {
                            if (data.result == false) {
                                ShowErrorMessage('المعاملة عند نفس المستخدم بالفعل.');
                                return;
                            }
                            window.location.href = '@Url.Action("MyTransactions", "File")'
                        }
                        else {
                            ShowErrorMessage(data.MessageText);
                        }
                    }
                });
            }
        });

        EnableDisableControls();

    });
    function goToDraft() {

          var trxId = EncryptionKey('@Model.Id');

            @*var outboundUlr = '@Url.Action("Add", "OutboundExternal")?baseTransactionId =' + trxId + '&isOutboundInternal = true")';
            window.open("@Html.Raw(outboundUlr)", '_self').focus();*@
            window.open("@Url.Action("Add", "OutboundExternal")?baseTransactionId=" + trxId + "&isOutboundInternal=true", '_self').focus();
    }
    function EnableDisableControls() {
        var editMode = '@EditMode';
        if (editMode.toLowerCase() != 'true') {
            $("#dvBasicInfo .BasicInfo .disableByPrivilege").prop("disabled", true);
            $("#dvBasicInfo .BasicInfo .readonlyByPrivilege").prop("readonly", true);

        }
    }

    $("#rejecttrans, #transactionAssigments, #assignmentPaper").click(function () {
        $(".save").hide()
    });
        $("#transactionChats, #basicInfo, #first, #anchorArchiving, #transactionNames, #transactionLinks, #transactionCopies, #electronicCopies, #explanations ").click(function () {
            $(".save").show()
        });
        $("div.anchor a").click(function () {
            $("div.anchor a").removeClass("active");
            $("div.anchor a").addClass("disabled");
            $(this).addClass("active");
            var id = $(this).data("id");
            $("#" + id).addClass("active");
            $(".tabscontent").addClass("hidden_");

            var divId = $(this).data("divid");
            $("#" + divId).removeClass("hidden_");

            if (divId == "thirteen-tab" || divId == "second-tab" || divId == "twelve-tab") {
                $('#dvButtonFooter').hide();
            }
            else {
                $('#dvButtonFooter').show();
            }

            if ($(this).data("id") == 'outboundDraft') {
                GetOutboundDraft();
            }

        });

        $("ul li a").click(function () {
            var tabId = $(this).attr("aria-controls");

            if (tabId != undefined && tabId.trim() != '') {
                //$('ul li').removeClass('active');
                //$(this).parent().addClass("active");

                $(".tab-pane").hide();
                $("#" + tabId).removeClass('hidden_');
                $("#" + tabId).show();
            }
        });

    function OnAddReporterSuccess(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText)
            ClearInputs('frmAddReporter');
            __dialog.close();
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

     function AddReporter() {
        __dialog = $.confirm({
            title: false,
            content: function ($obj) {
                return $.ajax({
                    url: '@Url.Action("AddReporter", "Shared")',
                    type: 'GET',
                    cache: false,
                    success: function (data) {
                        $obj.setContent(data.Html);
                        jQuery.validator.unobtrusive.parse('#frmAddReporter');
                    }
                });
            },
            onOpen: function () {
                jQuery(function () {
                    jQuery('.jconfirm-box').draggable({
                        revert: false,
                    });
                });
                $("#Loader").hide();
            },
            onClose: function () {
                GetAllReporter();
            },
            confirmButton: false,
            icon: 'fa fa-info',
            animation: 'scale',
            columnClass: "dialogbox col-md-8 col-md-offset-2 col-xs-8 col-xs-offset-2",
            backgroundDismiss: false,
            closeIcon: true,
            cancelButton: false
        });
    }

     function PrintTransaction(TransactionId) {
         var Number = $('#hdnNumber').val();
       @*var url= '@Url.Action("GetTransactionExplanationsForPrint", "Editor")' + '?transactionId=' + TransactionId

        ShowDialog(url, 'dialogbox col-md-12 ');*@

        //var data = { transactionId: TransactionId  ,__RequestVerificationToken: token };
        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("PrintTransaction", "Shared")' + '?transactionId=' + TransactionId + "&transactionNumber=" + Number,
            //data: data,
            cache: false,
            success:

                function (data) {
                    if (data.MessageType != 2) {
                        var TransactionWindow = window.open('', '_blank', 'width=900,height=500');

                        TransactionWindow.document.write(data);
                        TransactionWindow.document.close();
                        TransactionWindow.focus();

                        //setTimeout(function () {
                        //    TransactionExplanationsWindow.print();
                        //    TransactionExplanationsWindow.close();
                        //}, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }
     function GetAllReporter() {
        $.ajax({
            cache: false,
            type: 'get',
            url: '@Url.Action("GetReporters")',
            success: function (data) {
                AutoCompleteChangeList("ddlBasicReporter", data);
                AutoCompleteChangeList("ddlBasicReporterAssinment", data);
                AutoCompleteChangeList("ddlAssignmentPaperReporter", data);
                AutoCompleteChangeList("ddlRejectBasicReporter", data);
                var newItems = $.parseJSON(data);
                var lastItem = newItems.slice(-1)[0].value;
                $('#hdnBasicReporter').val(lastItem);
                $('#hdnBasicReporter').trigger('change')
            }
        });
    }

    function SetSuggestedTopic() {
        $("#txtAreaSubject").val($("#divForm__dvSuggestedTopicTree .txtDepartmentName").val());
