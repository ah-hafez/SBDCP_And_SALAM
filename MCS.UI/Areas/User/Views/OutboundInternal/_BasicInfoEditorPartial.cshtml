                <div>
                    @Html.Partial("~/Areas/User/Views/Transaction/_CopiesPartial.cshtml", copyVMs)
                </div>
            }

            <br />
            @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.CopiesExternal.DisplayLink))
