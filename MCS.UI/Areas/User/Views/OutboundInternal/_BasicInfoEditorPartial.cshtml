    <div class="row"> <div class="col-lg-12"><br /></div></div>

    <div>

        <div class="extraOption">
            <h4>
                <a role="button" style="display:flex">
                    <span onclick="CollapseDiv('divArchiving'); return false;" style="cursor: pointer;">
                        <img src="~/Content/User/lib/images/plus-icon.svg" id="divArchivingPlusIcon" width="25" />
                        <img src="~/Content/User/lib/images/Dash-icon.svg" id="divArchivingDashIcon" width="25" style="display: none;" />
                    </span>
                    <span class="ml-3 mt-1">@DbRes.TResource("User.Transaction.BasicInfo.Attachments")</span>
                </a>
            </h4>
            <div role="tabpanel" class="tab-pane" id="divArchiving" style="display:none">
