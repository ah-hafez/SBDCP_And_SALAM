    function GetDirectedToUsersByOrgUnitId() {
        if ($("#OutboundInternalBasicInfoEdit_DirectedToOrgUnitId").val() != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId")',
                data: { id: $("#OutboundInternalBasicInfoEdit_DirectedToOrgUnitId").val() },
                success:
               function (data) {
                   $("#ddlDirectedToId").val("");
                   $("#hdnDirectedToId").val("");
                   AutoCompleteChangeList("ddlDirectedToId", data);
                   $("#ddlDirectedToId").prop('disabled', false);
               }
            });
            return false;
        }
        else {
            $("#ddlDirectedToId").prop('disabled', true);
            $("#ddlDirectedToId").val("");
            $("#hdnDirectedToId").val("");
            AutoCompleteChangeList("ddlDirectedToId", "[]");
        }
    }



