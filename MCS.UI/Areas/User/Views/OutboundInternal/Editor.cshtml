    function OnSuccess(data) {

        if (data.MessageType != 2) {
            if (data.IsPopularization != false)
            {
                $("#transactionAssigments").hide();
                $("#ulTabs").addClass("steps_4");
                $("#ulTabs").removeClass("steps_5");
            }

            if (data.ArchivingHtml) {
                $("#grid-table-grdArchiving > tbody > .grid-empty-text").remove();
                $("#grid-table-grdArchiving > tbody > tr").remove();
                $("#grid-table-grdArchiving > tbody:last").append(data.ArchivingHtml);
            }

            if (data.AttachmentHtml) {
                $("#grid-table-grdAttachments > tbody > .grid-empty-text").remove();
                $("#grid-table-grdAttachments > tbody > tr").remove();
                $("#grid-table-grdAttachments > tbody:last").append(data.AttachmentHtml);
            }
            if (data.ExternalCopiesHtml) {
                $("#grid-table-grdExternalCopies > tbody > .grid-empty-text").remove();
                $("#grid-table-grdExternalCopies > tbody > tr").remove();
                $("#grid-table-grdExternalCopies > tbody:last").append(data.ExternalCopiesHtml);
            }
            refreshDoconut();
            ShowSuccesMessage(data.MessageText, 'Redirect');
            UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');

            if (typeof BindRoomsToTransaction != 'undefined') {
                BindRoomsToTransaction($('#hdnTransactionId').val());

            }
        }
        else {

            ShowErrorMessage(data.MessageText);
        }
        $('#officeIframe').hide();
      //  window.location.reload();
    }
    function doReload() {
        window.location.reload();
    }

