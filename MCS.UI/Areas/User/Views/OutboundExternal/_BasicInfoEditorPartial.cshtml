<script>
   
    $(document).ready(function () {
       

        var frameViewerAttachmentUrl = $('#frameViewerAttachment').prop('src');

        $("#frameViewerAttachmentForArchiving").attr("src", frameViewerAttachmentUrl);

        $("input[id^='IdArchiving_']").each(function () {
            let text = $(this).attr('id');
            const myArray = text.split("_");
            var IdArchiving = myArray[1];
            var documentId = myArray[2];
            var key = myArray[3]
            var headerText = myArray[5];
            var IsArchivalbe = myArray[4]
            if (IsArchivalbe == "True" || IsArchivalbe == "true") {
                debugger
                $("#IncludeArchivingSections").append('<div onclick="return ShowArchiviableData(' + IdArchiving + ',' + documentId + ',' + key + ')"  class="dv"><h5>' + headerText + ' </h5></div>');
            }
        });

        onChangeDeliveryMethod();
        
    });


    $(document).on("click", "span[data-node-id]", function () {
        var elemnt = $(this);
        if ($(this).hasClass('fa-plus') && $(this).hasClass('LoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetExternalPartyNodes")',
                data: { parentId: $(this).data("node-id"), letterId: $("#hdnOutboundExternalDocumentType").val(), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
                    function (data) {
                        $(elemnt).closest('li').children('ul').last().empty()

                        $(elemnt).closest('li').children('ul').last().append(data);

                        if ($(elemnt).attr('data-isRefreshEnabled').toLowerCase() == 'false') {

                            $(elemnt).removeClass("LoadedData")
                        }

                    }
            });
        }
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsNodes")',
                data: { parentId: $(this).data("node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
                    function (data) {

                        $(elemnt).closest('li').children('ul').last().empty()

                        $(elemnt).closest('li').children('ul').last().append(data);

                        $(elemnt).removeClass("InternalLoadedData");
                    }
            });
        }
    });
    $(document).on("click", "span[data-multi-node-id]", function () {
        var elemnt = $(this);

        if ($(this).hasClass('fa-plus') && $(this).hasClass('LoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetExternalPartyMultyNodes")',
                data: { parentId: $(this).data("multi-node-id"), letterId: $("#hdnInboundDocumentType").val(), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func'), checkboxFunction: "ExternalCheckboxChange" },
                success:
               function (data) {
                   $(elemnt).closest('li').children('ul').last().empty()

                   $(elemnt).closest('li').children('ul').last().append(data);

                   if ($(elemnt).attr('data-isRefreshEnabled').toLowerCase() == 'false') {

                       $(elemnt).removeClass("LoadedData")

                   }

               }
            });
        }
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsMultiNodes")',
                data: { parentId: $(this).data("multi-node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
               function (data) {
                   $(elemnt).closest('li').children('ul').last().empty()

                   $(elemnt).closest('li').children('ul').last().append(data);

                   $(elemnt).removeClass("InternalLoadedData");
               }
            });
        }
    });

    $(document).on("click", "#UserTransactionEditorSelectScannerForArchiving", function () {
        $(".dvScanningDataForArchivingSection").show();
        $('#dvScanningArchiving').hide();
    });

    function ShowHideReporterContent(isShow) {
        if (isShow) {
            $('#ReporterContent').removeClass('hide');
        } else {
            $('#ReporterContent').addClass('hide');
        }
    }

    function AddExternalParty() {
        $(document).ready(function () {
            onChangeDeliveryMethod();
        });
    }

    function onChangeDeliveryMethod() {
        var value = $('#hdnBasicDeliveryMethod').val();
        switch (parseInt(value)) {
            case DeliveryMethodType.Paper:
                ShowHideReporterContent(true);
                break;
            case DeliveryMethodType.Electronic:
                ShowHideReporterContent(false);
                break;
            case DeliveryMethodType.ElectronicPaper:
                ShowHideReporterContent(true);
                break;
            default:
        }
    }


    function AddExternalParty() {
        var token = $("#frmEditOutboundExternal").find("input[name='__RequestVerificationToken']").val();
        ShowDialogAjax('@Url.Action("AddNewExternalPartyForTransaction")',
            {
                treeName: "dvDestinationTree",
                onAddPartyfuntion: "GetExternalParties",
                __RequestVerificationToken: token
            }, 'OpenExternalPartyDialogSuccess', 'dialogbox col-md-12 ');
    }

    $(document).on("change", "#radio1", function () {
        if ($(this).val() == 0) {
            $('#hdnHasDateUm').val("");
            $('#hdnHasDateGreg').val("");
            $('#hdnMinute').val("");
            $('#hdnHour').val("");
            $('#datePicker').hide();
            $("#CalMessage").html('');
            $("#CalMessage1").addClass("hidden_");
        } else {
            $('#datePicker').show();
            $('#hdnHasDateGreg').val('@Model.RemindDate')
            $('#hdnHour').val('@Model.Hour')
            $('#hdnMinute').val('@Model.Minute')
            FillDateAndTime();
        }
    });
    function SetSuggestedTopic() {
        $("#txtAreaSubject").val($("#divForm__dvSuggestedTopicTree .txtDepartmentName").val());
    }

    function GetEditorUsersByPreparationEntityId() {
     
        if ($("#divForm__treeSignedByOrgUnitId").find(".hdnDepartmentId").val() != "" && $("#divForm__treeSignedByOrgUnitId").find(".hdnDepartmentId").val() !=undefined) {

            $.ajax({
                type: 'Get',
                url: '@Url.Action("GetUnitUsers","Editor")',
                data: { id: $("#divForm__treeSignedByOrgUnitId").find(".hdnDepartmentId").val() },
                success:
               function (data) {

                   AutoCompleteChangeList("ddlEditorSignedByUserId", data);

                   $("#ddlEditorSignedByUserId").val('');
                   $("#hdnEditorSignedByUserId").val('');
               }
            });
            return false;
        }
        else {

            AutoCompleteChangeList("ddlEditorSignedByUserId", "[]");

            $("#ddlEditorSignedByUserId").val('');
            $("#hdnEditorSignedByUserId").val('');

        }
    }

