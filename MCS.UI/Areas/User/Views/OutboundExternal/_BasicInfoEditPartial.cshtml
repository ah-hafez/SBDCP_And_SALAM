<script>
    var mainReportId;
function getMainTransactionReportId() {
    return new Promise(function (resolve, reject) {
        var outboundExternalId = $("#hdnOutboundExternalId").val();
        var token = $("#frmAddOutboundExternal").find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetDeliveryReportByTransactionIdV2", "OutboundExternal")',
            data: {
                transactionId: outboundExternalId,
                type: '@TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)',
                __RequestVerificationToken: token,
                isConfirmed: $("#isConfirmedId").val(),
            },
            success: function (data) {
                debugger;
                mainReportId = JSON.parse(data.ReportsIds);
                resolve(); 
            },
            error: function (err) {
                reject(err);
            }
        });
    });
}

async function PrimaryPrintTransactionsDeliveryReportV2() {
    debugger;
    try {
        await getMainTransactionReportId();

        deliveryReportArray = [];

        var transactionId = $("#hdnOutboundExternalId").val();


        mainReportId.forEach(function (id) {
            deliveryReportArray.push({
                TransactionId: transactionId,
                ReportsIds: [id]
            });
        });

        if (deliveryReportArray.length !== 0) {
            var showDialog = deliveryReportArray.some(function(report) {
                return report.ReportsIds.length > 1;
            });

            var radioType = 1;
            var reporterName = $('#ddlBasicReporter').val();
            var urlDeliveryReport = '@Url.Action("PrintDeliveryReportsByIds", "Reports")' +
                '?transactionReportInfo=' + JSON.stringify(deliveryReportArray) +
                '&isPerTransaction=false&group=' + true +
                '&reportType=' + radioType +
                '&reporterName=' + reporterName +
                '&printCount=' + 1;

            PrintReport(urlDeliveryReport);
        }
    } catch (error) {
    }
}


