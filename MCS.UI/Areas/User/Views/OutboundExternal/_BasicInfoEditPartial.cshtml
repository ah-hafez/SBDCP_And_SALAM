<script>

     $(document).ready(function () {
        $('#HasDateCal').attr('autocomplete', 'off');
        $('#datePicker').hide();
        if ($("#HasDateCal ").val() != "") {
            $('#datePicker').show();
            $('#radio1').attr('checked', true);
        }
        $("#hdnMinute").val('@Model.Minute');
        $("#hdnHour").val('@Model.Hour');
        $('#ddlHour').val($("#hdnHour").val());
        $('#ddlMinute').val($("#hdnMinute").val());

    });

    $(document).on("change", "#radio1", function () {
        if ($(this).val() == 0) {
            $('#datePicker').hide();
            $("#CalMessage").html('');
            $("#CalMessage1").addClass("hidden_");
        } else {
            $('#datePicker').show();
        }
    });



    $(document).ready(function () {

        $('#HasDateCal').attr('autocomplete', 'off');

        if ($('#hdnHasDateGreg').val() == "") {
            $('.withoutAppointment').trigger('change');
            $('.withoutAppointment').attr('checked', 'checked');
        } else {
            FillDateAndTime();
        }

        $('#ddlEditorDraftSourceType').attr("disabled", true);
        $('.iradioOutboundType').attr("disabled", true);
        $('#ddlTransactionSourceType').attr("disabled", true);

        if ($("input[id='OutboundDraft']").is(':checked')) {
            $('#ddlBasicDeliveryMethod').attr("disabled", 'disabled');
            $('#ddlBasicReporter').attr("disabled", 'disabled');
            $('#divPreparationEntityId').hide();
        }
        else {
            $('#ddlBasicDeliveryMethod').removeAttr("disabled");
            $('#ddlBasicReporter').removeAttr("disabled");
            $('#divPreparationEntityId').show();
        }

        if ($('#hdnOutboundExternalUserId').val() != '@SessionInfo.CurrentUser.Id') {
            $('#ddlTransactionPath').attr('disabled', true);
        }
    });

    $(document).on("change", "#ddlHour", function () {

        $('#hdnHour').val($('#ddlHour').val());
    });

    $(document).on("change", "#ddlMinute", function () {

        $('#hdnMinute').val($('#ddlMinute').val());
    });

    function FillDateAndTime() {
        $(".withAppointment").click();
        $('#ddlHour').val($('#hdnHour').val());
        if ($('#hdnMinute').val() != undefined) {
            if ($('#hdnMinute').val().length == 1) {

                $('#ddlMinute').val("0" + $('#hdnMinute').val());
            }
            else {
                $('#ddlMinute').val($('#hdnMinute').val());
            }
        }

    }
    function CheckPriorityIfHasDate()
    {
        if ($('#datePicker').css('display') == 'block' && $("#hdnHasDateGreg").val() == "") {
            $("#CalMessage1").removeClass("hidden_");
                    $("#CalMessage1").show();
             $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateRequired"))');
            return false;
        }
        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        if ($("#hdnHasDateGreg").val() != "") {

            if ($("#hdnHasDateGreg").val() != undefined) {
                 var selectedDate = convertdate($("#hdnHasDateGreg").val());

                if (selectedDate < currentDate) {
            $("#CalMessage1").removeClass("hidden_");
                    $("#CalMessage1").show();
                    $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateCompare"))');
                return false;
                }
            }
        }
        if ($('#datePicker').css('display') == 'block' && ($('#ddlMinute').val() == "" || $('#ddlHour').val() == "")) {
            $("#CalMessage1").removeClass("hidden_");
                    $("#CalMessage1").show();
              $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindTime"))');
            return false;
        }


        if ($('#datePicker').css('display') == 'block' && ($('#ddlMinute').val() != "" && $('#ddlHour').val() != "")) {
            var time = new Date();
            if (convertdate($("#hdnHasDateGreg").val()) > currentDate) {
                $("#CalMessage").html("")
                return true;
            }
            else if ($("#hdnHasDateGreg").val() > convertdate($("#hdnHasDateGreg").val())) {
                $("#CalMessage").html("")
                return CheckIfHasInboundDate();
            }
            else if ($('#ddlHour').val() > time.getHours()) {
                $("#CalMessage").html("")
                return CheckIfHasInboundDate();
            }
            else if ($('#ddlHour').val() == time.getHours() && $('#ddlMinute').val() > time.getMinutes()) {
                $("#CalMessage").html("")
                return CheckIfHasInboundDate();
            }
            else {
                 $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.WrongRemindTime"))');
                 return false;
            }
        }
        if ($("#DivtxtControls").html() != '' && $("#DivtxtControls").html() != undefined)
        {

            TXTextControl.saveDocument(TXTextControl.streamType.WordprocessingML, function (e)
            {

                $("#hdnBinaryDocument").val(e.data);

            });

        }
         if (!ValidateCopy()) {
            return false;
        }

        return true;
    }

    function GetExternalParties(selectedNode) {
        $("#divForm__dvDestinationTree").find(".hdnDepartmentId").val(selectedNode);

        $.ajax({
            cache: false,
            type: 'get',
            url: '@Url.Action("GetExternalParties")',
            data: {
                selectedParty: selectedNode },
            success:
                function (data) {

                    if ($('#divContainer__dvDestinationTree').css('display') == 'block') {

                        ShowHideTree('#divContainer__dvDestinationTree');
                    }

                    $('#divContainer__dvDestinationTree').remove();

                    $("#divContainerExternalParties").html("");

                    $("#divContainerExternalParties").html(data);

                    GetUsersByPartyId();
                }
        });
        return false;
    }
    $(document).ready(function () {
        if ($("#LetterNumber").val() != '') {
            $('.LetterNumber').show();
        }

        $("#ddlOutboundExternalDocumentType").change(function () {

            $.ajax({
                type: 'get',
                url: '@Url.Action("GetLetterTypeById")',
                data: { letterTypeId: $("#hdnOutboundExternalDocumentType").val()},
                success:
                    function (data) {
                        if (data.WithExtraField) {
                            $('.LetterNumber').show();
                        }
                        else {
                            $('.LetterNumber').hide();
                        }
                    }
            });
        });

     });
</script>

