    function GetUsersByExternalPartyId() {



        $('#MultiExternalOutbound_SendEmail').prop("checked", false);
        $('#MultiExternalOutbound_SendEmail').attr("disabled", true);
        if ($("#dvMultiExternalDepartmentsTree_hdnDepartmentId").val() != '' && $("dvMultiExternalDepartmentsTree_txtDepartmentName").val() != '') {
            if ($("#dvMultiExternalDepartmentsTree_txtDepartmentEmail").val() != '') {
                $("#MultiExternalOutbound_Email").val($("#dvMultiExternalDepartmentsTree_txtDepartmentEmail").val());
                $('#MultiExternalOutbound_SendEmail').removeAttr("disabled");
                $('#MultiExternalOutbound_SendEmail').prop("checked", false);
            }
            else {
                $("#MultiExternalOutbound_Email").val('');
            }
            $("#hdnExternalCopyOrgUnitUsers").val('');
            $("#ddlExternalCopyOrgUnitUsers").val('');
            $("#hdnExternalCopyOrgUnitUserName").val('');
            $('#hdnMultiExternalOrgUnitName').val($('#dvMultiExternalDepartmentsTree_txtDepartmentName').val());
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetManagersByPartyId", "OutboundExternal")',
                data: { id: $('[name="MultiExternalOutbound.OrgUnitId"]').val() },
                success:
                    function (data) {
                        AutoCompleteChangeList("ddlExternalCopyOrgUnitUsers", data);
                        $("#ddlExternalCopyOrgUnitUsers").trigger('change');
                        $("#hdnExternalCopyOrgUnitUsers").trigger('change');
                        $("#ddlExternalCopyOrgUnitUsers").prop('disabled', false);
                        $("#MultiExternalOrgSelectedList").val($('[name="MultiExternalOutbound.OrgUnitId"]').val());

                    }
            });
            return false;
        }
        else {
            AutoCompleteChangeList("ddlExternalCopyOrgUnitUsers", "[]");
            $("#hdnExternalCopyOrgUnitUsers").val('');
            $("#ddlExternalCopyOrgUnitUsers").trigger('change');
            $("#hdnExternalCopyOrgUnitUsers").trigger('change');
            $("#ddlExternalCopyOrgUnitUsers").prop('disabled', true);
         //   $("#dvFilesUploader").addClass("hidden_");
        }
    }

