    function GetExternalCopyById(key, orgUnitId) {

        var transId = $('#hdnTransactionID').val();
        //SetTreeDefaultInfo("dvMultiExternalDepartmentsTree");
        //$("#dvMultiExternalDepartmentsTree_hdnDepartmentId").val($("#dvMultiExternalDepartmentsTree_" + key).val());
      /*  SetTreeDefaultInfo("dvMultiExternalDepartmentsTree",orgUnitId);*/
        $('.uploaded-files').html("");
        $('#hdnMultiExEditKey').val(key);
        //$("#divForm__dvMultiExternalDepartmentsTree").find(".hdnDepartmentId").val($("#ExOrgUnitId_" + key).val());
        $("#dvMultiExternalBody .txtDepartmentName").val($("#ExOrgUnitName_" + key).val());
        $("#dvMultiExternalBody .txtDepartmentNumber").val($("#ExOrgUnitId_" + key).val());
        FillDepartmentTreeControlsById('dvMultiExternalDepartmentsTree', $("#ExOrgUnitId_" + key).val());
        //GetUsersByExternalPartyId();

        $("#hdnSendEmail").val($("#SendEmail_" + key).val().toLowerCase());
        if ($("#SendEmail_" + key).val().toLowerCase() == "true") {

            $('#MultiExternalOutbound_SendEmail').prop('checked', $("#SendEmail_" + key).val().toLowerCase());
        }


        $('#hdnMultiExternalOrgUnitName').val($('#dvMultiExternalBody .txtDepartmentName').val());
        $("#ddlExternalCopyOrgUnitUsers").val($("#ExUserName_" + key).val());
        $("#hdnExternalCopyOrgUnitUserName").val($("#ExUserName_" + key).val());
        $("#hdnExternalCopyOrgUnitUsers").val($("#ExUserId_" + key).val());
        $("#ddlExternalCopyActionId").val($("#ExActionName_" + key).val());
        $("#hdnExternalCopyActionId").val($("#ExActionId_" + key).val());
        $("#hdnExternalCopyActionName").val($("#ExActionName_" + key).val());
        $("#hdnExAttachments").val($("#ExAttachments_" + key).val());
        $("#hdnExternalCopiesAttachmentsCount").val($("#ExAttachment_" + key).val());
        $("#hdnExternalCopiesAttachmentsCount").removeAttr("disabled");
        $("#hdnMultiExEditId").val($("#ExEditId_" + key).val());
        $("#hdnAttachmentNames").val($("#ExAttachmentsNames_" + key).val());
        var attachmentsNames = $("#ExAttachmentsNames_" + key).val();
        if (attachmentsNames != '') {
            var attachmentsNamesArr = JSON.parse(attachmentsNames);
            for (i = 0; i < attachmentsNamesArr.length; i++) {
                if (attachmentsNamesArr[i].IsDeleted != true) {
                    $('.uploaded-files').append('<div class="file"><i class="uicon icon_attachments"></i><span class="attachment_name">' + attachmentsNamesArr[i].Name + '</span><a href="javascript:removeAttachemntPhysically(' + key + ',' + attachmentsNamesArr[i].Id + ')" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>');
                }
            }
            $('.col-uploadeed-files').fadeIn(200);
        } else {
            $.ajax({
                type: 'Get',
                url: '@Url.Action("RetriveExternalCopiesAttechment", "OutboundExternal")',
                data: { "OrgUnitId": orgUnitId, "id": transId },

                success: function (data) {
                    var files = data.filesNames.split(',');
                    if (data.filesNames == "")
                        $('.uploaded-files').html("");
                    else {
                        for (i = 0; i < files.length; i++) {
                            $('.uploaded-files').append('<div class="file"><i class="uicon icon_attachments"></i><span class="attachment_name">' + files[i] + '</span><a href="javascript:removeAttachemntPhysically(' + key +')" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>');
                        }
                        $('.col-uploadeed-files').fadeIn(200);
                    }

                }
            });
        }
        $("#hdnCopyIndex").val(key);
         $("#btnMultiExternal").hide();
        $("#btnResetExternalCopy").hide();
        $("#btnExternalEditCopies").removeClass("hidden_");
        $("#btnExternalEditCopies").show();
        $("#aCancelMultiExternal").show();
        //$("#dvFilesUploader").removeClass("hidden_");
        $.ajax({
            type: 'get',
            url: '@Url.Action("GetManagersByPartyId", "OutboundExternal")',
            data: { id: $("#ExOrgUnitId_" + key).val() },
            success:
                function (data) {
                    AutoCompleteChangeList("ddlExternalCopyOrgUnitUsers", data);
                    $("#ddlExternalCopyOrgUnitUsers").trigger('change');
                    $("#hdnExternalCopyOrgUnitUsers").trigger('change');
                    $("#ddlExternalCopyOrgUnitUsers").prop('disabled', false);
                    //$("#dvFilesUploader").removeClass("hidden_");
                }
        });
        $("#MultiExternalOutbound_Email").val($("#dvMultiExternalDepartmentsTree_txtDepartmentEmail").val());
        return false;
    }

