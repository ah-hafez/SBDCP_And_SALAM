<script>
                        function CancelConfidentialityAcknowledgment() {
               var Items = $.parseJSON($('#ConfidentialityItems').val());
               $("#ddlConfedentiality").val(Items[0].label);
               $("#hdnConfedentiality").val(Items[0].value);
               $("#Loader").hide();

           }
        function Acknowledgment() {

       $('#hdnIsAcknowledged').val(true);
        @*$.ajax({
            url:  '@Url.Action("AddConfidentialityAcknowledgment")',
            cache: false,
            data: { transactionId: parseInt(id)},
            success: function (data) {

               }
        });*@
        return false;
           }
        function CheckboxAcknowledged() {
              if ($('.requiredacknowledged:checked').length == $('.requiredacknowledged').length) {
                    $('.acknowledged-btn').prop('disabled', false);
                   $(".acknowledged-btn").css('background-color', '');
              }
              else
               {
                    $('.acknowledged-btn').prop('disabled', 'disabled');
                   $(".acknowledged-btn").css('background-color', 'gray');
               }
           }
    function CollapseDiv(divName) {
        if ($('#' + divName).css('display') == 'block') {
            $('#' + divName).css("display", "none");
            $('#' + divName + 'PlusIcon').css("display", "inline-block");
            $('#' + divName + 'DashIcon').css("display", "none");
        }
        else {
            $('#' + divName).css("display", "block");
            $('#' + divName + 'PlusIcon').css("display", "none");
            $('#' + divName + 'DashIcon').css("display", "inline-block");
        }
    }

     $(document).ready(function () {
        ShowHideReporterContent(false);
        if ($("input[id='OutboundDraft']").is(':checked')) {

            $('#TransactionTypeToGetPrevious').val('@TransactionCategory.DraftOutbound');
            $('#lbltransactionNumber').text('@DbRes.TResource("User.OutboundDraft.BasicInfo.DraftNumber") :');
            $('#transactionPathDDL').show();

        }

        $('#ddlConfedentiality').on('change', function () {

            var Items = $.parseJSON($('#ConfidentialityItems').val());
