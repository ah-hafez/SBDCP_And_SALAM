@{
    /**/
    Layout = "~/Areas/User/Views/Shared/_SearchLayout.cshtml";
    var isNotSent = (Request["IsFromDraft"] == null ? false : Convert.ToBoolean(AESEncrytDecry.Base64Decode(Request["IsFromDraft"]))) || Model.StatusId == TransactionStatus.NotSent.LookupIdentity(LookupCategory.TransactionStatus, SessionInfo.CultureShortName);
    var attachmentVM = new TransactionAttachmentVM { IsEnableAction = isNotSent, Attachments = (AjaxGrid<TransactionAttachmentVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Attachments, 1, Model.Attachments.Count, false) };
    var nameVM = new TransactionNameVM { IsEnableAction = isNotSent, Names = (AjaxGrid<TransactionNameVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Names, 1, Model.Names.Count, false) };
    var linkVM = new TransactionLinkVM { IsEnableAction = isNotSent, Links = (AjaxGrid<TransactionLinkVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Links, 1, Model.Links.Count, false) };
    var followUpVM = new TransactionFollowUpVM() { FollowUps = (AjaxGrid<TransactionFollowUpVM>)new AjaxGridFactory().CreateAjaxGrid(Model.FollowUps, 1, Model.FollowUps.Count, false) };
    var copyVM = new TransactionCopyVM { IsEnableAction = isNotSent, Copies = (AjaxGrid<TransactionCopyVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Copies, 1, Model.Copies.Count, false) };
    var externalCopyVM = new TransactionExternalCopyVM { IsEnableAction = isNotSent, ExternalCopies = (AjaxGrid<TransactionExternalCopyVM>)new AjaxGridFactory().CreateAjaxGrid(Model.ExternalCopies, 1, Model.ExternalCopies.Count, false) };
    ViewBag.Title = DbRes.TResource("User.OutboundExternal.EditTitle");
    string transactionId = ViewData["TransactionId"].ToString();
    bool barCodePermission = SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Outbound_PrintBarCode) && SessionInfo.CurrentUser.Claims.Contains(UserClaims.GeneralPermissions.PrintEncryptionCode);
    bool isEditMode = true;
    Session["IsEditMode"] = isEditMode;
    var tasks = ViewData["Tasks"] as TaskAddVM;
    var LinkCount = Model.Links.Count;
    var FollowupCount = Model.FollowUps.Count;
    var NameCount = Model.Names.Count;
    var TasksCount = tasks.TasksGrid.ItemsCount;
    string controllerName = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
}
