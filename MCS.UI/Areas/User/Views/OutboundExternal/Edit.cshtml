    function OnSaveSuccess(data) {
        debugger;
        if (data.MessageType != 2) {


            ConvertDraftToOutbound(@Model.Id);
        }
        else {
            ShowErrorMessage(data.MessageText);
        }


    }



        function OnSuccess(data) {

        if (data.MessageType != 2) {
            PrintTitleValue = '';
            PrintBarCodeValue = '';
            AddArchiveValue = '';
            CopyDataValue = '';
            SendOutboundValue = '';

            DraftAddArchiveValue = '';
            DraftCopyDataValue = '';
            DraftPrintBarCodeValue = '';
           DeliveryReportValue = 'طباعة بيان التسليم';
            var date = data.Date;
            if ('@barCodePermission' == 'True') {
                PrintBarCodeValue = '@DbRes.TResource("User.OutboundExternal.Add.barcode")';
            }
            if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Outbound_PrintTitle)' == 'True') {
                PrintTitleValue = '@DbRes.TResource("User.Transaction.PrintAddress")';
            }
            if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Outbound_AddArchive)' == 'True') {
                AddArchiveValue = '@DbRes.TResource("User.Add.AddArchive")';
            }
            if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Outbound_CopyData)' == 'True') {
                CopyDataValue = '@DbRes.TResource("User.OutboundExternal.Add.CopylastOutbound")';
            }
            if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Outbound_SendOutbound)' == 'True') {
                SendOutboundValue = '@DbRes.TResource("User.OutboundExternal.Add.sent")';
            }

            if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Draft_AddArchive)' == 'True') {
                DraftAddArchiveValue = '@DbRes.TResource("User.Add.AddArchive")';
            }
            if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Draft_CopyData)' == 'True') {
                DraftCopyDataValue = '@DbRes.TResource("User.OutboundExternal.Add.CopyLatestDraftData")';
            }
            if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Draft_PrintBarCode)' == 'True') {
                DraftPrintBarCodeValue = '@DbRes.TResource("User.OutboundExternal.Add.barcode")';
            }




            isDraft = data.IsDraft;

               if ('@SessionInfo.CurrentUser.Claims.Contains(UserClaims.PopUpWindowData.Prefix)' == 'True')
               {

                   if (isDraft=='True') {
                       ShowSaveTransSuccesMessage(data.MessageText, '', '@DbRes.TResource("User.OutboundExternal.Add.TranNo") :', data.OutboundExternalNumber, '@DbRes.TResource("User.OutboundExternal.Add.CreatedDate")', date, DraftPrintBarCodeValue, '', '', DraftCopyDataValue, '@DbRes.TResource("User.OutboundExternal.Add.NewOutbound")', PrintTitleValue, '', '', '', '@DbRes.TResource("User.Transaction.BackToBox")', DraftAddArchiveValue, DeliveryReportValue);

                   }
                   else {
                   ShowSaveTransSuccesMessage(data.MessageText, '', '@DbRes.TResource("User.OutboundExternal.Add.TranNo") :', data.OutboundExternalNumber, '@DbRes.TResource("User.OutboundExternal.Add.CreatedDate")', date, PrintBarCodeValue, '', '', CopyDataValue, '@DbRes.TResource("User.OutboundExternal.Add.NewOutbound")', PrintTitleValue, '', '', '', '@DbRes.TResource("User.Transaction.BackToBox")', AddArchiveValue, DeliveryReportValue);

                   }

               }

              else
            {
                ShowSuccesMessage(data.MessageText);


                   setTimeout(function () {
            $(document).trigger("AddArchiveButtonPopupClicked", '');
        }, 3000);


            }

        }
        else {
            ShowErrorMessage(data.MessageText);
        }


    }
    $(document).on("MoveToAssignmenPopupClicked", function (event, param) {
        debugger;
        var outboundExternalId = $("#hdnOutboundExternalId").val();
                var token = $("#frmAddOutboundExternal").find("input[name='__RequestVerificationToken']").val();
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("GetDeliveryReportByTransactionId", "OutboundExternal")',
                    data: {
                        transactionId: outboundExternalId,
                        type: '@TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)',
                        __RequestVerificationToken: token,
                        isConfirmed: $("#isConfirmedId").val(),
                    },
                    success: function (data)
                    {
                        debugger;
                        switch (data.MessageType)
                        {
                            case 0:
                                break;
                            case 1:
                                return ShowConfirmMessage(data.MessageText, "ContinueAssigneTransaction");
                                break;
                            default:
                                return ShowErrorMessage(data.MessageText);

                        }


                        if (data.MessageType != 2) {
                            if (data.ReportsIds) {
                                //UpdateTransactionStatus(data.ReportsIds);
                                PrimaryPrintTransactionsDeliveryReport(data.ReportsIds);
                            }
                        }
                        else {
                            ShowErrorMessage(data.MessageText);
                        }
                    }
                });
              //  SendToOutboundHub();


     });
     $(document).on("RedirectToTrayButtonPopupClicked", function (event, param) {
        window.location.href = '@Url.Action("DraftOutbound", "File")';
    });
    function OnConvertSuccess(data)
    {

        if (data.MessageType != 2)
        {
            ShowSuccesMessage(data.MessageText);

        }
        else
        {
            ShowErrorMessage(data.MessageText);
        }

         window.location.href = '@Url.Action("DraftOutbound", "File")';
    }



        function ConvertDraftToOutbound(id) {

            var IsDecisionDraft = '@Model.OutboundExternalBasicInfo.IsDecisionDraft';

