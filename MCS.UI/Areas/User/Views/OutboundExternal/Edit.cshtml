    function CheckPriorityIfHasDate()
    {
        $('#hdnDestinationId').val($('#divContainerExternalParties .hdnDepartmentId').val());
        $('#hdnHour').val($('#ddlHour').val());
        $('#hdnMinute').val($('#ddlMinute').val());
        if ($('#divContainerExternalParties .InboundDepName').val() == "") {
            $('#divContainerExternalParties .InboundDepNum ,  #divContainerExternalParties .InboundDepName ').addClass('RedBorder');
        }
        else {
            $('#divContainerExternalParties .InboundDepNum ,  #divContainerExternalParties .InboundDepName ').removeClass('RedBorder');
        }
        if ($('#datePicker').css('display') == 'block' && $("#hdnHasDateGreg").val() == "") {
            $("#CalMessage1").removeClass("hidden_");
            $("#CalMessage1").show();
            $('#HasDateCal, .date-icon2').addClass("RedBorder");
            $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateRequired"))');
            return false;
        }
        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        if ($("#hdnHasDateGreg").val() != "") {

            if ($("#hdnHasDateGreg").val() != undefined) {
                 var selectedDate = convertdate($("#hdnHasDateGreg").val());

                if (selectedDate < currentDate) {
                    $("#CalMessage1").removeClass("hidden_");
                    $("#CalMessage1").show();
                    $('#HasDateCal, .date-icon2').addClass("RedBorder");
                    $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateCompare"))');
                return false;
                }
            }
        }

        if ($('#datePicker').css('display') == 'block') {
            var time = new Date();
            if (convertdate($("#hdnHasDateGreg").val()) > currentDate) {
                $("#CalMessage").html("");
                $("#CalMessage1").hide();
                $('#HasDateCal, .date-icon2').removeClass("RedBorder");
                return checkIfHasMainDocument(true);
            }
            else if ($("#hdnHasDateGreg").val() > convertdate($("#hdnHasDateGreg").val())) {
                $("#CalMessage").html("");
                $("#CalMessage1").hide();
                $('#HasDateCal, .date-icon2').removeClass("RedBorder");
                return true;
            }
            else {
                $("#CalMessage1").removeClass("hidden_");
                $("#CalMessage1").show();
                $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.WrongRemindTime"))');
                return false;
            }
        }

         if (!ValidateCopy()) {
            return false;
        }
        return checkIfHasMainDocument(true);
    }

