@model AjaxGrid<MCS.UI.Areas.User.Models.Transaction.MultiExternalOutboundVM>

 


@Html.Grid(Model).CollectionName("MultiExternal").Named("grdMultiExternal").Columns(columns =>
{
columns.Add(true).RenderValueAs(model => Html.HiddenFor(column => model.Id, new { id = "ExEditId_" + model.Key }).FixIDAndName("column.", "column_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(column => model.Key, new { id = "Key_" + model.Key }).FixIDAndName("column.", "column_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(column => model.OrgUnitId, new { id = "ExOrgUnitId_" + model.Key }).FixIDAndName("column.", "column_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(column => model.OrgUnitName, new { id = "ExOrgUnitName_" + model.Key }).FixIDAndName("column.", "column_")).Sanitized(false).Encoded(false);

columns.Add(model => model.OrgUnitName).Titled(DbRes.TResource("User.Transaction.Copies.ExternalParty"));
 
   columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").RenderValueAs(model => @Html.ClientLinkTag("", cssClass: "edit_link", permissionCode: UserClaims.CopiesExternal.Delete, clientFunctionToCall: "DeleteActionGrid(" + "'grdMultiExternal'," + model.Key + ",'" + DbRes.TResource("Grid.DeleteMassage") + "','', 'ResetActionExternalCopy', '" + model.OrgUnitId + "')", innerHtml: "<i class='glyphicon glyphicon-trash color-danger'></i>"));
 
})

 