</div>
<div id="idSaveButton" class="row text-right mr-5 mt-4 ml-xs-3 mb-4">
    @Html.ConfirmAction(OperationType.Update, "btnSaveOutboundExternal", DbRes.TResource("User.File.Save"), Url.Action("Edit", "OutboundExternal"), null, null, null, "OnSuccess", null, null, "post", "frmEditOutboundExternal", "BasicInformation", "btn btn-st2 btn-lg pull-right", "CheckPriorityIfHasDate", UserClaims.Outbound.EditOutbound, "NotValid")
    <a class="btn btn-st2 btn-lg pull-right mr-1 " id="btnPrintTransaction" onclick="PrintTransaction(@Model.Id)">@DbRes.TResource("Grid.Preview")</a>
</div>

<script>
    $(document).ready(function () {
        window.textEditorSingature = '@Session["textEditorSignature"]';
        $("#dvDocumentViewerEditorContainer").html($("#dvEditorPartialContainer").html());
        $("#dvEditorPartialContainer").html("");
        $("#hdnOutboundExternalId").val('@Model.Id');
     
    });

        $("div.anchor a").click(function () {
            $("div.anchor a").removeClass("active");
            $("div.anchor a").addClass("disabled");
            $(this).addClass("active");
            var id = $(this).data("id");
            $("#" + id).addClass("active");
            $(".tabscontent").addClass("hidden_");
            var divId = $(this).data("divid");
            $("#" + divId).removeClass("hidden_");
            if (divId == "second-tab") {
                $('#idSaveButton').hide();
            }
            else {
                $('#idSaveButton').show();
            }
        });

        $("ul li a").click(function () {
            var tabId = $(this).attr("aria-controls");

            if (tabId != undefined && tabId.trim() != '') {
                $('ul li').removeClass('active');
                $(this).parent().addClass("active");

                $(".tab-pane").hide();
                $("#" + tabId).removeClass('hidden_');
                $("#" + tabId).show();
            }
        });

    function SetSuggestedTopic()
    {
        $("#txtAreaSubject").val($("#divForm__dvSuggestedTopicTree .txtDepartmentName").val());
    }
    function GetMode()
    {
        return EncryptionKey('@isEditMode');
    }

    var urlPrintDeliveryReport = '@Url.Action("DeliveryReport", "Reports")' + '?transactionId=' + '@Model.Id';

    var transactionId = $("#hdnOutboundExternalId").val();


    $("#basicInfo").click(function () {
        var actionType=@Convert.ChangeType(MCS.Common.AuditingActionCode.ViewBasicInformation, MCS.Common.AuditingActionCode.ViewBasicInformation.GetTypeCode());
        PostTransactionLog(actionType, @Model.Id);
    });

    $("#transactionLinks").click(function () {
        var actionType=@Convert.ChangeType(MCS.Common.AuditingActionCode.ViewTransactionLinks, MCS.Common.AuditingActionCode.ViewTransactionLinks.GetTypeCode());
        PostTransactionLog(actionType, @Model.Id);
    });

    $("#transactionNames").click(function () {
        var actionType=@Convert.ChangeType(MCS.Common.AuditingActionCode.ViewTransactionNames, MCS.Common.AuditingActionCode.ViewTransactionNames.GetTypeCode());
        PostTransactionLog(actionType, @Model.Id);
    });

    $("#transactionCopies").click(function () {
        var actionType=@Convert.ChangeType(MCS.Common.AuditingActionCode.ViewTransactionCopies, MCS.Common.AuditingActionCode.ViewTransactionCopies.GetTypeCode());
        PostTransactionLog(actionType, @Model.Id);
    });


    $("#dvViewAttachment").click(function () {
        if(!$(this).hasClass('active')){
            var transactionId = $("#hdnTransactionId").val();
            var actionType=@Convert.ChangeType(MCS.Common.AuditingActionCode.ViewTransactionAttachmentsArchiving, MCS.Common.AuditingActionCode.ViewTransactionAttachmentsArchiving.GetTypeCode());
            PostTransactionLog(actionType, @Model.Id);
        }
    });

    function NotValid() {
        $('#dvBasicInfo input').each(function () {
            if ($('#dvBasicInfo input').hasClass('invalid-input')) {
                $('div, a').removeClass('selected');
                if (!$('#first').hasClass('selected'))
                    $('#first').addClass('active');
                $(".tabscontent").addClass("hidden_");
                $("#first-tab").removeClass("hidden_");
                $(".boardered-circle-transparent").removeClass("active");
                $('#first').addClass('active');

                $(window).scrollTop(0);
            }
        });
    }

    $("#anchorArchiving").click(function () {
        var actionType=@Convert.ChangeType(MCS.Common.AuditingActionCode.ViewTransactionArchiving, MCS.Common.AuditingActionCode.PrintBarcode.GetTypeCode());
        PostTransactionLog(actionType, @Model.Id);
    });

    $(document).ready(function () {
        $('#DestinationId').trigger('change', {isFirstLoad:true});
        $("#rejecttrans, #transactionAssigments, #assignmentPaper, #returnCreator").click(function (e) {
            $('#idSaveButton').hide();

            if (e.target.id == 'returnCreator') {
                $('#hdnAssignToCreator').val(true);
            }
            else {
                $('#hdnAssignToCreator').val(false);
            }
        });
        $("#BasicInfo, #Explanation, #Attachment, #Names, #electronicCopies, #transactionCopies ").click(function () {
            $('#idSaveButton').show();
        });
        if ($("#hdnIsDraft").val() == "False") { $(".dvActions").hide(); }
        $("#hdnTransactionId").val('@Model.Id');
        $('#grdArchiving tbody tr td a.edit_trash').hide();
        var isDraft = '@Model.OutboundExternalBasicInfo.IsDraft';

        if (isDraft == "False" && '@Request["isHubEditable"].ToString()' != '@AESEncrytDecry.Base64Encode("True")') {
            $("#first-tab, #second-tab, #third-tab, #fourth-tab, #fifth-tab, #sixth-tab, #seventh-tab").each(function () {
                $(this).find("a").each(function () {
                    $(this).addClass("disable_a");
                });
                $(this).find('input').attr("disabled", true);
                $(this).find("input[type = 'hidden']").attr("disabled", false);
                $(this).find('textarea').attr("disabled", true);
                $(this).find("input[type = 'button']").remove();
                $(this).find('button').remove();
                $('#btnSaveOutboundExternal').remove();
                $('#idSaveButton').hide();
            });
        }
        $('#divContainer__dvDestinationTree #DestinationId').trigger('change', { isFirstLoad: true });
    });

    function ShowPrintDialog() {
        var params = { transactionId: $("#hdnOutboundExternalId").val() };
        ShowDialogAjaxPrintingBarcodes('@Url.Action("PrinttingBarcodes","Shared")' + "?" + $.param(params), {}, 'OpenPrintDialogSuccess', 'dialogbox col-md-12 ');
    }

    function OpenPrintDialogSuccess(data, $obj)
    {
        if (data.MessageType != 2) {
            $obj.setContent(data.Html);
        }
        else {
            __dialog.close();
            ShowErrorMessage(data.MessageText);
        }
    }


    function AddExternalParty() {
        var token = $("#frmEditOutboundExternal").find("input[name='__RequestVerificationToken']").val();
        ShowDialogAjax('@Url.Action("AddNewExternalPartyForTransaction")', {
            treeName: "dvDestinationTree",
            onAddPartyfuntion: "GetExternalParties",
            transactionId: @Model.Id,
            __RequestVerificationToken: token
        }, 'OpenExternalPartyDialogSuccess', 'dialogbox col-md-12 ');
    }

    function OpenExternalPartyDialogSuccess(data, $obj) {

        $obj.setContent(data.View);

        jQuery.validator.unobtrusive.parse('#frmAddParty');
    }

    function OnSuccess(data) {

        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
            if (data.ArchivingHtml) {
                $("#grid-table-grdArchiving > tbody > .grid-empty-text").remove();
                $("#grid-table-grdArchiving > tbody > tr").remove();
                $("#grid-table-grdArchiving > tbody:last").append(data.ArchivingHtml);
            }
            if (data.AttachmentHtml) {
                $("#grid-table-grdAttachments > tbody > .grid-empty-text").remove();
                $("#grid-table-grdAttachments > tbody > tr").remove();
                $("#grid-table-grdAttachments > tbody:last").append(data.AttachmentHtml);
            }
            if (data.ExternalCopiesHtml) {
                $("#grid-table-grdExternalCopies > tbody > .grid-empty-text").remove();
                $("#grid-table-grdExternalCopies > tbody > tr").remove();
                $("#grid-table-grdExternalCopies > tbody:last").append(data.ExternalCopiesHtml);
            }
            if (data.CopiesHtml) {
                $("#grid-table-grdCopies > tbody > .grid-empty-text").remove();
                $("#grid-table-grdCopies > tbody > tr").remove();
                $("#grid-table-grdCopies > tbody:last").append(data.CopiesHtml);
            }
            ShowSuccesMessage(data.MessageText, 'Redirect');
            if (typeof BindRoomsToTransaction != 'undefined') {
                BindRoomsToTransaction($('#hdnTransactionId').val());
            }
            refreshDoconut();
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
        $('#officeIframe').hide();
        //window.location.reload();
    }
     window.Redirect = function () {
        window.location.href ='@Url.Action("MyTransactions", "file")';
    }
    $(document).on('change', '#divContainer__dvDestinationTree #DestinationId', function (event, data) {
        GetUsersByPartyId();
        if (data == undefined || !data.isFirstLoad) {
            ResetAutoCompleteDeliveryMethod();
        }
    });

    function ResetAutoCompleteDeliveryMethod() {
        AutoCompleteChangeList("ddlBasicDeliveryMethod", "[]");
        $('#ddlBasicDeliveryMethod').autocomplete('close').val('');//Clear seleted item
        ShowHideReporterContent(false);
    }

    function GetUsersByPartyId() {
        if ($('#DestinationId').val() != "") {
            var destinationIdValue = "#li_" + $('#DestinationId').val();
            var isYesserregistered = $(destinationIdValue).find('[data-isyesserregistered]').data('isyesserregistered');
            if ($("input[id='OutboundDraft']").is(':checked')) {
                isYesserregistered = isYesserregistered && true;
                $('#divPreparationEntityId').hide();
            }
            else {
                $('#divPreparationEntityId').show();
            }
            $("#OutboundExternalBasicInfo_DestinationId").val($('#DestinationId').val());
            $.ajax({
                cache: false,
                type: 'get',
                url: '@Url.Action("GetManagersByPartyId")',
                data: { id: $('#DestinationId').val() },
                success:
                    function (data) {
                        AutoCompleteChangeList("ddlDirectedToId", data);
                        $("#ddlDirectedToId").val('');
                        $("#hdnDirectedToId").val('');
                        $("#ddlDirectedToId").trigger('change');
                        $("#hdnDirectedToId").trigger('change');
                        $("#ddlDirectedToId").prop('disabled', false);
                    }
            });
            GetDeliveryMethod(isYesserregistered);
            return false;
        }
        else {
            AutoCompleteChangeList("ddlDirectedToId", "[]");
            $("#ddlDirectedToId").val('');
            $("#hdnDirectedToId").val('');
            $("#ddlDirectedToId").prop('disabled', true);
        }
    }

    function GetDeliveryMethod(isYesserregistered) {
        var token = $("#frmEditOutboundExternal").find("input[name='__RequestVerificationToken']").val();

        if (isYesserregistered == undefined) { isYesserregistered = false; }
        $.ajax({
            cache: false,
            type: 'post',
            url: '@Url.Action("GetDeliveryMethod")',
            data: { isYesseRregistered: isYesserregistered, __RequestVerificationToken: token  },
            success: function (data) {
                AutoCompleteChangeList("ddlBasicDeliveryMethod", data);
                onChangeDeliveryMethod();
            }
        });
    }

    function OnAddReporterSuccess(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText)
            ClearInputs('frmAddReporter');
            __dialog.close();

        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function AddReporter() {
        __dialog = $.confirm({
            title: false,
            content: function ($obj) {
                return $.ajax({
                    url: '@Url.Action("AddReporter", "Shared")',
                    type: 'GET',
                    cache: false,
                    success: function (data) {
                        $obj.setContent(data.Html);
                        jQuery.validator.unobtrusive.parse('#frmAddReporter');
                    }
                });
            },
            onOpen: function () {
                jQuery(function () {
                    jQuery('.jconfirm-box').draggable({
                        revert: false,
                    });
                });
                $("#Loader").hide();
            },
            onClose: function () {
                GetAllReporter();
            },
            confirmButton: false,
            icon: 'fa fa-info',
            animation: 'scale',
            columnClass: "dialogbox col-md-8 col-md-offset-2 col-xs-8 col-xs-offset-2",
            backgroundDismiss: false,
            closeIcon: true,
            cancelButton: false
        });
    }

    function GetAllReporter() {
        $.ajax({
            cache: false,
            type: 'get',
            url: '@Url.Action("GetReporters")',
            success: function (data) {
                AutoCompleteChangeList("ddlBasicReporter", data);
                AutoCompleteChangeList("ddlBasicReporterAssinment", data);
                AutoCompleteChangeList("ddlAssignmentPaperReporter", data);
                AutoCompleteChangeList("ddlRejectBasicReporter", data);
                var newItems = $.parseJSON(data);
                var lastItem = newItems.slice(-1)[0].value;
                $('#hdnBasicReporter').val(lastItem);
                $('#hdnBasicReporter').trigger('change')
            }
        });
    }

    function PrintTransaction(TransactionId) {
        var Number = $('#hdnNumber').val();

       @*var url= '@Url.Action("GetTransactionExplanationsForPrint", "Editor")' + '?transactionId=' + TransactionId

        ShowDialog(url, 'dialogbox col-md-12 ');*@

        //var data = { transactionId: TransactionId  ,__RequestVerificationToken: token };
        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("PrintTransaction", "Shared")' + '?transactionId=' + TransactionId + "&transactionNumber=" + Number,
            //data: data,
            cache: false,
            success:

                function (data) {
                    if (data.MessageType != 2) {
                        var TransactionWindow = window.open('', '_blank', 'width=900,height=500');

                        TransactionWindow.document.write(data);
                        TransactionWindow.document.close();
                        TransactionWindow.focus();

                        //setTimeout(function () {
                        //    TransactionExplanationsWindow.print();
                        //    TransactionExplanationsWindow.close();
                        //}, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }

    function CheckPriorityIfHasDate()
    {
        $('#hdnHour').val($('#ddlHour').val());
        $('#hdnMinute').val($('#ddlMinute').val());
        if ($('#divContainerExternalParties .InboundDepName').val() == "") {
            $('#divContainerExternalParties .InboundDepNum ,  #divContainerExternalParties .InboundDepName ').addClass('RedBorder');
        }
        else {
            $('#divContainerExternalParties .InboundDepNum ,  #divContainerExternalParties .InboundDepName ').removeClass('RedBorder');
        }
        if ($('#datePicker').css('display') == 'block' && $("#hdnHasDateGreg").val() == "") {
            $("#CalMessage1").removeClass("hidden_");
            $("#CalMessage1").show();
            $('#HasDateCal, .date-icon2').addClass("RedBorder");
            $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateRequired"))');
            return false;
        }
        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        if ($("#hdnHasDateGreg").val() != "") {

            if ($("#hdnHasDateGreg").val() != undefined) {
                 var selectedDate = convertdate($("#hdnHasDateGreg").val());

                if (selectedDate < currentDate) {
                    $("#CalMessage1").removeClass("hidden_");
                    $("#CalMessage1").show();
                    $('#HasDateCal, .date-icon2').addClass("RedBorder");
                    $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateCompare"))');
                return false;
                }
            }
        }

        if ($('#datePicker').css('display') == 'block') {
            var time = new Date();
            if (convertdate($("#hdnHasDateGreg").val()) > currentDate) {
                $("#CalMessage").html("");
                $("#CalMessage1").hide();
                $('#HasDateCal, .date-icon2').removeClass("RedBorder");
                return checkIfHasMainDocument(true);
            }
            else if ($("#hdnHasDateGreg").val() > convertdate($("#hdnHasDateGreg").val())) {
                $("#CalMessage").html("");
                $("#CalMessage1").hide();
                $('#HasDateCal, .date-icon2').removeClass("RedBorder");
                return true;
            }
            else {
                $("#CalMessage1").removeClass("hidden_");
                $("#CalMessage1").show();
                $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.WrongRemindTime"))');
                return false;
            }
        }
         if (!ValidateCopy()) {
            return false;
        }
        return checkIfHasMainDocument(true);
    }

