    var nameVM = new TransactionNameVM { IsEnableAction = isNotSent, Names = (AjaxGrid<TransactionNameVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Names, 1, Model.Names.Count, false) };
    var linkVM = new TransactionLinkVM { IsEnableAction = isNotSent, Links = (AjaxGrid<TransactionLinkVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Links, 1, Model.Links.Count, false) };
    var copyVM = new TransactionCopyVM { IsEnableAction = isNotSent, Copies = (AjaxGrid<TransactionCopyVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Copies, 1, Model.Copies.Count, false) };
    var externalCopyVM = new TransactionExternalCopyVM { IsEnableAction = isNotSent, ExternalCopies = (AjaxGrid<TransactionExternalCopyVM>)new AjaxGridFactory().CreateAjaxGrid(Model.ExternalCopies, 1, Model.ExternalCopies.Count, false) };
    ViewBag.Title = DbRes.TResource("User.OutboundDraft.Editor");
    bool isEditMode = true;
    Session["IsEditMode"] = isEditMode;

    var tasks = ViewData["Tasks"] as TaskAddVM;
    var LinkCount = Model.Links.Count;
    var FollowupCount = Model.FollowUps.Count;
    var NameCount = Model.Names.Count;
    var TasksCount = tasks.TasksGrid.ItemsCount;

}
