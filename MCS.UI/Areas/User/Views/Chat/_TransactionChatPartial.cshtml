@using MCS.Common;
@using MCS.Framework.Controls
@using MCS.Framework.Localization
@using MCS.Framework.Controls.Mvc
@{
    /**/
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
    ViewData.TemplateInfo.HtmlFieldPrefix = "TransactionChatTab";
}

<div class="content_container panel-body" id="divTransactionChat">
    @Html.AntiForgeryToken()
    <div class="conversations">
        <div class="row m-0">
            <label id="totalChatCount" class="blue-color">{0} @DbRes.TResource("User.Transaction.Chat.CounterTitle")</label>
            <a class="btn btn-st1 btn-lg  pull-right" href="#" id="btnTransactionChatStart">
                <i class="icon-tab11"></i>
                @DbRes.TResource("User.Transaction.Chat.StartTransactionChat")
            </a>
            <div id="transChatMessages" class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content modal_chat2 w-100">
                        <div class="modal-header chat py-0">
                            <div class="d-flex align-item-center my-4">
                                <span class="site-color">@DbRes.TResource("User.Transaction.Chat.TransactionChatTitle") </span>
                                <small class="pl-3">
                                    <span class="gray3">@DbRes.TResource("User.Transaction.Chat.DateTime"): </span>
                                    <span id="transChatDate" class="site-color"></span>

                                </small>
                                <div class="close-icon mt-0 ml-auto" data-bs-toggle="tooltip" data-placement="bottom" title="@DbRes.TResource("User.Transaction.Chat.Close")">
                                    <a class="circle-icon color-white" href="#" data-dismiss="modal"><i class="la la-close"></i></a>
                                </div>
                            </div>
                        </div>

                        <div class="gray pt-3 pb-3 pr-1 pl-1 pop_chat2">
                            <span class="h-avatar mx-2 first_person">
                                <img src="~/Content/User/lib/images/avatar.svg">
                            </span>
                            <span class="h-avatar mx-2 second_person">
                                <img src="~/Content/User/lib/images/avatar.svg">
                            </span>
                            <div class="person-label pl-2">
                                <span id="transChatUsers" class="dark-color"></span>
                            </div>
                        </div>
                        <div class="modal-body">
                            <div id="transChatMessageListContainer" class="show_message" style="overflow-y:auto;">
                                <div class="mb-2" id="transChatMessageList">

                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <br />
        <div id="transactionChatsDiv">

        </div>
    </div>
</div>
<script>

    var transChatLastMessageId = null;
    var isLoadingMessage = false;
    var transChatLastMessageUserId = null;
    var chatToken = $("#divTransactionChat").find("input[name='__RequestVerificationToken']").val();

    $(document).ready(function () {
        $('#transChatMessageListContainer').bind('scroll', function () {
            if ($('#transChatMessageListContainer').scrollTop() < 60 && !isLoadingMessage) {
                isLoadingMessage = true;
                setTimeout(GetPreviousMessages(transChatLastMessageId), 1200);
            }
        });
    });

    function GetTransactionChats() {
        var data = { transactionId: $("#hdnTransactionId").val(), pageIndex: 0, __RequestVerificationToken: chatToken };
        $.ajax({
            url: '@Url.Action("GetTransactionConversations", "Chat")',
            type: 'post',
            cache: false,
            //contentType: "application/json",
            data: data,
            success: function (data) {
                $('#transactionChatsDiv').html(data.Html);
                $('#totalChatCount').html($('#totalChatCount').html().replace('{0}', data.TotalCount));
            },
            error: function (a, b, c, d) {
                ShowErrorMessage('حدث خطأ');
            }
        });
    }

    function DisplayTransactionChat(roomId, chatUsers, chatTime) {
        var data = { roomId: roomId, timeZone: new Date().getTimezoneOffset(), __RequestVerificationToken: chatToken };
        $.ajax({
            url: '@Url.Action("GetConversationMessages", "Chat")',
            type: 'post',
            cache: false,
            //contentType: "application/json",
            data: data,
            success: function (data) {
                $('#transChatMessageList').html('');
                if (data != undefined) {
                    if (data.Messages != undefined && data.Messages.length > 0) {
                        transChatLastMessageId = data.Messages[0].Id;
                        transChatLastMessageUserId = null;

                        $.each(data.Messages, function () {
                            var message = this;
                            AppendTransMessageChat(message, false);
                        });

                        $('#transChatDate').html(chatTime);
                        $('#transChatUsers').html(chatUsers);
                        $('#transChatMessages').modal('show');
                    }
                }
                isLoadingMessage = false;
            },
            error: function (a, b, c, d) {
                ShowErrorMessage('حدث خطأ');
            }
        });
    }

    function GetPreviousMessages(messageId) {
        var data = { messageId: messageId, timeZone: new Date().getTimezoneOffset(), __RequestVerificationToken: chatToken };
        $.ajax({
            url: '@Url.Action("GetPreviousMessages", "Chat")',
            type: 'post',
            cache: false,
            //contentType: "application/json",
            data: data,
            success: function (data) {
                if (data != undefined) {
                    if (data.Messages != undefined && data.Messages.length > 0) {
                        transChatLastMessageId = data.Messages[data.Messages.length -1].Id;

                        $.each(data.Messages, function () {
                            var message = this;
                            AppendTransMessageChat(message, true);
                        });
                        isLoadingMessage = false;
                    }
                }
                isLoadingMessage = false;
            },
            error: function (a, b, c, d) {
                ShowErrorMessage('حدث خطأ');
            }
        });
    }


    function AppendTransMessageChat(message, topMessage) {
        var messageElement = 'transChatMessageList';
        var messageContainer = 'transChatMessageListContainer';
        if (transChatLastMessageUserId == null) {
            transChatLastMessageUserId = message.User.Id
        }

        var htmlTemp = '';
        if (message.User.Id == transChatLastMessageUserId) {
            htmlTemp = CreateSenderMessageItem(message.Content, message.SendDate + ' ' + message.SendTime, message.Id, message.User.Id, false);
        }
        else {
            htmlTemp = CreateRecievedMessageItem(message.Content, message.SendDate + ' ' + message.SendTime, message.Id, message.User.Id);
        }

        if (!topMessage) {
            $('#' + messageElement).append(htmlTemp);
            $('#' + messageContainer).scrollTop($('#' + messageContainer).prop("scrollHeight"));
        }
        else {
            $('#' + messageElement).prepend(htmlTemp);
        }

        transChatLastMessageUserId = message.User.Id;
    }

</script>