    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.IC.ICAdd))
    {
        <li class="menu-item">
            <button type="button" class="menu-btn" onclick="CreateICView()"> <i class="fa fa-download"></i> <span class="menu-text">انشاء دليل </span> </button>
        </li>
    }


    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.IC.ICUpdate))
    {
        <li class="menu-item">
            <button type="button" class="menu-btn" onclick="UpdateICView()"> <i class="fa fa-edit"></i> <span class="menu-text">تعديل الدليل</span> </button>
        </li>
    }

    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.IC.ICDelete))
    {
        <li class="menu-item">
