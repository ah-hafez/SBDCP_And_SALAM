<div class="row">
    <div class="form-group col-lg-1 col-md-12 col-sm-12 col-xs-12 mb-3">
    </div>
    <div class="form-group col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-3">
        <label class="col-lg-1">بحث</label>
        <input id="searchControl" type="text" class="form-control" />

    </div>
    <br />


</div>

<br />

<ul id="myUL" class="tree">
</ul>

<script>

    var IsShowMenu = false;
    var PublishId = 0;
    var toggler = document.getElementsByClassName("caretNode");
    var i;

    for (i = 0; i < toggler.length; i++) {
        toggler[i].addEventListener("click", function () {
            this.parentElement.querySelector(".nested").classList.toggle("active");
            this.classList.toggle("caretNode-down");
        });
    }

    $('#searchControl').on('keyup', function (keyEvent)
    {
        debugger;
        if (keyEvent.keyCode == 13)
        {
            CallMainNode();

        } else
        {
            var query = $("#searchControl").val();
            //if (query.length > 0)
            //{
                CallMainNode();
            //}
        }




    });

    CallMainNode();


    function CreateICView() {

         var url = '@Url.Action("AddIcSubjectView", "IC")'

        ShowDialog(url);

    }

    function AddIC() {

        var code = $("#Code").val().trim();
        var itemDisplay = $("#txtAreaSubject").val().trim();
        var icNumber = $("#DirectoryNum").val().trim();
      /*  var classificationId = $("#hdnClassificationId").val();*/
        if (icNumber == "") {
            ShowSuccesMessage("ادخل رقم الدليل  ")

            return;
        }

        if (itemDisplay == "") {
            ShowSuccesMessage("ادخل اسم الدليل   ")

            return;
        }

        if (code == "") {
            ShowSuccesMessage("ادخل كود الدليل   ")

            return;
        }
        //if (classificationId == "")
        //{
        //    ShowSuccesMessage("اختر التصنيف    ")

        //    return;
        //}

        var activeId = PublishId;

        $.ajax({
            url: '@Url.Action("AddIcSubject", "IC")',
            type: 'GET',
            data: { ITEM_CODE: code, ITEM_DISPLAY: itemDisplay, PARENT_ID: PublishId, DirectoryNum: icNumber, classificationId: 0 } ,
            cache: false,
            success: function (data) {

                if (data.NewIC == -1) {

                    ShowSuccesMessage("لم تتم عملية الاضافة بنجاح , رمز الكود موجود مسبقا  ")

                }

                if (data.NewIC == -2) {

                    ShowSuccesMessage("لم تتم عملية الاضافة بنجاح , رقم الدليل موجود مسبقا  ")

                }

                if (data.NewIC > 0) {

                    ShowSuccesMessage("تمت عملية الاضافة بنجاح")

                    __dialog.close();

                    if ($("#icSpanText_" + activeId).hasClass("caretNode")) {
                    } else {
                        $("#icSpanText_" + activeId).addClass("caretNode")
                    }

                    GetChild(activeId);
                }
            }
        });

    }


     function UpdateIC() {
         var code = $("#Code").val().trim();
         var itemDisplay = $("#txtAreaSubject").val().trim();
         var icNumber = $("#DirectoryNum").val().trim();
         var classificationId = $("#hdnClassificationId").val();
         if (icNumber == "") {
             ShowSuccesMessage("ادخل رقم الدليل  ")

             return;
         }

         if (itemDisplay == "") {
             ShowSuccesMessage("ادخل اسم الدليل   ")

             return;
         }

         if (code == "") {
             ShowSuccesMessage("ادخل كود الدليل   ")

             return;
         }

         if (classificationId == "")
         {
             ShowSuccesMessage("اختر التصنيف    ")

             return;
         }


         var activeId = PublishId;
        $.ajax({
            url: '@Url.Action("UpdateIC_SUBJECT", "IC")',
            type: 'GET',
            data: { id: PublishId, ITEM_CODE: code, ITEM_DISPLAY: itemDisplay, DirectoryNum: icNumber, classificationId: classificationId } ,
            cache: false,
            success: function (data) {

                if (data.Result == -1) {

                    ShowSuccesMessage("لم تتم عملية الاضافة بنجاح , رمز الكود موجود مسبقا  ")

                }

                if (data.Result == -2) {

                    ShowSuccesMessage("لم تتم عملية الاضافة بنجاح , رقم الدليل موجود مسبقا  ")

                }


                if (data.Result > 0) {
                    ShowSuccesMessage("تمت عملية التعديل  بنجاح")

                    __dialog.close();

                    $("#icSpanText_" + PublishId).text(itemDisplay);
                }
            }
        });

    }

    function UpdateICView() {


        if ($("#ic_li_" + PublishId).hasClass('mainNode')) {

            ShowSuccesMessage("لا يمكن التعديل على الدليل الرئيسي ");

            return
        }


        var url = '@Url.Action("UpdateIC_SUBJECTView", "IC")'

        ShowDialog(url + "?id=" + PublishId);
    }

    function DeleteIC() {

        var activeId = PublishId;

        if ($("#ic_li_" + PublishId).hasClass('mainNode')) {

            ShowSuccesMessage("لا يمكن حذف الدليل الرئيسي ");

            return
        }

        $.ajax({
            url: '@Url.Action("DeleteIC_SUBJECT", "IC")',
            type: 'GET',
            cache: false,
            data: { id: PublishId},
            success: function (data) {
                console.log(data);

                debugger;

                ShowSuccesMessage(data.MessageText);

                if (data.MessageType == 0 || data.MessageType == "0") {

                    var parentId = $("#ic_li_" + activeId).attr('data-parentID');

                    GetChild(parentId);

                }

            }
        });

    }


    function CallMainNode()
    {
        var query = $("#searchControl").val();
        $.ajax({
            url: '@Url.Action("GetIC_SUBJECTByParentId", "IC")',
            type: 'GET',
            data: { query: query},
            cache: false,
            success: function (data) {
                console.log(data);
                debugger
                if (data.Node.length > 0)
                {
                    $('#myUL li').each(function (i) {
                        $(this).hide();
                    });
                    var innerhtml = '';
                    for (let i = 0; i < data.Node.length; i++) {

                        $('#ic_li_' + data.Node[i].Id).show();

                        if (data.Node[i].HasChilds) {
                                innerhtml += "<li class='mainNode' id='ic_li_" + data.Node[i].Id + "'data-storeID=" + data.Node[i].Id + " id='ic_li_" + data.Node[i].Id + "' data-parentID='" + data.Node[i].Id + "' > <span  id='icSpanText_" + data.Node[i].Id + "' class='caretNode' onclick=GetChild(" + data.Node[i].Id + ")>" + data.Node[i].ITEM_DESCRIPTION_AR + "</span>  <ul class='nested' id='icNode_" + data.Node[i].Id + "'" + ">   </ul>  </li>";
                            
                        }
                        else {
                            if (data.Node.filter(a => a.Id == data.Node[i].PARENT_ID).length == 0) {
                                innerhtml += "<li data-storeid=" + data.Node[i].Id + " id='ic_li_" + data.Node[i].Id + "' data-parentid='" + data.Node[i].parentId + "'> <span id='icSpanText_" + data.Node[i].Id + "' class='' onclick='GetChild(" + data.Node[i].Id + ")'>" + data.Node[i].ITEM_DESCRIPTION_AR + "</span> <ul class='nested' id='icNode_" + data.Node[i].id + "'> </ul> </li>";
                            }

                        }


                    }
                    $("#myUL").html(innerhtml);


                }

               /* $("#myUL").html("<li class='mainNode' id='ic_li_" + data.Node[0].Id + "' data-parentID='" + data.Node[0].Id + "' > <span  id='icSpanText_" + data.Node[0].Id + "' class='caretNode' onclick=GetChild(" + data.Node[0].Id + ")></span>  <ul class='nested' id='icNode_" + data.Node[0].Id + "'" + ">   </ul> " + data.Node[0].ITEM_DESCRIPTION_AR +"  </li>");*/

            }
        });
    }



    function GetChild(id) {
        var query = $("#searchControl").val();
         $.ajax({
            url: '@Url.Action("GetIC_SUBJECTChildByParentId", "IC")',
            type: 'GET',
             data: { query:query,id:id},
            cache: false,
             success: function (data) {
                 debugger;
                console.log(data);
                 if (data.Node.length <= 0) { return; }

                 $("#icNode_" + id).html("");

                 for (i = 0; i < data.Node.length; i++) {

                     if (data.Node[i].HasChilds == true || data.Node[i].HasChilds == 'true' || data.Node[i].HasChilds == '1' || data.Node[i].IsLeaf == 1) {

                         $("#icNode_" + id).append("<li  data-storeID=" + data.Node[i].Id +" id='ic_li_" + data.Node[i].Id + "'  data-parentID='" + id + "'> <span  id='icSpanText_" + data.Node[i].Id + "' class='caretNode' onclick=GetChild(" + data.Node[i].Id + ") >" + data.Node[i].ITEM_DESCRIPTION_AR + "</span> <ul class='nested'  id='icNode_" + data.Node[i].Id + "'> </ul> </li>");

                     } else {

                         $("#icNode_" + id).append("<li data-storeID=" + data.Node[i].Id + " id='ic_li_" + data.Node[i].Id + "'   data-parentID='" + data.Node[i].PARENT_ID + "'> <span  id='icSpanText_" + data.Node[i].Id + "' class='' onclick=GetChild(" + data.Node[i].Id + ") >" + data.Node[i].ITEM_DESCRIPTION_AR + "</span> <ul class='nested'  id='icNode_" + data.Node[i].Id + "'> </ul> </li>");

                     }
                 }


                 if (data.Node.length == 0) {
                     $("#icSpanText_" + id).removeClass("caretNode-down");
                     $("#icSpanText_" + id).removeClass("caretNode");
                     $("#icNode_" + id).removeClass("active");


                 }


                 if ($("#icSpanText_" + id).hasClass("caretNode-down")) {
                     $("#icSpanText_" + id).removeClass("caretNode-down");
                    $("#icNode_" + id).removeClass("active");

                    return;
                 }
                 $("#icSpanText_" + id).addClass("caretNode-down");
                 $("#icNode_" + id).addClass("active");


            }
         });

        $(".selectedDataItem").removeClass("selectedDataItem")

        $("#ic_li_" + id).addClass("selectedDataItem");
    }

    $('#myUL').mousedown(function (event) {
        if ((event.which == 3) && (event.target.nodeName == 'SPAN')) {
            IsShowMenu = true;

            let text = $(event.target).attr("id");
            const myArray = text.split("_");
            PublishId = myArray[1];
            event.preventDefault();
        }
    });

    var menu = document.querySelector('.menu');
    function showMenu(x, y) {
        if (IsShowMenu == true) {
            menu.style.left = x + 'px';
            menu.style.top = y + 'px';
            menu.classList.add('show-menu');
            IsShowMenu == false;
        }
    }
    function hideMenu() {
        menu.classList.remove('show-menu');
    }
    function onContextMenu(e) {
        e.preventDefault();
        showMenu(e.pageX, e.pageY);
        document.addEventListener('click', onClick, false);
    }
    function onClick(e) {
        hideMenu();
        document.removeEventListener('click', onClick);
        IsShowMenu = false;
    }
    document.addEventListener('contextmenu', onContextMenu, false);


</script>

