@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models
@using System.Globalization

@{
    int taskId = Convert.ToInt32(ViewData["TaskId"]);
}

<div class="refusal_task sort dropdown">
    <a class="dropdown-toggle" href="#" data-bs-toggle="dropdown">
        <i data-bs-toggle="tooltip" data-placement="top" title='@DbRes.TResource("User.Task.Reject.Reject")' class="glyphicon glyphicon-remove"></i>
    </a>
    <div class="dropdown-menu animated zoomIn ">
        <form role="form" class="form-horizontal form-row">
            <div class="form-group">
                <label class="col-md-12 control-label">@DbRes.TResource("User.Task.Reject.RejectReason")</label>
                <div class="col-md-12">
                    <div class="">
                        <textarea class="rejectReasonTask form-control" rows="3" data-task-id='@taskId' data-id="@String.Format("task_reject_{0}", taskId)"></textarea>
                    </div>
                </div>
            </div>
            <div class="form-group footer_form">
                <div class="col-md-12">
                    <button class="pull-right btn btn-save" type="button"  disabled onclick='RejectTask(@taskId)' data-id="@String.Format("btnRejectTask{0}",taskId)">@DbRes.TResource("User.Task.Reject.Send")</button>
                    <a class="btn-link pull-right closePopUp">@DbRes.TResource("User.Task.Reject.Close")</a>
                </div>
            </div>
        </form>
</div>
</div>

