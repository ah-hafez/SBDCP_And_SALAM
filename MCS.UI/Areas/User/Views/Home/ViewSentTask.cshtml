@using MCS.UI.Areas.User.Models.Transaction
@using MCS.Framework.Localization
@model SentTaskVM

@{
    Layout = null;
}

<div class="content-rtl panel panel-default dialogbox_panel">
    <div class="panel-heading">
        <h3 class="panel-title">@DbRes.TResource("User.Task.SentTask.TaskDetails")</h3>
    </div>
    <div class="panel-body editor">
        <div class="row just_read">
            <div class="col-md-4">
                <div class="form-group">
                    <label class="col-md-5 control-label definition"> @DbRes.TResource("User.Task.SentTask.TaskNumber")</label>
                    <label class="col-md-7 control-label">@Model.Id</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="col-md-5 control-label definition"> @DbRes.TResource("User.Task.SentTask.Direction") </label>
                    <label class="col-md-7 control-label">@Model.ToOrgUnit</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="col-md-5 control-label definition"> @DbRes.TResource("User.Task.SentTask.DeliveryDate")</label>
                    <label class="col-md-7 control-label">@Model.DeliveryDateH</label>
                </div>
            </div>

        </div>
        <div class="row just_read group push-bottom">
            <div class="col-md-6">
                <div class="form-group">
                    <label class="col-md-4 control-label definition"> @DbRes.TResource("User.Task.SentTask.TaskDescription")</label>
                    <label class="col-md-8 control-label">@Model.TaskDescription </label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="col-md-4 control-label definition"> @DbRes.TResource("User.Task.SentTask.StatusName") </label>
                    <label class="col-md-8 control-label">@Model.StatusName </label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="col-md-4 control-label definition"> @DbRes.TResource("User.Task.SentTask.Notes")</label>
                    <label class="col-md-8 control-label">@Model.Notes </label>
                </div>
            </div>

        </div>
    </div>
</div>