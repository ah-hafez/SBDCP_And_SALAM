@using MCS.Common
@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.File
@model IList<TransactionTrayInfoVM>


<div class="boxes">
    <div class="d-flex flex-wrap align-content-start">
        @foreach (TransactionTrayInfoVM transactionTrayInfoVM in Model)
        {
            <!-- #Start# BOX -->
            <div class="box-grid">
                <div class="box no_sorting animated zoomIn buttons-action" id="box_@transactionTrayInfoVM.TransactionDetailsInfoVM.Id">
                    <div class="correspondence-t">
                        <div class="d-flex">
                            <div class="ml-auto d-flex">
                                <div>@transactionTrayInfoVM.TransactionDetailsInfoVM.DocumentNumber</div>
                            </div>
                        </div>
                    </div>
                    <div class="correspondence-h">
                        <div class="title">
                            @transactionTrayInfoVM.TransactionDetailsInfoVM.ExternalPartyName
                        </div>
                        <div class="date">
                            @transactionTrayInfoVM.TransactionDetailsInfoVM.Date
                        </div>
                    </div>
                    <div class="correspondence-b d-flex flex-wrap">
                        <div class="f-line w-full">
                            @if (transactionTrayInfoVM.TransactionDetailsInfoVM.Subject != null && transactionTrayInfoVM.TransactionDetailsInfoVM.Subject.Length > 30)
                            {
                                <div id="example" class="description" data-bs-toggle="tooltip" data-placement="bottom" title="@transactionTrayInfoVM.TransactionDetailsInfoVM.Subject">
                                    @transactionTrayInfoVM.TransactionDetailsInfoVM.Subject
                                </div>
                            }
                            else
                            {
                                <div class=" description">
                                    @transactionTrayInfoVM.TransactionDetailsInfoVM.Subject
                                </div>
                            }
                        </div>
                        <div class="f-line w-medium w-small">
                            <div class="heading">@DbRes.TResource("User.File.Priority")</div>
                            <div>@transactionTrayInfoVM.TransactionDetailsInfoVM.PriorityName</div>
                        </div>
                        <div class="f-line w-medium w-small">
                            <div class="heading">@DbRes.TResource("User.File.Confidentiality")</div>
                            <div>@transactionTrayInfoVM.TransactionDetailsInfoVM.ConfidentialityName</div>
                        </div>
                        <div class="f-line w-medium w-small">
                            <div class="heading">@DbRes.TResource("User.GeneralSearch.Type")</div>
                            <div>@transactionTrayInfoVM.TransactionDetailsInfoVM.TransactionTypeName</div>
                        </div>
                    </div>
                    <div class="correspondence-icon d-flex">
                        <div>
                            <a href="#" title="@DbRes.TResource("User.Copies.Show")" onclick="ViewTransaction(this)" data-transactionId="@transactionTrayInfoVM.TransactionDetailsInfoVM.Id"
                               data-transactionNumber="@transactionTrayInfoVM.TransactionDetailsInfoVM.DocumentNumber" data-orgUnitId="@transactionTrayInfoVM.TransactionDetailsInfoVM.OrgUnitId"
                               data-type="عرض" class="circle color-blue">
                                <i class="la la-folder-open-o"></i>
                            </a>
                            <a href="#" title="@DbRes.TResource("User.File.Assign")" onclick="Confirm(this)" data-transactionId="@transactionTrayInfoVM.TransactionDetailsInfoVM.Id"
                               data-transactionNumber="@transactionTrayInfoVM.TransactionDetailsInfoVM.DocumentNumber" data-orgUnitId="@transactionTrayInfoVM.TransactionDetailsInfoVM.OrgUnitId"
                               data-type="موافقة" class="aAssign circle color-red referral">
                                <i class="la la-download"></i>
                            </a>
                            <a href="#" title="@DbRes.TResource("User.Task.Reject.Send")" class="btnShowRejectionPopup circle color-delet" data-transactionId="@transactionTrayInfoVM.TransactionDetailsInfoVM.Id"
                               data-transactionNumber="@transactionTrayInfoVM.TransactionDetailsInfoVM.DocumentNumber" data-orgUnitId="@transactionTrayInfoVM.TransactionDetailsInfoVM.OrgUnitId"
                               data-type="رفض">
                                <i class="demo-icon icon-return"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

