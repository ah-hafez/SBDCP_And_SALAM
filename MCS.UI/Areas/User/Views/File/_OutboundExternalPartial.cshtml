                    @Html.Partial("~/Areas/User/Views/Transaction/_CopiesPartial.cshtml", new TransactionCopyVM())
                    @Html.Partial("~/Areas/User/Views/Transaction/_ExternalCopiesPartial.cshtml", new TransactionExternalCopyVM())
                </div>
            </div>
            <div role="tabpanel" class="tab-pane " id="fifth-tab">
                <div class="content_container content_container--body white-bg">
                    @*@Html.Partial("~/Areas/User/Views/Transaction/_ExternalCopiesPartial.cshtml", new TransactionExternalCopyVM())*@
                </div>
            </div>
            <div role="tabpanel" class="tab-pane " id="sixth-tab">
