</div>
<div class="row text-right mr-5 mt-4 ml-xs-3 mb-4">
    @Html.ConfirmAction(OperationType.Save, "btnSaveOutboundExternal", DbRes.TResource("User.OutboundDraft.Edit"), "AddOutboundExternal", null, null, null, "OnSuccess", null, DbRes.TResource("User.OutboundExternal.SaveMessage"), "post", "frmAddOutboundExternal", "BasicInformation", "btn btn-st1 btn-lg pull-right", "CheckPriorityIfHasDate", UserClaims.Outbound.CreateExternalOutbound, "NotValid")
