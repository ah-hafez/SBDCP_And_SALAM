    <script>
    function checkNumber()
    {

        if ($('.boxes input:checked').length > 0)
        {
            $('.sidebarMultiOptions').removeClass('invisible')
        }
        else
        {
            $('.sidebarMultiOptions').addClass('invisible')
        }



        if (!IsAllChecked)
        {
            $("#transactionsAssignmentIds").val("");


        } else
        {

            var assignmentSelectedList = [];

            $('.boxes input:checkbox').each(function ()
            {
                assignmentSelectedList.push($(this).data("assignmentid"));

            });

            $("#transactionsAssignmentIds").val(assignmentSelectedList.join(","));


        }


        }



    var sentTransactionEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File",new { trayId = "TrayType", dateType = ViewData["dateType"] ?? 1584 }))";
    function prepareSentTransaction(trayId, optionalData) {

        $(".grid-mvc").gridmvc();
        var newURL = sentTransactionEventHandler.replace("TrayType", trayId);
        pageGrids.SentTransactionGrid.ajaxify(
            {
                getPagedData: newURL,
                getData: newURL,
                requestType: "POST",
                callbackClientFunctionAfter: ["goToViewAfterPaging", "reRegisterRevertButton"],
                optionalData: optionalData
            });
    }

    $(document).ready(function () {
        $('#AssignDate').attr('autocomplete', 'off');
        $("#list_transaction").find(".view_group:first").trigger("click");
        reRegisterRevertButton();
        $('#CheckAllBoxes').prop("disabled", false);

        $('#CheckAllBoxes').change(function ()
        {
            checkNumber();
        });


        $('#checkbox .FillIds').click(function ()
        {
            if (!$(this).is(':checked'))
            {
                return confirm("Are you sure?");
            }
        });



    });


    $(".view_group").click(function (e) {

        $(".view_group").removeClass("select");
        $(this).addClass("select");

        var type = $(this).data("type");
        var id = $(this).data("id");
        var trayId = $(this).data("tray");

        var data = {
            trayId: trayId, transactionId: id, transactionCategoryId: type
        };

        $.ajax({
            url: '@Url.Action("Index","Editor")',
            type: 'Get',
            cache: false,
            data: data,
            success: function (data) {
                $("#editor_transaction").html("");
                $("#editor_transaction").html(data);
                jQuery.validator.unobtrusive.parse('#editor_transaction');
            },
            error: function (a) {
            }
        });
    })

    var dataToMoveTransaction;
    function reRegisterRevertButton() {

        $(".aRevert").click(function (e) {

            e.stopPropagation();
            var currentTarget = $(event.currentTarget);
            var isViewed = currentTarget.data('viewed');
            var deliveryMethodId = currentTarget.data('deliverymethodid');
            var transactionType = currentTarget.data('transactiontypeid');
            var Id = currentTarget.data('id');

            var trayid = parseInt($("#hdnTrayId").val());
            var page = $("#hdnCurrentPage").val();
            var orderBy = $("#hdnOrderBy").val();
            var dir = $("#hdnDirection").val();
            var filter = $("#hdnFilter").val();
            var fromDate = $("#hdnFromDateValue").val();
            var toDate = $("#hdnToDateValue").val();
            var number = $("#hdnSearchTransactionNumberValue").val();
            var viewType = $("#hdnViewFile").val();
            var dateType = $("#hdnFilterDateType").val();
            var transactionId = $(this).data("id");
            var trayActionType = $(this).data("type");
            var PageSize = $("#ddlPaging").val();

            dataToMoveTransaction = {
                trayId: trayid, page: page, gridColumn: orderBy, dir: dir, filter: filter, fromDate: fromDate,
                toDate: toDate, searchColumn: number, viewType: viewType, transactionId: transactionId, trayActionType: trayActionType
                , dateType: dateType, pageSize: PageSize
            };

            @*if (JSON.parse(isViewed.toLowerCase()) == false && deliveryMethodId == DeliveryMethodType.ElectronicPaper) {
                ShowVerifyTransactionNumberOrBarcode('@Url.Action("VerifyTransactionNumberOrBarcode", "Inbound")', Id, transactionType);
            }
            else {
                MoveTransactionFile(dataToMoveTransaction)
            }*@

            MoveTransactionFile(dataToMoveTransaction)
        });
    }

    function ExecuteTargetFunction() {

        MoveTransactionFile(dataToMoveTransaction);
    }

    function MoveTransactionFile(dataToMoveTransaction) {
        debugger
        $.ajax({
            url: '@Url.Action("MoveTransaction","File")',
            type: 'POST',
            data: dataToMoveTransaction,
            success: function (data) {
                if (data.MessageType != 2) {
                    //$("#dvTransactionsContainer").html("");
                    //$("#dvTransactionsContainer").html(data.Html);
                    //$("#txtCurrentPage").val(page);
                    //$("#hdnCurrentPage").val(page);
                    //$("#ddlPaging option[value=" + PageSize + "]").attr('selected', 'selected');

                    //$("li#_UserFileMenu").html("");
                    //$("li#_UserFileMenu").html(data.FileMenuHtml);
                    window.location.href = '@Url.Action("SentTransactions", "File")';
                    UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }
    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {

        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {

        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }
    function doSort(obj) {


        var SortData = $('#hdn' + obj.id).val();
        updateSortingData(currentIndex, SortData, obj);

        var filters = $("#hdnFilter").val();
        var sortDataResult = { trayId: @trayId, sortType: obj.id, dir: SortData, searchData: SortData, SortingOrders: sortingOrders, filter: filters };

        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortDataResult,
            success: function (data) {
                $('#transBoxes').html("");
                $('#transBoxes').html(data.Html);
                goToViewAfterPaging();
                prepareSentTransaction(@trayId, sortDataResult);
                reRegisterRevertButton();
            }
        });
    }
    function fillHidden(obj) {

        $('#hdn' + obj.id).val("");
        $('#hdn' + obj.id).val(obj.value);
    }

    function FilterBy() {

        var trayid = @trayId;
        var filter = "";
        if ($("#TransId").val() != "" && $("#TransId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Number__1__" + $("#TransId").val();
        }

        if ($("#hdnAssignDate").val() != "" && $("#hdnAssignDate").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "AssignDate__1__" + $("#hdnAssignDate").val();
        }
        if ($("#Descri").val() != "" && $("#Descri").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Subject__2__" + $("#Descri").val();
        }
        $("#hdnFilter").val(filter);

        var filterData = { trayId: trayid, filter: filter, SortingOrders: sortingOrders };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterData,
            success: function (data) {
                $('#transBoxes').html("");
                $('#transBoxes').html(data.Html);
                goToViewAfterPaging();
                reRegisterRevertButton();
                prepareSentTransaction(@trayId, filterData);
            }
        });
    }

    function OpenTransaction(transId) {

        var trayid = 4;
        var filter = "";

        if (transId != "" && transId != null && transId > 0) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Id__1__" + transId;
        }

        var data = {
            trayId: trayid, filter: filter

        };

        window.location.href = '@Url.Action("GetTransactionDetails", "File")?trayId=' + trayid + '&transId=' + transId;
    }

    function ShowTransactionLog(transactionId) {

     var trxId=   EncryptionKey(transactionId);
        var url = '@Url.Action("Index", "TransactionLog")' + '?transactionId=' + trxId.toString() + "&transactionCategory=" + @((int)TransactionCategory.Inbound);
        ShowDialog(url, 'dialogbox col-md-12');
    }


    function HideTransaction(id, transactionId ) {
          $.ajax({
            url: '@Url.Action("HideTransactionAssignment", "Editor")',
            type: 'POST',
              data: { id: id, transactionId: transactionId },
              success: function (data) {

                if (data.MessageType == 2) {
                    ShowErrorMessage(data.MessageText);
                } else {
                    window.location.reload();
                }
            }
        });
    }

    function HideTransactionAll()
        {
            var transactionIds = $('#transactionsIds').val();
            var assignmentIds = $('#transactionsAssignmentIds').val();
          $.ajax({
            url: '@Url.Action("HideTransactionAssignments", "Editor")',
            type: 'POST',
              data: { assignmentIds: assignmentIds, transactionIds: transactionIds },
              success: function (data) {

                if (data.MessageType == 2) {
                    ShowErrorMessage(data.MessageText);
                } else {
                    window.location.reload();
                }
            }
        });
    }

    function goToView(id) {

        var dateType= parseInt('@Convert.ToInt32(TransactionDateType.Any)');
        var TypeData = { trayId: '@Convert.ToInt32(TrayType.SentTransactions)', dateType: dateType, PageSize: @ViewData["PageSize"]!= null ?@ViewData["PageSize"]: '@UIHelper.PageSize', renderType : id};
        $("#transBoxes").html("");
            $.ajax({
                url: '@Url.Action("UpdateTrayTransactions","File")',
                type: 'POST',
                data: TypeData,
                 success: function (data) {
                $('#transBoxes').html("");
                $('#transBoxes').html(data.Html);
                goToViewAfterPaging();
                     prepareSentTransaction(@trayId, TypeData);
                reRegisterRevertButton();
            },
                error: function (a) {
                }
            });
        }


        function SentCheckboxChange(chk)
        {
            var oldIds = $("#transactionsAssignmentIds").val();
            var trainindIdArray = oldIds.split(',');
            var assignmentId = $(chk).data("assignmentid");

            if ($(chk).is(':checked'))
            {
                trainindIdArray.indexOf(assignmentId) === -1 ? trainindIdArray.push(assignmentId) : "";
            } else
            {
                trainindIdArray.splice($.inArray(assignmentId, trainindIdArray), 1);
            }

            $("#transactionsAssignmentIds").val(trainindIdArray.join(","));
        }
    </script>
