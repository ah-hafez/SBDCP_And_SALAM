@model Classification
@using MCS.Common
@using MCS.Framework.Controls.Mvc
@using MCS.Framework.Controls
@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Archives


<h2 class="site-color main-title " style="margin-left:40px; font-size:20px; font-weight:bold;">@DbRes.TResource("User.File.Classification.Return")</h2>
<div class="content_container content_container--body white-container">
    <div class="row col-lg-4 col-md-4 col-sm-4">
        <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-3">
            <label>@DbRes.TResource("User.File.Classification.Number") <span class="stark">*</span></label>
            @Html.TextBoxGroupFor(model => model.TransactionNum, "", new { @class = "form-control", maxlength = "5" })
        </div>
    </div>
    
    <div class="mb-3 col-lg-6" style="margin-top:34px;">
        <label class="container" style="color: #233f2d;">
            <input type="checkbox">
            @DbRes.TResource("User.File.Classification.Delete")
        </label>
    </div>
    <div class="form-group w-100 col-lg-12" style="direction:ltr">
        @Html.ConfirmAction(OperationType.Save, "btnSaveOutboundExternal", DbRes.TResource("User.File.Classification.ReturnClassificate"), "AddOutboundExternal", null, null, null, "OnSuccess", null, DbRes.TResource("User.File.Classification.ReturnMessage"), "post", "frmAddOutboundExternal", "BasicInformation", "btn btn-st1 btn-lg", "CheckPriorityIfHasDate", "", "NotValid")
        <input class="btnSendOutbound btn-site" style="display:none;" type="button" value="@DbRes.TResource("User.OutboundExternal.Add.sent")" />
    </div>
</div>

<style>
    .white-container{
        margin:9px;
    }
</style>
