<script>
    var urlActionPage = "";
    function Open(Id, EncryptedId) {
         
        var currentTarget = $(event.currentTarget);
        var type = $('#hdnTransactionType_' + Id).val();
        var IsDraft = currentTarget.data("isdraft");
        var isHubEditable = currentTarget.data('ishubeditable');

        urlActionPage;
        switch (type) {
            case '@TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)':
                controllerName = 'Inbound';
                urlActionPage = '@Url.Action("Edit", "Inbound")?id=-1';
                break;
            case '@TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)':
                controllerName = 'OutboundExternal';
                urlActionPage = '@Url.Action("Edit","OutboundExternal")?id=-1&IsFromDraft=' + IsDraft + '&isHubEditable=True';
                break;
            case '@TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)':
                controllerName = 'OutboundInternal';
                urlActionPage = '@Url.Action("Edit", "OutboundInternal")?id=-1';
                break;
            case '@TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)':
                controllerName = 'OutboundDraft';
                urlActionPage = '@Url.Action("Edit", "OutboundDraft")?id=-1';
                break;
        }
        urlActionPage = urlActionPage.replace("-1", EncryptionKey(EncryptedId));
        ExecuteTargetFunction();
    }

    function ExecuteTargetFunction() {
        window.location.href = urlActionPage;
    }

    function OpenEditor(trayId, id, type) {
        window.location.href = '@Url.Action("Index","Editor")?trayId=' + trayId + "&transactionId=" + id + "&transactionCategoryId="+type;
	}

    var reservationEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File",new { trayId = "TrayType", dateType = ViewData["dateType"] ?? 1584 }))";
    function prepareReservation(trayId, optionalData) {
        $(".grid-mvc").gridmvc();
        var newURL = reservationEventHandler.replace("TrayType", trayId);
        pageGrids.ReservationGrid.ajaxify(
            {
                getPagedData: newURL,
                getData: reservationEventHandler,
                requestType: "POST",
                callbackClientFunctionAfter: ["goToViewAfterPaging"],
                optionalData: optionalData
            });
    }

    function filterByReserveType(obj, trayId) {
        $("div.mr-auto.filter-link a ").removeClass("active");
        $(obj).addClass("active");

        $('#trayId').val(trayId);
        var filterByReserveTypeData = { trayId: trayId, dateType: '@Convert.ToInt32(TransactionDateType.Any)' };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterByReserveTypeData,
            success: function (data) {
                $("#TransactionsBoxes").html(data.Html);
                unfillSelectedAll();
                prepareReservation(trayId, filterByReserveTypeData);
                goToViewAfterPaging();
            },
            error: function (a) {
            }
        })
        $("#TransactionsBoxes").html("");
    }

    var _this = null;

    $(document).ready(function () {
        $('#DateCal').attr('autocomplete', 'off');
        $("#list_transaction").find(".view_group:first").trigger("click");
    })
    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }

    function doSort(obj, value) {
        updateSortingData(currentIndex, value, obj);
        var filters = $("#hdnFilter").val();
        var sortData = { trayId: parseInt($('#trayId').val()), sortType: obj.id, dir: value, searchData: value, SortingOrders: sortingOrders, filter: filters };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                prepareReservation(sortData);
                goToViewAfterPaging();
            }
        });
    }



    function fillHidden(obj) {
        $('#hdn' + obj.id).val("");
        $('#hdn' + obj.id).val(obj.value);
    }

    function FilterBy() {
         
        var trayid = parseInt($('#trayId').val());
        var filter = "";

        if ($("#hdnPriorityLevelId").val() != "" && $("#hdnPriorityLevelId").val() != null) {

            filter += "Priority__1__" + $("#hdnPriorityLevelId").val();
        }
        if ($("#hdnConfidentialityLevelId").val() != "" && $("#hdnConfidentialityLevelId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Confidentiality__1__" + $("#hdnConfidentialityLevelId").val();
        }
        if ($("#TransId").val() != "" && $("#TransId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Number__1__" + $("#TransId").val();
        }
        if ($("#hdnExternalPartyId").val() != "" && $("#hdnExternalPartyId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "ExternalParty__1__" + $("#hdnExternalPartyId").val();
        }
        if ($("#hdnDocTypeId").val() != "" && $("#hdnDocTypeId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "LetterType__1__" + $("#hdnDocTypeId").val();
        }
        if ($("#hdnDateCal").val() != "" && $("#hdnDateCal").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Date__1__" + $("#hdnDateCal").val();
        }
        $("#hdnFilter").val(filter);

        var filterData = { trayId: trayid, filter: filter, SortingOrders: sortingOrders };

        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                prepareReservation(filterData);
                goToViewAfterPaging();
            }
        });
    }

     $(".aMarkSelectedSeen").click(function (e)
     {
         _this = this;
        ShowConfirmMessage('@(DbRes.TResource("User.File.View"))', "MarkSelectedSeen");
    })

    function MarkSelectedSeen()
    {

        var trayid = parseInt($("#hdnTrayId").val());
        var transactionIds = $('#transactionsIds').val();
        var transactionTypeId = 16;
        var trayActionType = '@TrayActionType.Viewed';
        var url2 = '@Url.Action("MoveElectronicTransactionsCopies", "File")';

        var data = {
            trayId: trayid, TransactionsIds: transactionIds, trayActionType: trayActionType,
        };

        $.ajax({
            url: url2,
            type: 'post',
            data: data,
            success: function (data) {
                if (data.MessageType != 2) {
                    window.location.href = '@Url.Action("Copies", "File")';
                    UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }

            },
            error: function (a) {

                alert(a)
            }
        });

    }


</script>
