
<div class="tab-content">
    <div class="tab-pane active">
        <div class="boxes px-md-2 grid-mvc table-view">
            <div class="tbody">
                <div id="DirectoryCards" class="d-flex flex-wrap mx-auto mx-md-4">
                    <div class="box-grid">
                        <div class="box animated zoomIn buttons-action">
                            <div class="header">
                                <label class="DirectoryNum">1</label>
                                -
                                <label class="DirectoryCode">242</label>
                            </div>
                                <label class="DirectoryClass">التصنيف</label>
                                <div class="correspondence-icon d-flex" style="gap:3px">
                                    <hr style="border:1px solid green" />

                                    <div>
                                        <a title="تعديل" href="~/User/File/DirectoryEdit">
                                            <img src="~/Content/User/lib/images/SystemIcon/main bar-24.svg" width="30" />
                                        </a>

                                    </div>

                                    <div>
                                        <a id="OpenEditor" title="معاينة" onclick="Editor()">
                                            <img src="~/Content/User/lib/images/SystemIcon/main bar-22.svg" width="30" />
                                        </a>
                                    </div>
                                </div>
                   
                         </div> 
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .box {
        background: #f6f6f6;
        border: 3px solid white;
        text-align: center;
    }
    .header {
        display: flex;
        gap: 5px;
        padding-right:10px;
    }
    .DirectoryCode {
        font-size: 16px;
        font-weight: bold;
    }
    .DirectoryNum {
        font-size: 16px;
        font-weight: bold;
    }
    .DirectoryClass {
        color: black;
        font-size: 16px;
        font-weight: bold;
        margin: 16px 0px 16px 0px;
    }
    .DirectoryCode label {
        font-size: 20px;
        font-weight: bold;
        margin-top: -12px;
    }
    .correspondence-icon{
        padding:1px 10px;
    }
    label {
        color: #a9a9a9;
    }
</style>

<script>
    function Editor() {

        url = '@Url.Action("DirectoryEditor", "File")'
        ShowDialog(url,'dialogbox col-md-12 ');
    }
</script>