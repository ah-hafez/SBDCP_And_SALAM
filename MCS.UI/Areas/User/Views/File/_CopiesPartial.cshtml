    function FilterBy() {
        var trayid = parseInt($('#trayId').val());
        var filter = "";

        // if ($("#hdnPriorityLevelId").val() != "" && $("#hdnPriorityLevelId").val() != null) {

        //     filter += "Priority__1__" + $("#hdnPriorityLevelId").val();
        //}
        // if ($("#hdnConfidentialityLevelId").val() != "" && $("#hdnConfidentialityLevelId").val() != null) {

        //    if (filter.length > 0) {
