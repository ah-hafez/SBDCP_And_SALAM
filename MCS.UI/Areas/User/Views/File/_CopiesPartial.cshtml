<script>
    var copiesEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File",new { trayId = "TrayType", dateType = ViewData["dateType"] ?? 1584 }))";
    function prepareCopies(trayId, optionalData) {
        $(".grid-mvc").gridmvc();
        var newURL = copiesEventHandler.replace("TrayType", trayId);
        pageGrids.CopiesGrid.ajaxify(
            {
                getPagedData: newURL,
                getData: copiesEventHandler,
                requestType: "POST",
                callbackClientFunctionAfter: ["goToViewAfterPaging"],
                optionalData: optionalData
            });
    }

    function filterByCopyType(obj, trayId) {

        $("div.mr-auto.filter-link a ").removeClass("active");
        if (obj != null)
        {
            $(obj).addClass("active");
        }


        $('#trayId').val(trayId);
        var filterByCopyTypeData = { trayId: trayId, dateType: '@Convert.ToInt32(TransactionDateType.Any)', PageSize: @ViewData["PageSize"]!=null?@ViewData["PageSize"]: '@UIHelper.PageSize' };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterByCopyTypeData,
            success: function (data) {
                $("#TransactionsBoxes").html(data.Html);
                unfillSelectedAll();
                prepareCopies(trayId, filterByCopyTypeData);
                goToViewAfterPaging();
            },
            error: function (a) {
            }
        })
        $("#TransactionsBoxes").html("");
    }

    var _this = null;

    $(document).ready(function () {
        $("#list_transaction").find(".view_group:first").trigger("click");
    })



    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }
    function doSort(obj, value) {
        debugger;
        updateSortingData(currentIndex, value, obj);
        var filters = $("#hdnFilter").val();

        var sortData = { trayId: parseInt($('#trayId').val()), sortType: obj.id, searchData: value, dir: value, SortingOrders: sortingOrders, filter: filters};
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                prepareCopies(parseInt($('#trayId').val()), sortData);
                goToViewAfterPaging();
            }
        });
    }

    $(document).ready(function () {
    $('#fromDateCal').attr('autocomplete', 'off');
    $('#toDateCal').attr('autocomplete', 'off');

    var year = @DateTimeUtility.GetHijriYear(DateTime.Now).ToString();
        var type = '@CalenderType.Ummalqura.ToString().ToLower()';
        //SetStartEndDate(year, 'fromDateCal', 'toDateCal', type);
    });
 var type = '@CalenderType.Ummalqura.ToString().ToLower()';
    var year = parseInt($('#ddlYear').val());

    SetStartEndDate(year, 'fromDateCal', 'toDateCal', type);


        $(document).ready(function () {
            $('#fromDateCal').attr('autocomplete', 'off');
            $('#toDateCal').attr('autocomplete', 'off');
        });


    $('#ddlYear').change(function () {

        if ($('#ddlYear').val() != '') {

            var year = parseInt($('#ddlYear').val());

            SetStartEndDate(year, 'fromDateCal', 'toDateCal', type);
        }
    });

    $('#fromDateCal, #toDateCal').change(function () {

        var dateFrom = $('#hdnFromDateUm').val();
        var dateTo = $('#hdnToDateUm').val();

        if (dateFrom != null && dateFrom != '' && dateTo != null && dateTo != '') {

            var splitDateFrom = dateFrom.split("/");
            var splitDateTo = dateTo.split("/");

            if (splitDateTo[2] == splitDateFrom[2]) {

                $('#ddlYear').val(splitDateTo[2]);
            }
            else {

                $('#ddlYear').val('');
            }
        }
        else {

            $('#ddlYear').val('');
        }
    });

    function fillHidden(obj) {
        $('#hdn' + obj.id).val("");
        $('#hdn' + obj.id).val(obj.value);
