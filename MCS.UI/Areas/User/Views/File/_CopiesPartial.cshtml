            if (filter.length > 0) {
                filter += "&";
            }
            filter += "FromEntity__1__" + $("#hdnEntityId").val();
        }
        if ($("#hdnDateCal").val() != "" && $("#hdnDateCal").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Date__1__" + $("#hdnDateCal").val();
