                        <a data-type="Table" onclick="goToView(2)" href="#" class="active grid_system Darkgreen font-size-16">
                            <i class="uicon icon_table Darkgreen font-size-16"></i>
                            <span class="Darkgreen font-size-16">
                                جدول
                            </span>
                        </a>
                    }
                    else
                    {
                        <a data-type="Card" onclick="goToView(1)" href="#" class="active system_1">
                            <i class="uicon icon_cards Darkgreen font-size-16"></i>
                            <span class="Darkgreen font-size-16">
                                بطاقات
                            </span>
                        </a>
                        <a data-type="Table" onclick="goToView(2)" href="#" class="active grid_system">
                            <i class="uicon icon_table Darkgreen font-size-16"></i>
                            <span class="Darkgreen font-size-16">
                                جدول
                            </span>
                        </a>
                    }
                    <div class="toggling-menu">


                    </div>
                </div>
            </div>
        </div>
    </div>

    <form>
        <div class="search mx-5 mx-xs-3 white-container mt-2 pb-2 filter-box">
            <div class="form-row">
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    <label class="">@DbRes.TResource("User.Transaction.Link.TransactionNumber")</label>
                    <input type="text" class="form-control trans-input" id="TransId" onkeypress="return IsNumeric(event);">
                    @Html.StickyHidden("hdnTransId", "", null)
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    <label class=" "> @DbRes.TResource("User.Transaction.SortbyPriorityLevel")</label>
                    @Html.AutoCompleteBuilder("PriorityLevelId", "hdnPriorityLevelId", ViewData["PrioritiesDataForSearch"].ToString(), "", true, "form-control", "", "", "", true)
                    @Html.StickyHidden("hdnPriorityLevelId", "", new { @Value = "", id = "hdnPriorityLevelId" })
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    <label class="">@DbRes.TResource("User.Transaction.SortbyConfLevel")</label>
                    @Html.AutoCompleteBuilder("ConfidentialityLevelId", "hdnConfidentialityLevelId", ViewData["ConfidentialityDataForSearch"].ToString(), "", true, "form-control", "", "", "", true)
                    @Html.StickyHidden("hdnConfidentialityLevelId", "", new { @Value = "", id = "hdnConfidentialityLevelId" })
                </div>

                <div class="col-xs-12 panel-body row text-right">
                    <input type="button" value="@DbRes.TResource("User.Search.SubmitSearch")" class="btn btn-st2" onclick="FilterBy()" />
                </div>
            </div>
        </div>
        <div class="search mx-5 mx-xs-3 white-container mt-2 pb-2 order-box">
            <div class="form-row">
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    <label class=""> @DbRes.TResource("User.Transaction.SortbyTransactionNum")</label>
                    @Html.AutoCompleteBuilder("Number", "hdnNumber", ViewData["NumberAcsDesc"].ToString(), "", true, "form-control", onChangeCallback: "doSort")
                    @Html.StickyHidden("hdnNumber", "", new { @Value = "", id = "hdnNumber" })
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    <label class="">@DbRes.TResource("User.Transaction.DateCopleted")</label>
                    <div id="datePicker">
                        @Html.AutoCompleteBuilder("Date", "hdnDate", ViewData["SortByDate"].ToString(), "", true, "form-control", onChangeCallback: "doSort")
                        @Html.StickyHidden("hdnDate", "", new { @Value = "", id = "hdnDate" })
                    </div>
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    <label class=" "> @DbRes.TResource("User.Transaction.SortbyPriorityLevel")</label>
                    @Html.AutoCompleteBuilder("Priority", "hdnPriority", ViewData["PrioritiesData"].ToString(), "", true, "form-control", onChangeCallback: "doSort")
                    @Html.StickyHidden("hdnPriority", "", new { @Value = "", id = "hdnPriority" })
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    <label class=""> @DbRes.TResource("User.Transaction.SortbyConfLevel")</label>
                    @Html.AutoCompleteBuilder("Confidentiality", "hdnConfidentiality", ViewData["ConfidentialityData"].ToString(), "", true, "form-control", onChangeCallback: "doSort")
                    @Html.StickyHidden("hdnConfidentiality", "", new { @Value = "", id = "hdnConfidentiality" })
                </div>
            </div>
        </div>
    </form>


    <div class="content_container content_container--body" id="TransactionsBoxes">
        @Html.Partial("~/Areas/User/Views/File/_SavedBoxesPartial.cshtml", Model)
    </div>
    @Html.StickyHidden("hdnFilter")
</div>


<div class="sidebarMultiOptions invisible transparent-bg">
    <div class="options-list d-flex">

        <div class="d-flex mr-auto info-bottom">
            <a class="align-self-start close-box" href="javascript:toggleSelectedPaperBox()">
                <i class="uicon icon_arrow_down"></i>
            </a>
            <span class="paper_count"></span>
            <span>@DbRes.TResource("User.Transaction.Count")</span>

        </div>
        <div class="d-flex bottom-actions text-right" id="TransactionSavedAction">
            <div class="d-flex text-center">
                @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Files.SaveRetrieve))
                {
                    using (Html.BeginForm("MoveTransactionsList", "File", FormMethod.Post, new { id = "frmRevert" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.StickyHidden("trayId", trayId.ToString(), new { id = "trayId" })
                         
                            <input type="hidden" id="transactionsIds" name="transactionsIds" value="" />
                            <input type="hidden" id="trayActionType" name="trayActionType" value="" />
                            <a onclick="MultipleRevert()" class="boardered-circle-transparent"><img src="~/Content/User/lib/images/SystemIcon/main bar-36.svg" width="25"></a>
                            <a onclick="MultipleRevert()">@DbRes.TResource("User.Saved.ReturnsTransactions")</a>
                            @Html.ConfirmAction(OperationType.Save, "btnRevert", "ارجاع", "MoveTransactionsList", null, null, null, "ReloadPage", null, DbRes.TResource("User.Saved.ReturnsTransactions.Message"), "post", "frmRevert", "BasicInformation", "btn-site hidden_", "", UserClaims.Inbound.CreateInbound, "NotValid")
                            @Html.ConfirmAction(OperationType.Save, "btnRevertCopy", "ارجاع", "MoveElectronicTransactionsCopies", null, null, null, "ReloadPage", null, DbRes.TResource("User.Saved.ReturnsTransactions.Message"), "post", "frmRevert", "BasicInformation", "btn-site hidden_", "", UserClaims.Inbound.CreateInbound, "NotValid")

                        
                    }
                }
            </div>
            <a href="javascript:closeSendActionShowMessage()" class="close-box close-box-md hidden-success"><i class="uicon icon_close"></i></a>
        </div> 
    </div>
    <div class="bottom-white selected-papers-wrapper">
        <div class="col-xs-12">
            <ul class="papers-selected"></ul>
        </div>
    </div>


    <div class="bottom-white msg-bottom-box msg-confirm-box">
        <div class="col-xs-12 col-sm-6">
            <h4 class="title4">
                <i class="glyphicon glyphicon-question-sign"></i>
                <span>سيتم نقل المعاملات الى قائمة المعاملات المنجزة</span>
            </h4>
        </div>
        <div class="col-sm-6 text-right">
            <a class="btn-site " href="javascript:closePaperSendToDone()">الغاء</a>
            <a class="btn-site" href="javascript:sendActionShowMessage()">موافق</a>
        </div>
    </div>

    <div class="bottom-white msg-bottom-box success-done-msg">
        <div class="col-xs-12 col-sm-6">
            <h4 class="title4">
                <i class="glyphicon glyphicon-ok"></i>
                <span>تم نقل المعاملات الى قائمة المعاملات المنجزة بنجاح</span>
            </h4>
        </div>
        <div class="col-sm-6 text-right">
            <a class="btn-site" href="#">الذهاب الى المعاملات المنجزة</a>
        </div>
    </div>
</div>



<script>



    var savedEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File",new { trayId = "TrayType", dateType = ViewData["dateType"] ?? 1584 }))";
    function prepareSaved(trayId, optionalData) {
        $(".grid-mvc").gridmvc();
        var newURL = savedEventHandler.replace("TrayType", trayId);
        pageGrids.Saved.ajaxify(
            {
                getPagedData: newURL,
                getData: savedEventHandler,
                requestType: "POST",
                callbackClientFunctionAfter: ["goToViewAfterPaging"],
                optionalData: optionalData
            });
    }

    function filterByCopyType(obj, trayId) {
        debugger;
        $("div.mr-auto.filter-link a ").removeClass("active");
        if (obj != null)
        {
            $(obj).addClass("active");
        }


        $('#trayId').val(trayId);
        var filterByCopyTypeData = { trayId: trayId, dateType: '@Convert.ToInt32(TransactionDateType.Any)', PageSize: @ViewData["PageSize"]!=null?@ViewData["PageSize"]: '@UIHelper.PageSize' };
           $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterByCopyTypeData,
               success: function (data) {
                   debugger;
                $("#TransactionsBoxes").html(data.Html);
                unfillSelectedAll();
                prepareSaved(trayId, filterByCopyTypeData);
                goToViewAfterPaging();
            },
            error: function (a) {
            }
        })
        $("#TransactionsBoxes").html("");
    }
    $(document).ready(function () {
        $("#list_transaction").find(".view_group:first").trigger("click");
        reRegisterSaveRevertButton();
    })

    $(".view_group").click(function (e) {
        debugger;
        if ($(e.target).hasClass('aSaveRevert'))
            return;

        $(".view_group").removeClass("select");
        $(this).addClass("select");

        var id = $(this).data("id");

        switch ($(this).data("type")) {

           case @(TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)):
            case @(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)):
                $.ajax({
                    url: '@Url.Action("InboundCertificate", "File")',
                    type: 'Get',
                    cache: false,
                    data: { transactionId: id },
                    success: function (data) {
                        $("#editor_transaction").html("");
                        $("#editor_transaction").html(data);
                        jQuery.validator.unobtrusive.parse('#editor_transaction');
                    },
                    error: function (a) {
                    }
                });
                break;

            case @(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)):
            case @(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)):
                $.ajax({
                    url: '@Url.Action("OutboundCertificate","File")',
                    type: 'Get',
                    cache: false,
                    data: { transactionId: id },
                    success: function (data) {
                        $("#editor_transaction").html("");
                        $("#editor_transaction").html(data);
                        jQuery.validator.unobtrusive.parse('#editor_transaction');
                    },
                    error: function (a) {
                    }
                });
                break;

        }
        return false;
    })

    function reRegisterSaveRevertButton() {
        debugger;
        $(".aSaveRevert").click(function (e) {
            debugger;

            if ($('#trayId').val() == @((int)TrayType.Saved)) {
                $('#transactionsIds').val($(this).data("id"));
                $('#trayId').val(@trayId);
                $('#trayActionType').val($(this).data("type"));
                $('#btnRevert').click();

            } else {

                  $('#trayActionType').val(@((int)TrayActionType.UndoDeleteCopy));
                 $('#transactionsIds').val($(this).data("id"));
                $('#trayId').val(@trayId);
                $('#btnRevertCopy').click();


            }
        });
        @*UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
    }
    function DeleteTransaction(transId, isDeleted) {
        debugger
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
            $.ajax({
                    type: 'POST',
                    url: '@Url.Action("DeleteDraftTransaction", "Shared")',
                data: { transId: transId, isDeleted: isDeleted, __RequestVerificationToken: token },
                success: function (data) {
                    if (data.MessageType != 2)
                    {
                        if (isDeleted == "true")
                        {
                            ShowSuccesMessage("تم الحذف ");
                        }
                        else
                        {
                            ShowSuccesMessage("تم الارجاع");
                        }

                        setTimeout((function () {
                            window.location.reload() ;
                        }), 1000);

                    }

                    }
                });
    }

    function ReloadPage(data) {
        if (data.MessageType != 2)
        {
            window.location.href = '@Url.Action("Saved", "File")';
            @*UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function MultipleRevert() {
        debugger;
        if ( $('#trayId').val() == @((int)TrayType.Saved)) {

        $('#trayActionType').val(@((int)TrayActionType.SaveRevert));

        $('#btnRevert').click();


        } else {

        $('#trayActionType').val(@((int)TrayActionType.UndoDeleteCopy));

        $('#btnRevertCopy').click();


        }

    }
    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }
    function doSort(obj) {
        var ele = $('#hdn' + obj.id).val();
        updateSortingData(currentIndex, ele, obj);

        var filters = $("#hdnFilter").val();
        var sortData = { trayId: @trayId, sortType: obj.id, dir: ele, searchData: ele, SortingOrders: sortingOrders, filter: filters };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                goToViewAfterPaging();
                prepareSaved(@trayId, sortData);
            }
        });
    }



    function fillHidden(obj) {
        $('#hdn' + obj.id).val("");
        $('#hdn' + obj.id).val(obj.value);
    }


    function filterByType(obj, trayId, statusId) {
        debugger;
        if (trayId == @((int)TrayType.SavedCopies)) {
            $("#CopySavedAction").removeClass("hidden");
            $("#TransactionSavedAction").addClass("hidden");
        } else {
              $("#CopySavedAction").addClass("hidden");
            $("#TransactionSavedAction").removeClass("hidden");

        }
        /*  var trayId = $("#trayId").val();*/
        $("div.mr-auto.filter-link a ").removeClass("active");
        $(obj).addClass("active");

        $('#trayId').val(trayId);
        var filterByCopyTypeData = { trayId: trayId, dateType: '@Convert.ToInt32(TransactionDateType.Any)', PageSize: @ViewData["PageSize"]!= null ?@ViewData["PageSize"]: '@UIHelper.PageSize', filter:"" };
        if (statusId > 0) {

            filterByCopyTypeData.filter = "Status__1__" + statusId;
        }

        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterByCopyTypeData,
            success: function (data) {
                $("#TransactionsBoxes").html(data.Html);
                unfillSelectedAll();
                prepareSaved(trayId, filterByCopyTypeData);
                goToViewAfterPaging();
            },
            error: function (a) {
            }
        })
        $("#TransactionsBoxes").html("");
    }






    function FilterBy() {
        debugger;
        var trayid =   $('#trayId').val();;
        var filter = "";

         if ($("#hdnPriorityLevelId").val() != "" && $("#hdnPriorityLevelId").val() != null) {

             filter += "Priority__1__" + $("#hdnPriorityLevelId").val();
        }
         if ($("#hdnConfidentialityLevelId").val() != "" && $("#hdnConfidentialityLevelId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
             filter += "Confidentiality__1__" + $("#hdnConfidentialityLevelId").val();
        }
        if ($("#TransId").val() != "" && $("#TransId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Number__1__" + $("#TransId").val();
        }
        if ($("#hdnExternalPartyId").val() != "" && $("#hdnExternalPartyId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "ExternalParty__1__" + $("#hdnExternalPartyId").val();
        }
        if ($("#hdnDocTypeId").val() != "" && $("#hdnDocTypeId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "LetterType__1__" + $("#hdnDocTypeId").val();
        }
        if ($("#hdnDateCal").val() != "" && $("#hdnDateCal").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Date__1__" + $("#hdnDateCal").val();
        }
        $("#hdnFilter").val(filter);

        var filterData = { trayId: trayid, filter: filter, SortingOrders: sortingOrders};

        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                goToViewAfterPaging();

                prepareSaved(@trayId, filterData);
            }
        });
    }
    function goToView(id) {

        var TypeData = { trayId: '@Convert.ToInt32(TrayType.Saved)',dateType: '@Convert.ToInt32(TransactionDateType.Any)' , PageSize: @ViewData["PageSize"]!= null ?@ViewData["PageSize"]: '@UIHelper.PageSize', renderType : id};
            $("#TransactionsBoxes").html("");
            $.ajax({
                url: '@Url.Action("UpdateTrayTransactions","File")',
                type: 'POST',
                data: TypeData,
                success: function (data) {
                    $("#TransactionsBoxes").html(data.Html);
                    $('#selectedTab').val(TypeData.dateType);
                    unfillSelectedAll();
                    prepareSaved(TypeData);
                },
                error: function (a) {
                }
            });
    }
     $(".aSaveCopyRevert").unbind('click').click(function (e)
     {
         debugger
        e.stopPropagation();
        _this = this;
        ShowConfirmMessage('هل انت متأكد من التراجع من الحفظ ؟', "ViewedCopiesTransaction");
    })
</script>
