                    <a href="#sub-tab-1" aria-controls="sub-tab-1" role="tab" data-toggle="tab" onclick="filterByType(this,'@Convert.ToInt32(TrayType.Saved)',0)"> <span class="badge badge badge-primary badge-pill1 spnCount_@((int)TrayType.Saved)">0</span> @DbRes.TResource("User.Trays.Saved")</a>
