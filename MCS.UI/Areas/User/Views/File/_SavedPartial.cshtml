@using MCS.Common
@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.File
@using MCS.Framework.Controls.Mvc
@using MCS.Framework.Controls
@model IList<TransactionTrayInfoVM>


@{int trayId = (int)TrayType.Saved;
    var ViewedStatusId = TransCopyStatus.Viewed.LookupIdentity(LookupCategory.TransCopyStatus, string.Empty);

}

<div class="mx-3 mx-md-5 header-container d-flex flex-row align-items-center" id="divBtn" style="display:none">

    <div class="d-flex flex-column flex-lg-row align-items-lg-center flex-grow-1 mb-3 mb-lg-0 mt-md-5 mt-auto">
