                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 with-icon">
                    <label class="">@DbRes.TResource("User.Transaction.CreateDate")</label>
                    @Html.Calendar("DateCal", "hdnDateCal", "hdnHasDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), "", "dataCal form-control")
                    <a class=" date-icon2 " onclick="showCalender('DateCal')"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                    @Html.StickyHidden("hdnDateCal", "", null)
