    @Html.StickyHidden("RejectedTaskId")
    @Html.StickyHidden("ReplyTaskId")
    @Html.StickyHidden("selectedTab", ((int)ReceivedTasksType.AcceptedTasks).ToString(), new { id = "selectedTab" })
    @Html.StickyHidden("transactionsIds", "", new { id = "transactionsIds" })
    @Html.StickyHidden("hdnTasksAttachment")
    @Html.StickyHidden("hdnFilter")
    <div class="content_container content_container--body" id="TransactionsBoxes">
        @Html.Partial("~/Areas/User/Views/File/_TransactionTasksBoxesPartial.cshtml", Model)
    </div>
</div>
<style>
</style>
<script>
    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }

     function doSort(obj, value) {
        var selectedTab = parseInt($('#selectedTab').val());
         updateSortingData(currentIndex, value, obj);
         var filters = $("#hdnFilter").val();
         var sortData = { TabId: selectedTab, sortType: obj.id, dir: value, searchData: value, SortingOrders: sortingOrders, filter: filters };
        $.ajax({
            url: '@Url.Action("GetTasksByFilter", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                //prepareTransactions(sortData);
                goToViewAfterPaging();
            }
        });
    }


    function FilterBy() {
        var selectedTab = parseInt($('#selectedTab').val());
        var filter = "";
        if ($("#hdnDateCal").val() != "" && $("#hdnDateCal").val() != null) {

            filter += "CreationDate__1__" + $("#hdnDateCal").val();
        }
        if ($("#Description").val() != "" && $("#Description").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Description__1__" + $("#Description").val();
        }
        if ($("#TaskDescription").val() != "" && $("#TaskDescription").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "TaskDescription__1__" + $("#TaskDescription").val();
        }
        if ($("#TransId").val() != "" && $("#TransId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Number__1__" + $("#TransId").val();
        }

        $("#hdnFilter").val(filter);

        var filterData = { TabId: selectedTab, filter: filter, SortingOrders: sortingOrders};

        $.ajax({
            url: '@Url.Action("GetTasksByFilter", "File")',
            type: 'POST',
            data: filterData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                //prepareTransactions(filterData);
                goToViewAfterPaging();
            }
        });
    }


    $(document).ready(function () {
        $('#DateCal').attr('autocomplete', 'off');
    });



    function AssignToUser(TaskId) {
        var taskId = TaskId;
        var url = '@Url.Action("AssignToUser", "File")?taskId=' + taskId;
        ShowDialog(url, 'dialogbox col-md-8 col-md-offset-3');
    }

    function AcceptTask(taskId) {
        data = { TaskId: taskId, taskAcceptanceStatus: "@TaskAcceptanceStatus.Accept" };
        $.ajax({
            url: '@Url.Action("AcceptRejectTask", "File")',
            type: 'GET',
            data: data,
            success: function (data) {
                if (true) {
                    $("#TransactionsBoxes").html(data.Html);
                    //$('#selectedTab').val(tabId);
                    unfillSelectedAll();
                    @*UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
                    //prepareTransactions(sortByDateTypeData);
                }
            },
            error: function (a) { }
        });
    }

    function RejectTask(taskId, rejectionReason) {
        data = { TaskId: taskId, taskAcceptanceStatus: "@TaskAcceptanceStatus.Reject", RejectionReason: rejectionReason };
        $.ajax({
            url: '@Url.Action("AcceptRejectTask", "File")',
            type: 'GET',
            data: data,
            success: function (data) {
                if (true) {
                    $("#TransactionsBoxes").html(data.Html);
                    unfillSelectedAll();
                    $('#RejectedTaskId').val("");
                    $('#rejectionReason').val("");
                    $('#errorMessageValidate').html("");
                    $("#CalMessageError").addClass("hidden_");
                    $("#CalMessageError").hide();
                    $("#rejectionReason").removeClass("RedBorder");
                    $('.close-button-popup').click();
                    @*//UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
                }
            },
            error: function (a) { }
        });
    }

    function showRejectionPopup(TaskId) {
        $("#RejectedTaskId").val(TaskId);
        ShowRejectTransactionPopup('@DbRes.TResource("User.Tasks.RejectTask")', '', ' @DbRes.TResource("User.Tasks.ReasonForReject") *','', '@DbRes.TResource("User.Tasks.Send")');
    }

    function showReplyTaskPopup(TaskId) {
        $("#ReplyTaskId").val(TaskId);
        ShowReplyTaskPopup('@DbRes.TResource("User.Tasks.RespondTask")', '', ' @DbRes.TResource("User.Tasks.RespondText") *', '@DbRes.TResource("User.Tasks.Send")', '@DbRes.TResource("User.Tasks.Copy.Attachment")', '@DbRes.TResource("User.Tasks.AddedAttachment")');

    }

    $(document).on("RejectButtonPopupClicked", function () {
        if ($('#rejectionReason').val().trim() == '') {
            $('#errorMessageValidate').html(" أدخل سبب الرفض");
            $("#CalMessageError").removeClass("hidden_");
            $("#CalMessageError").show();
            $("#rejectionReason").addClass("RedBorder");
        }
        else {
            if ($('#RejectedTaskId').val() != "") {
                RejectTask($("#RejectedTaskId").val(), $("#rejectionReason").val().trim());
                @*UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
            }
        }
    });

    $(document).on("ReplyTaskButtonPopupClicked", function () {
        if ($('#replyTxt').val().trim() == '') {
            $('#ReplyErrorMessageValidate').html("أدخل نص الرد");
            $("#CalReplyMessageError").removeClass("hidden_");
            $("#CalReplyMessageError").show();
            $("#replyTxt").addClass("RedBorder");
        }
        else {
            if ($('#ReplyTaskId').val() != "") {
                ShowConfirmMessage("هل انت متأكد من الاضافة؟", 'replyTaskConfirmed');

            }
        }

    });

    function replyTaskConfirmed() {
        ReplyTask($("#ReplyTaskId").val(), $("#replyTxt").val().trim());
        @*UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
        $('.close-button-popup').click();
    }

    $(document).ready(function () {
        $(".ReceivedTasksType").click(function () {
            $("div.mr-auto.filter-link a").removeClass("active");
            $($(this)).addClass("active");

            $('#selectedTab').val($(this).attr("id"));
            var TabData = { PageSize: '@UIHelper.PageSize', receivedTasksTypeId: $(this).attr("id") };
            $("#TransactionsBoxes").html("");
            $.ajax({
                url: '@Url.Action("GetTasksByTabId", "File")',
                type: 'get',
                data: TabData,
                success: function (data) {
                    $("#TransactionsBoxes").html(data.Html);
                    @*UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
                },
                error: function (a) { }
            });
        });

        @if ((int?)ViewData["StatusId"] != null)
        {
            if(((int?)ViewData["StatusId"]).Value == TaskStatus.Received.LookupIdentity(LookupCategory.TaskStatus, SessionInfo.CultureShortName) )
            {
                //المهام المقبولة
                <text>$($(".ReceivedTasksType")[0]).click();</text>
            }
            else if (((int?)ViewData["StatusId"]).Value == TaskStatus.Sent.LookupIdentity(LookupCategory.TaskStatus, SessionInfo.CultureShortName) )
            {
                //المهام الجديدة
                <text>$($(".ReceivedTasksType")[1]).click();</text>
            }
        }
    });

    function ReplyTask(replyTaskId, replyTxt) {


        var token = $("#frmSearch").find("input[name='__RequestVerificationToken']").val();
        var data = { ReplyTaskId: replyTaskId, ReplyTxt: replyTxt, __RequestVerificationToken: token };
        $.ajax({
            url: '@Url.Action("SendTaskReply", "File")',
            type: 'post',
            data: data,
            success: function (data) {
                if (data.MessageType != 2) {

                    $("#TransactionsBoxes").html(data.Html);
                    unfillSelectedAll();
                    $('#ReplyTaskId').val("");
                    $('#replyTxt').val("");
                    $('#ReplyErrorMessageValidate').html("");
                    $("#CalMessageError").addClass("hidden_");
                    $("#CalMessageError").hide();
                    $("#replyTxt").removeClass("RedBorder");
                    $('.close-button-popup').click();
                    @*//UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            },
            error: function (a) {
            }
        });
    }

    function SaveTaskAttachements() {

        shownameForTask();
        $('#hdnTasksAttachment').val($('.uploaded-files').find('.file').length);

        var files = $('#dvUploadFiles').find($("input:file")).get(0).files;
        if (files.length <= 0) {
            return;
        }

        if (window.FormData !== undefined) {
            var data = new FormData();
            var fileExist = false;
            for (i = 0; i < files.length; i++) {
                $('.uploaded-files').find('.attachment_name').each(function () {
                    if ($(this).html() == files[i].name) {
                        fileExist = true;
                    }
                });
                if (fileExist) {
                    data.append("file" + i, files[i],"Task_" + $("#ReplyTaskId").val() + "_" + files[i].name);
                }
            }
            var token = $("#frmSearch").find("input[name='__RequestVerificationToken']").val();
            data.append("__RequestVerificationToken", token);

            var jqXHR = $.ajax({
                type: "post",
                url: '@Url.Action("UploadTasksAttachmentPath", "File")',
                data: data,
                contentType: false,
                processData: false,
                dataType: 'json',
                async: false,
            }).done(function () {

            }).fail(function (jqXHR, textStatus) {
                alert("error");
            });
        } else {
            alert("Your browser doesn't support HTML5 multiple file uploads! Please use some decent browser.");
            return;
        }

        return;
    }


    function removeTaskAttachemntPhysically() {
        var token = $("#frmSearch").find("input[name='__RequestVerificationToken']").val();

        if (DeletedAttach && DeletedAttach != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("RemoveTasksAttachemntPhysically", "File")',
                data: { "TaskAttachmentsToDelete": DeletedAttach, TaskId: $("#ReplyTaskId").val(), __RequestVerificationToken: token },
                success: function (data) {
                    return;
                }
            });
        }
    }
</script>