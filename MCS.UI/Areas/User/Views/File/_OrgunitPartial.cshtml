    <script>
    var OutboundDraftStatusType = { Accept: 1, Reject: 2 };
    var OutboundDraftStatus;
    var OrgunitEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File",new { trayId = "5", dateType = ViewData["dateType"] ?? 1584 }))";
    var RejectTransactionByTransactionIdAction = '@Url.Action("RejectTransaction", "File")';
    function prepareOrgunit(optionalData) {
        $(".grid-mvc").gridmvc();
        pageGrids.OrgunitGrid.ajaxify(
            {
                getPagedData: OrgunitEventHandler,
                getData: OrgunitEventHandler,
                requestType: "POST",
                callbackClientFunctionAfter: ["goToViewAfterPaging"],
                optionalData: optionalData
            });
    }

    var deliveryMethodId;
    var transactionTypeId;
    function showRejectionPopup() {
        var currentTarget = $(event.currentTarget);
        var isViewed = currentTarget.data('viewed');
        deliveryMethodId = currentTarget.data('deliverymethodid');
        transactionTypeId = currentTarget.data("transactiontypeid");
        var tranId = currentTarget.data("id");
        OutboundDraftStatus = OutboundDraftStatusType.Reject;
        $('#transId').val(tranId);

        switch (parseInt(deliveryMethodId)) {
            case DeliveryMethodType.ElectronicPaper:
                ShowVerifyTransactionNumberOrBarcode('@Url.Action("VerifyTransactionNumberOrBarcode", "Inbound")', tranId, transactionTypeId);
                break;
            case DeliveryMethodType.Electronic:
                ShowRejectTransactionPopup('إرجاع المعاملة', '', ' يرجى ادخال سبب الارجاع *','', 'إرجاع');
                break;
        }
    }

    $(document).on("RejectButtonPopupClicked", function (event, param) {
        if ($('#rejectionReason').val().trim() == '')
        {
            $('#errorMessageValidate').html(" أدخل سبب الإرجاع");
            $("#CalMessageError").removeClass("hidden_");
            $("#CalMessageError").show();
            $("#rejectionReason").addClass("RedBorder");
        }
        else
        {
            if ($('#transId').val() != "") {
                RejectTransaction($('#transId').val(), $('#rejectionReason').val().trim());
            }
        }
        UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
    });

    function doReload() {
        window.location.href = '@Url.Action("OrgUnit", "File")';
    }

    function RejectTransaction(transactionId, rejectionReason) {

        var trayid = @((int)TrayType.MyTransactions);
        var transactionId = parseInt(transactionId);
        var trayActionType = @((int)TrayActionType.RejectRevert) ;
        var remarks = rejectionReason;
        var data = {
            trayId: trayid,
            transactionId: transactionId, trayActionType: trayActionType
            , Remarks: remarks
        };
        $.ajax({
            url: '@Url.Action("MoveTransaction", "File")',
            type: 'POST',
            data: data,
            success: function (data) {
                //ShowSuccesMessage("تم إرجاع المعاملة بنجاح");
                doReload();
                UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
                $('#transId').val("");
                $('#rejectionReason').val("");
                $('#errorMessageValidate').html("");
                $("#CalMessageError").addClass("hidden_");
                $("#CalMessageError").hide();
                $("#rejectionReason").removeClass("RedBorder");
                $('.close-button-popup').click();
            }
        });
    }

    function RejectTransactionByTransaction() {
        __dialogRejectTransaction = $.confirm({
            title: false,
            content: function ($obj) {
                return $.ajax({
                    url: RejectTransactionByTransactionIdAction,
                    type: 'post',
                    data: { id: $('#transId').val(), deliveryMethodId: deliveryMethodId, transactionCategoryId: transactionTypeId },
                    success: function (data) {
                        $obj.setContent(data.Html);
                        jQuery.validator.unobtrusive.parse('#frmRejectAssign');
                        $('#hdnTransEditorId').val($('#transId').val());
                    }
                });
            },
            onOpen: function () {
                jQuery(function () {
                    jQuery('.jconfirm-box').draggable({
                        revert: false,
                    });
                });
                $("#Loader").hide();
            },
            confirmButton: false,
            icon: 'fa fa-info',
            animation: 'scale',
            columnClass: "dialogbox col-md-8 col-md-offset-2 col-xs-8 col-xs-offset-2",
            backgroundDismiss: false,
            closeIcon: true,
            cancelButton: false
        });
    }

     @if (ViewData["TransactionId"] != null && ViewData["TransactionCategoryId"] != null)
     {
         <text>
    $(document).ready(function () {
        $('#DateCal').attr('autocomplete', 'off');
                if ('@ViewData["TransactionId"].ToString()' != 0) {
                    OpenEditor('@trayId', '@ViewData["TransactionId"].ToString()', '@ViewData["TransactionCategoryId"].ToString()');
                } else {
                    $("#list_transaction").find(".view_Editor:first").trigger("click");
                }



            });
            </text>
     }
     else
     {
         <text>
            $(document).ready(function () {
                $(".checkall").show();
                $("#list_transaction").find(".view_Editor:first").trigger("click");
            });
            </text>
     }


     $(".view_Editor").click(function (e) {

         var type = $(this).data("type");
         var id = $(this).data("id");
         var trayId = $(this).data("tray");
         $(".view_group").removeClass("select");
         $(this).parents(".view_group").addClass("select");

         OpenEditor(trayId, id, type);

     })


     function OpenEditor(trayId, id, type) {
         var data = {
             trayId: trayId, transactionId: id, transactionCategoryId: type
         };

         $.ajax({
             url: '@Url.Action("Index","Editor")',
             type: 'Get',
             cache: false,
             data: data,
             success: function (data) {
                 $("#editor_transaction").html("");
                 $("#editor_transaction").html(data);
                 jQuery.validator.unobtrusive.parse('#editor_transaction');
             },
             error: function (a) {
             }
         });
    }

    function ShowTransactionLog() {
        var currentTarget = $(event.currentTarget);
        var transactionType = currentTarget.data('transactiontypeid');
        var Id = currentTarget.data('id');
        var url = '/MCS.UI/User/TransactionLog/Index' + '?transactionId=' + EncryptionKey(Id) + "&transactionType=" + transactionType;
        ShowDialog(url, 'dialogbox col-md-12 ');
    }

    var dataToMoveTransaction;
            function AssignToSelf(item) {

        var currentTarget = $(event.currentTarget);
        var isViewed = currentTarget.data('viewed');
        var deliveryMethodId = currentTarget.data('deliverymethodid');
        var transactionType = currentTarget.data('transactiontypeid');
        var Id = currentTarget.data('id');
        var trayid = parseInt($("#hdnTrayId").val());
        var page = $("#hdnCurrentPage").val();
        var orderBy = $("#hdnOrderBy").val();
        var dir = $("#hdnDirection").val();
        var filter = $("#hdnFilter").val();
        var fromDate = $("#hdnFromDateValue").val();
        var toDate = $("#hdnToDateValue").val();
        var number = $("#hdnSearchTransactionNumberValue").val();
        var viewType = $("#hdnViewFile").val();
        var dateType = $("#hdnFilterDateType").val();
        var transactionId = $(item).data("id");
        var transactionIdEncrypt = $(item).data("idencrypt");
        var trayActionType = $(item).data("type");
        var PageSize = $("#ddlPaging").val();
        OutboundDraftStatus = OutboundDraftStatusType.Accept;

        dataToMoveTransaction = {
            transactionTypeId: transactionType, trayId: trayid, page: page, gridColumn: orderBy, dir: dir, filter: filter, fromDate: fromDate,
            toDate: toDate, searchColumn: number, viewType: viewType, transactionId: transactionId, trayActionType: trayActionType
            , dateType: dateType, pageSize: PageSize, transactionIdEncrypt: transactionIdEncrypt
        };

        @*if (JSON.parse(isViewed.toLowerCase()) == false && deliveryMethodId == DeliveryMethodType.ElectronicPaper) {
            ShowVerifyTransactionNumberOrBarcode('@Url.Action("VerifyTransactionNumberOrBarcode", "Inbound")', Id, transactionType);
        }
        else {
            MoveTransactionFile(dataToMoveTransaction)
        }*@

        MoveTransactionFile(dataToMoveTransaction)
    }

    function ExecuteTargetFunction(id) {
        switch (OutboundDraftStatus) {
            case OutboundDraftStatusType.Accept:
                SetTransactionAssignmentToViewedByTransactionId(id);
                break;
            case OutboundDraftStatusType.Reject:
                RejectTransactionByTransaction();
                break;
        }
    }

    function SetTransactionAssignmentToViewedByTransactionId(transactionId) {
        $.ajax({
            url: '@Url.Action("SetTransactionAssignmentToViewedByTransactionId", "File")',
            type: 'POST',
            data: { transactionId: transactionId},
            success: function (data) {
                if (data.MessageType != 2) {
                    MoveTransactionFile(dataToMoveTransaction);
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }

            function MoveTransactionFile(dataToMoveTransaction) {
                debugger;
        var EncryptedFalse = $('#EncryptedFalse').val();
        var EncryptedTrue = $('#EncryptedTrue').val();
                var IsVip = $('#IsVip').val();
        $.ajax({
            url: '@Url.Action("MoveTransaction","File")',
            type: 'POST',
            data: dataToMoveTransaction,
            success: function (data) {
                debugger;
                if (data.MessageType != 2) { 
                    var url = "";
                    if (dataToMoveTransaction.transactionTypeId != "" && dataToMoveTransaction.transactionTypeId != undefined) { 
                        if (IsVip == 'True') { 
                               switch (dataToMoveTransaction.transactionTypeId) {
       case @(TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)) :
                                       url = "@Url.Action("Edit", "VipInbound")" + "?id=" + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt) + '&defaultTabId=' + "";
           break;
       case @(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)) :
                                       url = "@Url.Action("Edit", "VipOutboundInternal")" + "?id=" + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt) + '&defaultTabId=' + "";
           break;
       case @(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)) :
                                       url = '@Url.Action("Edit", "VipOutboundDraft")?id=' + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt) + '&defaultTabId=' + "";
           break;
       case @(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)) :
                                       url = '@Url.Action("Edit", "VipOutboundDraft")?id=' + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt) + '&defaultTabId=' + "";
           break;
       default:
           break;
   }
                        } else {

                        switch (dataToMoveTransaction.transactionTypeId) {
                            case @(TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)) :
                                url = "@Url.Action("Editor", "Inbound")" + "?id=" + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt);
                                break;
                            case @(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)) :
                                url = "@Url.Action("Editor", "OutboundInternal")" + "?id=" + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt);
                                break;
                            case @(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)) :
                                url = '@Url.Action("Edit","OutboundExternal")?id=' + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt) + '&IsFromDraft=' + EncryptedTrue + '&isHubEditable=' + EncryptedFalse;
                                break;
                            case @(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)) :
                                url = '@Url.Action("Edit","OutboundExternal")?id=' + EncryptionKey(dataToMoveTransaction.transactionIdEncrypt) + '&IsFromDraft=' + EncryptedFalse + '&isHubEditable=' + EncryptedFalse;
                                break;
                            default:
                                break;
                        }

                        }

                            window.location.href = url;
                    }
                    else {
                        window.location.href = '@Url.Action("Orgunit", "File")';

                    }


                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }
    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }
        function doSort(obj) {
            updateSortingData(currentIndex, obj.value, obj);
         var filters = $("#hdnFilter").val();
         var sortData = { trayId: @((int)TrayType.OrgUnit), sortType: obj.id, dir: obj.value, searchData: obj.value, SortingOrders: sortingOrders, filter: filters };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                goToViewAfterPaging();
                prepareOrgunit(sortData);
            }
        });
    }

    function fillHidden(obj) {
        $('#hdn' + obj.id).val("");
        $('#hdn' + obj.id).val(obj.value);
    }

    function FilterBy() {
        var trayid = @((int)TrayType.OrgUnit);
        var filter = "";

        if ($("#hdnPriorityLevelId").val() != "" && $("#hdnPriorityLevelId").val() != null) {

            filter += "Priority__1__" + $("#hdnPriorityLevelId").val();
        }

        if ($("#hdnConfidentialityLevelId").val() != "" && $("#hdnConfidentialityLevelId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
