            var isHubEditable = currentTarget.data('ishubeditable');
            var type = currentTarget.data("type");
            var id = currentTarget.data("id");
            var IsDraft = currentTarget.data("isdraft");

            urlActionPage = '@Url.Action("Edit","OutboundExternal")?id=' + EncryptionKey(EncryptedId) + '&IsFromDraft=' + IsDraft + '&isHubEditable=' + isHubEditable;

        @*if (IsDraft && JSON.parse(isViewed.toLowerCase()) == false && deliveryMethodId == DeliveryMethodType.ElectronicPaper) {
            ShowVerifyTransactionNumberOrBarcode('@Url.Action("VerifyTransactionNumberOrBarcode", "OutboundExternal")', id, type);
        } else {
            ExecuteTargetFunction();
        }*@

            ExecuteTargetFunction();
        }
    }

