    function goToView(id) {

        var TypeData = { trayId: '@Convert.ToInt32(TrayType.DraftOutbound)',dateType: '@Convert.ToInt32(TransactionDateType.Any)' , PageSize: @ViewData["PageSize"]!= null ?@ViewData["PageSize"]: '@UIHelper.PageSize', renderType : id};
            $("#TransactionsBoxes").html("");
            $.ajax({
                url: '@Url.Action("UpdateTrayTransactions","File")',
                type: 'POST',
                data: TypeData,
                success: function (data) {
                    $("#TransactionsBoxes").html(data.Html);
                    $('#selectedTab').val(TypeData.dateType);
                    unfillSelectedAll();
                    prepareDraftOutbound(TypeData);
                },
                error: function (a) {
                }
            });
        }
