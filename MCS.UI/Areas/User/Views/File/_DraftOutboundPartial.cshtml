    function PrintManifest() {
        var currentTarget = $(event.currentTarget);
        var outboundExternalId = currentTarget.data("id");
        var token = $("#frmEditOutboundExternal").find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetDeliveryReportByTransactionId", "OutboundExternal")',
            data: {
                transactionId: outboundExternalId,
                type: '@TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)',
                __RequestVerificationToken: token
            },
            success: function (data) {
                if (data.MessageType != 2) {
                    if (data.ReportsIds) {
                        PrintTransactionsDeliveryReport(outboundExternalId, data.ReportsIds);
                    }
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });

        return false;
    }


    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }
    function doSort(obj, value) {
        updateSortingData(currentIndex, value, obj);
        var filters = $("#hdnFilter").val();
        var sortData = { trayId: parseInt($('#trayId').val()), sortType: obj.id, dir: value, searchData: value, SortingOrders: sortingOrders, filter: filters};
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                prepareDraftOutbound(sortData);
                goToViewAfterPaging();
            }
        });
    }
    function fillHidden(obj) {
        $('#hdn' + obj.id).val("");
        $('#hdn' + obj.id).val(obj.value);
    }

    function FilterBy() {
        var trayid = parseInt($('#trayId').val());
        var filter = "";

         if ($("#hdnPriorityLevelId").val() != "" && $("#hdnPriorityLevelId").val() != null) {

             filter += "Priority__1__" + $("#hdnPriorityLevelId").val();
        }
         if ($("#hdnConfidentialityLevelId").val() != "" && $("#hdnConfidentialityLevelId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
             filter += "Confidentiality__1__" + $("#hdnConfidentialityLevelId").val();
        }
        if ($("#TransId").val() != "" && $("#TransId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Number__1__" + $("#TransId").val();
        }
        if ($("#hdnExternalPartyId").val() != "" && $("#hdnExternalPartyId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "ExternalParty__1__" + $("#hdnExternalPartyId").val();
        }
        if ($("#hdnDocTypeId").val() != "" && $("#hdnDocTypeId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "LetterType__1__" + $("#hdnDocTypeId").val();
        }
        if ($("#hdnDateCal").val() != "" && $("#hdnDateCal").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Date__1__" + $("#hdnDateCal").val();
        }
        if ($("#Description").val() != "" && $("#Description").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Subject__2__" + $("#Description").val();
        }
        $("#hdnFilter").val(filter);

        var filterData = { trayId: trayid, filter: filter, SortingOrders: sortingOrders , PageSize: @ViewData["PageSize"]};

        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                prepareDraftOutbound(filterData);
                goToViewAfterPaging();
            }
        });
    }


    function showRejectionPopup(transId) {
        $('#transId').val(transId);
        ShowRejectTransactionPopup('إرجاع المعاملة', '', ' يرجى ادخال سبب الارجاع *','','إرجاع')
    }
    $(document).on("RejectButtonPopupClicked", function (event, param) {
        if ($('#rejectionReason').val().trim() == '') {
            $('#errorMessageValidate').html(" أدخل سبب الإرجاع");
            $("#CalMessageError").removeClass("hidden_");
            $("#CalMessageError").show();
            $("#rejectionReason").addClass("RedBorder");
        } else {
            if ($('#transId').val() != "") {
                RejectTransaction($('#transId').val(), $('#rejectionReason').val().trim());
            }
        }

    });


    function RejectTransaction(transactionId, rejectionReason) {

        var trayid = @((int)TrayType.DraftOutbound);
        var transactionId = parseInt(transactionId);
        var trayActionType = @((int)TrayActionType.RejectRevert) ;
        var remarks = rejectionReason;

        var data = {
            trayId: trayid,
            transactionId: transactionId, trayActionType: trayActionType
            , Remarks: remarks
        };
        $.ajax({
            url: '@Url.Action("MoveTransaction", "File")',
            type: 'POST',
            data: data,
            success: function (data) {
                doReload();
                $('#transId').val("");
                $('#rejectionReason').val("");
                $("#CalMessageError").addClass("hidden_");
                $("#CalMessageError").hide();
                $("#rejectionReason").removeClass("RedBorder");
                $('#errorMessageValidate').html("");
                $('.close-button-popup').click();
                ShowSuccesMessage("تم إرجاع المعاملة بنجاح");
            }
        });
    }
    function doReload() {
        window.location.href = '@Url.Action("DraftOutbound", "File")';
    }

