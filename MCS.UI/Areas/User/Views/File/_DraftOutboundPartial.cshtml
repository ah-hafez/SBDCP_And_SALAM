<script>

    function DoPrintReport(transactionId) {
        urlDeliveryReport = '/MCS.UI/User/Reports/PrintDeliveryReportsByIds' + '?transactionReportInfo=' + JSON.stringify(deliveryReportArray) + '&isPerTransaction=false&group=false&reportType=' + 1;
        PrintReport();
    }


    function PrintOutBoundAddress() {
        var transId = $(event.currentTarget).data("encryptedid");
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetOutBoundAddressInfo", "Shared")',
            data: { TransactionId: transId },
        }).success(function (data) {
            if (data.MessageType != 2) {
                var BarcodeWindow = window.open('', '_blank', 'width=500,height=500');
                BarcodeWindow.opener = null;
                BarcodeWindow.document.write(data.Html);
                BarcodeWindow.document.close();
                BarcodeWindow.focus();
                setTimeout(function () { BarcodeWindow.print(); BarcodeWindow.close(); }, 3000);
            }

        });

    }
    function DeleteTransaction(transId, isDeleted) {
        debugger
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
            $.ajax({
                    type: 'POST',
                    url: '@Url.Action("DeleteDraftTransaction", "Shared")',
                data: { transId: transId, isDeleted: isDeleted, __RequestVerificationToken: token },
                success: function (data) {
                    if (data.MessageType != 2)
                    {
                        if (isDeleted == "true")
                        {
                            ShowSuccesMessage("تم حذف المشروع");
                        }
                        else
                        {
                            ShowSuccesMessage("تم الارجاع");
                        }

                        setTimeout((function () {
                            window.location.reload() ;
                        }), 1000);

                    }

                    }
                });
    }


    $(document).ready(function () {
        $('#DateCal').attr('autocomplete', 'off');
    });
     var idsList = [];
    function openPendingExecution(type) {
         idsList = $('#encryptedTransactionsIds').val().split(",");
         var encryptedtype = type == '1' ? $('#numberOne').val() : $('#numberThree').val();
         var queryString = idsList.length > 0 ? "?" : "";
                for (var i = 0; i < idsList.length; i++) {
                    queryString = queryString + "transactionsIds=" + idsList[i] + "&";
                }
         window.location.href = '@Url.Action("PendingExecuting", "File")' + queryString + 'type=' + encryptedtype + "&trayType=" + @((int)TrayType.DraftOutbound) +'&tabId=' + encryptedtype;
    }

    var draftOutboundEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File",new { trayId = ViewData["TrayType"] ?? 1 , dateType =ViewData["dateType"] ?? 1}))";
    function prepareDraftOutbound(optionalData) {
        $(".grid-mvc").gridmvc();
        pageGrids.DraftOutboundGrid.ajaxify(
            {
                getPagedData: draftOutboundEventHandler,
                getData: draftOutboundEventHandler,
                requestType: "POST",
                callbackClientFunctionAfter: ["goToViewAfterPaging", "reRegisterSendInqueryButton"],
                optionalData: optionalData
            });
    }

    function reRegisterSendInqueryButton() {

        $('.clsResend').off().on("click", ResendHub.bind(this));
    }

    function ResendHub(event) {

        var currentTarget = $(event.currentTarget);
        var transactionId = currentTarget.data('transactionid');
        var deliveryMethodId = currentTarget.data('deliverymethodid');
        var id = currentTarget.data('id');
        var type = currentTarget.data('type');
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
        switch (deliveryMethodId) {
            case @DeliveryMethodType.Paper.LookupIdentity(LookupCategory.DeliveryMethod,SessionInfo.CultureShortName):
                //عرض بيانات التسليم
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("GetDeliveryReportByTransactionId", "OutboundExternal")',
                    data: { transactionId: id, type: type, __RequestVerificationToken: token },
                    success: function (data) {
                        if (data.MessageType != 2) {
                            if (data.ReportsIds) {
                                UpdateTransactionStatus(data.ReportsIds, id);
                            }
                        }
                        else {
                            ShowErrorMessage(data.MessageText);
                        }
                    }
                });
                break;
            case @DeliveryMethodType.Electronic.LookupIdentity(LookupCategory.DeliveryMethod, SessionInfo.CultureShortName):
                SendToOutboundHub(transactionId);
                break;
            case @DeliveryMethodType.ElectronicPaper.LookupIdentity(LookupCategory.DeliveryMethod, SessionInfo.CultureShortName):
                //عرض بيانات التسليم
                @*$.ajax({
                    type: 'POST',
                    url: '@Url.Action("GetDeliveryReportByTransactionId", "OutboundExternal")',
                    data: { transactionId: id, type: type, __RequestVerificationToken: token },
                    success: function (data) {
                        if (data.MessageType != 2) {
                            if (data.ReportsIds) {
                                //UpdateTransactionStatus(data.ReportsIds, id);
                                PrintTransactionsDeliveryReport(id, data.ReportsIds);
                                SendToOutboundHub(transactionId);
                            }
                        }
                        else {
                            ShowErrorMessage(data.MessageText);
                        }
                    }
                });*@
                SendToOutboundHub(transactionId);
                //ShowSaveDeliveryNumberSuccesMessage(id, type, transactionId);
                break;
        }
        event.stopImmediatePropagation();
    }

    function SendToOutboundHub(transactionId) {
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            url: '@Url.Action("ResendOutbound", "Hub")',
            data: { transactionId: transactionId, __RequestVerificationToken: token },
            success: function (data) {
                if (data == "Success") {
                    window.location.reload();
                } else if (data.includes('الملف') || data.includes('فعالة')) {
                    ShowErrorMessage(data);
                } else {
                    ShowErrorMessage('حدث خطأ');
                }
                UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
            },
            error: function (data) {
                ShowErrorMessage('حدث خطأ');
            }
        });
    }

    function UpdateTransactionStatus(reportsIds, OutboundExternalId) {
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("UpdateTransactionStatus", "OutboundExternal")',
            data: {
                transactionId: OutboundExternalId,
                statusId: '@TransactionStatus.Sent.LookupIdentity(LookupCategory.TransactionStatus, SessionInfo.CultureShortName)',
                type: '@TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)',
                __RequestVerificationToken: token
            },
            success: function (data) {
                if (data.MessageType != 2) {
                    UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
                    PrintTransactionsDeliveryReport(OutboundExternalId, reportsIds);
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }


    function PrintTransactionsDeliveryReport(transactionId, ReportsIds) {
        var deliveryReportArray = [];
        var result = JSON.parse(ReportsIds);

        for (var i = 0; i < result.length; i++) {
             deliveryReportArray.push({ TransactionId: transactionId, ReportsIds: [result[i]] });
        }
        var reportType = @((int)DeliveryReportType.DeliveryReport);
        var parameters = '?transactionReportInfo=' + JSON.stringify(deliveryReportArray) + '&isPerTransaction=true&group=false&reportType=' + reportType;
        urlDeliveryReport = '@Url.Action("PrintDeliveryReportsByIds", "Reports")' + parameters
        PrintReport(urlDeliveryReport, '', afterPrintDeliveryReport);
    }

    function ShowSaveDeliveryNumberSuccesMessage(OutboundExternalId, type, transactionId) {
        __dialogDeliveryNumber = $.confirm({
            title: false,
            content: function ($obj) {
                return $.ajax({
                    url: '@Url.Action("SaveDeliveryNumber", "OutboundExternal")',
                    type: 'get',
                    cache: false,
                    data: { id: OutboundExternalId, transactionCategoryId: type },
                    success: function (data) {
                        $obj.setContent(data.Html);
                        jQuery.validator.unobtrusive.parse('#frmDeliveryNumber');
                        $('#DeliveryTransactionId').val(transactionId);
                    }
                });
            },
            //template: '<div class="jconfirm"><div class="jconfirm-bg"></div><div class="modal-dialog"><div class="modal-content"><div class="content" style="margin:0px"></div></div></div>',
            icon: 'fa fa-info',
            animation: 'scale',
            columnClass: 'alert_success alert_new col-md-6 col-md-offset-3 col-xs-6 col-xs-offset-3',
            backgroundDismiss: false,
            closeIcon: true,
            cancelButton: false,
            confirmButton: false,
            onOpen: function () {
                jQuery(function () {
                    jQuery('.jconfirm-box').draggable({
                        revert: false,
                    });
                });
                $("#Loader").hide();
            }
        });
    }

    function OnAddDeliveryNumberSuccess(data) {
        if (data.MessageType != 2) {
            __dialogDeliveryNumber.close();
            SendToOutboundHub($('#DeliveryTransactionId').val());
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function afterPrintDeliveryReport() {
        setTimeout(function () {
            window.location.href = '@Url.Action("DraftOutbound", "File")';
        }, 3000);
    }

    function filterByTransactionType(obj, trayId) {
        $("div.mr-auto.filter-link a ").removeClass("active");
        $(obj).addClass("active");

        goToViewAfterPaging();
        if (trayId == @outboundTrayId) {
            $('#dvcheckAll').hide();
            $("#dvChck").hide();
            $(CheckAllBoxes).closest('div').hide();
        }
        else {
            $('#dvcheckAll').show();
            $("#dvChck").show();
            $(CheckAllBoxes).closest('div').show();
        }

        $('#trayId').val(trayId);
        var filterByTransactionTypeData = { trayId: trayId, dateType: '@Convert.ToInt32(TransactionDateType.Any)', PageSize: '@ViewData["PageSize"]' };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterByTransactionTypeData,
            success: function (data) {
                $("#TransactionsBoxes").html(data.Html);
                unfillSelectedAll();
                prepareDraftOutbound(filterByTransactionTypeData);
                goToViewAfterPaging();
            },
            error: function (a) {
            }
        })
        $("#TransactionsBoxes").html("");
    }

    function Open(Id) {
        var type = $('#hdnTransactionType_' + Id).val();
        var url = "";
        switch (type) {
            case 'Inbound':
                url = '@Url.Action("Edit", "Inbound")' + '?id=-1';
                break;
            case 'ExternalOutbound':
                url = '@Url.Action("Edit", "OutboundExternal")' + '?id=-1';
                break;
            case 'InternalOutbound':
                url = '@Url.Action("Edit", "OutboundInternal")' + '?id=-1';
                break;
            case 'DraftOutbound':
                url = '@Url.Action("Edit", "OutboundDraft")' + '?id=-1';
                break;
        }
        url = url.replace("-1", EncryptionKey(Id));
        window.location.href = url;
    }

    var urlActionPage = "";
    function ViewEditor(Id, EncryptedId) {
        var isEncrypted = $('#hdnEncrypted_' + Id).val();
        var token = $("input[name='__RequestVerificationToken']").val();
        var data = {
            transactionId: Id, TransactionCategoryId: @TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName), Mode: "Edit", __RequestVerificationToken: token
        };
        if (isEncrypted == "True") {
            debugger;
            $.ajax({
                url: '@Url.Action("ShowVerifyCodeBox", "Inbound")',
                type: 'POST',
                data: data,
                success: function (data) {
                    debugger;
                    if (data.Count > 0) {
                        debugger;
                        ShowEncrypttionDialog(data.Html, "new-footer dialogbox col-md-8 col-md-offset-2 col-xs-8 col-xs-offset-2");
