<script>
        var idsList = [];
        function openPendingExecution(type, tabId) {
            idsList = $('#encryptedTransactionsIds').val().split(",");
            var encryptedtype = type == '1' ? $('#numberOne').val() : $('#numberTwo').val();
            var encryptedtab = tabId == '1' ? $('#numberOne').val() : $('#numberTwo').val();
            var queryString = idsList.length > 0 ? "?" : "";
            for (var i = 0; i < idsList.length; i++) {
                queryString = queryString + "transactionsIds=" + idsList[i] + "&";
            }
            window.location.href = '@Url.Action("PendingExecuting", "File")' + queryString + 'type=' + encryptedtype + '&tabId=' + encryptedtab;
        }

        var myTransactionEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File", new { trayId = ViewData["TrayType"] ?? 1, dateType = ViewData["dateType"] ?? 1 }))";

        function prepareTransactions(optionalData) {
            $(".grid-mvc").gridmvc();
            pageGrids.MyTransactionsGrid.ajaxify(
                {
                    getPagedData: myTransactionEventHandler,
                    getData: myTransactionEventHandler,
                    requestType: "POST",
                    callbackClientFunctionAfter: ["goToViewAfterPaging"],
                    optionalData: optionalData
                });
        }

    function sortingByDateType(obj, dateType) {
            $("div.mr-auto.filter-link a").removeClass("active");
        $(obj).addClass("active");
        var sortByDateTypeData = { trayId: '@Convert.ToInt32(TrayType.MyTransactions)', dateType: parseInt(dateType), PageSize: @ViewData["PageSize"]!= null ?@ViewData["PageSize"]: '@UIHelper.PageSize'};
            $("#TransactionsBoxes").html("");
            $.ajax({
                url: '@Url.Action("UpdateTrayTransactions","File")',
                type: 'POST',
                data: sortByDateTypeData,
                success: function (data) {
                    $("#TransactionsBoxes").html(data.Html);
                    $('#selectedTab').val(dateType);
                    unfillSelectedAll();
                    prepareTransactions(sortByDateTypeData);
                },
                error: function (a) {
                }
            });
    }

      function goToView(id) {

          var TypeData = { trayId: '@Convert.ToInt32(TrayType.MyTransactions)', dateType: parseInt('@Convert.ToInt32(TransactionDateType.Any)'), PageSize: @ViewData["PageSize"]!= null ?@ViewData["PageSize"]: '@UIHelper.PageSize', renderType : id};
            $("#TransactionsBoxes").html("");
            $.ajax({
                url: '@Url.Action("UpdateTrayTransactions","File")',
                type: 'POST',
                data: TypeData,
                success: function (data) {
                    $("#TransactionsBoxes").html(data.Html);
                    $('#selectedTab').val(TypeData.dateType);
                    unfillSelectedAll();
                    prepareTransactions(TypeData);
                },
                error: function (a) {
                }
            });
        }

        function chechSourseTypeId() {
            if ($('#hdnTransactionTypeId').val() != -1 && $('#hdnTransactionTypeId').val() != "") {
                getSourceTypeByTransactionTypeId($('#hdnTransactionTypeId').val());
                $('#SourceTypeId').attr('disabled', false);
            } else {
                $('#SourceTypeId').val("");
                $('#hdnSourceTypeId').val("");
                $('#SourceTypeId').attr('disabled', true);
            }
        }

        function getSourceTypeByTransactionTypeId(typeId) {

             $.ajax({
                url: '@Url.Action("GetTransactionTypesForSearch", "File")',
                type: 'GET',
                cache: false,
                 data: { transactionCategory: typeId },
                 success: function (data) {
                     $('#SourceTypeId').val("");
                     $('#hdnSourceTypeId').val("");
                     AutoCompleteChangeList("SourceTypeId", data);
                }
            });
        }

    $(document).ready(function () {
        var selectddl = '';
        $(".MCShomeTabs li").click(function () {

            $(".MCShomeTabs").find('li').removeClass("active");

            if (selectddl == '') {
                $('#othrs').removeClass("active");
                selectddl = '';
            }
            else {
                $('#othrs').addClass("active");
                selectddl = '';
            }
            $(this).addClass("active");
        });
            $('#SourceTypeId').val("");
            $('#SourceTypeId').attr('disabled', true);

            $(".aSave").click(function () {
            idsList = [];
            $('.boxes input:checked').each(function (index, obj) {
                idsList.push(parseInt(obj.id.replace("ch_", "")));
            });
                var transactionsIds = idsList.join(',');
                var trayid = @((int)TrayType.MyTransactions);
                var trayActionType = @((int)TrayActionType.Save);
                var token = $("input[name='__RequestVerificationToken']").val();

                var data = {
                    trayId: trayid, transactionsIds: transactionsIds, trayActionType: trayActionType, __RequestVerificationToken: token
                };

                $.ajax({
                    url: '@Url.Action("MoveTransactionsList", "File")',
                    type: 'POST',
                    data: data,
                    success: function (data) {
                        window.location.href = '@Url.Action("MyTransactions", "File")';
                    }
                });
            });

        switch (localStorage.getItem('CurrentTypeView')) {
            case 'Card': goCardsView(event);
                break;
            case 'Table': goTableView(event);
                break;
            default: goTableView(event);
