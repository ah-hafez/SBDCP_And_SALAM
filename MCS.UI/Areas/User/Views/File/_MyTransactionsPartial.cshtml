             success: function (data) {
                 if (data.Count > 0) {
                     ShowCommitmentDialog(data.Html, "new-footer dialogbox col-md-8 col-md-offset-2 col-xs-8 col-xs-offset-2");
                 };
			   }
           });
        });


        var sortingOrders = [];
        var currentIndex = 1;

        function updateSortingData(index, ascending, obj) {
            var objIndex = checkIfExist(obj, ascending);

            if (obj.value == "") {
               sortingOrders.splice(objIndex, 1);
            } else {
                if (objIndex == -1) {
                    sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                    currentIndex++;
                } else {
                    sortingOrders[objIndex].Ascending = ascending;
                }
            }
        }

        function checkIfExist(obj) {
            var index = -1;
            for (var i = 0; i < sortingOrders.length; i++) {
                if (sortingOrders[i].ColunmName == obj.id) {
                    index = i;
                    break;
                }
            }
            return index;
        }

    function doSort(obj, value) {
        debugger;
            var selectedTab = parseInt($('#selectedTab').val());
             var dir = "";

            updateSortingData(currentIndex, value, obj);

            var filters = $("#hdnFilter").val();
            var sortData = { trayId: 1, dateType: selectedTab, sortType: obj.id, dir: dir, searchData: value, SortingOrders: sortingOrders, filter: filters };
            $.ajax({
                url: '@Url.Action("UpdateTrayTransactions", "File")',
                type: 'POST',
                cache: false,
                data: sortData,
                success: function (data) {
                    $('#TransactionsBoxes').html("");
                    $('#TransactionsBoxes').html(data.Html);
                    prepareTransactions(sortData);
                    goToViewAfterPaging();
                }
            });
        }

