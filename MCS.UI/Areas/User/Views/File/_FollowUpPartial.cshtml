<script>
        function Open(Id) {

        var type = $('#hdnTransactionType_' + Id).val();
        var url = "";
        switch (type) {
            case 'Inbound':
                url = '@Url.Action("Edit", "Inbound")' + '?id=-1';
                break;
            case 'ExternalOutbound':
                url = '@Url.Action("Edit", "OutboundExternal")' + '?id=-1';
                break;
            case 'InternalOutbound':
                url = '@Url.Action("Edit", "OutboundInternal")' + '?id=-1';
                break;
            case 'DraftOutbound':
                url = '@Url.Action("Edit", "OutboundDraft")' + '?id=-1';
                break;
            }
            url = url.replace("-1", EncryptionKey(Id));
            window.location.href = url;
    }

  var urlActionPage = "";
    function OpenFollowUpCertificate(transId) {
        debugger;
        var FollowuptrayId = $("#FollowuptrayId").val();
        var Id = transId;
          urlActionPage = '@Url.Action("FollowUp", "TransactionFollowUp")?transId=' + Id +  "&FollowuptrayId=" + FollowuptrayId ;

          ExecuteTargetFunction();

	}
     function ExecuteTargetFunction() {
            window.location.href = urlActionPage;
    }
	function OpenDraftEditor(trayId, id, type) {

        window.location.href = '@Url.Action("Index","Editor")?trayId=' + trayId + "&transactionId=" + id + "&transactionCategoryId="+type;
	}
    function OpenEditor(trayId, id, type) {

        window.location.href = '@Url.Action("Index","Editor")?trayId=' + trayId + "&transactionId=" + id + "&transactionCategoryId=" + type;
    }
</script>

<script>
	 var idsList = [];
	var FollowUpEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File", new { trayId = ViewData["TrayType"] ?? 1, dateType = ViewData["dateType"] ?? 1 }))";

    function prepareFollowUpTransactions(optionalData) {
        $(".grid-mvc").gridmvc();
        pageGrids.FollowUpGrid.ajaxify(
            {
                getPagedData: FollowUpEventHandler,
                getData: FollowUpEventHandler,
                requestType: "POST",
                optionalData: optionalData,
                callbackClientFunctionAfter: ["goToViewAfterPaging"],
            });
    }

    $(document).ready(function () {
          var selectddl = '';
        $(".MCShomeTabs li").click(function () {

            $(".MCShomeTabs").find('li').removeClass("active");

            if (selectddl == '') {
                $('#othrs').removeClass("active");
                selectddl = '';
            }
            else {
                $('#othrs').addClass("active");
                selectddl = '';
            }
            $(this).addClass("active");
        });
        $('#DateCal').attr('autocomplete', 'off');
    });
    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }
    function doSort(obj, value) {
        var trayid = '@Convert.ToInt32(TrayType.FollowUp)';
        var selectedTab = parseInt($('#selectedTab').val());
        updateSortingData(currentIndex, value, obj);

        var filters = $("#hdnFilter").val();
        var sortData = { trayId: trayid, dateType: selectedTab, sortType: obj.id, dir: value, searchData: value, SortingOrders: sortingOrders, filter: filters };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#FollowUpTransactionsBoxes').html("");
                $('#FollowUpTransactionsBoxes').html(data.Html);
                prepareFollowUpTransactions(sortData);
                goToViewAfterPaging();
            }
        });
    }
	function fillHidden(obj) {
		$('#hdn' + obj.id).val("");
		$('#hdn' + obj.id).val(obj.value);
	}

    function FilterBy(obj,trayid) {

        var selectedTab = parseInt($('#selectedTab').val());
        var filter = "";

        if ($("#TransNo").val() != "" && $("#TransNo").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Number__1__" + $("#TransNo").val();
        }

        if ($("#hdnDateCal").val() != "" && $("#hdnDateCal").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "FollowUpCreatedOn__1__" + $("#hdnDateCal").val();
        }
        if ($("#Description").val() != "" && $("#Description").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Subject__2__" + $("#Description").val();
        }
        $("#hdnFilter").val(filter);
        $("#FollowuptrayId").val(trayId);
        var filterData = { trayId: trayid, dateType: selectedTab, filter: filter,SortingOrders: sortingOrders };

        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterData,
            success: function (data) {

                $('#FollowUpTransactionsBoxes').html("");
                $('#FollowUpTransactionsBoxes').html(data.Html);
                prepareFollowUpTransactions(filterData);
                goToViewAfterPaging();
            },
            error: function (textStatus, errorThrown) {

            }

        });
    }

    function ShowUnFollowPopUp() {
        ShowConfirmMessage("@DbRes.TResource("User.FollowUp.AreYouUnFollowUp")", "doUnFollow");
    }

    function doUnFollow() {
        if (selectedTrans == "" || selectedTrans == null) {
            return;
        }
        var token = $("#frmOrgUnitsList").find("input[name='__RequestVerificationToken']").val();
        var Data = { transactionIds: selectedTrans, __RequestVerificationToken: token };

        $.ajax({
            url: '@Url.Action("MultiFollowUpUpdate", "File")',
            type: 'POST',
            data: Data,
            success: function (data) {
                window.location.href = "@Url.Action("FollowUp" , "File")";
            },
            error: function (textStatus, errorThrown) {
            }
        });
        }


    function filterByFollowUpType(obj, trayId) {
        $("#FollowuptrayId").val(trayId);

        $("div.mr-auto.filter-link a ").removeClass("active");
        //$(obj).addClass("active");

        goToViewAfterPaging();
        if (trayId == @FollowUpTrayId) {
            $('#dvcheckAll').hide();
            $("#dvChck").hide();
            $(CheckAllBoxes).closest('div').hide();
        }
        else {
            $('#dvcheckAll').show();
            $("#dvChck").show();
            $(CheckAllBoxes).closest('div').show();
        }
        $("#FollowUpTransactionsBoxes").html("");
        $('#trayId').val(trayId);
        var filterByTransactionTypeData = { trayId: trayId, dateType: '@Convert.ToInt32(TransactionDateType.Any)', PageSize: '@ViewData["PageSize"]' };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterByTransactionTypeData,
            success: function (data)
            {

                $("#FollowUpTransactionsBoxes").html(data.Html);
                unfillSelectedAll();
                prepareFollowUpTransactions(filterByTransactionTypeData);
                goToViewAfterPaging();
            },
            error: function (a)
            {
            }
        });

    }
    function goToView(id) {
        var trayId = $("#FollowuptrayId").val();
        var selectedTab = parseInt($('#selectedTab').val());
        $("#FollowUpTransactionsBoxes").html("");
        var filterByTransactionTypeData = { trayId: trayId , dateType: '@Convert.ToInt32(TransactionDateType.Any)', PageSize: '@ViewData["PageSize"]', renderType: id };
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterByTransactionTypeData,
            success: function (data) {
                $("#FollowUpTransactionsBoxes").html(data.Html);
                unfillSelectedAll();
                $('#selectedTab').val(filterByTransactionTypeData.dateType);
                prepareFollowUpTransactions(filterByTransactionTypeData);
                goToViewAfterPaging();
            },
            error: function (a) {
            }
        });
        }
</script>