    var managerEventHandler = "@Html.Raw(Url.Action("UpdateTrayTransactions", "File",new { trayId = "TrayType", dateType = ViewData["dateType"] ?? 1584 }))";
    function prepareManager(trayId, optionalData) {
        $(".grid-mvc").gridmvc();
        var newURL = managerEventHandler.replace("TrayType", trayId);
        pageGrids.Manager.ajaxify(
            {
                getPagedData: newURL,
                getData: managerEventHandler,
                requestType: "POST",
                callbackClientFunctionAfter: ["goToViewAfterPaging"],
                optionalData: optionalData
            });
    }

    var selectedAssignmentId = '';
    var selectedTransactionId = '';
    var trayActionType = '';
    var idsList = [];

    function openPendingExecution(type, tabId) {
        idsList = $('#encryptedTransactionsIds').val().split(",");
        var encryptedtype = type == '1' ? $('#numberOne').val() : $('#numberTwo').val();
        var encryptedtab = tabId == '1' ? $('#numberOne').val() : $('#numberTwo').val();
        var queryString = idsList.length > 0 ? "?" : "";
        for (var i = 0; i < idsList.length; i++) {
            queryString = queryString + "transactionsIds=" + idsList[i] + "&";
        }
        window.location.href = '@Url.Action("PendingExecuting", "File")' + queryString + 'type=' + type + '&trayType=' + type + '&tabId=' + tabId;
    }

    function ComfirmRevertManagerTray() {

        var trayid = parseInt($("#hdnTrayId").val());
        var page = $("#hdnCurrentPage").val();
        var orderBy = $("#hdnOrderBy").val();
        var dir = $("#hdnDirection").val();
        var filter = $("#hdnFilter").val();
        var fromDate = $("#hdnFromDateValue").val();
        var toDate = $("#hdnToDateValue").val();
        var number = $("#hdnSearchTransactionNumberValue").val();
        var dateType = $("#hdnFilterDateType").val();
        var viewType = $("#hdnViewFile").val();
        var PageSize = $("#ddlPaging").val();

        var data = {
            trayId: trayid, page: page, gridColumn: orderBy, dir: dir, filter: filter, fromDate: fromDate,
            toDate: toDate, searchColumn: number, viewType: viewType, transactionId: selectedTransactionId, trayActionType: trayActionType
            , dateType: dateType, assignmentId: selectedAssignmentId, pageSize: PageSize
        };


        $.ajax({
            url: '@Url.Action("MoveTransaction","File")',
            type: 'POST',
            data: data,
            success: function (data) {
                if (data.MessageType != 2) {

                    $("#dvTransactionsContainer").html("");
                    $("#dvTransactionsContainer").html(data.Html);
                    $("#txtCurrentPage").val(page);
                    $("#hdnCurrentPage").val(page);
                    $("#ddlPaging option[value=" + PageSize + "]").attr('selected', 'selected');

                    $("li#_UserFileMenu").html("");
                    $("li#_UserFileMenu").html(data.FileMenuHtml);

                    if (selectedTransactionId == parseInt($("#hdnTransEditorId").val())) {
                        $("#editor_transaction").html("");
                    }

                    ShowSuccesMessage(data.MessageText);
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            },
            error: function (a) {
            }
        });

        return true;
    }

    $(".revertAssignment").click(function () {
        selectedAssignmentId = $(this).data("id-assignment");
        selectedTransactionId = $(this).data("id")
        trayActionType = $(this).data("type");

        $.ajax({
            type: 'get',
            url: '@Url.Action("RevertManagerTray", "File")',
            data: { transactionId: selectedTransactionId, assignmentId: selectedAssignmentId },
            success:
           function (data) {
               if (data.MessageType != 2) {
                   if (parseInt(data.TasksCount) > 0) {
                       ShowConfirmMessage(data.MessageText, "ComfirmRevertManagerTray");
                       return true;
                   }

                   ComfirmRevertManagerTray();
                   return true;
               }
               else {
                   ShowErrorMessage(data.MessageText);
               }
           }
        });
    })

    $(".aSave").click(function () {
        selectedAssignmentId = $(this).data("id-assignment");
        selectedTransactionId = $(this).data("id")
        trayActionType = $(this).data("type");

        $.ajax({
            type: 'get',
            url: '@Url.Action("RevertManagerTray","File")',
            data: { transactionId: selectedTransactionId, assignmentId: selectedAssignmentId },
            success:
               function (data) {

                   if (data.MessageType != 2) {
                       if (parseInt(data.TasksCount) > 0) {
                           ShowConfirmMessage(data.MessageText, "ComfirmRevertManagerTray");
                           return true;
                       }

                       ComfirmRevertManagerTray();
                       return true;
                   }
                   else {
                       ShowErrorMessage(data.MessageText);
                   }
               }
        });
    });

    $(".openAssignment").click(function (e) {

        e.stopPropagation();

        var transactionId = $(this).data("id");
        var assignmentId = $(this).data("id-assignment");
        var data = { transactionIds: transactionId, assignmentId: assignmentId };

        ShowDialogAjax('@Url.Action("OpenManagerAssignment", "File")', data, "OnOpenAssignmentSuccess", "dialogbox col-md-10 col-md-offset-1 col-xs-10 col-xs-offset-1")
    })

    function OnOpenAssignmentSuccess(data, $obj) {
        $obj.setContent(data.Html);
        jQuery.validator.unobtrusive.parse('#dvTransactionAssignmentCotainer');
    }

    //$(document).ready(function () {
    //    $("#list_transaction").find(".view_Editor:first").trigger("click");
    //})

    $(".view_Editor").click(function (e) {

        var type = $(this).data("type");
        var id = $(this).data("id");
        var trayId = $(this).data("tray");
        $(".view_group").removeClass("select");
        $(this).parents(".view_group").addClass("select");

        var data = {
            trayId: trayId, transactionId: id, transactionCategoryId: type
        };

        $.ajax({
            url: '@Url.Action("Index","Editor")',
            type: 'Get',
            cache: false,
            data: data,
            success: function (data) {
                $("#editor_transaction").html("");
                $("#editor_transaction").html(data);
                jQuery.validator.unobtrusive.parse('#editor_transaction');
            },
            error: function (a) {
            }
        });
    })

    var sortingOrders = [];
    var currentIndex = 1;

    function updateSortingData(index, ascending, obj) {
        var objIndex = checkIfExist(obj, ascending);

        if (obj.value == "") {
            sortingOrders.splice(objIndex, 1);
        } else {
            if (objIndex == -1) {
                sortingOrders.push({ Index: index, Ascending: ascending, ColunmName: obj.id });
                currentIndex++;
            } else {
                sortingOrders[objIndex].Ascending = ascending;
            }
        }
    }

    function checkIfExist(obj) {
        var index = -1;
        for (var i = 0; i < sortingOrders.length; i++) {
            if (sortingOrders[i].ColunmName == obj.id) {
                index = i;
                break;
            }
        }
        return index;
    }


    function doSort(obj) {
        var ele = $('#hdn' + obj.id).val();
        updateSortingData(currentIndex, ele, obj);

        var filters = $("#hdnFilter").val();
        var sortData = { trayId: @trayId , sortType: obj.id, dir: ele, searchData: ele, SortingOrders: sortingOrders, filter: filters};
        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions", "File")',
            type: 'POST',
            cache: false,
            data: sortData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                goToViewAfterPaging();
                prepareManager(@trayId, sortData);
            }
        });
    }

    function fillHidden(obj) {
        $('#hdn' + obj.id).val("");
        $('#hdn' + obj.id).val(obj.value);
    }

    function FilterBy() {
        var trayid = @trayId;
        var filter = "";

         if ($("#hdnPriorityLevelId").val() != "" && $("#hdnPriorityLevelId").val() != null) {

             filter += "Priority__1__" + $("#hdnPriorityLevelId").val();
        }
         if ($("#hdnConfidentialityLevelId").val() != "" && $("#hdnConfidentialityLevelId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
             filter += "Confidentiality__1__" + $("#hdnConfidentialityLevelId").val();
        }

        //if ($("#hdnEntityId").val() != "" && $("#hdnEntityId").val() != null) {

        //    if (filter.length > 0) {
        //        filter += "&";
        //    }
        //    filter += "UserId__1__" + $("#hdnEntityId").val();
        //}
        if ($("#hdnDocTypeId").val() != "" && $("#hdnDocTypeId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "TransactionType__1__" + $("#hdnDocTypeId").val();
        }
        if ($("#hdnDateCal").val() != "" && $("#hdnDateCal").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Date__1__" + $("#hdnDateCal").val();
        }
        if ($("#TransId").val() != "" && $("#TransId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "Number__1__" + $("#TransId").val();
        }
        if ($("#divForm__treeManager").find(".hdnDepartmentId").val() != "" && $("#divForm__treeManager").find(".hdnDepartmentId").val() != null) {

            if (filter.length > 0) {
                filter += "&";
            }
            filter += "ToEntity__1__" + $("#divForm__treeManager").find(".hdnDepartmentId").val();
        }
        if ($("#hdnManagerUserId").val() != "" && $("#hdnManagerUserId").val() != null) {
            if (filter.length > 0) {
                filter += "&";
            }
            filter += "UserId__1__" + $("#hdnManagerUserId").val();
        }
        $("#hdnFilter").val(filter);

        var filterData = { trayId: trayid, filter: filter, SortingOrders: sortingOrders };

        $.ajax({
            url: '@Url.Action("UpdateTrayTransactions","File")',
            type: 'POST',
            data: filterData,
            success: function (data) {
                $('#TransactionsBoxes').html("");
                $('#TransactionsBoxes').html(data.Html);
                goToViewAfterPaging();
                prepareManager(@trayId, filterData);
            }
        });
    }

    function GetUsersByOrgUnitId() {
        var FromOrgUnitId = $('#TreeOrgUnit_hdnDepartmentId').val();
        var token = $("#frmOrgUnitsList").find("input[name='__RequestVerificationToken']").val();
        if (FromOrgUnitId != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId", "File")',
                data: { id: FromOrgUnitId, __RequestVerificationToken: token },
                cache: false,
                success: function (data) {
                    $("#ddlEmployeeId").val("");
                    $("#EmployeeId").val("");
                    AutoCompleteChangeList("ddlEmployeeId", data);
                    $("#ddlEmployeeId").prop('disabled', false);
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
            return false;
        }
        else {
            $("#ddlEmployeeId").prop('disabled', true);
            $("#ddlEmployeeId").val("");
            $("#EmployeeId").val("");
            AutoCompleteChangeList("ddlEmployeeId", "[]");
        }
    }

    function GetManagerAllUsers() {

        if ($("#divForm__treeManager").find(".hdnDepartmentId").val() != "") {

            $.ajax({
                type: 'post',
                cache: false,
                url: '@Url.Action("GetUsersByOrgUnitId", "File")',
                data: { id: $("#divForm__treeManager").find(".hdnDepartmentId").val() },
                success:
               function (data) {
                   AutoCompleteChangeList("ddlManagerUserId", data);
               }
            });
        }
        else {
            $("#ddlManagerUserId").val("");
            $("#hdnManagerUserId").val("");
            AutoCompleteChangeList("ddlManagerUserId", "[]");
        }
    }
</script>