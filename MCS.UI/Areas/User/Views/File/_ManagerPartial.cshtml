<script>
          @*function goToView(id) {

          var TypeData = { trayId: '@Convert.ToInt32(TrayType.Manager)', dateType: parseInt('@Convert.ToInt32(TransactionDateType.Any)'), PageSize: @ViewData["PageSize"]!= null ?@ViewData["PageSize"]: '@UIHelper.PageSize', renderType : id};
