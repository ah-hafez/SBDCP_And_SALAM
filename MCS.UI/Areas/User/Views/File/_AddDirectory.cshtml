@model ArchivDirectory
@using MCS.Common
@using MCS.Framework.Controls.Mvc
@using MCS.Framework.Controls
@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Archives


<!-- ******************************Content ************************* -->
<div class="mt-5" style="margin-top: 3rem;">
    <label style="font-size: 30px;text-align: center;display: grid;">@DbRes.TResource("User.Directory.Create") </label>
</div>

<div class="white-container mx-md-5 mx-3">

    <div class="form-row center">

        <div class="row col-lg-12 col-md-12 col-sm-9">
            <div class="form-group col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-3">
                <label> @DbRes.TResource("User.Archive.Directory.Number") <span class="stark">*</span></label>
                @Html.TextBoxFor(Model => Model.DirectoryNum, new { @class = "form-control" })
            </div>
        </div>

        <div class="row col-lg-12 col-md-12 col-sm-9">
            <div class="form-group col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-3">
                <label>@DbRes.TResource("User.Archive.Dirtctory.Code") <span class="stark">*</span></label>
                @Html.TextBoxGroupFor(model => model.Code, "", new { @class = "form-control", maxlength = "5" })
            </div>
        </div>
        <div class="row col-lg-12 col-md-12 col-sm-9">
            <div class="form-group col-lg-6 col-md-12 col-sm-12 col-xs-12  mb-3">
                <div class="input-group w-100">
                    <div class="form-group w-100">
                        <label class="w-100">@DbRes.TResource("User.Inbound.BasicInfo.Subject") <span class="stark">*</span></label>
                        @Html.TextAreaGroupFor(model => model.Description, new { id = "txtAreaSubject", @class = "form-control", @rows = "5" }, "BasicInformation")
                    </div>
                </div>
            </div>
        </div>
        <div class="row col-lg-12 col-md-12 col-sm-9">
            <div class="form-group col-lg-6 col-md-12 col-sm-12 col-xs-12  mb-3">
                <div class="input-group w-100">
                    <div class="form-group w-100">
                        <label class="container" style="color: #233f2d;">
                            <input type="checkbox" id="SubCheckBox" onclick="DirectorySubFun()">
                            @DbRes.TResource("User.Archive.Directory.Subdirectory")
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row col-lg-12 col-md-12 col-sm-9" id="DirectorySub" style="display:none;">
            <div class="form-group col-lg-6 col-md-12 col-sm-12 col-xs-12 mb-3">
                <label> @DbRes.TResource("User.Archive.Classification") <span class="stark">*</span></label>
                @Html.TextBoxFor(Model => Model.DirectoryNum, new { @class = "form-control" })
            </div>
        </div>

        <div class="row col-lg-12 col-md-12 col-sm-9" style="direction:ltr">
            <div class="form-group col-lg-6 col-md-12 col-sm-12 col-xs-12  mb-3">
                <div class="input-group w-100">
                    <div class="form-group w-100">
                        @Html.ConfirmAction(OperationType.Save, "btnSaveOutboundExternal", DbRes.TResource("User.OutboundExternal.Save"), "AddOutboundExternal", null, null, null, "OnSuccess", null, DbRes.TResource("User.OutboundExternal.SaveMessage"), "post", "frmAddOutboundExternal", "BasicInformation", "btn btn-st1 btn-lg", "CheckPriorityIfHasDate", "", "NotValid")
                        <input class="btnSendOutbound btn-site" style="display:none;" type="button" value="@DbRes.TResource("User.OutboundExternal.Add.sent")" />
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- ****************************** end Content ************************* -->

<style>
    .RedBorder {
        border: 1px solid #fe0000 !important
    }

    .center {
        position: absolute;
    }

    .white-container {
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        padding: 15px 25px;
        box-shadow: 0px 8px 20px 5px #00000017 !important;
        clear: both;
        margin-bottom: 30px;
        box-shadow: none !important;
        border: 1px solid #e2e2e2;
        width: 40%;
        position: absolute;
        height: 80%;
        left: 27%;
    }

    label {
        font-size: 20px;
    }

    .app-content.center-layout, html body .content.app-content {
        overflow: scroll
    }
</style>

<script>
    var DirectorySub = document.getElementById('DirectorySub');
    var checkBox = document.getElementById('SubCheckBox');

    function DirectorySubFun() {
        debugger
        if (checkBox.checked == true) {
            DirectorySub.style.display = "block";
        }
        else {
            DirectorySub.style.display = "none"
        }
    }
</script>

