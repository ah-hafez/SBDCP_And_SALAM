@model CopyViewModel

@using MCS.UI.Areas.User.Models;
@using MCS.UI.Areas.User.Models.Transaction;
@using MCS.Framework.Localization;
@using MCS.Common;
@using MCS.UI.Areas.User.Models.Assignment;
@using MCS.UI.Helpers


@{
    Layout = "~/Areas/User/Views/Shared/_VIPLayout.cshtml";
    var Copies = (AjaxGrid<TransactionCopyVM>)new AjaxGridFactory().CreateAjaxGrid(Model.TransactionCopyVM.Copies, 1, Model.TransactionCopyVM.Copies.Count, false);

}
<script src="~/Scripts/VipCommon.js"></script>

<script src="~/Content/User/lib/js/app.min.js"></script>
<div class="white-container mx-md-5 mx-3">

    @using (Html.BeginForm("", "", FormMethod.Post, new { id = "frmVipTransactionCopy", @class = "tab-content" }))
    {
        @Html.AntiForgeryToken()
        @Html.StickyHidden("hdnTransactionId",Model.TransactionBasicInfoVM.TransactionId.ToString(), new { id = "Id", @class = "TransactionId" })
        <div class="" id="">
            @Html.Partial("~/Areas/User/Views/Editor/EditorInbound/_InboundBasicInfoPartial.cshtml", Model.TransactionBasicInfoVM)
            <hr />
            <div id="ArchivingPartial">
                @if (Model.EditorType == EditorType.Scanning)
                {
                    Html.ViewData.TemplateInfo.HtmlFieldPrefix = null;
                    @Html.Partial("~/Areas/User/Views/Transaction/_ArchivingPartialMainDocument.cshtml", new TransactionArchiveVM(TransactionAttachmentType.Main, true, false, true, bReadOnly: true), Html.ViewData)
                }
                else if (Model.EditorType == EditorType.TextEditor)
                {
                    @Html.Partial("~/Areas/User/Views/Transaction/_EditorPartial.cshtml", ViewData["EditorViewModel"], Html.ViewData)
                }
            </div>
        </div>
        <div class="extraOption col-lg-12 c0l-md-6 col-xs-12 m-3">
            <h4>
                <a role="button" style="display:flex">
                    <span onclick="CollapseDiv('electronicCopies'); return false;" style="cursor: pointer;">
                        <img src="~/Content/User/lib/images/plus-icon.svg" id="electronicCopiesPlusIcon" width="25" />
                        <img src="~/Content/User/lib/images/Dash-icon.svg" id="electronicCopiesDashIcon" width="25" style="display: none;" />
                    </span>
                    <span class="ml-3 mt-1">@DbRes.TResource("User.Trays.ElecCopies")</span>
                </a>
            </h4>

            <div role="tabpanel" class="tab-pane" id="electronicCopies" style="display:none">
                <div>
                    @Html.Partial("~/Areas/User/Views/Vip/Copies/TransactionCopies/_TransactionCopiesGridPartial.cshtml", Copies)
                </div>
            </div>
        </div>

        @*<div class="extraOption col-lg-12 c0l-md-6 col-xs-12 m-3">
            <h4>
                <a role="button" style="display:flex">
                    <span onclick="CollapseDiv('assigmentpaper'); return false;" style="cursor: pointer;">
                        <img src="~/Content/User/lib/images/Dash-icon.svg" id="assigmentpaperDashIcon" width="25" />
                        <img src="~/Content/User/lib/images/plus-icon.svg" id="assigmentpaperPlusIcon" width="25" style="display: none;" />
                    </span>
                    <span class="ml-3 mt-1">@DbRes.TResource("User.File.AssignmentPaper")</span>
                </a>
            </h4>
            <div role="tabpanel" class="tab-pane" id="assigmentpaper">
                <div>
                    @{ViewData.TemplateInfo.HtmlFieldPrefix = "AssignmentVM";}

                    @if (SessionInfo.CurrentUser.DefaultAssignmentPaper == false)
                    {
                        @Html.Partial("~/Areas/User/Views/Vip/Copies/AssignmentPaper/_AssignmentPaperCopiesPartial.cshtml", new VipCopyTransactionAssignmentVM(), Html.ViewData)
                    }
                    else
                    {
                        @Html.Partial("~/Areas/User/Views/Vip/Copies/AssignmentPaper/_AssignmentPaperPartialNewCopis.cshtml", new VipCopyTransactionAssignmentVM(), Html.ViewData)
                    }
                </div>
            </div>
        </div>*@


        <div class="extraOption col-lg-12 c0l-md-6 col-xs-12 m-3">
            <h4>
                <a role="button" style="display:flex">
                    <span onclick="CollapseDiv('followup'); return false;" style="cursor: pointer;">
                        <img src="~/Content/User/lib/images/Dash-icon.svg" id="followupDashIcon" width="25" />
                        <img src="~/Content/User/lib/images/plus-icon.svg" id="followupPlusIcon" width="25" style="display: none;" />
                    </span>
                    <span class="ml-3 mt-1">@DbRes.TResource("User.Inbound.FollowUp")</span>
                </a>
            </h4>
            <div id="followup">
                @Html.Partial("~/Areas/User/Views/Vip/Copies/FollowUp/_FollowUpPartial.cshtml", Model.TransactionFollowUp, Html.ViewData)
            </div>
        </div>
        @Html.StickyHidden("hdntransactionId", ViewData["TransactionId"].ToString())
    }
    <div class="row text-right mr-5 mt-4 ml-xs-3 mb-4">
        <a class="btn btn-st2 btn-lg pull-right mr-1 " id="ViewedCopy" onclick="ViewedCopy(@Model.TransactionBasicInfoVM.TransactionId)">@DbRes.TResource("User.File.Viewed")</a>

        @Html.ConfirmAction(OperationType.Update, "SaveBtn", DbRes.TResource("User.File.SaveandSend"), Url.Action("SaveCopy", "Vip"), null, null, null, "OnSuccess", null, DbRes.TResource("User.OutboundInternal.SaveMessage"), "post", "frmVipTransactionCopy", "", "btn btn-st2 btn-lg pull-right margin mr-2", "", "", null)
        <button id="SaveBtn" hidden></button>

    </div>
</div>
<script>


    $(document).ready(function () {
        $('html, body').animate({
            scrollTop: $('#ArchivingPartial').offset().top
        }, 'slow');
    });
    function CollapseDiv(divName) {
        if ($('#' + divName).css('display') == 'block') {
            $('#' + divName).css("display", "none");
            $('#' + divName + 'PlusIcon').css("display", "inline-block");
            $('#' + divName + 'DashIcon').css("display", "none");
        }
        else {
            $('#' + divName).css("display", "block");
            $('#' + divName + 'PlusIcon').css("display", "none");
            $('#' + divName + 'DashIcon').css("display", "inline-block");
        }
    }
    function OnSuccess(data) {

        debugger;
        SendAssignmentPaper();
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
        }
    }
    function ViewedCopy(id) {
     var token = $("#frmVipTransactionCopy").find("input[name='__RequestVerificationToken']").val();
            $.ajax({
            type: "POST",
            url: '@Url.Action("ViewedCopy", "Vip")',
            cache: false,
            data: { TransactionsId:id, __RequestVerificationToken: token},
            success: function (data) {
            window.location.href = '@Url.Action("Copies", "File")';
               }

        });
        return false;
    }


</script>