<style>

    table {
        width: 100%;
        border-collapse: collapse;
        /*        margin-bottom: 20px;
    */
    }

    table, th, td {
        border: 1px solid black;
    }

    th, td {
        padding: 2px;
        text-align: center;
    }

    /* th {
                background-color: #f2f2f2;
            } */

    table table {
        width: 100%;
        border-collapse: collapse;
    }

