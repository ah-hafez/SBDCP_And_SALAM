               var EnableBcc = objId.replace("IsCopy", "IsBcc");
            if (obj.checked) {
                $('#' + hdnId).val(true);
                $('#' + EnableBcc).removeAttr("disabled");
                $('#' + EnableBcc).removeClass("disabled");
