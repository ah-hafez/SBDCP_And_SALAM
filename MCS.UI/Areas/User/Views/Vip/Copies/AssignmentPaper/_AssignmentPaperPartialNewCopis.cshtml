        var TransactionId = @ViewData["TransactionId"];

        var requestData = "__RequestVerificationToken=" + token +
            "&" + AddedEntities +
            "&transactionId=" + TransactionId +
            "&explanation=" + explanation +
            "&Action=" + selectedAction +
            "&Confidentiality=" + selectedConfidentiality +
            "&ExplanationPriority" + ExplanationPriority;



        if (AddedEntities != "") {

           $.ajax({
                    type: 'post',
                    cache: false,
                    url: '@Url.Action("PrintAssignmentPaperVIP", "Inbound")',
                    data: requestData,
               success:
                   function (data) {
                       if (data) {
                           if (data.MessageType != 2) {

                               var TransactionAssignmentWindow = window.open('', '_blank', 'width=900,height=500');

                               TransactionAssignmentWindow.document.write(data);
                               TransactionAssignmentWindow.document.close();
                               TransactionAssignmentWindow.focus();

                               setTimeout(function () {
                                   TransactionAssignmentWindow.print();
                                   TransactionAssignmentWindow.close();
                               }, 2000);
                           }
                           else {
                               ShowErrorMessage(data.MessageText);
                           }
                       }
                   }
            });
        }
    }

    function PrintAssignmentPaperDeliveryReport(data) {
