    var urlAccordingToTransactionType;
    var errorCount = 0;
    function SendAssignmentPaper() {
        debugger;
        var AddFollowUp = false;
        errorCount = 0;
        if (localStorage.getItem("selectedEntity") == null) {
            $("#CalMessageOrg").removeClass("hidden_");
            $("#CalMessageorg").show();
            $("#dateMessageOrg").html('@Html.Raw(DbRes.TValidation("User.Transaction.AssignedToEntityValidation"))');
            errorCount++;
        }
        if ($('#hdnDeliveryMethodForAssignmentPaper').val() == null || $('#hdnDeliveryMethodForAssignmentPaper').val() == "") {
            $("#CalMessageDeliveryMethod").removeClass("hidden_");
            $("#CalMessageDeliveryMethod").show();
            $("#dateMessageDeliveryMethod").html('@Html.Raw(DbRes.TValidation("User.Transaction.AssignmentPaper.DeliveryMethodValidation"))');
            errorCount++
        }
        if (($('#explanation').text() != null && $('#explanation').text().trim() != "") && ($('#hdnExplanationConfedentialityForAssignmentPaper').val() == null || $('#hdnExplanationConfedentialityForAssignmentPaper').val() == "")) {
            $("#CalMessageConfidentiality").removeClass("hidden_");
            $("#CalMessageConfidentiality").show();
            $("#dateMessageConfidentiality").html('@Html.Raw(DbRes.TValidation("User.Explanation.ConfidentialityRequired"))');
            errorCount++
        }

        if (followUpCheck.checked == true) {
            AddFollowUp = true;
            AssignPaperCheckFollowUpDate();

        }
        else {
            $('#hdnAssignmentPaperFolloupDateGreg').val(null);
            $('#hdnAssignmentPaperFollowUpDateUm').val(null);
            $('#AssignmentPaperFollowUpPeriodId').val(null);
            $('#AssignmentPaperFollowUpProccessId').val(null);
        }
        if (errorCount > 0) {
            return false;
        }
        var token = $("input[name='__RequestVerificationToken']").val();
        var AddedEntities = $("#AddedEntities :input").serialize();
        var explanation = $("#explanation").text().trim();
        var Confedentiality = $('#hdnExplanationConfedentialityForAssignmentPaper').val();


        var selectedConfidentiality = $("input[name='selectedConfidentiality']:checked").val() != undefined ? $("input[name='selectedConfidentiality']:checked").val() : $('#hdnExplanationConfedentialityForAssignmentPaper').val();
        var selectedAction = $("input[name='selectedAction']:checked").val() != undefined ? $("input[name='selectedAction']:checked").val() : '';


        var deliveryMethodId = $('#hdnDeliveryMethodForAssignmentPaper').val();
        var TransactionId = @ViewData["TransactionId"];
        var reporterId = $('#hdnAssignmentPaperReporter').val();
        var FolloupDateTo = $('#hdnAssignmentPaperFolloupDateGreg').val();
        var FolloupDateH = $('#hdnAssignmentPaperFollowUpDateUm').val();
        var FollowUpPeriod = $('#AssignmentPaperFollowUpPeriodId').val();
        if (FollowUpPeriod == "") {
            FollowUpPeriod = "0"
        }
        var FollowUpProccess = $('#AssignmentPaperFollowUpProccessId').val();
        if (FollowUpProccess == "") {
            FollowUpProccess = "0"
        }

        var isConfirmed = $("#isConfirmed").val();

        var requestData = "__RequestVerificationToken=" + token + "&" + AddedEntities +
            "&explanationTxt=" + explanation +
            "&ConfedentialityId=" + selectedConfidentiality +
            "&TransactionId=" + TransactionId +
            "&deliveryMethodId=" + deliveryMethodId +
            "&reporterId=" + reporterId +
            "&AddFollowUp=" + AddFollowUp +
            "&FolloupDateTo=" + FolloupDateTo +
            "&FolloupDateH=" + FolloupDateH +
            "&FollowUpPeriod=" + FollowUpPeriod +
            "&FollowUpProccess=" + FollowUpProccess +
            "&isConfirmed=" + isConfirmed +
            "&action=" + selectedAction;


        if (AddedEntities != "") {
            $.ajax({
                type: 'post',
                cache: false,
                url: '@Url.Action("SendAssignmentPaper","Inbound")',
                data: requestData,
                success: function (data) {
                        switch (data.MessageType)
                        {
                            case 0:
                                break;
                            case 1:
                                return ShowConfirmMessage(data.MessageText, "ContinueAssigneTransaction");
                                break;
                            default:
                                return ShowErrorMessage(data.MessageText);
                        }
                        if (data.MessageType != 2) {
                            urlAccordingToTransactionType = data.returnUrl;
                            if (false) {
                                $.ajax({
                                    type: 'post',
                                    url: '@Url.Action("GetDeliveryReportByTransactionIds", "Inbound")',
                                    data: { transactionIds: $('#hdnTransactionID').val(), __RequestVerificationToken: token },
                                    success: function (data) {
                                        if (data.MessageType != 2) {
                                            PrintAssignmentPaperDeliveryReport(data.TransactionDeliveryReports);
