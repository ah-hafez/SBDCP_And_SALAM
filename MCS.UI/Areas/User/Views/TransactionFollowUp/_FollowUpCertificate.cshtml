@model MCS.UI.Areas.User.Models.Transaction.FollowUpCertificateVM
@using MCS.Common;
@using MCS.UI.Areas.User.Models.Transaction;
@using MCS.Framework.Controls
@using MCS.Framework.Localization
@using MCS.Framework.Controls.Mvc
@{
    /**/
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
    ViewData.TemplateInfo.HtmlFieldPrefix = "FollowUpTab";
    if (ViewData["FollowUpOrgId"] != null)
    {
        Model.FollowUpEntityId = Convert.ToInt32(ViewData["FollowUpOrgId"]);
    }
    if (ViewData["FollowUpUserId"] != null)
    {
        Model.FollowUpUserId = Convert.ToInt32(ViewData["FollowUpUserId"]);
    }
}
<script src=@Url.Content("~/Content/User/lib/js/app.min.js")></script>
<script src="~/Scripts/Transaction.js"></script>
<br />

<div id="FollowUpForm">
    @if (true)
    {

        <div class="form-row BasicInfo ml-3">
            <div class="d-flex" style="margin-right:-45px; margin-bottom:16px;">
                <div class="pl-sm-5 Editor-div">
                    <div class="gray3">@DbRes.TResource("User.Inbound.BasicInfo.Subject")</div>
                    <div class="transaction-number Editor-lable">@ViewData["Subject"]</div>
                </div>
                <div class="pl-5 Editor-div">
                    <div class="gray3">@DbRes.TResource("User.Transaction.Link.TransactionNumber") </div>
                    <div class="date-value Editor-lable">
                        @ViewData["TransactionsNumber"]
                    </div>
                </div>
                <div class="pl-sm-5">
                    <div class="gray3">@DbRes.TResource("User.Transaction.PriorityLevel")</div>
                    <div class="transaction-number Editor-lable" style="word-break:break-all">@ViewData["PriorityLevel"]</div>
                </div>

                <div class="pl-5 Editor-div">
                    <div class="gray3">@DbRes.TResource("User.Transaction.ConfidentialityLevel") </div>
                    <div class="date-value Editor-lable">
                        @ViewData["ConfidentialityName"]
                    </div>
                </div>

            </div>
        </div>


        <div id="divFollowUpContent">

            <div class="form-row">
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.Source") <span class="stark">*</span></label>
                    @Html.AutoCompleteBuilder("ddlFollowUpSource", "FollowUpSourceId", ViewData["FollowUpSource"].ToString(), null, true, "form-control", selectFirstIndex: true)
