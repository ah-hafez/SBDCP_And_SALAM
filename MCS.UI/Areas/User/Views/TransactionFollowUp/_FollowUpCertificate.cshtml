                        <span id="FollowUpdateMessage" style="color:red"></span>
                    </div>
                </div>
                <div class="form-group col-lg-6 col-md-6 col-sm-12 col-xs-12  mb-3">
                    <div class="class=" input-group w-100"">
                        <div class="form-group w-100">
                            <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.FollowUpProccessNote") <span class="stark">*</span></label>
                            @Html.TextAreaGroupFor(model => model.FollowUpProccessNote, new { id = "txtAreaFollowUpProccessNote", @class = "form-control basic-info-add", @rows = "3" }, "FollowUp")
                        </div>
                    </div>
                </div>
                <div class="form-group col-lg-6 col-md-6 col-sm-12 col-xs-12  mb-3">
                    <div class="class=" input-group w-100"">
                        <div class="form-group w-100">
                            <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.FollowUpReason") <span class="stark">*</span></label>
                            @Html.TextAreaGroupFor(model => model.FollowUpReason, new { id = "txtAreaFollowUpReason", @class = "form-control basic-info-add", @rows = "3" }, "FollowUp")
                        </div>
                    </div>
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.Progress") </label>
                    @Html.NumericTextBoxFor(model => model.FollowUpProgressId, new { id = "txtFollowUpProgress", @class = "form-control", maxlength = 3 }, "")

                </div>

                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <label>
                        @Html.CheckBoxFor(model => model.IsCompleted, new { id = "chkIsCompleted", @class = "" })
                        @Html.StickyHiddenFor(model => model.IsCompleted, new { id = "hdnIsCompleted" })
                        @DbRes.TResource("User.FollowUpCertificate.FollowUp.IsCompleted")
                    </label>
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3" id="divCompletionDate" style="display:none">

                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.CompletionDate")<span class="stark NotIndividual">*</span></label>
                    <div class="with-icon">
                        @Html.CalendarCustom("FolloupCompletionDateCal", "hdnFolloupCompletionDateGreg", "hdnFolloupCompletionDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), Model != null ? Model.FollowUpCompletionDateHj : null, "form-control")
                        <a class=" date-icon2 " onclick="showCalender('FolloupCompletionDateCal')"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                        @Html.HiddenGroupFor(model => model.FollowUpCompletionDate, new { id = "hdnFolloupCompletionDateGreg", AutoComplete = "off" }, "")
                        @Html.HiddenGroupFor(model => model.FollowUpCompletionDateHj, new { id = "hdnFolloupCompletionDateUm", AutoComplete = "off" }, "")
                        <i id="FollowUpMessage" style="color:red" class="glyphicon glyphicon-exclamation-sign hidden_"></i>
                        <span id="FollowUpdateMessage" style="color:red"></span>
                    </div>

                    @Html.StickyHiddenFor(model => model.TransactionId, new { id = "hdnTransactionId" })
                    @Html.StickyHiddenFor(model => model.FollowUpTypeId, new { id = "hdnfollowuptype" })
                    @Html.StickyHiddenFor(model => model.FollowUpId, new { id = "hdnfollowupid" })
                    @Html.StickyHiddenFor(model => model.ReadOnly, new { id = "hdnReadOnly" })
                    @Html.StickyHiddenFor(model => model.IsUnderFollowup, new { id = "hdnIsUnderFollowup" })
                    @Html.StickyHiddenFor(model => model.IsCanceld, new { id = "hdnIsCanceld" })
                    @Html.StickyHiddenFor(model => model.HasChild, new { id = "hdnHasChild" })
                    @Html.StickyHiddenFor(model => model.IsFinalCompleted, new { id = "hdnIsFinalCompleted" })
                    @Html.StickyHiddenFor(model => model.FollowUpUserName, new { id = "hdnFollowUpUserName" })
                    @Html.StickyHiddenFor(model => model.IsEscalated)
                    @Html.StickyHiddenFor(model => model.IsCopy)
                    @Html.StickyHiddenFor(model => model.IsImportant)
                    @Html.StickyHiddenFor(model => model.IsReminder)
                </div>
                <div id="dvButtonFooter" class="row text-right mr-5 mt-4 ml-xs-3 mb-4 save">
                    <div class="btn btn-st2 btn-lg pull-right mr-1 " style="clear:both" id="dvSaveFollowUp">
                        <button id="btnConfirmAddFollowUp" style="background-color:#0E8270;border:hidden" type="button" validationgroup="FollowUpValidation" value="حفظ">حفظ</button>
                        @Html.ClientActionButton(DbRes.TResource("User.Transaction.FollowUp.Save"), Url.Action("SaveFollowUp", controller), "FollowUpForm", "OnAddFollowUpEmployeeSuccess", null, "FollowUpValidation", "btnAddFollowUp", "FollowUpForm", " btn-site clsHidden", null, "", UserClaims.FollowUps.AddFollowUp, "<i class='glyphicon glyphicon-plus'></i>")

                    </div>
                    <div class="btn btn-st2 btn-lg pull-right mr-1 " id="dvSendFollowUp">
                        <button id="btnConfirmSendFollowUp" style="background-color:#0E8270;border:hidden" type="button" validationgroup="FollowUpValidation" value="ارسال">ارسال</button>
                        @Html.ClientActionButton(DbRes.TResource("User.Transaction.FollowUp.Send"), Url.Action("SendFollowUp", controller), "FollowUpForm", "OnSendFollowUpEmployeeSuccess", null, "FollowUpValidation", "btnSendFollowUp", "FollowUpForm", " btn-site clsHidden", null, "", UserClaims.FollowUps.AddFollowUp, "<i class='glyphicon glyphicon-plus'></i>")

                    </div>
                    <a class="btn btn-st2 btn-lg pull-right mr-1 " id="btnLockFollowup" onclick="LockFollowup(@Model.FollowUpId,@Model.TransactionId)">@DbRes.TResource("User.FollowUpCertificate.FollowUp.Lock")</a>
                    <a class="btn btn-st2 btn-lg pull-right mr-1 " id="btnUnLockFollowup" onclick="UnLockFollowup(@Model.FollowUpId,@Model.TransactionId)">@DbRes.TResource("User.FollowUpCertificate.FollowUp.UnLock")</a>
                    <a class="btn btn-st2 btn-lg pull-right mr-1 " id="btnDeactivateFollowup" onclick="DeactivateFollowup(@Model.FollowUpId,@Model.TransactionId)">@DbRes.TResource("User.FollowUpCertificate.FollowUp.DeactivateFollowup")</a>
                    <a class="btn btn-st2 btn-lg pull-right mr-1 " id="btnComplitFollowup" onclick="ComplitFollowup(@Model.FollowUpId,@Model.TransactionId)">@DbRes.TResource("User.FollowUpCertificate.FollowUp.ComplitFollowup")</a>

                    <a class="btn btn-st2 btn-lg pull-right mr-1 " id="btnSendFollowUpReminder" onclick="SendFollowUpReminder(@Model.FollowUpId,@Model.TransactionId,@Model.FollowUpUserId)">@DbRes.TResource("User.FollowUpCertificate.FollowUp.SendFollowUpReminder")</a>

                    <a class="btn btn-st2 btn-lg pull-right mr-1 " id="btnEscalateFollowUp" onclick="EscalateFollowUp(@Model.FollowUpId,@Model.TransactionId,@Model.FollowUpUserId)">@DbRes.TResource("User.FollowUpCertificate.FollowUp.EscalateFollowUp")</a>
                </div>


                <div class="extraOption col-lg-12 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <h4>
                        <a role="button" style="display:flex">
                            <span onclick="CollapseDiv('divFollowUpGridContent'); return false;" style="cursor: pointer;">
                                <img src="~/Content/User/lib/images/plus-icon.svg" id="divFollowUpGridContentPlusIcon" width="25" />
                                <img src="~/Content/User/lib/images/Dash-icon.svg" id="divFollowUpGridContentDashIcon" width="25" style="display: none;" />
                            </span>
                            <span class="ml-3 mt-1">@DbRes.TResource("جدول المتابعات المضافة")</span>
                        </a>
                    </h4>
                    <div role="tabpanel" class="tab-pane" id="divFollowUpGridContent" style="display:none">
                        <div>
                            @Html.Partial("~/Areas/User/Views/TransactionFollowUp/_FollowUpGridPartial.cshtml", ViewData["DetailsGridData"])
                        </div>
                    </div>
                </div>

                <div class="extraOption col-lg-12 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <h4>
                        <a role="button" style="display:flex">
                            <span onclick="CollapseDiv('divFollowUpAuditTrailContent'); return false;" style="cursor: pointer;">
                                <img src="~/Content/User/lib/images/plus-icon.svg" id="divFollowUpAuditTrailContentPlusIcon" width="25" />
                                <img src="~/Content/User/lib/images/Dash-icon.svg" id="divFollowUpAuditTrailContentDashIcon" width="25" style="display: none;" />
                            </span>
                            <span class="ml-3 mt-1">@DbRes.TResource("جدول تاريخ الإجراءات")</span>
                        </a>
                    </h4>
                    <div role="tabpanel" class="tab-pane" id="divFollowUpAuditTrailContent" style="display:none">
                        <div>
                            @Html.Partial("~/Areas/User/Views/TransactionFollowUp/_FollowUpAuditTrail.cshtml", ViewData["AuditTrailGridData"])
                        </div>
                    </div>
                </div>


                <div class="extraOption col-lg-12 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <h4>
                        <a role="button" style="display:flex">
                            <span onclick="CollapseDiv('divTransactionFollowUp'); return false;" style="cursor: pointer;">
                                <img src="~/Content/User/lib/images/plus-icon.svg" id="divTransactionFollowUpPlusIcon" width="25" />
                                <img src="~/Content/User/lib/images/Dash-icon.svg" id="divTransactionFollowUpDashIcon" width="25" style="display: none;" />
                            </span>
                            <span class="ml-3 mt-1">@DbRes.TResource("User.OutboundInternal.Link")</span>
                        </a>
                    </h4>
                    <div role="tabpanel" class="tab-pane" id="divTransactionFollowUp" style="display:none">
                        <div>
                            @{Html.ViewData.TemplateInfo.HtmlFieldPrefix = null;}
                            @Html.Partial("~/Areas/User/Views/TransactionFollowUp/_FollowUpLinksPartial.cshtml", Model)
                        </div>
                    </div>
                </div>
            </div>




        </div>
    }
</div>
<script>
    $(function () {
        //LoadFollowUpAuditTrails();
        //  LoadFollowUpDetailsTab();

       $("#chkIsCompleted").change(function() {
            if (this.checked) {
                $('#divCompletionDate').show();
                $('#btnComplitFollowup').show();
            }
            else {
                $('#divCompletionDate').hide();
                  $('#btnComplitFollowup').hide();
                }
                });
            });

    function CollapseDiv(divName) {
        if ($('#' + divName).css('display') == 'block') {
            $('#' + divName).css("display", "none");
            $('#' + divName + 'PlusIcon').css("display", "inline-block");
            $('#' + divName + 'DashIcon').css("display", "none");
        }
        else {
            $('#' + divName).css("display", "block");
            $('#' + divName + 'PlusIcon').css("display", "none");
            $('#' + divName + 'DashIcon').css("display", "inline-block");
        }
    }

    $(document).ready(function () {

        EnableDisableControl($("#hdnReadOnly").val(),$("#hdnIsCanceld").val(),$("#hdnIsFinalCompleted").val(),$("#hdnIsUnderFollowup").val());


        if ($("#chkIsCompleted").checked) {
             $("#btnComplitFollowup").attr("disabled", "");
        }
        $('#FollowUpDateCal').attr('autocomplete', 'off');
        $('#FolloupCompletionDateCal').attr('autocomplete', 'off');
        GetFollowUpUsersByOrgUnitId(callback);

        $('#btnConfirmAddFollowUp').click(function () {
            //if (CheckFollowUpDate()) {
                ShowConfirmMessage("هل انت متأكد من الحفظ ؟", 'addFollowUp');
            //}
        });

                $('#btnConfirmSendFollowUp').click(function () {
            //if (CheckFollowUpDate()) {
                ShowConfirmMessage("هل انت متأكد من الحفظ ؟", 'sendFollowUp');
            //}
        });
    });


        function UnLockFollowup(FollowUpId, TransactionId) {

        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("UnLockFollowUp", "TransactionFollowUp")' + '?FollowUpId=' + FollowUpId + '&TransactionId=' + TransactionId ,
            cache: false,
            success:
                function (data) {
                    LoadFollowUpAuditTrails();
                    LoadFollowUpDetailsTab();
                    EnableDisableControl(true,false, false, false);
                }
        });
    }
    function LockFollowup(FollowUpId, TransactionId) {

        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("LockFollowUp", "TransactionFollowUp")' + '?FollowUpId=' + FollowUpId + '&TransactionId=' + TransactionId ,
            cache: false,
            success:
                function (data) {

                     $("#hdnReadOnly").val(false);
                $("#hdnIsCanceld").val(false);
                $("#hdnIsFinalCompleted").val(false);
                $("#hdnIsUnderFollowup").val(true);
                    LoadFollowUpAuditTrails();
                     LoadFollowUpDetailsTab();
                    EnableDisableControl(false,false, false, true);
                }
        });
    }
     function LoadFollowUpDetailsTab() {

        var id = $("#hdnTransactionID").val();
        $.ajax({
            url: '@Url.Action("FollowUpLoadGrid", controller)',
                data: { transactionId: id },
            success: function (data) {
                debugger
                $("#divFollowUpGridContent").html("");
                $("#divFollowUpGridContent").html(data);

            }
        })
    }

    function LoadFollowUpAuditTrails() {

        var id = $("#hdnfollowupid").val();
        $.ajax({
            url: '@Url.Action("FollowUpLoadAuditTrailGrid", controller)',
                data: { FollowUpId: id },
            success: function (data) {
                $("#divFollowUpAuditTrailContent").html("");
                $("#divFollowUpAuditTrailContent").html(data);

            }
        })
    }
        function DeactivateFollowup(FollowUpId, TransactionId) {

        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("DeactivateFollowUp", "TransactionFollowUp")'  + '?FollowUpId=' + FollowUpId + '&TransactionId=' + TransactionId ,
            cache: false,
            success:
                function (data) {
                      window.location.href = '@Url.Action("FollowUp", "File")';
                }
        });
    }


    function ComplitFollowup(FollowUpId,TransactionId) {

        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("ComplitFollowup", "TransactionFollowUp")' + '?FollowUpId=' + FollowUpId + '&TransactionId=' + TransactionId ,
            cache: false,
            success:
                function (data) {
                    EnableDisableControl(false,false, true, false);
                     LoadFollowUpAuditTrails();
                    ShowErrorMessage("تم اكمال المتابعة واغلاقها ");
                },

        });
    }

    function SendFollowUpReminder(FollowUpId,TransactionId,FollowUoUserId) {

        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("SendFollowUpReminder", "TransactionFollowUp")' + '?FollowUpId=' + FollowUpId + '&TransactionId=' + TransactionId  + '&FollowUoUserId=' + FollowUoUserId ,
            cache: false,
            success:
                function (data) {
                    ShowErrorMessage("تم ارسال تذكير للمتابعة الفرعية بنجاح");
                }
        });
    }

    function EscalateFollowUp(FollowUpId, TransactionId, FollowUoUserId) {

        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EscalateFollowUp", "TransactionFollowUp")' + '?FollowUpId=' + FollowUpId + '&TransactionId=' + TransactionId  + '&FollowUoUserId=' + FollowUoUserId ,
            cache: false,
            success:
                function (data) {
                    ShowErrorMessage("تم تصعيد المتابعة الفرعية بنجاح");
                }
        });
    }



    function EnableDisableControl(IsReadOnly, IsCanceld, IsFinalCompleted, IsUnderFollowup) {

        if (IsReadOnly == "True" || IsReadOnly == true) {

            //$("#ddlFollowUpSource").prop("readonly", "readonly");
            $("#ddlFollowUpSource").attr("disabled", "disabled");
            $("#ddlFollowUpMethod").attr("disabled", "disabled");
            $("#ddlFollowUpPrioritytype").attr("disabled", "disabled");
            $("#ddlFollowUpProccess").attr("disabled", "disabled");
            $("#ddlFollowUpSource").attr("disabled", "disabled");
            $("#txtAreaFollowUpProccessNote").attr("disabled", "disabled");
            $("#txtAreaFollowUpReason").attr("disabled", "disabled");
            $("#txtFollowUpProgress").attr("disabled", "disabled");
            $("#chkIsCompleted").attr("disabled", "disabled");
            $("#FolloupCompletionDateCal").attr("disabled", "disabled");
            $("#FollowUpDateCal").attr("disabled", "disabled");
            $("#autoCompleteFollowUpUserId").attr("disabled", "disabled");
            $("#treeFollowUpToOrgUnit").attr("disabled", "disabled");
            $("#dvSaveFollowUp").attr("disabled", "disabled");
            $("#btnDeactivateFollowup").show();
            $("#btnComplitFollowup").hide();
            $("#btnUnLockFollowup").hide();
            $("#btnEscalateFollowUp").hide();
             $("#dvSaveFollowUp").hide();
            $("#dvSendFollowUp").hide();
            $("#btnLockFollowup").show();
            $("#btnSendFollowUpReminder").hide();
            $("#btnEscalateFollowUp").hide();

            //$('#btnUnLockFollowup').prop('disabled', true);
        } else if (IsCanceld  == "True" || IsCanceld  == true) {


            $("#ddlFollowUpSource").attr("disabled", "disabled");
            $("#ddlFollowUpMethod").attr("disabled", "disabled");
            $("#ddlFollowUpPrioritytype").attr("disabled", "disabled");
            $("#ddlFollowUpProccess").attr("disabled", "disabled");
            $("#ddlFollowUpSource").attr("disabled", "disabled");
            $("#txtAreaFollowUpProccessNote").attr("disabled", "disabled");
            $("#txtAreaFollowUpReason").attr("disabled", "disabled");
            $("#txtFollowUpProgress").attr("disabled", "disabled");
            $("#chkIsCompleted").attr("disabled", "disabled");
            $("#FolloupCompletionDateCal").attr("disabled", "disabled");
            $("#FollowUpDateCal").attr("disabled", "disabled");
            $("#btnUnLockFollowup").attr("disabled", "disabled");
            $("#autoCompleteFollowUpUserId").attr("disabled", "disabled");
            $("#treeFollowUpToOrgUnit").attr("disabled", "disabled");
            $("#btnLockFollowup").hide();
            $("#btnDeactivateFollowup").hide();
            $("#btnComplitFollowup").hide();
            $("#btnUnLockFollowup").hide();
             $("#dvSaveFollowUp").hide();
            $("#dvSendFollowUp").hide();
              $("#btnSendFollowUpReminder").hide();
            $("#btnEscalateFollowUp").hide();
        } else if (IsFinalCompleted  == "True" || IsFinalCompleted  == true) {
             $("#ddlFollowUpSource").attr("disabled", "disabled");
            $("#ddlFollowUpMethod").attr("disabled", "disabled");
            $("#ddlFollowUpPrioritytype").attr("disabled", "disabled");
            $("#ddlFollowUpProccess").attr("disabled", "disabled");
            $("#ddlFollowUpSource").attr("disabled", "disabled");
            $("#txtAreaFollowUpProccessNote").attr("disabled", "disabled");
