                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.Method") <span class="stark">*</span></label>
                    @Html.AutoCompleteBuilder("ddlFollowUpMethod", "FollowUpMethodId", ViewData["FollowUpMethod"].ToString(), null, true, "form-control", selectFirstIndex: true)
                    @Html.HiddenGroupFor(model => model.FollowUpMethodId, new { @Value = "", id = "FollowUpMethodId" }, "FollowUp")
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.Prioritytype") <span class="stark">*</span></label>
                    @Html.AutoCompleteBuilder("ddlFollowUpPrioritytype", "FollowUpPrioritytypeId", ViewData["FollowUpPrioritytype"].ToString(), null, true, "form-control", selectFirstIndex: true)
                    @Html.HiddenGroupFor(model => model.FollowUpPriortyId, new { @Value = "", id = "FollowUpPrioritytypeId" }, "FollowUp")
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.Proccess") <span class="stark">*</span></label>
                    @Html.AutoCompleteBuilder("ddlFollowUpProccess", "FollowUpProccessId", ViewData["FollowUpProccess"].ToString(), null, true, "form-control", selectFirstIndex: true)
                    @Html.HiddenGroupFor(model => model.FollowUpProccessId, new { @Value = "", id = "FollowUpProccessId" }, "FollowUp")
