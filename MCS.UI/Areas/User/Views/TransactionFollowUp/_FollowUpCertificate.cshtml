                    @Html.HiddenFor(model => model.FollowUpUserId, new { id = "hdnFollowUpIndividualToUserId" })

                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">

                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.EndDate")<span class="stark NotIndividual">*</span></label>
                    <div class="with-icon">
                        @Html.CalendarCustom("FollowUpDateCal", "hdnFolloupDateGreg", "hdnFollowUpDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), Model != null ? Model.FollowUpExpireDateHj : null, "form-control")
