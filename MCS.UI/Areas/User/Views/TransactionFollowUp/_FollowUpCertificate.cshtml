                        @Html.HiddenGroupFor(model => model.FollowUpExpireDate, new { id = "hdnFolloupDateGreg", AutoComplete = "off" }, "")
                        @Html.HiddenGroupFor(model => model.FollowUpExpireDateHj, new { id = "hdnFollowUpDateUm", AutoComplete = "off" }, "")
