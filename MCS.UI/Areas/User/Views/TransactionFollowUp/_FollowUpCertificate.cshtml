                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("User.FollowUpCertificate.FollowUp.FollowUpUser")<span class="stark NotIndividual">*</span></label>
