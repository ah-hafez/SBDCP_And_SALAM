@using MCS.UI.Helpers
@using MCS.UI.Areas.User.Models.Transaction

@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<TransactionLinkVM>

@{
    var operationType = ViewData["IsEnableAction"] ?? true;
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
    ViewData.TemplateInfo.HtmlFieldPrefix = "FollowUpTab";
}

@Html.Grid(Model).CollectionName("Links").Named("grdLinks").Columns(columns =>
{
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Id, new { id = "Id_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Key, new { id = "Key_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.TransactionId, new { id = "TransactionId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.TransactionNumber, new { id = "TransactionNumber_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.LinkTypeName, new { id = "LinkTypeName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.LinkTypeId, new { id = "LinkTypeId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.TransactionCategoryName, new { id = "TransactionTypeName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.TransactionCategory, new { id = "TransactionType_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.DateH, new { id = "DateH_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Year, new { id = "Year_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.YearDesc, new { id = "YearDesc_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Subject, new { id = "TransactionSources_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.LinkTypeId, new { id = "LinkTypeId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);

columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").Titled(DbRes.TResource("User.Transaction.Link.TransactionNumber"))
.RenderValueAs(o => @<a class="trans_Number" data-transactioncategory="@o.TransactionCategory" data-linktypeid="@o.LinkTypeId" data-id="@o.TransactionId">@o.TransactionNumber</a>);

columns.Add(model => model.LinkTypeName).Titled(DbRes.TResource("User.Transaction.Link.LinkType"));
columns.Add(model => model.TransactionCategoryName).Titled(DbRes.TResource("User.Transaction.Link.TransactionType"));
columns.Add(false).RenderValueAs(model => @DateHelper.GetDate(model.DateH)).Titled(DbRes.TResource("User.Inbound.BasicInfo.RecordDate"));
columns.Add(model => model.Subject).Titled(DbRes.TResource("User.OutboundExternal.BasicInfo.Subject"));

if ((bool)operationType)
{
columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").RenderValueAs(model => @Html.ClientLinkTag("", cssClass: "edit_link", title: DbRes.TResource("Grid.Preview"), clientFunctionToCall: "PreviewTransactionDocument(" + model.TransactionId + ")", permissionCode: UserClaims.Links.Edit, innerHtml: "<i class='fa fa-solid fa-eye'></i>"));
 }
})


<script> 
    $(".trans_Number").click(function () { 

        var transactionId = $(this).data("id");
        var trx = EncryptionKey(transactionId);
        var linkTypeId = $(this).data("linktypeid");
        var transactionCategory = $(this).data("transactioncategory");
        switch (transactionCategory) {
            case @(TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)):
                var url = '@Url.Action("Index", "TransactionLog")' + '?transactionId=' + trx + "&transactionCategory=" + @((int)TransactionCategory.Inbound);
                break;
            case @(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)):
                var url = '@Url.Action("Index", "TransactionLog")' + '?transactionId=' + trx + "&transactionCategory=" + @((int)TransactionCategory.InternalOutbound);
                break;
            case @(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)):
            case @(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)):
                var url = '@Url.Action("Index", "TransactionLog")' + '?transactionId=' + trx + "&transactionCategory=" + @((int)TransactionCategory.ExternalOutbound);
                break;
        }

        ShowDialog(url, 'dialogbox col-md-12 ');
    });
</script>
