<script>
    $.validator.addMethod('require-oneAdd', function (value) {
        return $('.require-oneAdd:checked').size() > 0;
    });
    var checkboxes = $('.require-oneAdd');
    var checkbox_names = $.map(checkboxes, function (e, i) {
        return $(e).attr("name")
    }).join(" ");

    $('#ddlPartyNumber').change(function () {
        $('#dvpartyNumberMessage').html('');
    });
    $('.require-oneAdd').change(function ()
    {
        var data = $('#Types').find('input[type=CheckBox]');
        var count = data.length;
        for (var i = 0; i < count; i++) {
            var checkBox = data[i];
            if ($(checkBox).is(':checked')) {
                $("#_msgvalAdd").hide();
                break;
            }
            else {
                $("#_msgvalAdd").removeClass("field-validation-error").addClass("field-validation-valid").show();
                $("#_msgvalAdd").find("i").remove(".glyphicon")
            }
        }
    });

    function CheckPartyNumber() {
        var number = $('#ddlPartyNumber').val();
        var valid = false;
        $.ajax({
            type: 'Get',
            url: '@Url.Action("CheckPartyNumber")',
            data: { Number: number, partyId: -1 },
            async: false,
            success:
                function (data) {
                    if (data.Exists) {
                        valid = true;
                    }
                    else {
                        $('#dvpartyNumberMessage').html('رقم الجهة مدخل مسبقا');
                        valid = false;
                    }
                }
        });

        return valid;
    }
    function SetData() {
        $("#hdnParentId").val($("#ParentId_hdnDepartmentId").val());
    }


    function OnAddSuccess(data, div) {
        if (data.MessageType != 2) {
            var id = data.Id;
            ClearInputs('frmEditParty');
            OpenEditView(id);
            $("#" + div).html("");
            $("#" + div).html(data.Html);
            RefreshJsTree('TreeDiv');

            var parentNode = $('*[node=' + id + ']').parent().parent().attr('node');

            node = $('*[node=' + id + ']');

            if (parentNode != undefined && parentNode != 0 )
                OpenTreeNode(parentNode);

            jQuery.validator.unobtrusive.parse('#' + div);
            ShowSuccesMessage(data.MessageText)
            $("._selected").find("a.jstree-anchor").addClass("jstree-clicked");
            $("#hdnPartyId").val(id);
            $("#Addfooter").addClass("middle");
            $("#AddManager").show();

            GetExternalParties(data.Id);
         
            var transactionId = '@ViewData["TransactionId"]';
            if(@ViewData["TransactionId"]!=null && @ViewData["TransactionId"] != 0){

                var actionType=@Convert.ChangeType(MCS.Common.AuditingActionCode.AddNewExternalParty, MCS.Common.AuditingActionCode.ViewTransactionCopies.GetTypeCode());
                PostTransactionLog(actionType, @ViewData["TransactionId"]);
            }
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
</script>

