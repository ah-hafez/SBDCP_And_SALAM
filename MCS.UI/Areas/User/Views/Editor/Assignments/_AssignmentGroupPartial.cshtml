@using MCS.Framework.Localization
@using MCS.Common
@model MCS.UI.Areas.User.Models.Assignment.TransactionAssignmentVM

<div class="form-group">
    @Html.LabelFor(model => model.GroupId, new { @class = "col-md-4 control-label" })
    <div class="col-md-8">
        <div class="">
            @Html.AutoCompleteBuilder("ddlEditorAssignmentGroupId", "hdnEditorAssignmentGroupId", ViewData["AssignmentGroupData"].ToString(), null, true, "form-control")
            @Html.HiddenGroupFor(model => model.GroupId, new { @Value = "", id = "hdnEditorAssignmentGroupId" }, "AssignmentGroup")
            @Html.HiddenGroupFor(model => model.GroupName, new { @Value = "", id = "hdnEditorGroupName" }, "AssignmentGroup")
            @Html.StickyHidden("hdnGroupData", ViewData["AssignmentGroupData"].ToString())
        </div>
    </div>
</div>
<div class="form-group">
    <div class="col-md-4">
    </div>
    <div class="col-md-8">
        <div class="panel-title">
            @{if (Convert.ToBoolean(ViewData["IsAllowedToCreateGroup"]))
                {
                    <a class="btn btn-primary btn-block btn-rounded create_group _openDia">
                        <i class="fa fa-group"></i>@DbRes.TResource("User.Transaction.Assignment.CreateGroup")
                    </a>
                }
                else
                {
                    <a style=" pointer-events: none;cursor: default;" class="btn btn-primary btn-block btn-rounded create_group disable">
                        <i class="fa fa-group"></i>@DbRes.TResource("User.Transaction.Assignment.CreateGroup")
                    </a>
                }
            }

        </div>

    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.ActionForAllId, new { @class = "col-md-4 control-label" })
    <div class="col-md-8">
        <div class="">
            @Html.AutoCompleteBuilder("ddlEditorActionForAllId", "hdnEditorActionForAllId", ViewData["AllActionsData"].ToString(), null, true, "form-control", "hdnEditorActionTypeForAllId")
            @Html.HiddenGroupFor(model => model.ActionForAllId, new { @Value = "", id = "hdnEditorActionForAllId" }, "AssignmentGroup")
            @Html.HiddenGroupFor(model => model.ActionNameForAll, new { @Value = "", id = "hdnEditorActionNameForAll" }, "AssignmentGroup")
            @Html.HiddenGroupFor(model => model.ActionTypeForAllId, new { @Value = "", id = "hdnEditorActionTypeForAllId" }, "AssignmentGroup")
        </div>
    </div>
</div>
<div class="form-group">
    @Html.LabelFor(model => model.DeliveryMethod, new { @class = "col-md-4 control-label" })
    <div class="col-md-8">
        <div class="">
            @Html.AutoCompleteBuilder("ddlDeliveryMethod", "DeliveryMethod", LookupCategory.DeliveryMethod, null, true, "form-control")
            @Html.HiddenGroupFor(model => model.DeliveryMethod, new { @Value = "" }, "AssignmentGroup")
        </div>
    </div>

</div>

