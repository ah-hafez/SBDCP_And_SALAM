@using MCS.Common
@model MCS.UI.Areas.User.Models.Assignment.TransactionAssignmentVM



<div class="col-xs-12" id="editorAssignmentsPartialBody">
    <div class="single-wrapper">
        <div class="row">
            <!-- Form start -->
            <div class="form-horizontal form-row">
                <div class="col-sm-12">
                    <div class="col-sm-4 TreeHeight">
                        <fieldset>
                            <div class="form-group" id="dvEditorTreeAssignment">
                                @Html.DepartmentsTree(ViewData["DepartmentsData"] as TreeViewModel, model => model.ToOrgUnitId, TreeMode.Single, "treeEditorAssignment", true, "GetAllUsersEditorAssignment", "AssignmentIndividual", "dvEditorTreeAssignment")
                                @Html.HiddenGroupFor(model => model.ToOrgUnitName, new { id = "hdnAssignmentToOrgUnitName" }, "AssignmentIndividual")
                            </div>
                        </fieldset>
                    </div>


                    <div class="col-sm-4">
                        <fieldset>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ToUserId, new { @class = " control-label" })
                                <div class="">
                                    @Html.AutoCompleteBuilder("ddlEditorAssginmentIndividualToUserId", "hdnEditorAssginmentIndividualToUserId", ViewData["ToUserAssignment"] != null ? ViewData["ToUserAssignment"].ToString() : null, Model != null ? Model.ToUserId.ToString() : null, true, "form-control")
                                    @Html.HiddenGroupFor(model => model.ToUserId, new { id = "hdnEditorAssginmentIndividualToUserId" })
                                    @Html.HiddenGroupFor(model => model.ToUserName, new { id = "hdnToEditorAssginmentIndividualUserName" })

                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-sm-4">
                        <fieldset>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ActionId, new { @class = "col-md-4 control-label" })
                                <div>
                                    @Html.AutoCompleteBuilder("ddlEditorAssginmentIndividualActionId", "hdnEditorAssginmentIndividualActionId", ViewData["AllActionsData"].ToString(), Model != null ? Model.ActionId.ToString() : null, true, "form-control", "hdnEditorAssginmentIndividualActionTypeId")
                                    @Html.HiddenGroupFor(model => model.ActionId, new { @Value = "", id = "hdnEditorAssginmentIndividualActionId" }, "AssignmentIndividual")
                                    @Html.HiddenGroupFor(model => model.ActionName, new { id = "hdnEditorAssginmentIndividualActionName" }, "AssignmentIndividual")
                                    @Html.HiddenGroupFor(model => model.ActionTypeId, new { @Value = "", id = "hdnEditorAssginmentIndividualActionTypeId" }, "AssignmentIndividual")
                                </div>
                            </div>
                        </fieldset>
                    </div>


                    <div class="col-sm-4">
                        <fieldset>
                            <div class="form-group">
                                @Html.LabelFor(model => model.DeliveryMethodId, new { @class = "col-md-4 control-label" })
                                <div>
                                    @Html.AutoCompleteBuilder("ddlDeliveryMethod", "hdnDeliveryMethodId", LookupCategory.DeliveryMethod, Model.DeliveryMethodId.ToString(), true, "form-control")
                                    @Html.HiddenGroupFor(model => model.DeliveryMethod, new { @Value = "", id = "hdnDeliveryMethod" }, "AssignmentIndividual")
                                    @Html.HiddenGroupFor(model => model.DeliveryMethodId, new { @Value = "", id = "hdnDeliveryMethodId" }, "AssignmentIndividual")
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                @Html.StickyHidden("hdnIndexIndividual", null, new { id = "hdnIndexIndividual" })

            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ClearInputs('editorAssignmentsPartialBody');
    });
</script>