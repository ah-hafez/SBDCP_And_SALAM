                        </div>
                    </div>
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 pt-4 " id="isAssigned">
                        <label>
                            @Html.CheckBoxFor(model => model.CanBeSigned, new { @class = "" })
                            @Html.StickyHiddenFor(model => model.CanBeSigned, new { id = "hdnIsVirtual" })
