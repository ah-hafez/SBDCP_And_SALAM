                    <div class="col-lg-9 col-md-6 col-sm-12 mb-3">
                        <div class="mb-3">اضافة شرح عن طريق : </div>
                        <div class="col-lg-3">
                            <a id="aEditorScanning" class="d-flex explain-text">
                                <div class="explain-circle">
                                    <i class="fas fa-print" data-bs-toggle="tooltip" data-placement="bottom" title="@DbRes.TResource("الماسح الضوئي")"></i>
                                </div>
                                @DbRes.TResource("الماسح الضوئي")
                            </a>
                        </div>
                        <div class="col-lg-3">
                            <a id="aText" class="d-flex explain-text">
                                <div class="explain-circle">
                                    <i class="fa fa-plus-circle" data-bs-toggle="tooltip" data-placement="bottom" title="@DbRes.TResource("User.Editor.Explanations.Remaks")"></i>
                                </div>
                                @DbRes.TResource("User.Editor.Explanations.Remaks")
                            </a>
                        </div>
                        <div class="col-lg-3" id="txtEditorIconContainer">
                            <a id="aUploadFile" class="d-flex explain-text">
