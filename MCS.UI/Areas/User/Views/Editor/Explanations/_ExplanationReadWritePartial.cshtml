                                    <span class="align-self-center "> @explanationVM.FromUser </span>

                                    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ExpalanationsEditor.Delete))
                                    {
                                        <span class="align-self-center removing_tag uicon icon_close" data-id="@explanationVM.Id" title="حذف المرفق"></span>
                                    }
                                </a>
                            </span>
                            <div style="border-left: 1px solid #d7d7d7; height: 30px; margin-top: 15px "></div>

                        }
                        else
                        {
                            <span class="tag">
                                <a class="aExplanation d-flex flex-nowrap" data-signed="@explanationVM.CanBeSigned" data-editable="@explanationVM.CanBeDeleted" data-id="@explanationVM.Id">

                                    <span class="badgee">@explanationVM.ConfidentialityName</span><span class="align-self-center ">@explanationVM.FromUser </span>
                                </a>
                            </span>
                            <div style="border-left: 1px solid #d7d7d7; height: 30px; margin-top: 15px "></div>
                        }
                    }

                }
