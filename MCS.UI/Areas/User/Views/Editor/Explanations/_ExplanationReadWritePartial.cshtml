@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Transaction;
@using MCS.Common;
@using MCS.UI.Common

@model MCS.UI.Areas.User.Models.Transaction.ExplanationVM

@{
    var doconutIframeUrl = UIConfigurations.GetFullURl() + string.Format("{0}?explanations=true", SystemConfigurations.DoconutIframeUrl);
    int explanationTextType = (int)EditorType.Text;
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
    var isAssigned = ViewData["IsAssigned"] != null ? (bool)ViewData["IsAssigned"] : false;

    List<ExplanationVM> explanations = ViewData["ExplanationsData"] as List<ExplanationVM>;


}
