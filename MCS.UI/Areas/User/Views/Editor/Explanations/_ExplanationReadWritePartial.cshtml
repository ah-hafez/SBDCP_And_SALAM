            </div>

        </div>
        <i id="CalMessage3" style="color:red" class="glyphicon glyphicon-exclamation-sign hidden_"></i>
        <span id="CalMessageForMainDocEdit" style="color:red"> </span>

        <div id="explinationDateTime"></div>

        <div id="dvEditorScanning" style="display:none;">
            <div class="panel-body">
                <div class="row">
                    <div class="panel-body panel-style panel-body-open">
                        @{
                            string sessionKey = ViewData["ExplanationDocumentSessionKey"] != null ? ViewData["ExplanationDocumentSessionKey"].ToString() : null;
                        }

                        <div id="Signatures">

                            @if (
                                (SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Signature)
                                || SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Mark))

                                )
                            {
                                @*<div style="border-left: 2px solid; height: 95px; margin-top:5px;"></div>*@

                                <div class="form-group" style="direction: rtl;" id="DivSigBtn">
                                    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Signature))
                                    {
                                        <div id="btnAddSig">
                                            <a onclick="InsertSignatureExplanation('@(((int)SigntureType.Electronic).ToString())');"
                                               class="btn btn-st1 btn-sm pull-left" style="margin-right:5px">
                                                إضافة توقيع
                                            </a>
                                        </div>

                                    }

                                    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Mark))
                                    {
                                        <div style="margin-right:5px" id="btnAddMark">

                                            <a onclick="InsertSignatureExplanation('@(((int)SigntureType.Marking).ToString())');" class="btn btn-st1 btn-sm pull-left" style="margin-right:5px">
                                                إضافة تأشيرة/ تركين
                                            </a>
                                        </div>

                                    }

                                </div>

                            }



                        </div>

                        <div class="mt-5" id="doconutContainer">
                            <iframe src="@doconutIframeUrl" class="col-md-12" style="height:500px" id="ExplanationframeViewer" sandbox="allow-modals allow-same-origin allow-scripts allow-popups allow-forms allow-downloads"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="dvText" style="display:none;">
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.TextAreaGroupFor(model => model.Description, new { id = "txtDescription", @class = "form-control readonlyByPrivilege", @rows = "50", style = "background: #FFFA9E;height:200px;", maxlength = "2500" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="dvUploadFile" style="display:none;">
            @Html.Partial("~/Areas/User/Views/Transaction/_ExplanationUploadFile.cshtml")
        </div>

        <div id="dvEditorTextEditor" style="display:none;">
            <div class="panel-body">

                <div class="row">
                    <div class="panel-group accordion accordion-dc">
                        <div class="col-md-6">
                            <div class="form-group" id="dvExplanationTextEditorForm">
                                @Html.Label(DbRes.TResource("User.OutboundDraft.Forms"), new { @class = "col-md-4 control-label" })
                                <div class="col-md-8">
                                    <div class="">
                                        @Html.AutoCompleteBuilder("ddlExplanationFormDocument", "hdnOrgUnitFormDocumentId", ViewData["FormDocumentList"].ToString(), null, true, "form-control")
                                        @Html.Hidden("hdnOrgUnitFormDocument", null, new { id = "hdnOrgUnitFormDocumentId" })
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="panel-group accordion accordion-dc">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="col-md-8">
                                    <div class="">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" id="dvExplanationTextEditor">
                                @Html.Partial("~/Areas/User/Views/Editor/Explanations/_TextEditorPartial.cshtml")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <input type="checkbox" id="ExplanationType" hidden />
        <div class="row">
            <div class="col-xs-12 text-right panel-body">
                @Html.HiddenFor(model => model.Id, new { id = "hdnExplanationId" })
                @Html.HiddenFor(model => model.isCopies)
                @Html.HiddenFor(model => model.EditorType, new { id = "hdnExplanationEditorType" })



            </div>
        </div>
    }
</div>
<script>





    function InsertSignatureExplanation(sig)
    {
        OpenCloseEditModeDoconut(true);

             if (sig =='@(((int)SigntureType.Electronic).ToString())')
        {

                 setTimeout(function ()
                 {
                     document.getElementById('ExplanationframeViewer').contentWindow.ImageSignature();
                 }, 100);

        }
        else
        {
                 setTimeout(function ()
                 {
                     document.getElementById('ExplanationframeViewer').contentWindow.ImageStamp();
                 }, 100);
        }


        setTimeout(function ()
        {
            OpenCloseEditModeDoconut(true);
        }, 200);



    }




    $('#aExplanationAdd').on('click', function () {
        debugger;
        CancelUpdateExplanation()
    });

    $('.aExplanation').on('click', function () {
        debugger;
        $('.activate').removeClass('activate')
        $(this).addClass('activate');
    });
    function CheckExplanationIfHasContent() {

        $("#txtDescription").removeClass("invalid-input");
        $('#txtDescription').css('border-color', '');
            var docoNutFrameContent = $('#ExplanationframeViewer').contents();
            var __docViewerToken = $('#_hdnToken', docoNutFrameContent)[0].value;
             var token = $("#frmEditorExplanations").find("input[name='__RequestVerificationToken']").val();

        if ($('#hdnTextEditorContent').val() == "" && $("#txtDescription").val() == "" &&/* __docViewerToken == "" &&*/ $('#ExplanationFiles').val() == '') {
                var IsEmptyDoc = true;
               $.ajax({
                type: 'post',
                cache: false,
                url: '@Url.Action("CheckIfHasArchive", "Editor")',
                   data: { param: __docViewerToken, __RequestVerificationToken:token },
                async: false,
                success: function (data) {
                    if (data.data == "NotEmpty") {
                        IsEmptyDoc = false
                     }
                    }
                });

                if (IsEmptyDoc) {
                    if ($("#ddlExplanationConfedentiality").val() == "") {
                         $("#CalMessage3").removeClass("hidden_");
                         $("#CalMessage3").show();
                         $("#CalMessageForMainDocEdit").html('@Html.Raw(DbRes.TValidation("User.Editor.Explanations.ExplanationRequired"))');

                        return true;
                    }
                    else
                    {
                        $("#CalMessage3").removeClass("hidden_");
                         $("#CalMessage3").show();
                         $("#CalMessageForMainDocEdit").html('@Html.Raw(DbRes.TValidation("User.Editor.Explanations.ExplanationRequired"))');

                    return false;
                    }
                } else
                {

                    if ($("#hdnExplanationEditorType").val() == @explanationTextType  && $("#txtDescription").val() == '')
                    {
                        $("#txtDescription").addClass("invalid-input");
                        $('#txtDescription').css('border-color', 'red');
                         $("#CalMessage3").removeClass("hidden_");
                         $("#CalMessage3").show();
                         $("#CalMessageForMainDocEdit").html('@Html.Raw(DbRes.TValidation("Admin.RequiredField"))');


                        return false;
                    }
                    $("#CalMessage3").addClass("hidden_");
                    $("#CalMessage3").hide();
                    $("#CalMessageForMainDocEdit").html("")
                    return true;
                }

        }


        if (!($('#ExplanationFiles').val() == '')) {

            $("#hdnFileName").val($('#FileName').val());
                return true;
            }
            else {
                $("#CalMessage3").addClass("hidden_");
                $("#CalMessage3").hide();
                $("#CalMessageForMainDocEdit").html("")
                return true;
            }

        }

    function OnAddExplanationSuccess(data, div) {
            if (data.MessageType != 2) {
                //ShowSuccesMessage(data.MessageText);
                $(".enter_list-tags").append("<span class='tag'><a class='d-flex flex-nowrap aExplanation' data-editable='True' data-id='" + data.Id + "'>" + "<span class='align-self-center'>" + data.Name + "</span><span class='align-self-center removing_tag uicon icon_close' data-id='" + data.Id + "' title = 'حذف المرفق' ></span></a></span>");
                document.getElementById('ExplanationframeViewer').contentWindow.location.reload();
                $("#CalMessage3").addClass("hidden_");
                $("#CalMessage3").hide();
                $("#CalMessageForMainDocEdit").html("")
                CancelUpdateExplanation();
            }
            else {
                ShowErrorMessage(data.MessageText);
            }
        }

        function OnEditExplanationSuccess(data, div) {
            if (data.MessageType != 2) {
                //ShowSuccesMessage(data.MessageText);
                CancelUpdateExplanation();
            }
            else {
                ShowErrorMessage(data.MessageText);
            }
        }

        $(document).ready(function () {
            $('#aUploadFile').click(function () {
                $('#hdnExplanationEditorType').val('4');
                $('#hdnAttachmentTypeId').val('4');
                $('#dvUploadFile').show();
                $('#dvEditorScanning').hide();
                $('#dvText').hide();
                $('#dvEditorTextEditor').hide();
                $('#hdnTextEditorContent').val('');
                $("#txtDescription").attr("readonly", false);
                BackToAddMode();
            });
            $('#aEditorTextEditor').click(function () {

                $('#hdnExplanationEditorType').val('1');
                $('#dvEditorTextEditor').show();
                $('#dvUploadFile').hide();
                $('#dvEditorScanning').hide();
                $('#dvText').hide();
                $('#hdnTextEditorContent').val('');
                BackToAddMode();
            });

            $('#aText').click(function () {

                $('#hdnExplanationEditorType').val('3');
                $('#dvText').show();
                $('#dvUploadFile').hide();
                $('#dvEditorTextEditor').hide();
                $('#dvEditorScanning').hide();
                $('#hdnTextEditorContent').val('');
                BackToAddMode();
            });

            $('#aEditorScanning').click(function () {

                $('#hdnExplanationEditorType').val('2');
                $('#dvEditorTextEditor').hide();
                $('#dvUploadFile').hide();
                $('#dvText').hide();
                $('#dvEditorScanning').show();
                $('#hdnTextEditorContent').val('');
                BackToAddMode();
            });




        });

        $(document).on('change', "#ddlExplanationFormDocument", function () {

            if ($("#hdnOrgUnitFormDocumentId").val() != "") {
                $.ajax({
                    type: 'get',
                    cache: false,
                    url: '@Url.Action("GetContentByFormId", "Editor")',
                    data: { id: $("#hdnOrgUnitFormDocumentId").val() },
                    success: function (data) {
                        ChangeTextEditorContent("txtEditorExplanation", "hdnTextEditorContent", data);
                    }
                });
                return false;
            }
    });


    $(document).on('click', ".aExplanation", function () {
        debugger;

        var id = $(this).data("id");
        var editable = $(this).data("editable");


        var signed = $(this).data("signed");


        //var editable = $(this).data("editable");
        //var editable = $(this).data("editable");
        if (signed == "True") {
            $('#Signatures').show();

        }
        else {
            $('#Signatures').hide();

        }


        if ("@isAssigned" == "True") {

            $('#isAssigned').show();
        }
        else {
            $('#isAssigned').hide();

        }


        var sessionKey = $("#hdnExplanationDocumentSessionKey").val();
        $('#dvExplanationTextEditorForm').show();
        $('#dvConfidentialityContainer').show();
        $('#btnCancelExplanation').show();
        $('.ExplanationInput').show();
        $("#txtDescription").attr("readonly", false);
        $('#btnEditExplanation').show();
        $('#btnEditExplanation').removeClass("hidden_");

        $.ajax({
            type: 'get',
            cache: false,
            url: '@Url.Action("GetExplanationById","Editor")',
            data: { id: id, hdnExplanationDocumentSessionKey: sessionKey },
            success: function (data)
            {
                debugger;
                if (data.Type == 1) {
                    $("#dvExplanationTextEditor").html("");
                    $("#dvExplanationTextEditor").html(data.Html);
                    $('#hdnExplanationEditorType').val('1');
                    $('#dvEditorTextEditor').show();
                    $('#dvEditorScanning').hide();
                    $('#dvText').hide();
                    $('#btnAddExplanation').hide();
                    $('#aEditorTextEditor').removeClass("disable_a");
                    $('#aEditorScanning').addClass("disable_a");
                    $('#aText').addClass("disable_a");
                    $('#btnCancelExplanation').show();

                    if (editable == "True") {
                        $("#hdnExplanationId").val(id);
                        $("#hdnExplanationConfedentiality").val(data.ConfidentialityId);
                        $("#hdnExplanationConfedentiality").trigger("change");
                        $('#btnEditExplanation').removeClass("hidden_");
                        $('#btnEditExplanation').show();



                    }
                    else {
                        $('#dvExplanationTextEditorForm').hide();
                        $('#dvConfidentialityContainer').hide();
                        $('#btnEditExplanation').hide();
                        $("#txtDescription").attr("readonly", true);
                        $('.ExplanationInput').hide();

                    }
                }
                if (data.Type == 2) {
                    document.getElementById('ExplanationframeViewer').contentWindow.location.reload();
                    $('#hdnExplanationEditorType').val('2');
                    $('#dvEditorTextEditor').hide();
                    $('#dvText').hide();
                    $('#dvEditorScanning').show();
                    $('#btnAddExplanation').hide();
                    $('#hdnTextEditorContent').val('');
                    $('#aEditorTextEditor').addClass("disable_a");
                    $('#aEditorScanning').removeClass("disable_a");
                    $('#aText').addClass("disable_a");
                    $('#btnCancelExplanation').show();

                    if (editable == "True") {
                        $("#hdnExplanationId").val(id);
                        $("#hdnExplanationConfedentiality").val(data.ConfidentialityId);
                        $("#hdnExplanationConfedentiality").trigger("change");
                        $('#btnEditExplanation').removeClass("hidden_");
                        $('#btnEditExplanation').show();
                    }
                    else {
                        $('#dvConfidentialityContainer').hide();
                        $('#btnEditExplanation').hide();
                        $("#txtDescription").attr("readonly", true);
                        $('.ExplanationInput').hide();
                    }
                }
                if (data.Type == 3) {
                    document.getElementById('explinationDateTime').innerText = data.Date;
                    $("#txtDescription").val(data.Content);
                    $('#hdnExplanationEditorType').val('3');
                    $('#dvText').show();
                    $('#dvEditorTextEditor').hide();
                    $('#dvEditorScanning').hide();
                    $('#btnAddExplanation').hide();
                    $('#hdnTextEditorContent').val('');
                    $('#aEditorTextEditor').addClass("disable_a");
                    $('#aEditorScanning').addClass("disable_a");
                    $('#aText').removeClass("disable_a");
                    $('#btnCancelExplanation').show();

                    if (editable == "True") {
                        $("#hdnExplanationId").val(id);
                        $("#hdnExplanationConfedentiality").val(data.ConfidentialityId);
                        $("#hdnExplanationConfedentiality").trigger("change");
                        $('#btnEditExplanation').removeClass("hidden_");

                        $('#btnEditExplanation').show();
                    }
                    else {
                        $('#dvConfidentialityContainer').hide();
                        $('#btnEditExplanation').hide();
                        $("#txtDescription").attr("readonly", true);
                        $('.ExplanationInput').hide();
                    }
                }
                if (data.Type == 4) {
                    $("#dvExplanationTextEditor").html("");
                    $('#hdnExplanationEditorType').val('4');
                    $('#dvEditorTextEditor').hide();
                    $('#dvEditorScanning').hide();
                    $('#dvText').hide();
                    $('#btnAddExplanation').hide();
                    $('#dvUploadFile').show();
                    $('#aUploadFile').removeClass("disable_a");
                    $(".uploaded-files").html('');
                    $(".uploaded-files").html('<a onclick="DownloadFile(' + data.FileId + ')">' + data.FileName + '</a>'+'<div class="file newAdded"><i class="uicon icon_attachments">' +
                        '</i ><span class="attachment_name"></span><a href="javascript:removeMainDocAttachemntPhysically()" ' +
                        'class= "color-danger remove-mini" > <i class="uicon icon_recycle"></i></a ></div > ');

                    $('#btnCancelExplanation').show();

                    if (editable == "True") {
                        $("#hdnExplanationId").val(id);
                        $("#hdnExplanationConfedentiality").val(data.ConfidentialityId);
                        $("#hdnExplanationConfedentiality").trigger("change");
                        $('#btnEditExplanation').removeClass("hidden_");
                        $('#btnEditExplanation').show();
                    }
                    else {
                        $('#dvExplanationTextEditorForm').hide();
                        $('#dvConfidentialityContainer').hide();
                        $('#btnEditExplanation').hide();
                        $("#txtDescription").attr("readonly", true);
                        $('.ExplanationInput').hide();
                        $('#dvUploadExplanationFiles').hide();

                    }
                }
            }
        });
    });

    $(document).on('click', ".removing_tag", function () {
        debugger;
            var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
            var id = $(this).data("id");
        var element = $(this);


            $.ajax({
                type: 'post',
                cache: false,
                url: '@Url.Action("DeleteExplanationById","Editor")',
                data: { id: id, __RequestVerificationToken: token },
                success: function (data) {
                    if (data.MessageType == 2) {
                        ShowErrorMessage(data.MessageText);
                    }
                    else {
                        if ($("#hdnExplanationId").val() == id) {
                            CancelUpdateExplanation();
                        }
                        element.parent().remove();

                        $('#btnCancelExplanation').hide();
                        $('#btnEditExplanation').hide();
                    }
                }
            });
    });
