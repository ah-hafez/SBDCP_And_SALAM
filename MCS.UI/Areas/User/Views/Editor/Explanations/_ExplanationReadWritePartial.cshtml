    function SaveExplanationAttachements() {
       // showname();
        debugger;
            var name = document.getElementById('ExplanationFiles');
        $('#dvUploadFile .uploaded-files').children('.newAdded').remove();
        var fileExist = false;
        for (i = 0; i < name.files.length; i++) {
            $('#dvUploadFile .uploaded-files').find('.attachment_name').each(function () {

                var S = $(this).html();
                if (S.includes(name.files.item(i).name)) {
                    fileExist = true;
                }
            });
            if (!fileExist) {
                $("#FileName").val(name.files.item(i).name);
                $('#dvUploadFile .uploaded-files').append('<div class="file newAdded"><i class="uicon icon_attachments"></i><span class="attachment_name">' + name.files.item(i).name + '</span><a href="javascript:removeMainDocAttachemntPhysically()" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>');
            }
        }
        $('.col-uploadeed-files').fadeIn(200);

        var files = $('#dvUploadFile').find($("input:file")).get(0).files;
        if (files.length <= 0) {
            return;
        }

        if (window.FormData !== undefined) {
            var data = new FormData();
            var fileExist = false;
            for (i = 0; i < files.length; i++) {
                $('#dvUploadFile .uploaded-files').find('.attachment_name').each(function () {
                    if ($(this).html() == files[i].name) {
                        fileExist = true;
                    }
                });
                if (fileExist) {
                    data.append("file" + i, files[i], files[i].name);
                }
            }
            data.append('TransactionArchiveVM', $("#dvAttachmentsBody :input").serializeArray());
            data.append('AttachmentTypeId', $("#hdnAttachmentType").val());
            var jqXHR = $.ajax({
                type: "post",
                url: '@Url.Action("UploadExplanationAttachments", controller)',
                data: data,
                contentType: false,
                processData: false,
                dataType: 'json',
                async: false,
            }).done(function (data)
            {
                debugger;
                if (data.MessageType != 2)
                {
                    $("#JFile").val(data.AddedFilesJson);
                } else
                {
                    $('#ExplanationFiles').val("");
                    $('#dvUploadFile .uploaded-files').find('.attachment_name').html("");
                    alert(data.MessageText);

                }
            }).fail(function (jqXHR, textStatus) {
                alert("error");
            });
        } else {
            alert("Your browser doesn't support HTML5 multiple file uploads! Please use some decent browser.");
            return;
        }

        return;
    }








