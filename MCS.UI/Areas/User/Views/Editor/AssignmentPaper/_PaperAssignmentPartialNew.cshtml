<script>
     function ChecktAllowedUserAssignment() {
         var UserId = $("#ddlAssignmentPaperUsers_hdnIdToSaveValue").val();
         if (!UserId) {
             AddNewEntity();
             return;
         }
          $.ajax({
            type: 'get',
            data: { FromUserId: UserId },
            url: '@Url.Action("GetAllowedUserAssignment", "Inbound")',
              success: function (data) {
                  if (data.selectedUserAllowedAssignmentCount == 0) {
                      AddNewEntity();
                }
                else {
                    if (data.isUserAllowAssignment) {
                        AddNewEntity();
                    }
                    else {
                        ShowInformationMessage(data.MessageText);
                    }
                }


            }
        });
    }

</script>