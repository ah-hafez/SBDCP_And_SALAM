@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Transaction.Inbound
@using MCS.UI.Areas.User.Models.Assignment
@using MCS.UI.Areas.User.Models.Transaction
@using MCS.Common
@using MCS.UI.Helpers


<ul class="nav nav-pills MCShomeTabs" id="navMenus" style="gap:20px;">
    <li class="active">
        <a href="#dvTemplateAssignment" id="TemplateAssignment">
            <div>@DbRes.TResource("User.File.AssignmentPaper")</div>
        </a>
    </li>
    <li class="">
        <a href="#dvDirectAssignment" id="DirectAssignment">
            <div>@DbRes.TResource("User.AssignmentPaper.DirectAssignment")</div>
        </a>
    </li>

</ul>
<div id="dvTemplateAssignment">
    @{ViewData.TemplateInfo.HtmlFieldPrefix = "EditorAssignmentPaper";}

    @if (SessionInfo.CurrentUser.DefaultAssignmentPaper == false)
    {
        @Html.Partial("~/Areas/User/Views/Editor/AssignmentPaper/_AssignmentPaperPartialNew.cshtml", new TransactionAssignmentVM { ToOrgUnitId = SessionInfo.OrgUnitId }, Html.ViewData)
    }
    else
    {
        @Html.Partial("~/Areas/User/Views/Editor/AssignmentPaper/_AssignmentPaperPartialNew2.cshtml", new TransactionAssignmentVM { ToOrgUnitId = SessionInfo.OrgUnitId }, Html.ViewData)
    }
    

</div>
@using (Html.BeginForm("SendAssignment", "OutboundInternal", FormMethod.Post, new { id = "EditorAssignmentForm" }))
{
    <div id="dvDirectAssignment" style="display:none">
        @Html.AntiForgeryToken()
        @{Html.ViewData.TemplateInfo.HtmlFieldPrefix = "EditorAssignment";}
        @Html.Partial("~/Areas/User/Views/Shared/_AssignmentsPartial.cshtml", new TransactionAssignmentVM { ToOrgUnitId = SessionInfo.OrgUnitId, ActionId = 5 }, Html.ViewData)
    </div>
}



<script>

    var TemplateAssignment = document.getElementById('TemplateAssignment');
    var DirectAssignment = document.getElementById('DirectAssignment');
    TemplateAssignment.addEventListener('click', () =>
    {
        GetDirectedToUsersByOrgUnitId_Assignment();
        debugger
        if (dvTemplateAssignment.style.display === "none")
        {
            dvTemplateAssignment.style.display = "block";
            dvDirectAssignment.style.display = "none";
        }
    });

    DirectAssignment.addEventListener('click', () =>
    {
        debugger
        if (dvDirectAssignment.style.display === "none")
        {
            dvDirectAssignment.style.display = "block";
            dvTemplateAssignment.style.display = "none";
        }
    });

    $("#navMenus").on('click', 'li', function ()
    {
        $("#navMenus li.active").removeClass("active");
        $(this).addClass("active");
    });

</script>
<style>

    ul > li.navMenusTab.active {
        background: #29504D;
    }

    ul > li.navMenusTab {
        border: 1px solid #bebebe;
    }

        ul > li.navMenusTab.active > a > div {
            color: white;
        }


    .navMenusTab {
        padding: 5px;
    }
</style>
