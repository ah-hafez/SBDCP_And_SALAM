            PrintHtml = PrintHtml + '<div><label>' + ToUserId + '</label></div>';
            PrintHtml = PrintHtml + '</div>';

            PrintHtml = PrintHtml + '<div class="form-group col-lg-3 col-md-3 col-sm-3 col-xs-3 mb-2">';
            PrintHtml = PrintHtml + '<label class="control-label"> النوع :</label>';
            PrintHtml = PrintHtml + '<div class="inline-radio mr-3 ml-3">';


            
            if (isAssigned == 'true') {
              /*  PrintHtml = PrintHtml + '<div class="radio">  <input class="form-check-input" disabled type="radio" checked >  <label class="form-check-label"> إحالة </label> ';*/
            }
            else {
               // PrintHtml = PrintHtml + '<div class="radio">  <input class="form-check-input" disabled type="radio"   >   <label class="form-check-label"> إحالة </label> ';
            }

