                PrintHtml = PrintHtml + '<div class="checkbox  mr-3 ml-3">  <input disabled class="form-check-input" type="checkbox"    ><label class="form-check-label"> صورة </label></div>';
            }

            PrintHtml = PrintHtml + '</div>';
            PrintHtml = PrintHtml + '</div>';
            PrintHtml = PrintHtml + '<div class="form-group col-lg-3 col-md-3 col-sm-3 col-xs-3 mb-2">';
            PrintHtml = PrintHtml + '<label class="control-label">الإجراء  :</label>';
