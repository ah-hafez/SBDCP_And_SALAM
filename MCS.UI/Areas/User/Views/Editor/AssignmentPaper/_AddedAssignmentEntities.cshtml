@using MCS.Framework.Localization
@using MCS.Common;
@using MCS.UI.Areas.User.Models.Assignment
@model TransactionAssignmentVM

 @{ 
     bool selectfirst = false;
     if(Model.ActionId == 0)
     {
         selectfirst = true;
     }
 }
@using (Html.BeginCollectionItem("TransactionAssignments"))
{  
    <div class="row TransactionAssignment col-lg-10" id="@Model.Key">
        <div class="form-group col-lg-2 col-md-4 col-sm-6 col-xs-12 mb-3 divRadio">
            <div class="inline-radio">
                <div class="radio">
                    <label>
                        <input onchange="UpdateAssignedToEntity(this); ActionChanged();" type="radio" class="rValue" name="Radio" id="Radio_@Html.IdFor(a => a.IsAssigned).ToString()" />
                        <span class="cr"><i class="cr-icon"></i></span>
                        <text>إحالة</text>
                    </label>
                </div>
                <div class="checkbox">
                    <label>
                        @if (Model.ChkConstant == true)
                        {
                            <input onchange="UpdateIsCopy(this); ActionChanged();" type="checkbox" id="ch_@Html.IdFor(a => a.IsCopy).ToString()" value="@Model.ChkConstant.ToString()" checked>
                        }
                        else
                        {

                            <input onchange="UpdateIsCopy(this); ActionChanged();" type="checkbox" id="ch_@Html.IdFor(a => a.IsCopy).ToString()" value="@Model.ChkConstant.ToString()">
                        }
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        <text style="color:black">صورة</text>
                    </label>
                </div>
            </div>
            @Html.HiddenFor(a => a.IsAssigned, new { id = "hdn_" + Html.IdFor(a => a.IsAssigned).ToString(), @class = "isAssigned", @Value = false })
            @Html.HiddenFor(a => a.IsCopy, new { id = "hdn_" + Html.IdFor(a => a.IsCopy).ToString(), @class = "IsCopy", @Value = Model.ChkConstant })
            @Html.HiddenFor(a => a.IsBcc, new { id = "hdn_" + Html.IdFor(a => a.IsBcc).ToString(), @class = "IsBcc" })
            @Html.HiddenFor(a => a.ToOrgUnitId)
            @Html.HiddenFor(a => a.ToOrgUnitName)
            @Html.HiddenFor(a => a.ToUserId, new { @class = "ToUserId" })
            @Html.HiddenFor(a => a.ToUserName)
            @Html.HiddenFor(a => a.DeliveryMethodId, new { @Value = 2703 })
            @Html.HiddenFor(a => a.GroupId, new { id = "hdn_" + Html.IdFor(a => a.GroupId).ToString(), @class = "GroupId", @Value = Model.GroupId })
            @Html.HiddenFor(a => a.GroupName)
            @Html.HiddenFor(a => a.DeliveryMethod)
            @Html.HiddenFor(a => a.ActionName)
            @Html.HiddenFor(a => a.IsAssigned)
            @Html.HiddenFor(a => a.IsBcc)
            @*@Html.HiddenFor(a => a.IsBcc)*@
            @*@Html.HiddenFor(a => a.IsAssigned)*@
        </div>
            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3 ToOrgUnitName">
                <label>@Model.ToOrgUnitName /</label>
            </div>
            <div class="ToUserId col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                <label id="ToUserNamelabel" style="word-break:break-word">@Model.ToUserName</label>
            </div>
            <div class="form-group col-lg-4 col-md-4 col-sm-6 col-xs-12 mb-2 divDDl ActionId" style="display:flex" title="حذف">
                @Html.AutoCompleteBuilder("Action_" + Html.IdFor(a => a.ActionId).ToString(), Html.IdFor(a => a.ActionId).ToString(), ViewData["AllActionsData"].ToString(), Model != null ? Model.ActionId.ToString() : null,true, "form-control DDLClass col-lg-12", "", "", "", selectfirst, "", "ActionChanged")
                @Html.HiddenGroupFor(model => model.ActionId, new { @Value = "", id = Html.IdFor(a => a.ActionId).ToString() }, "AssignmentPaper")
                <a class="edit_link" onclick="DeleteAssignment('@Model.Key')"> <i class="glyphicon glyphicon-remove" style="margin-top:9px; margin-right:6px; color:red"></i> </a>
            </div>
            @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.CopiesInternal.BCC))
            {
                <div class="checkbox col-lg-12 mt-1 mb-3">
                    <label>
                        <input class="disabled" onchange="UpdateIsBCC(this); ActionChanged();" type="checkbox" disabled="disabled" id="ch_@Html.IdFor(a => a.IsBcc).ToString()">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        <text style="color:black">نسخة مخفية</text>
                    </label>
                </div>
            }
            <!--<div class="form-group col-lg-1 col-md-4 col-sm-6 col-xs-12 mb-1">
            <label class="control-label"></label>-->
            @*<a class="edit_link" onclick="DeleteAssignment('@Model.Key')"> <i class="glyphicon glyphicon-remove"></i> </a>*@
            @*<label class="control-label"></label>
                <a class="edit_link" data-original-title="" data-placement="top" data-bs-toggle="tooltip" onclick="return DeleteActionGrid('grdArchiving',1,'هل أنت متأكد من عملية الحذف ؟','dvAttachmentsForm','DeleteArchive','1')" style="">
                    <i class="glyphicon glyphicon-trash color-danger"></i>
                </a>*@
            <!--</div>-->
            <hr style="border-color: #0E8270;" />

        </div>
}
<script>
    function DeleteAssignment(id) {

        var value;
        value = '#' + id;
        $(value).remove();
    }
</script>