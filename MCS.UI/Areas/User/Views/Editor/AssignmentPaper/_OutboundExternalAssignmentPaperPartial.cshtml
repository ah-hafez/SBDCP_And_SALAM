    function AddNewEntity() {
        var token = $("#frmAddTemporaryEntity").find("input[name='__RequestVerificationToken']").val();
        var AddedEntities = $("#AddedEntities :input").serialize();
        var NewEntity = $("#dvAddTemporaryEntity :input").serialize();
        var requestData = "__RequestVerificationToken=" + token + "&" + NewEntity + '&' + AddedEntities;
        $.ajax({
            type: 'post',
            cache: false,
            url: '@Url.Action("AddTemporaryEntity")',
            data: requestData,
            success:
                function (data) {
                    if (data.MessageType == @((int)MessageType.Error)) {
                        ShowErrorMessage(data.MessageText);
                    } else {
                        addEntitySuccess(data, "");
                    }
                }
        });
    }

    function UpdateAssignedToEntity(obj) {
        $(".isAssigned").each(function () {
            $(this).val(false);
        });

        var objId = obj.id;
        var hdnId = objId.replace("Radio_", "hdn_");
        $('#' + hdnId).val(true);
        localStorage.setItem('selectedEntity', objId);
    }

    function UpdateIsCopy(obj) {
        var objId = obj.id;
        var hdnId = objId.replace("ch_", "hdn_");
        if (obj.checked) {
            $('#' + hdnId).val(true);
        } else {
            $('#' + hdnId).val(false);
        }
    }

    function addEntitySuccess(data, div) {
        var includeCopy = [];
        $('input[type = "checkbox"]:checked').each(function (index, obj) {
            includeCopy.push(obj.id);
        });

        if (data != "") {
            $('#AddedEntities').append(data.html);
            $('#' + localStorage.getItem("selectedEntity")).attr("checked", true);

            $.each(includeCopy, function (i, val) {
                $('#' + val).attr("checked", true);
            });
        }
    }

