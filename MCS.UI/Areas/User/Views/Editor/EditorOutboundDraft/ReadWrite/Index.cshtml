        $("div.editoranchor a").removeClass("active");
        $("div.editoranchor a").addClass("disabled");
        $(this).addClass("active");
        $(".tab_editor").addClass("hidden_");

        var divId = $(this).data("divid");
        $("#" + divId).removeClass("hidden_");
    });


