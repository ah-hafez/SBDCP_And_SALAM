<script>
    function AddExternalParty() {
        var token = $("#frmEditorBasicInfo").find("input[name='__RequestVerificationToken']").val();
        ShowDialogAjax('@Url.Action("AddNewExternalPartyForTransaction")', {
            treeName: "dvDestinationTree",
            onAddPartyfuntion: "GetExternalParties",
            __RequestVerificationToken: token
        }, 'OpenExternalPartyDialogSuccess', 'dialogbox col-md-12 ');
    }

    $(document).on('change', '#ddlOutboundExternalDocumentType', function () {
        GetExternalPartisByLetterId(-1);
    });



    function GetExternalPartisByLetterId(selectedNode) {
        $.ajax({
            type: 'get',
            url: '@Url.Action("GetExternalParties")',
            data: {selectedParty: selectedNode },
            success:
                function (data) {

               if ($('#divContainer__dvDestinationTree').css('display') == 'block') {

                   ShowHideTree('#divContainer__dvDestinationTree');
               }

               $('#divContainer__dvDestinationTree').remove();

               $("#divContainerExternalParties").html("");

               $("#divContainerExternalParties").html(data);

           }
        });
        return false;
        //}
    }
    $(document).on("change", "#radio1", function () {
        if ($(this).val() == 0) {
            $('#hdnHasDateUm').val("");
            $('#hdnHasDateGreg').val("");
            $('#hdnMinute').val("");
            $('#hdnHour').val("");
            $('#datePicker').hide();
        } else {
            $('#datePicker').show();
            $('#hdnHasDateGreg').val('@Model.RemindDate')
            $('#hdnHour').val('@Model.Hour')
            $('#hdnMinute').val('@Model.Minute')
            FillDateAndTime();
        }
    });
    function SetSuggestedTopic() {
        $("#txtAreaSubject").val($("#divForm__dvSuggestedTopicTree .txtDepartmentName").val());
    }

    function GetEditorUsersByPreparationEntityId() {
     
        if ($("#divForm__treeSignedByOrgUnitId").find(".hdnDepartmentId").val() != "" && $("#divForm__treeSignedByOrgUnitId").find(".hdnDepartmentId").val() != undefined) {

            $.ajax({
                type: 'Get',
                url: '@Url.Action("GetUnitUsers","Editor")',
                data: { id: $("#divForm__treeSignedByOrgUnitId").find(".hdnDepartmentId").val() },
                success:
               function (data) {

                   AutoCompleteChangeList("ddlEditorSignedByUserId", data);

                   $("#ddlEditorSignedByUserId").val('');
                   $("#hdnEditorSignedByUserId").val('');
               }
            });
            return false;
        }
        else {

            AutoCompleteChangeList("ddlEditorSignedByUserId", "[]");

            $("#ddlEditorSignedByUserId").val('');
            $("#hdnEditorSignedByUserId").val('');

        }
    }

    $(document).on('change', '#dllEditorLetterType', function () {

            GetEditorExternalPartisByLetterId(-1);
    });



    function GetEditorExternalPartisByLetterId(selectedParty) {

        $.ajax({
            cache: false,
            type: 'get',
            url: '@Url.Action("GetExternalPartiesbyLetterId")',
            data: { LetterId: $("#hdnEditorLetterType").val(), selectedParty: selectedParty },
            success:
           function (data) {

               if ($('#divContainer__ExternalPartyTree').css('display') == 'block') {

                   ShowHideTree('#divContainer__ExternalPartyTree');
               }

               $('#divContainer__ExternalPartyTree').remove();

               $("#divEditorDraftExternalParties").html("");

               $("#divEditorDraftExternalParties").html(data);

               GetEditorUsersByPartyId();
           }
        });
        return false;
    }

    function GetEditorUsersByPartyId() {

        if ($("#divForm__ExternalPartyTree").find(".hdnDepartmentId").val() != "") {

            $.ajax({
                type: 'Get',
                url: '@Url.Action("GetManagersByPartyId","Editor")',
                data: { id: $("#divForm__ExternalPartyTree").find(".hdnDepartmentId").val() },
                success:
               function (data) {

                   AutoCompleteChangeList("ddlEditorExternalPartyManagerId", data);
                   $("#ddlEditorExternalPartyManagerId").val('');
                   $("#hdnEditorExternalPartyManagerId").val('');
               },
            });
            return false;
        }
        else {

            AutoCompleteChangeList("ddlEditorExternalPartyManagerId", "[]");

            $("#ddlEditorExternalPartyManagerId").val('');
            $("#hdnEditorExternalPartyManagerId").val('');

            //$("#ddlSignedById").prop('disabled', false);
        }
    }

    function OnSaveBasicInfoSuccess(data, div) {
        if (data.MessageType != 2) {

            ShowSuccesMessage(data.MessageText)
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
</script>
<script>
    $(document).ready(function () {
        GetExternalPartisByLetterId(-1);
        if ($('#hdnHasDateGreg').val() == "") {
            $('.withoutAppointment').trigger('change');
            $('.withoutAppointment').attr('checked', 'checked');
        } else {
            FillDateAndTime();
        }

        $('#ddlEditorDraftSourceType').attr("disabled", true);
        $('.iradioOutboundType').attr("disabled", true);
    });

    $(document).on("change", "#ddlHour", function () {

        $('#hdnHour').val($('#ddlHour').val());
    });

    $(document).on("change", "#ddlMinute", function () {

        $('#hdnMinute').val($('#ddlMinute').val());
    });

    function FillDateAndTime() {
        $(".withAppointment").click();
        $('#ddlHour').val($('#hdnHour').val());
        $('#ddlHour').trigger("focusout");
        if ($('#hdnMinute').val().length == 1) {

            $('#ddlMinute').val("0" + $('#hdnMinute').val());
            $('#ddlMinute').trigger("focusout");
        }
        else {
            $('#ddlMinute').val($('#hdnMinute').val());
            $('#ddlMinute').trigger("focusout");
        }
    }
    function CheckPriorityIfHasDate() {
        if ($('#datePicker').css('display') == 'block' && $("#hdnHasDateGreg").val() == "") {
             $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateRequired"))');
            return false;
        }
        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        if ($("#hdnHasDateGreg").val() != "") {

            if ($("#hdnHasDateGreg").val() != undefined) {
                 var selectedDate = convertdate($("#hdnHasDateGreg").val());

                if (selectedDate < currentDate) {
                    $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateCompare"))');
                return false;
                }
            }
        }
        if ($('#datePicker').css('display') == 'block' && ($('#ddlMinute').val() == "" || $('#ddlHour').val() == "")) {
              $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindTime"))');
            return false;
        }


        if ($('#datePicker').css('display') == 'block' && ($('#ddlMinute').val() != "" && $('#ddlHour').val() != "")) {
            var time = new Date();
            if (convertdate($("#hdnHasDateGreg").val()) > currentDate) {
                $("#CalMessage").html("")
                return true;
            }
            else if ($("#hdnHasDateGreg").val() > convertdate($("#hdnHasDateGreg").val())) {
                $("#CalMessage").html("")
                return true;
            }
            else if ($('#ddlHour').val() > time.getHours()) {
                $("#CalMessage").html("")
                return true;
            }
            else if ($('#ddlHour').val() == time.getHours() && $('#ddlMinute').val() > time.getMinutes()) {
                $("#CalMessage").html("")
                return true;
            }
            else {
                 $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.WrongRemindTime"))');
                 return false;
            }
        }

         if (!ValidateCopy()) {
           
            return false;
        }

         return true;
    }
</script>
