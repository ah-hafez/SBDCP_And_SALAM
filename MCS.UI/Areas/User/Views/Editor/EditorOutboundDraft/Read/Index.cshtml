@using MCS.UI.Areas.User.Models.Transaction;
@using MCS.UI.Areas.User.Models;
@using MCS.Framework.Localization;
@using MCS.Common
@using MCS.UI.Common
@model EditorViewModel
@{
    ViewBag.Title = "Index";
    bool isVIP = (bool)SessionInfo.GetObjectFromSession(Constants.IsVIPUser);
    if (!isVIP)
    {
        Layout = "~/Areas/User/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Areas/User/Views/Shared/_VIPLayout.cshtml";
    }


    var copyVM = new TransactionCopyVM
    {
        Copies = (AjaxGrid<TransactionCopyVM>)new AjaxGridFactory().CreateAjaxGrid(Model.TransactionCopyVM.Copies, 1, Model.TransactionCopyVM.Copies.Count, false)
    };
    var followUpVM = new TransactionFollowUpVM() { FollowUps = (AjaxGrid<TransactionFollowUpVM>)new AjaxGridFactory().CreateAjaxGrid(Model.FollowUps, 1, Model.FollowUps.Count, false) };
    followUpVM.IsCopy = true;
    var archivesVm = new TransactionArchiveVM { Archives = (AjaxGrid<TransactionArchiveVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Archives, 1, Model.Archives.Count, false) };
    var linksVm = new TransactionLinkVM { Links = (AjaxGrid<TransactionLinkVM>)new AjaxGridFactory().CreateAjaxGrid(Model.TransactionBasicInfoVM.Links, 1, Model.TransactionBasicInfoVM.Links.Count, false) };

    var doconutIframeUrl = UIConfigurations.GetFullURl() + string.Format("{0}?sIncludedItemDoc=true&hidecontrols=true&hideAllcontrols=true&showwatermark={1}", SystemConfigurations.DoconutIframeUrl, "true");
    bool isEditMode = false;
    Session["IsEditMode"] = isEditMode;
}
<script src="~/Scripts/Transaction.js"></script>
<script>
    var archiveMode = '@isEditMode';
</script>

<div class="white-container mx-md-5 mx-3">

    @*<div class="content_container content_container--body transparent-bg">
            <div class="options-list row anchor">
                <div class="col-xs-4 col-sm-2 text-center" id="basicInfor">
                    <a href="#" id="first" class="boardered-circle-transparent active" data-divid="first-tab"><i class="uicon icon_folder1"></i></a>
                    <a href="#" data-id="first" data-divid="first-tab">  @DbRes.TResource("User.Editor.BasicInfo")</a>
                </div>
                <div class="col-xs-4 col-sm-2 text-center" id="transactionAttachment">
                    <a href="#" id="second" class="boardered-circle-transparent" data-divid="second-tab"><i class="uicon icon_folder2"></i></a>
                    <a href="#" data-id="second" data-divid="second-tab"> @DbRes.TResource("User.Editor.Explanations")</a>
                </div>
                <div class="col-xs-4 col-sm-2 text-center" id="electronicCopies">
                    <a href="#" id="third" class="boardered-circle-transparent" data-divid="third-tab"><i class="uicon icon_folder4"></i></a>
                    <a href="#" data-id="third" data-divid="third-tab"> @DbRes.TResource("النسخ الالكترونية")</a>
                </div>
            </div>
        </div>*@
    @Html.Hidden("hdnCurrentTransactionId", ViewData["TransactionId"], new { @id = "hdnTransactionId" })
    <div class="" id="">
        @Html.Partial("~/Areas/User/Views/Editor/EditorOutboundDraft/Read/_OutboundDraftBasicInfoPartial.cshtml", Model.TransactionBasicInfoVM)
        <hr />
        @if (Model.EditorType == EditorType.Scanning)
        {
            Html.ViewData.TemplateInfo.HtmlFieldPrefix = null;
            @Html.Partial("~/Areas/User/Views/Transaction/_ArchivingPartialMainDocument.cshtml", new TransactionArchiveVM(TransactionAttachmentType.Main, true, false, true, bReadOnly: true), Html.ViewData)
        }
        else if (Model.EditorType == EditorType.TextEditor)
        {
            @Html.Partial("~/Areas/User/Views/Transaction/_EditorPartial.cshtml", ViewData["EditorViewModel"], Html.ViewData)
        }
        <div id="dvScanningArchiving" style="display:none">
            <div id="dvDocumentViewerEditorContainerArchiving" class="">

                <iframe src="@doconutIframeUrl" class="col-md-12" style="height:500px" id="frameViewerAttachmentForArchiving"></iframe>

            </div>
        </div>
    </div>

    <div class="extraOption col-lg-12 c0l-md-6 col-xs-12 m-3">
        <h4>
            <a role="button" style="display:flex">
                <span onclick="CollapseDiv('transactionAttachment'); return false;" style="cursor: pointer;">
                    <img src="~/Content/User/lib/images/plus-icon.svg" id="transactionAttachmentPlusIcon" width="25" />
                    <img src="~/Content/User/lib/images/Dash-icon.svg" id="transactionAttachmentDashIcon" width="25" style="display: none;" />
                </span>
                <span class="ml-3 mt-1">@DbRes.TResource("User.Editor.Explanations")</span>
            </a>
        </h4>
        <div role="tabpanel" class="tab-pane" id="transactionAttachment" style="display:none">
            <div>
                @{Html.ViewData.TemplateInfo.HtmlFieldPrefix = "EditorExplanations";}
                @Html.Partial("~/Areas/User/Views/Editor/Explanations/_ExplanationReadWritePartial.cshtml", new ExplanationVM() { isCopies = true }, Html.ViewData)
            </div>
        </div>
    </div>

    <div class="extraOption col-lg-12 c0l-md-6 col-xs-12 m-3">
        <h4>
            <a role="button" style="display:flex">
                <span onclick="CollapseDiv('electronicCopies'); return false;" style="cursor: pointer;">
                    <img src="~/Content/User/lib/images/plus-icon.svg" id="electronicCopiesPlusIcon" width="25" />
                    <img src="~/Content/User/lib/images/Dash-icon.svg" id="electronicCopiesDashIcon" width="25" style="display: none;" />
                </span>
                <span class="ml-3 mt-1">@DbRes.TResource("User.Trays.ElecCopies")</span>
            </a>
        </h4>

        @using (Html.BeginForm("AddTransactionCopy", "Editor", FormMethod.Post, new { id = "CopiesEditorform" }))
        {
            @Html.AntiForgeryToken()
            <div role="tabpanel" class="tab-pane" id="electronicCopies" style="display:none">

                <div>
                    @Html.Partial("~/Areas/User/Views/Editor/Copies/_CopiesPartial.cshtml", copyVM, Html.ViewData)
                </div>

                <div class="content_container content_container--footer">
                    <div class="row">

                        <div class="col-xs-12 text-center">
                            @Html.ConfirmAction(OperationType.Save, "btnSaveCopies", DbRes.TResource("User.Inbound.Edit"), Url.Action("AddTransactionCopy", "Editor"), null, null, null, "OnSuccess", null, DbRes.TResource("User.Inbound.SaveMessage"), "post", "CopiesEditorform", "CopiesEditor", "btn btn-save btn-site", "", UserClaims.Outbound.EditOutbound)
                        </div>
                    </div>
                </div>
            </div>
            @Html.StickyHidden("hdntransactionId", ViewData["TransactionId"].ToString())
        }

    </div>


    <div class="extraOption col-lg-12 c0l-md-6 col-xs-12 m-3">
        <h4>
            <a role="button" style="display:flex">
                <span onclick="CollapseDiv('followup'); return false;" style="cursor: pointer;">
                    <img src="~/Content/User/lib/images/plus-icon.svg" id="followupPlusIcon" width="25" />
                    <img src="~/Content/User/lib/images/Dash-icon.svg" id="followupDashIcon" width="25" style="display: none;" />
                </span>
                <span class="ml-3 mt-1">@DbRes.TResource("User.Inbound.FollowUp")</span>
            </a>
        </h4>
        <div id="followup" style="display:none">
            @using (Html.BeginForm("AddFollowUp", "Editor", FormMethod.Post, new { id = "EditorFollowUpForm", role = "tabpanel", @class = "tab-pane" }))
            {
                @Html.AntiForgeryToken()
                <div>
                    @Html.Partial("~/Areas/User/Views/Editor/FollowUp/_FollowUpPartial.cshtml", followUpVM)
                </div>
            }
        </div>
    </div>




    @*<div class="tabscontent hidden_" id="second-tab">
            <div id="dvEditorExplanation">
            </div>
            <div class="content_container content_container--body white-bg panel-body">
                @{Html.ViewData.TemplateInfo.HtmlFieldPrefix = "EditorExplanations";}
                @Html.Partial("~/Areas/User/Views/Editor/Explanations/_ExplanationReadWritePartial.cshtml", new ExplanationVM(), Html.ViewData)
            </div>
        </div>*@


</div>

<div id="dvArchivingGrid" hidden>
    @Html.Partial("~/Areas/User/Views/Transaction/_ArchivingGridPartial.cshtml", archivesVm.Archives)
</div>
<div id="dvLinksGrid" hidden>
    @Html.Partial("~/Areas/User/Views/Shared/_LinksGridPartial.cshtml", linksVm.Links)
</div>
<script>
    $(document).ready(function () {
        debugger;
        AppendArchives();
    });
    $("div.anchor a").click(function () {
        $("div.anchor a").removeClass("active");
        $("div.anchor a").addClass("disabled");
        $(this).addClass("active");
        var id = $(this).data("id");
        $("#" + id).addClass("active");
        $(".tabscontent").addClass("hidden_");

        var divId = $(this).data("divid");
        $("#" + divId).removeClass("hidden_");
    });

    $('.tab_editor').click(function () {

        var url;
        var data = new Array();

        $('.tab_editor').removeClass('select_but');
        $(this).addClass('select_but');

        $("._views").hide();

        switch ($(this)[0].id) {

            case "btnBasicInfo":
                $("#dvEditorBasicInfo").show();
                break;

            case "btnExplanation":
                $("#dvEditorExplanation").show();
                break;
        }
        return false;
    });
    function OnSuccess(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
        }
    }
</script>