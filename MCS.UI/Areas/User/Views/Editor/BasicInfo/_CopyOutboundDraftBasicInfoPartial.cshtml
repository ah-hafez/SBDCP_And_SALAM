@model MCS.UI.Areas.User.Models.Transaction.TransactionBasicInfoVM
@using MCS.Framework.Localization



<div class="panel-body editor">
    <p class="subtitle">@DbRes.TResource("User.Editor.BasicInfo")</p>


    <div class="panel-body">
        <div class="row just_read">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.Editor.BasicInfo.OutboundDraft.Number"), new { @class = "col-md-5 control-label definition" })
                    <label class="col-md-7 control-label">@Html.DisplayFor(model => model.Number)</label>
                </div>
                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.Editor.BasicInfo.OutboundDraft.Date"), new { @class = "col-md-5 control-label definition" })
                    <label class="col-md-7 control-label">@Html.DisplayFor(model => model.DateH)</label>
                </div>
                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.Editor.BasicInfo.OutboundDraft.SourceType"), new { @class = "col-md-5 control-label definition" })
                    <label class="col-md-7 control-label">@Html.DisplayFor(model => model.TransactionTypeName)</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.Editor.BasicInfo.OutboundDraft.Confidentiality"), new { @class = "col-md-5 control-label definition" })
                    <label class="col-md-7 control-label">@Html.DisplayFor(model => model.ConfidentialityName)</label>
                </div>
                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.Editor.BasicInfo.OutboundDraft.Priority"), new { @class = "col-md-5 control-label definition" })
                    <label class="col-md-7 control-label">@Html.DisplayFor(model => model.PriorityName)</label>
                </div>
            </div>
            <div class="col-md-4">

                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.OutboundDraft.BasicInfo.SignedByOrgUnit"), new { @class = "col-md-5 control-label definition" })
                    <label class="col-md-7 control-label">@Html.DisplayFor(model => model.SignedByOrgUnitName)</label>
                </div>
                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.Editor.BasicInfo.OutboundDraft.SignedByUser"), new { @class = "col-md-5 control-label definition" })
                    <label class="col-md-7 control-label">@Html.DisplayFor(model => model.SignedByUserName)</label>
                </div>
            </div>
        </div>

        <div class="row just_read group push-bottom">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label(DbRes.TResource("User.Editor.BasicInfo.OutboundDraft.Subject"), new { @class = "col-md-4 control-label definition" })
                    <label class="col-md-8 control-label">@Html.DisplayFor(model => model.Subject)</label>
                </div>
            </div>

        </div>

    </div>


</div>


