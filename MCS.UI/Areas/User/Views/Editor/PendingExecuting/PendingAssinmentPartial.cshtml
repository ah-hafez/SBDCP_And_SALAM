}
@{
    Model.ToOrgUnitId = SessionInfo.OrgUnitId;
    Model.ToUserId = SessionInfo.CurrentUser.Id;
    Model.DeliveryMethodId = 236;
}
<script src="~/Scripts/Transaction.js"></script>
<div class="content_container white-bg">

