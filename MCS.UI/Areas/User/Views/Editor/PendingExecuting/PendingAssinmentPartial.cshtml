</div>


<div class="modal fade" id="UserDelegationsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">تفويضات الموظف </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-lg-12">
                    <ul id="UserDelegationsList" style="list-style: disc;"></ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnsConfirmSendEditorAssignments" class="btn-site">استمرار</button>
            </div>
        </div>
    </div>
</div>


<script>
     function ChecktAllowedUserAssignment() {
        var UserId = $("#ddlEditorAssginmentIndividualToUserId_hdnIdToSaveValue").val();
        if (!UserId) {
            $("#btnsSendEditorAssignments").click();
            return;
        }
        $.ajax({
            type: 'get',
            data: { FromUserId: UserId },
            url: '@Url.Action("GetAllowedUserAssignment", "File")',
            success: function (data) {
                if (data.selectedUserAllowedAssignmentCount == 0) {
                    $("#btnsSendEditorAssignments").click();
                }
                else {
                    if (data.isUserAllowAssignment) {
                        $("#btnsSendEditorAssignments").click();
                    }
                    else {
                        ShowInformationMessage(data.MessageText);
                    }
                }
            }
        });
    }

    function CheckUserHasPermission()
    {
        debugger;
        var form = $("#frmEditorAssignment").serialize();
         $.ajax({
                type: 'post',
                url: '@Url.Action("CheckUserHasPermission", "File")',
               data: form,
               success:
                   function (data)
                   {
                       switch (data.MessageType)
                       {
                           case 0:
                               return true;
                           case 1:
                               return ShowConfirmMessage(data.MessageText,"ContinueAssigneTransaction");
                               break;
                           case 1:
                               // code block
                               ShowErrorMessage(data.MessageText);
                               return false;
                           default:
                               ShowErrorMessage(data.MessageText);
                               return false;
                       }

               }
            });
    }



    $(document).ready(function () {
        $("#GetUserDelegationsById").click(function () {

            if (EditorAssignmentPaper_rbSearchByUser.checked) {
                document.getElementsByName('ToOrgUnitId')[1].value = document.getElementsByName('ToOrgUnitId')[0].value;
            } else {
                document.getElementsByName('ToOrgUnitId')[0].value = document.getElementsByName('ToOrgUnitId')[1].value;
            }

            if ($("#frmEditorAssignment").valid()) {
                var AssginmentIndividualToUserId = $("#ddlEditorAssginmentIndividualToUserId_hdnIdToSaveValue").val();
                var del = "{0} مفوض بالعمل عن {1} من تاريخ {2} الى تاريخ {3}."
                var DelegationsList = '';
                $("ul#UserDelegationsList").html('');
                $.ajax({
                    url: "@Url.Action("GetUserDelegationsById", "Editor")",
                    type: 'GET',
                    data: { UserId: AssginmentIndividualToUserId },
                    success: function (data) {
                        if (data.result != null) {
                            if (data.result.length > 0) {

                                data.result.forEach(element => {
                                    var Msg = del;
                                    Msg = Msg.replace('{1}', $("#ddlEditorAssginmentIndividualToUserId").val());
                                    Msg = Msg.replace('{0}', element.UserPreferenceName);
                                    Msg = Msg.replace('{2}', new Date(parseInt(element.FromDate.replace('/Date(', '').replace(')/', ''))).toLocaleDateString());
                                    Msg = Msg.replace('{3}', new Date(parseInt(element.ToDate.replace('/Date(', '').replace(')/', ''))).toLocaleDateString());

                                    DelegationsList = DelegationsList + '<li>' + Msg + '</li>'
                                });

                                $("ul#UserDelegationsList").append(DelegationsList);
                                $("#UserDelegationsModal").modal();
                            }
                            else {
                                $("#UserDelegationsList").hide();
                                $("#UserDelegationsModal").modal('hide');
                                ChecktAllowedUserAssignment();
                            }
                        } else {
                            $("#UserDelegationsModal").modal('hide');
                            ChecktAllowedUserAssignment();
                        }
                    },
                    error: function (a) {
                    }
                });
            }
        });



    });
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $("#btnsConfirmSendEditorAssignments").click(function () {

            $("#UserDelegationsModal").modal('hide');
            $("#btnsSendEditorAssignments").click();
        });

        onChangePendingAssinmentDeliveryMethod();
        setTimeout(function () {
            $('#EditorAssignmentPaper_rbSearchByOrgUnit').click();
        }, 500);
    });

    function GetDirectedToUsersByOrgUnitId() {
        //$("#ddlEditorAssginmentIndividualToUserId_hdnIdToSaveValue").val('')
        var token = $("#frmEditorAssignment").find("input[name='__RequestVerificationToken']").val();
        if ($("#ToOrgUnitId").val() != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId")',
                data: { id: $("#ToOrgUnitId").val(), __RequestVerificationToken: token, addSelectOption: true },
                success:
               function (data) {

                   //$("#ddlEditorAssginmentIndividualToUserId").val("");
                   AutoCompleteChangeList("ddlEditorAssginmentIndividualToUserId", data);
                   $("#ddlEditorAssginmentIndividualToUserId").val("استقبال الادارة");
                   $("#ddlEditorAssginmentIndividualToUserId_hdnIdToSaveValue").val("-1");
                   $("#ddlEditorAssginmentIndividualToUserId").prop('disabled', false);
               }
            });
            return false;
        }
        else {
            $("#ddlEditorAssginmentIndividualToUserId").prop('disabled', true);
            $("#ddlEditorAssginmentIndividualToUserId").val("");
            AutoCompleteChangeList("ddlEditorAssginmentIndividualToUserId", "[]");
        }
    }

     function AddReporter() {
        __dialog = $.confirm({
            title: false,
            content: function ($obj) {
                return $.ajax({
                    url: '@Url.Action("AddReporter", "Shared")',
                    type: 'GET',
                    cache: false,
                    success: function (data) {
                        $obj.setContent(data.Html);
                        jQuery.validator.unobtrusive.parse('#frmAddReporter');
                    }
                });
            },
            onOpen: function () {
                jQuery(function () {
                    jQuery('.jconfirm-box').draggable({
                        revert: false,
                    });
                });
                $("#Loader").hide();
            },
            onClose: function () {
                GetAllReporter();
            },
            confirmButton: false,
            icon: 'fa fa-info',
            animation: 'scale',
            columnClass: "dialogbox col-md-8 col-md-offset-2 col-xs-8 col-xs-offset-2",
            backgroundDismiss: false,
            closeIcon: true,
            cancelButton: false
        });
    }
     function GetAllReporter() {
        $.ajax({
            cache: false,
            type: 'get',
            url: '@Url.Action("GetReporters")',
            success: function (data) {
                AutoCompleteChangeList("ddlBasicReporter", data);
                AutoCompleteChangeList("ddlBasicReporterAssinment", data);
                AutoCompleteChangeList("ddlAssignmentPaperReporter", data);
                var newItems = $.parseJSON(data);
                var lastItem = newItems.slice(-1)[0].value;
                $('#hdnBasicReporter').val(lastItem);
                $('#hdnBasicReporter').trigger('change')
            }
        });
    }
    function OnAddReporterSuccess(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText)
            ClearInputs('frmAddReporter');
            __dialog.close();
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
    function onChangePendingAssinmentDeliveryMethod() {
        var value = $('#hdnDeliveryId').val();
        switch (parseInt(value)) {
            case DeliveryMethodType.Paper:
                ShowHidePendingAssinmentReporterContent(true);
                break;
            case DeliveryMethodType.Electronic:
                ShowHidePendingAssinmentReporterContent(false);
                break;
            case DeliveryMethodType.ElectronicPaper:
                ShowHidePendingAssinmentReporterContent(true);
                break;
            default:
        }
    }

    function ShowHidePendingAssinmentReporterContent(isShow) {
        if (isShow) {
            $('#ReporterContent').removeClass('hide');
            $('#hdnDeliveryMethod').prop('disabled', false);
        } else {
            $('#ReporterContent').addClass('hide');
            $('#hdnDeliveryMethod').prop('disabled', 'disabled');
        }
    }

    $(document).on("click", "span[data-node-id]", function () {
        var elemnt = $(this);
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsNodes")',
                data: { parentId: $(this).data("node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
                    function (data) {
                        $(elemnt).closest('li').children('ul').last().empty()
                        $(elemnt).closest('li').children('ul').last().append(data);
                        $(elemnt).removeClass("InternalLoadedData");
                    }
            });
        }
    });

    function CheckAssignment() {
        if ($('#dvEditorAssignmentContainer .txtDepartmentName').val() == "") {
            $('#dvEditorAssignmentContainer .txtDepartmentName, #dvEditorAssignmentContainer .txtDepartmentNumber').addClass("RedBorder");
        }
        else {
            $('#dvEditorAssignmentContainer .txtDepartmentName, #dvEditorAssignmentContainer .txtDepartmentNumber').removeClass("RedBorder");
        }
        return true;
    }

    function ValidateUser() {
        if ($("#hdnEditorAssginmentIndividualToUserId").val() == "") {
            return false;
        }
        return true;
    }

