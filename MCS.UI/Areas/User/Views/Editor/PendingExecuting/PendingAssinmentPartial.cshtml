    function CheckIfHasEditorAssignments() {
        if ($("#dvEditorAssignmentContainer #hdnAssignmentIndividualData").val() != "[]") {
            var check = true;
            if ($("#dvEditorAssignmentContainer #hdnAssignmentIndividualData").val() != "[]") {
                var data = jQuery.parseJSON($("#dvEditorAssignmentContainer #hdnAssignmentIndividualData").val());
                $.each(data, function (i, item) {
                    if (item.ActionId == -1 || item.ActionId == "") {
                        check = false;
                    }
                })
            }
            if (check) {
                return true;
            }
            else {
                ShowErrorMessage('@Html.Raw(DbRes.TValidation("User.Transaction.Assignment.ActionsRequired"))');
                return false;
            }
        }
        else {
            ShowErrorMessage('@Html.Raw(DbRes.TValidation("User.Transaction.Assignment.AssignmentRequired"))');
            return false;
        }
    }

    var _url = null;
    var urlDeliveryReport;



    function SendEditorAssignmentSuceeded(data)
    {

        switch (data.MessageType)
        {
            case 0:
                break;
            case 1:
               return ShowConfirmMessage(data.MessageText, "ContinueAssigneTransaction");
                break;

            default:
             return   ShowErrorMessage(data.MessageText);

        }


        var token = $("#frmEditorAssignment").find("input[name='__RequestVerificationToken']").val();
        if (data.MessageType != 2) {

            if (parseInt($('#hdnDeliveryId').val()) == DeliveryMethodType.ElectronicPaper) {
                $.ajax({
                    type: 'post',
                    url: '@Url.Action("GetDeliveryReportByTransactionIds", "Inbound")',
                    data: { transactionIds: $('#transIds').val(), __RequestVerificationToken: token },
                    success: function (data) {
                        if (data.MessageType != 2) {
                            PrintPendingTransactionsDeliveryReport(data.TransactionDeliveryReports);
                        }
                        else {
                            ShowErrorMessage(data.MessageText);
                        }
                    }
                });
            }
            else {
                RedirectToHomePage();
            }
            @*UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');*@
        }
        else {
            ShowErrorMessage(data.MessageText);
        }



    }

    function ContinueAssigneTransaction()
    {
        $("#isConfirmed").val(true);
        $("#btnEditorAssignments").click();

    }
    function CheckOrgUserSuceeded(data) {

          var token = $("#frmEditorAssignment").find("input[name='__RequestVerificationToken']").val();
        if (data.MessageType == 3) {
            $("#btnSendEditorAssignments").click();

        } else {
            $("#btnEditorAssignments").click();
        }

    }

    function PrintPendingTransactionsDeliveryReport(data) {
        var reporterName = $('#ddlBasicReporter').val();
        var deliveryReportArray = [];
        for (var i = 0; i < data.length; i++) {
            var tranDeliveryReport = data[i];
            deliveryReportArray.push({ TransactionId: tranDeliveryReport.TransactionId, ReportsIds: [] });
            deliveryReportArray[i].ReportsIds.push(tranDeliveryReport.Id);
        }
        var reportType = @((int)DeliveryReportType.DeliveryReport);
        var parameters = '?transactionReportInfo=' + JSON.stringify(deliveryReportArray) + '&isPerTransaction=true&IsNew=true&group=false&reportType=' + reportType + '&reporterName=' + reporterName;
        urlDeliveryReport = '@Url.Action("PrintDeliveryReportsByIds", "Reports")' + parameters
        PrintReport(urlDeliveryReport, '', RedirectToHomePage);
    }

    function RedirectToHomePage() {
        setTimeout(function () {
            window.location.href = '@Url.Action(((TrayType)Convert.ToInt32(ViewData["type"])).ToString(), "File")';
        }, 3000);
    }


    function toggleSearchMethod() {

        //ddlEditorAssginmentIndividualToUserId.value = ''
        //document.getElementsByClassName('txtDepartmentName')[0].value = ''
        //document.getElementsByClassName('txtDepartmentNumber')[0].value = ''
        var rbSearchByUser = $("#EditorAssignmentPaper_rbSearchByUser");
        var rbSearchByOrgUnit = $("#EditorAssignmentPaper_rbSearchByOrgUnit");
        var divUser = $("#divUser");
        var divOrgUnit = $("#divOrgUnit");

        if (rbSearchByUser.is(':checked')) {
            $('#orgUnit_Department').hide();
            $('#orgUnit_user').show();
            divOrgUnit.insertAfter(divUser);
             AutoCompleteChangeSourceParameters("ddlEditorAssginmentIndividualToUserId", '@Url.Action("AutoComplete_SearchUsersByOrgUnit", "Inbound")', "");
            TreeChangeGetChildrenParameters("treeEditorAssignment", { UserId: "##ddlEditorAssginmentIndividualToUserId_hdnIdToSaveValue" });
            //ResetAutoComplete("ddlEditorAssginmentIndividualToUserId");
            //ResetTree("treeEditorAssignment");
        }
        else {
            $('#orgUnit_user').hide();
            $('#orgUnit_Department').show();
            divUser.insertAfter(divOrgUnit);
            AutoCompleteChangeSourceParameters("ddlEditorAssginmentIndividualToUserId", '@Url.Action("AutoComplete_SearchUsersByOrgUnit", "Inbound")', { orgUnitId: "#input[name ='ToOrgUnitId']" });
            TreeChangeGetChildrenParameters("treeEditorAssignment", "");
            //ResetAutoComplete("ddlEditorAssginmentIndividualToUserId");
            //ResetTree("treeEditorAssignment");
        }
    }
    function TreeChangeGetChildrenParameters(treeId, newParameters) {
    $("#" + treeId + "_hrefShowDialog").data('getchildrenparameters', newParameters);
}

</script>
