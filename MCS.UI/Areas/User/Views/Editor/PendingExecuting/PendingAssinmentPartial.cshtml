                                        @Html.DepartmentsTree(ViewData["DepartmentsData"] as TreeViewModel, model => model.ToOrgUnitId, TreeMode.Single, "treeEditorAssignment", true, "GetDirectedToUsersByOrgUnitId", "AssignmentIndividual", "dvEditorTreeAssignment")
