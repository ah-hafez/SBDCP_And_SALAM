                    @Html.ConfirmAction(OperationType.Save, "btnsSendEditorAssignments", DbRes.TResource("User.Transaction.Assignment.Send"), Url.Action("CheckOrgUser", controller), null, null, null, "CheckOrgUserSuceeded", null, DbRes.TResource("User.Transaction.Assignment.SendMessage"), "get", "frmEditorAssignment", "AssignmentIndividual", " btn-site d-none", "CheckAssignment", UserClaims.Assignments.Assign, null)
                </div>

            </div>
        </div>
