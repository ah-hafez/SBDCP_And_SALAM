                                        <div>
                                            @Html.AutoCompleteBuilder("ddlSaveReason", "hdnSaveReason", ViewData["SaveReason"].ToString(), Model != null ? ViewData["SaveReason"].ToString() : null, true, "form-control", "remarks", "", "", true)
