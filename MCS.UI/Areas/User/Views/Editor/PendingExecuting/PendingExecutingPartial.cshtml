                        @using (Html.BeginForm("MoveTransactionsList", "File", FormMethod.Post, new { id = "frmMoveToDone" }))
                        {
                            @Html.AntiForgeryToken()
                            @*<div class="form-group col-xs-12 ">
                                <label class="w-100">@DbRes.TResource("User.File.ReasonForTransfer")  <span class="stark">*</span></label>
                                <textarea class="form-control long-textarea2" id="remarks" name="remarks" maxlength="500"></textarea>
