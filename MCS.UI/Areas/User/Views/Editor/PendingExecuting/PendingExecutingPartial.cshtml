                                @Html.StickyHidden("TrayId", ((int)TrayType.MyTransactions).ToString(), null)
                                @Html.StickyHidden("TrayActionType", TrayActionType.Save.ToString(), null)
                                @Html.ConfirmAction(OperationType.Save, "btnSend", DbRes.TResource("User.Task.TaskAdd.Send"), "MoveTransactionsList", null, null, null, "OnMoveSuccess", null, DbRes.TResource("User.Move.Done"), "post", "frmMoveToDone", "BasicInformation", "btn-site", "checkIfHasReason", UserClaims.Inbound.CreateInbound, "NotValid")
                            </div>
                        }
                    </div>
                </div>
