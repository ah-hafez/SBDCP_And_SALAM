</div>

<script>
    function show() {
    }
    function dvReplace(id) {
        if (id == "moveToDone") {
            $('#dv_directAssignment').hide();
            $('#dv_moveToDone').show();
            $('.Assignment a').removeClass("active");
        }
        else{
            $('#dv_moveToDone').hide();
            $('#dv_directAssignment').show();
            $('.Assignment a').addClass("active");
            $('.move a').removeClass("active");
        }
    }
    function checkIfHasReason() {
        if ($('#ddlSaveReason').val().trim() == '') {

            $("#ddlSaveReason").addClass("RedBorder");
            $("#CalMessageRes").removeClass("hidden_");
            $("#CalMessageRes").show();
            $("#CalMessage").html('@Html.Raw(DbRes.TResource("Tray.Done.Reason"))');
            return false;
        }
        else {
            $("#ddlSaveReason").removeClass("RedBorder");
            $("#CalMessage").html('');
            $("#CalMessageRes").addClass("hidden_");
            return true;
        }
    }

    $(document).ready(function () {
        dvReplace();
        var selectedTrans = $('#transIds').val().split(",");
        $('.row-inactiveBoxes input:checkbox').change(function () {
            var id = $(this).data('id') + "";
            if ($(this).is(":checked")) {
                $('#div_' + id).attr('class', 'col-xs-12 active-box');
                selectedTrans.push(id);
            } else {
                $('#div_' + id).attr('class', 'col-xs-12');
                index = selectedTrans.indexOf(id);
                if (index > -1) {
                    selectedTrans.splice(index, 1);
                }
            }
            var finalData = selectedTrans.join(",");
            $('#transIds').val(finalData);
        });
        $('#dv_moveToDone').hide();

        if ('@ViewData["TabId"]' == '@((int)TrayType.SentTransactions)') {
            dvReplace('moveToDone');
            $('.move a').addClass("active");
        }
        switch (@ViewData["TabId"]) {
            case @((int)TrayType.Manager):
                $("#selected5").addClass("active");
                $("#selected").removeClass("active");
                break;
            case @((int)TrayType.DraftOutbound):
                $("#selected2").addClass("active");
                $("#selected").removeClass("active");
                break;
             case @((int)TrayType.OutboundExternal):
                $("#selected2").addClass("active");
                $("#selected").removeClass("active");
                $(".move").hide();
                break;
        }
    });

    function OnMoveSuccess(data)
    {
        if (data.MessageType != 2)
        {
              window.location.href = '@Url.Action(((TrayType)Convert.ToInt32(ViewData["type"])).ToString(), "File")';
        }
        else
        {
            ShowErrorMessage(data.MessageText);
        }

    }

</script>
<style>
    .RedBorder {
        border: 1px solid #fe0000 !important
    }

    .description {
        text-align: center;
    }
</style>