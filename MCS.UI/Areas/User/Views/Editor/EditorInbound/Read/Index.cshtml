<script>
    $(document).ready(function () {
        debugger;
        AppendArchives();
    });


    function ViewedTransaction()
    {

        var trayid = parseInt($("#hdnTrayId").val());
        var page = $("#hdnCurrentPage").val();
        var orderBy = $("#hdnOrderBy").val();
        var dir = $("#hdnDirection").val();
        var filter = $("#hdnFilter").val();
        var fromDate = $("#hdnFromDateValue").val();
        var toDate = $("#hdnToDateValue").val();
        var number = $("#hdnSearchTransactionNumberValue").val();
        var viewType = $("#hdnViewFile").val();
        var dateType = $("#hdnFilterDateType").val();
        var transactionId = $(_this).data("id");
        var transactionTypeId = $(_this).data("tray");
        var trayActionType = $(_this).data("type");
        var PageSize = $("#ddlPaging").val();
          var url2 = '@Url.Action("MoveTransaction","File")';
        var copyType = 0;

        if (transactionTypeId == @(TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName))|| transactionTypeId == @(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))) {
            copyType = @((int)TrayType.Copies);
        }
        else if ((transactionTypeId == @(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)) || transactionTypeId == @(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)))) {
            copyType = @((int)TrayType.CopiesOutbound);
        }

        var data = {
            trayId: trayid, page: page, gridColumn: orderBy, dir: dir, filter: filter, fromDate: fromDate,
            toDate: toDate, searchColumn: number, viewType: viewType, transactionId: transactionId, trayActionType: trayActionType,
            dateType: dateType, pageSize: PageSize
        };
        $.ajax({
            url: url2,
            type: 'post',
            data: data,
            success: function (data) {
                if (data.MessageType != 2) {
                    UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
                    window.location.href = '@Url.Action("Copies", "File")';
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }

            },
            error: function (a) {

                alert(a)
            }
        });

    }


    $(".aMarkSeen").unbind('click').click(function (e) {
        e.preventDefault();
        _this = this;
        ShowConfirmMessage('@(DbRes.TResource("User.File.View"))', "ViewedTransaction");
    });



    $("div.anchor a").click(function () {
        $("div.anchor a").removeClass("active");
        $("div.anchor a").addClass("disabled");
        $(this).addClass("active");
        var id = $(this).data("id");
        $("#" + id).addClass("active");
        $(".tabscontent").addClass("hidden_");

        var divId = $(this).data("divid");
        $("#" + divId).removeClass("hidden_");
    });

    function OnSuccess(data) {
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
        }
    }

     function GetAllReporter() {
        $.ajax({
            cache: false,
            type: 'get',
            url: '@Url.Action("GetReporters")',
            success: function (data) {
                AutoCompleteChangeList("ddlBasicReporter", data);
                AutoCompleteChangeList("ddlBasicReporterAssinment", data);
                AutoCompleteChangeList("ddlAssignmentPaperReporter", data);
                AutoCompleteChangeList("ddlRejectBasicReporter", data);
                var newItems = $.parseJSON(data);
                var lastItem = newItems.slice(-1)[0].value;
                $('#hdnBasicReporter').val(lastItem);
                $('#hdnBasicReporter').trigger('change')
            }
        });
        }



</script>
