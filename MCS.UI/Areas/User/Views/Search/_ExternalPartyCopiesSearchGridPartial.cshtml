@using MCS.Framework.Localization
@*@using MCS.Framework.Controls.Mvc*@
@using MCS.UI.Areas.User.Models.Search
@*@model IList<ManifestNumberSearchResultVM>*@
@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<SearchCriteriaByExternalPartyCopiesResultVM>

<div style="margin-bottom:50px;">

    @Html.Grid(Model, "_CardGrid").Named("ExternalPartyCopies").CollectionName("ExternalPartyCopiesSearchResult").Columns(columns =>
    {
        columns.Add(true).Titled("").RenderValueAs(mvcgridcolumn => Html.Partial("ListItems/_ExternalPartyCopiesItem", mvcgridcolumn))
        .Sanitized(false).Encoded(false);
    }).WithPaging(UIHelper.PageSize)
</div>



<script>
      var myManifestNumberSearchGridEventHandler = "@Url.Action("SearchPaging", "Search")";
    function prepareManifestNumberSearchGrid() {
        pageGrids.ManifestNumberSearch = undefined;
        var filterData = $("#frmSearch").serializeArray();

        if (!pageGrids.ManifestNumberSearch) {
            $("div[data-gridname='ExternalPartyCopies']").gridmvc();
        }
        if (!pageGrids.ManifestNumberSearch) {
            $(".grid-mvc").gridmvc();
        }
        pageGrids.ManifestNumberSearch.ajaxify({ getPagedData: myManifestNumberSearchGridEventHandler, requestType: "POST", getData: myManifestNumberSearchGridEventHandler, optionalData: filterData });

    }






    $(document).ready(function () {
        prepareManifestNumberSearchGrid();
        goCardsView();
        sessionStorage.setItem('CurrentTypeView', 'Card');
    });





    function ShowPrintDialog(id) {
        var params = { transactionId: id };
        ShowDialogAjaxPrintingBarcodes('@Url.Action("PrinttingBarcodes","Shared")' + "?" + $.param(params), {}, 'OpenPrintDialogSuccess', 'dialogbox col-md-12 ');
        event.stopPropagation();
    }
    function OpenPrintDialogSuccess(data, $obj) {
        if (data.MessageType != 2) {
            $obj.setContent(data.Html);
        }
        else {
            __dialog.close();
            ShowErrorMessage(data.MessageText);
        }
    }

    function ShowVisitTickect(id) {
        var actionUrl = '@Url.Action("PrintTicket", "Shared")' + "?transactionId=" + id;

        PrintButton(actionUrl);

    }




</script>