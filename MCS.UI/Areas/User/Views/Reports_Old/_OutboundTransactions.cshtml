<script type="text/javascript" src="Scripts/ReportFunctions.js"></script>
<script type="text/javascript">
    function __IsDestinationTransFilled(source, arguments) {
        code = document.getElementById('<%= UcCabinetsMenu.ClientID %>_wstxtCode');
        desc = document.getElementById('<%= UcCabinetsMenu.ClientID %>_wstxtName');
        if ((code.value != '') && (desc.value != '')) {
            arguments.IsValid = true;
        }
        else {
            arguments.IsValid = false;
        }
    }
</script>
<script type="text/javascript">
    function UcEntitiesMenu_Initialize(nTabID, nUserDivisionID, strUserDivisionDesc, nDivisionTabID) {
        var obj_UcInboundTransactions_UcEntitiesMenu_Class = new ucMenuCallerClass('<%=UcEntitiesMenu.ClientID %>', '');
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_ucMenuDialog_hdnFilterByCabinetID").value = nTabID;
        ucMenuCaller_GetObject(obj_UcInboundTransactions_UcEntitiesMenu_Class.Name).SetFilterByEntity(nTabID);
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtCode").value = nUserDivisionID;
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtName").value = strUserDivisionDesc;

        // Set Focus to be changed immediately if the ucInboundDivision enabled
        if (!document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtCode").disabled)
            document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtCode").focus();

        // Set m_tabID
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_hhidTabID").value = nDivisionTabID;
    }

    function UcCabinetsMenu_OnChange(nTabID) {
        ucMenuCaller_GetObject("<%=UcEntitiesMenu.ClientID %>").SetFilterByEntity(nTabID);
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_ucMenuDialog_hdnFilterByCabinetID").value = nTabID;
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtCode").value = "";
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtName").value = "";
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_hhidTabID").value = "";
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_ucMenuDialog_hdnSelectID").value = "";
        if (!document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtCode").disabled)
            document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtCode").focus();
    }

    function UcCabinetsMenu_OnChangeWithNoPrivilege(nTabID) {
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtCode").value = "";
        document.getElementById("<%=UcEntitiesMenu.ClientID %>_wstxtName").value = "";
    }
</script>


