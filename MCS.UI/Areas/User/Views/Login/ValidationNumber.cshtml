@model MCS.UI.Areas.User.Models.SMSNotificationsModel

@{
    ViewBag.Title = DbRes.TResource("User.Login.ValidationNumber");
}



@using (Html.BeginForm("ValidationNumber", "Login", FormMethod.Post, new { id = "frmValidationNumber" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="login-form" style="max-width: 350px; margin: 30px auto;">
        <div class="d-flex justify-content-center pb-4">
            <div class="">
                <img src="~/Content/User/lib/images/logo.png">
            </div>
        </div>
        <div class="clearfix"></div>
        @if (!string.IsNullOrEmpty(SessionInfo.CurrentUser.PhoneNumber))
        {
            <h3 class="text-center pb-3" style="font-size: 25px;">@DbRes.TResource("User.Login.ValidationNumber")</h3>
            <div class="form-group">
                @Html.TextBoxFor(model => model.ValidationNumber, new { placeholder = DbRes.TResource("User.Login.ValidationNumber"), @class = "form-control valid ", autofocus = "autofocus", autocomplete = "off" })
                @Html.ValidationMessageFor(m => m.ValidationNumber, "", new { @class = "text-danger" })
                @Html.Label("", ViewData["OTP"].ToString())
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-st1 btn-block">دخول</button>
                <button type="button" id="btnResend" class="btn btn-st1 btn-block" data-interval="30" disabled>اعادة ارسال</button>
            </div>
            <div class="text-center">
                تم ارسال رمز التحقق الى هاتفك المنتهي بـ
                @(SessionInfo.CurrentUser.PhoneNumber.Substring(SessionInfo.CurrentUser.PhoneNumber.Length - 4))
            </div>
        }
        else
        {
            <h3 class="text-center pb-3" style="font-size: 25px;">لا يوجد لديك رقم هاتف مسجل</h3>
            <br />
            <a href="@Url.Action("Logout", "Login")">تسجيل خروج</a>
        }
    </div>
    <div style="clear: both;"></div>
}
<script>
    function OnNotValidation(result) {
        ShowErrorMessage(data.MessageText);
    }

    $(document).ready(function () {
        $('#btnResend').click(function () {
            window.location.reload();
        });

        startCountDown();
    });

    function startCountDown() {
        contDown = $('#btnResend').data('interval');
        if (contDown == 0) {
            $('#btnResend').removeAttr('disabled');
            $('#btnResend').text('اعادة ارسال');
        } else {
            $('#btnResend').data('interval', contDown - 1);
            $('#btnResend').text('اعادة ارسال (' + contDown + ')')
            setTimeout(function () {
                startCountDown();
            }, 1000);
        }
    }
</script>
