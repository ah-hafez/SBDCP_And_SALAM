<script>

    $(document).on("click", "span[data-node-id]", function () {
        var elemnt = $(this);
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsNodes")',
                data: { parentId: $(this).data("node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
                    function (data) {

                        $(elemnt).closest('li').children('ul').last().empty()

                        $(elemnt).closest('li').children('ul').last().append(data);

                        $(elemnt).removeClass("InternalLoadedData");
                    }
            });
        }
    });
    $(document).ready(function () {
        GetDirectedToUsersByOrgUnitId();
    });
    function OnAddUserPereferenceSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#dvGrid" + div).html("");
            $("#dvGrid" + div).html(data.EmptyHTML);
            $("#dvCurrentGrid").html("");
            $("#dvCurrentGrid").html(data.Html);
            window.location.href = '@Url.Action("UserDelegations", "UserPreferences")';
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function OnDeleteDelegationSuccess(data, div) {
         
        if (data.MessageType != 2) {
            ShowSuccesMessage(data.MessageText);
            $("#hdnCurrentUsersArray").val(data.hdnValue);
            $("#hdnAddCurrentUsersArray").val(data.hdnValue);
            $("#hdnEditCurrentUsersArray").val(data.hdnValue);

            $("#dvEditDelegation").hide();
            $("#dvAddUserDelegation").show();
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    var currentDelegateId = -1;
    function ManagerRejectDelegation(delegateId) {
        currentDelegateId = delegateId;
        ShowRejectTransactionPopup('@DbRes.TResource("User.UserDelegation.DelegationReject")', '', '@DbRes.TResource("User.UserDelegation.DelegationRejectReason")','', '@DbRes.TResource("User.UserDelegation.Reject")');
    }

    function ManagerApproveDelegation(delegateId) {
        currentDelegateId = delegateId;
        var token = $("#frmUserDelegation").find("input[name='__RequestVerificationToken']").val();
        var data = { delegateId: currentDelegateId, statusType: 1, rejectionReason: "---", __RequestVerificationToken: token };
        $.ajax({
            url: '@Url.Action("UpdateUserDelegationStatus", "UserPreferences")',
            type: 'POST',
            cache: false,
            //contentType: "application/json",
            data: data,
            success: function (data) {
                if (data.MessageType == 2) {
                    ShowErrorMessage(data.MessageText);
                    return;
                }
                window.location.reload();
            },
            error: function (a, b, c, d) {
                ShowErrorMessage('حدث خطأ');
            }
        });
    }

    $(document).on("RejectButtonPopupClicked", function (event, param) {
        if ($('#rejectionReason').val().trim() == '') {
            $('#errorMessageValidate').html("* أدخل سبب الرفض");
        } else {
            var token = $("#frmUserDelegation").find("input[name='__RequestVerificationToken']").val();
            var data = { delegateId: currentDelegateId, statusType: 2, rejectionReason: $('#rejectionReason').val(), __RequestVerificationToken: token };
            $.ajax({
                url: '@Url.Action("UpdateUserDelegationStatus", "UserPreferences")',
                type: 'POST',
                cache: false,
                //contentType: "application/json",
                data: data,
                success: function (data) {
                    if (data.MessageType == 2) {
                        ShowErrorMessage(data.MessageText);
                        return;
                    }
                    window.location.reload();
                },
                error: function (a,b,c,d) {
                    ShowErrorMessage('حدث خطأ');
                }
            });
        }

    });

    function DisplayRejectReason(rejectReason) {
        if (rejectReason != undefined && rejectReason != "") {
            ShowInformationMessage(rejectReason);
        }
    }

    var currentDisableDelegateId = -1;
    function DisableDelegation(delegateId) {
        ShowConfirmMessage("@DbRes.TResource("User.UserDelegation.ConfirmDisable")", "ConfirmDisableDelegation");
        currentDisableDelegateId = delegateId;
    }

    function ConfirmDisableDelegation() {
         
         
        var token = $("#frmUserDelegation").find("input[name='__RequestVerificationToken']").val();
        var data = { delegateId: currentDisableDelegateId, statusType: 3, rejectionReason: '---', __RequestVerificationToken: token };
        $.ajax({
            url: '@Url.Action("ClientDeleteDelegation", "UserPreferences")',
            type: 'POST',
            cache: false,
            //contentType: "application/json",
            data: data,
            success: function (data) {
                if (data.MessageType == 2) {
                    ShowErrorMessage(data.MessageText);
                    return;
                }
                window.location.reload();
            },
            error: function (a, b, c, d) {
                ShowErrorMessage('حدث خطأ');
            }
        });
    }

</script>
<script>
    $(".input-group-text.hyperlink ").click(function () {
        $(this).parent().parent().find('.is-calendarsPicker').focus()
    });

</script>