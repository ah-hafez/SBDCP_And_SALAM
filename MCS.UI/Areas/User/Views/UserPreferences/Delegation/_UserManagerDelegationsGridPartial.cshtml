@using MCS.UI.Areas.User.Models.UserPreferences.UserDelegation;
@model AjaxGrid<UserDelegationVM>

@{
    Layout = null;
}

@Html.Grid(Model).CollectionName("ManagerDelegationListGrid").Named("grdManagerDelegations").Columns(columns =>
{
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Id, new { id = "Id_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Key, new { id = "Key_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.FromDate, new { id = "FromDate_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.ToDate, new { id = "ToDate_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.FromDateH, new { id = "FromDateH_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.ToDateH, new { id = "ToDateH_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.OrgUnitId, new { id = "OrgUnitId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.OrgUnit, new { id = "OrgUnit_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.DirectedToId, new { id = "DirectedToId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.DirectedTo, new { id = "DirectedTo_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Status, new { id = "Status_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.StatusId, new { id = "StatusId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(model => model.DirectedTo).Titled(DbRes.TResource("User.UserDelegation.EmployeeName"));
columns.Add(model => model.OrgUnit).Titled(DbRes.TResource("User.UserDelegation.Unit"));
columns.Add(model => model.Status).Titled(DbRes.TResource("User.UserDelegation.Status"));
columns.Add(model => model.FromDateH).Titled(DbRes.TResource("User.UserDelegation.FromDate"));
columns.Add(model => model.ToDateH).Titled(DbRes.TResource("User.UserDelegation.ToDate"));
//columns.Add(model => model.FromDateH).Encoded(false).Sanitized(false).Titled(DbRes.TResource("User.UserDelegation.FromTo")).RenderValueAs(m => @<label> @m.FromDateH - @m.ToDateH</label>);
    columns.Add().Encoded(false).Sanitized(false).Css("fixed_col text-right site-danger action-icon").RenderValueAs(model => @Html.ClientLinkTag("", cssClass: "edit_link", title: DbRes.TResource("User.UserDelegation.Approve"), clientFunctionToCall: "ManagerApproveDelegation(" + model.Id + ")", innerHtml: "<i class='fa fa-check'></i>"));
    columns.Add().Encoded(false).Sanitized(false).Css("fixed_col text-right site-danger action-icon").RenderValueAs(model => @Html.ClientLinkTag("", cssClass: "edit_link", title: DbRes.TResource("User.UserDelegation.Reject"), clientFunctionToCall: "ManagerRejectDelegation(" + model.Id + ")", innerHtml: "<i class='fa fa-times-circle color-danger'></i>"));

}).WithPaging(GridHelper.PageSize)

<script>
    $(document).ready(function () {
        userManagerDelegation();
    })
    function userManagerDelegation() {
        $(".grid-mvc").gridmvc();
        pageGrids.grdManagerDelegations.ajaxify(
            {
                getPagedData: '@Html.Raw(Url.Action("UpdateGridDelegationsManager", "UserPreferences"))',
                getData: '@Html.Raw(Url.Action("UpdateGridDelegationsManager", "UserPreferences"))',
                requestType: "POST"
            });
    }
</script>
