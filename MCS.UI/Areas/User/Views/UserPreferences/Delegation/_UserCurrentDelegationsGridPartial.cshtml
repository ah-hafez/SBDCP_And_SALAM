<script>

    var DelegationId;
    function DeleteDelegation(delegateId, keyId) {
         
        if (delegateId == 0) {
            DeleteActionGrid('grdCurrentDelegations', keyId, "@DbRes.TResource("User.UserDelegation.ConfirmDisable")", 'dvAddDelegation', 'CancelDelegationEdit');
        }
        else {
            DelegationId = delegateId;
            ShowConfirmMessage("@DbRes.TResource("User.UserDelegation.ConfirmDisable")", "ConfirmDeleteDelegation");
        }
    }

    function ConfirmDeleteDelegation() {
        
        var token = $("#frmUserDelegation").find("input[name='__RequestVerificationToken']").val();
        var data = { delegateId: DelegationId, __RequestVerificationToken: token};
        $.ajax({
            url: '@Url.Action("DeleteDelegationById", "UserPreferences")',
            type: 'POST',
            cache: false,
            //contentType: "application/json",
            data: data,
            success: function (data) {
                if (data.MessageType == 2) {
                    ShowErrorMessage(data.MessageText);
                    return;
                }
                window.location.reload();
            },
            error: function (a, b, c, d) {
                ShowErrorMessage('حدث خطأ');
            }
        });
    }
    @*$(document).ready(function () {
        userDelegation();
    })
    function userDelegation() {
        $(".grid-mvc").gridmvc();
        pageGrids.grdCurrentDelegations.ajaxify(
            {
                getPagedData: '@Html.Raw(Url.Action("UpdateGridDelegations", "UserPreferences"))',
                getData: '@Html.Raw(Url.Action("UpdateGridDelegations", "UserPreferences"))',
                requestType: "POST"
            });
    }*@
</script>
