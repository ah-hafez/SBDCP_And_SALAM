@using MCS.UI.Areas.User.Models
@using MCS.UI.Areas.User.Models.UserPreferences
@using MCS.Framework.Localization
@using MCS.Common
@model UserPreferenceVM

@{
    /**/

    ViewBag.Title = DbRes.TResource("User.UserPreferences.UserPreferences");
    Layout = "~/Areas/User/Views/Shared/_SearchLayout.cshtml";
}
<script src="~/Scripts/jSignature/jSignature.js"></script>
<script src="~/Scripts/jSignature/plugins/jSignature.UndoButton.js"></script>

<div class="d-flex flex-column flex-sm-row mx-5 mx-xs-3 mb-3 header-container mt-5">
    <h3 class="site-color">@DbRes.TResource("User.UserPreferences.UserPreferences")</h3>
</div>
<div class="white-container mx-5 mx-xs-3">
    <div class="tab-content">
        <div class=" white-bg">
            <div class="form-row">

                @using (Html.BeginForm("AddUserPreferences", "UserPreferences", FormMethod.Post, new { id = "formAddUserPreferences", @class = "tab-content" }))
                {
                    @Html.AntiForgeryToken()
                    if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Language))
                    {
                        <div class="form-group col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                            <label class="w-100">@DbRes.TResource("User.UserPreferences.Language")<span class="stark">*</span></label>
                            @Html.AutoCompleteBuilder("ddlLanguage", "hdnLanguageId", ViewData["Cultures"] as string, Model != null ? Model.LanguageId.ToString() : null, true, "form-control")
                        </div>
                    }
                    @Html.HiddenGroupFor(model => model.LanguageId, new { id = "hdnLanguageId" }, "AddUserPereference")



                    <div class="form-group col-lg-9 col-md-12 col-xs-12 col-sm-12">
                        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Theme))
                        {
                            <div class="form-group col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                                <label class="w-100">@DbRes.TResource("User.UserPreferences.Theme")</label>
                                @Html.AutoCompleteBuilder("ddlThemes", "hdnThemeId", ViewData["Theme"] as string, Model != null ? Model.Theme.ToString() : null, true, "form-control")
                            </div>
                        }

                        <div class="form-group col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                            <label class="w-100"> @DbRes.TResource("Admin.User.Email")</label>
                            <div>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                            </div>
                        </div>

                    </div>
                    @Html.HiddenGroupFor(model => model.Theme, new { id = "hdnThemeId" }, "AddUserPereference")


                    <div class="form-group col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3 hide" style="text-align:center">
                        <label class="w-100">رسالة تأكيد عند الدخول</label>
                        <div class="checkbox">
                            @Html.CheckBoxFor(m => m.SMSNotifications, new { @class = "form-check-input" })
                            <label class="dark-color p-0">
                                @DbRes.TResource("User.UserPreferences.Yes")
                            </label>
                        </div>
                    </div>
                    if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Signature))
                    {
                        if (Model.HasSignaturePasswordText == false)
                        {
                            <div class="form-group col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                                <label class="w-100">@DbRes.TResource("UserPreferences.PasswordToSign")</label>
                                <div class="checkbox">
                                    <label>
                                        <input id="chPasswordToSign" type="checkbox" onclick="onPasswordToSignChange(this)">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                    <label class="dark-color p-0">
                                        @DbRes.TResource("User.UserPreferences.Yes")
                                    </label>
                                </div>
                            </div>
                            <div id="SignaturePasswordContent" style="display:none;">
                                <div class="form-group col-xs-6 mb-3">
                                    <div class="row form-group col-xs-6 mb-3">
                                        <label class="w-100">@DbRes.TResource("UserPreferences.NewPassword")</label>
                                        @Html.PasswordGroupFor(model => model.NewPassword, "AddUserPereference", new { @class = "form-control" })
                                    </div>
                                    <div class="form-group col-xs-6 mb-3">
                                        <label class="w-100">@DbRes.TResource("UserPreferences.ConfirmPassword")</label>
                                        @Html.PasswordGroupFor(model => model.ConfirmPassword, "AddUserPereference", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="">
                                <div class="form-group col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3" style="text-align:center">
                                    <label class="w-100">@DbRes.TResource("UserPreferences.PasswordProtection")</label>
                                    <div class="checkbox">
                                        <label>
                                            <input id="chPasswordProtection" type="checkbox" onclick="onPasswordProtectionChange(this)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                        <label class="dark-color p-0">
                                            @DbRes.TResource("User.UserPreferences.Yes")
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group panel-body col-xs-6 mb-3">
                                <div>
                                    @Html.ClientButton(DbRes.TResource("UserPreferences.ChangeSignaturePassword"), "btnChangePassword", " btn btn-st1", "onChangePassword")
                                </div>

                            </div>
                        }




                    }

