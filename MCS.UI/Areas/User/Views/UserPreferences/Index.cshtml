    function capturedSig(sImageData) {
        switch (wacomSigType) {
            case "Signature":
                $('#hdnSignatureImgBase64').val(' data:image/png;base64,' + sImageData);
                break;
            case "SignatureCommand":
                $('#hdnSignatureCommandImgBase64').val(' data:image/png;base64,' + sImageData);
                break;
            case "SignatureBehalf":
                $('#hdnSignatureBehalfImgBase64').val(' data:image/png;base64,' + sImageData);
                break;
            case "Marking":
                $('#hdnMarkingImgBase64').val(' data:image/png;base64,' + sImageData);
                break;
            case "MessageSignature":
                $('#hdnMessageSignatureImgBase64').val(' data:image/png;base64,' + sImageData);
                break;
        }
    }
