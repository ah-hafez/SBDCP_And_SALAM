        var datamarking = $("#marking").jSignature('getData', "default");

        var dataSignatureCommand = $("#signatureCommand").jSignature('getData', "default");
        var dataSignatureBehalf = $("#signatureBehalf").jSignature('getData', "default");

        if ($("input[name='Signature']:checked").val() == "SignOnScreen") {
            $("#hdnSignatureImgBase64").val(dataSignature);
        }

        if ($(".rbSignatureCommand:checked").val() == "SignOnScreen") {
            $("#hdnSignatureCommandImgBase64").val(dataSignatureCommand);
        }

        if ($(".rbSignatureBehalf:checked").val() == "SignOnScreen") {
            $("#hdnSignatureBehalfImgBase64").val(dataSignatureBehalf);
        }

        if ($(".rbMarking:checked").val() == "SignOnScreen") {
            $("#hdnMarkingImgBase64").val(datamarking);
        }
        if ($(".rbMessageSignature:checked").val() == "SignOnScreen") {
            $("#hdnMessageSignatureImgBase64").val(datamessageSignature);
        }

        return true;
    }


    function GetUsersByOrgUnitId() {

        if ($("#divForm__dvDepartmentsTree").find(".hdnDepartmentId").val() != '') {
            $("#hdnOrgUnitUsers").val('');
            $("#ddlOrgUnitUsers").val('');
            //$("#hdnOrgUnitUserName").val('');
            //$('#hdnOrgUnitName').val($('#dvBeneficiaryBody .txtDepartmentName').val());
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetUnitUsers", "Editor")',
                data: { id: $("#FollowUpOrgId").val() },
                success:
               function (data) {
                   AutoCompleteChangeList("ddlOrgUnitUsers", data);
                   $("#ddlOrgUnitUsers").trigger('change');
                   $("#hdnOrgUnitUsers").trigger('change');
                   $("#ddlOrgUnitUsers").prop('disabled', false);
               }
            });
            return false;
        }
        else {

            AutoCompleteChangeList("ddlOrgUnitUsers", "[]");
            $("#hdnOrgUnitUsers").val('');
            $("#ddlOrgUnitUsers").trigger('change');
            $("#hdnOrgUnitUsers").trigger('change');
            $("#ddlOrgUnitUsers").prop('disabled', true);
        }
    }



    $(document).ready(function () {
        $('#ddlOrgUnitUsers').focus();
        if ('@Model.FollowUpUserId' != '') {
            SetData(@Model.FollowUpUserId)
        }
    });

    function SetData(keyValue) {
        GetUsersByOrgUnitId();
        $("#hdnOrgUnitUsers").val(keyValue);
    }

