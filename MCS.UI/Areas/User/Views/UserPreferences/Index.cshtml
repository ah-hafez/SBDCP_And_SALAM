                                    <label class="form-group col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                                        @Html.CheckBoxFor(model => Model.NotificationSubscriptions[i].IsSelected, new { @class = "require-one" })
                                        @Html.StickyHiddenFor(model => Model.NotificationSubscriptions[i].Id)
                                        @Html.LabelFor(model => model.NotificationSubscriptions[i].Name, Model.NotificationSubscriptions[i].Name, null)
                                    </label>
                                }

                            }
                        </div>
                    </div>

