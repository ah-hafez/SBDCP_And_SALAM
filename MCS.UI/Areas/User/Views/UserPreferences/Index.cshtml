    function validateFileType() {
        var arrayType = ['jpg', 'jpeg', 'png'];
        var fileName = $("#MarkingFile").val();
        if (fileName != undefined) {
            var idxDot = fileName.lastIndexOf(".") + 1;
            var extFile = fileName.substr(idxDot, fileName.length).toLowerCase();
            if (extFile != "" && $.inArray(extFile, arrayType) == -1) {
                ShowErrorMessage("@DbRes.TValidation("User.Setting.ValidateFileType")");
                return false
            }
            else
                return true;
        }
        return true;
    }

