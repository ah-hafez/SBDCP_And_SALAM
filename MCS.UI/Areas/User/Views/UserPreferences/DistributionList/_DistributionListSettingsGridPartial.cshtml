@using MCS.Framework.Localization
@using MCS.Common;
@using MCS.UI.Areas.User.Models.UserPreferences
@model AjaxGrid<DistributionListVM>


@{
    Layout = null;
}

@{string controller = "UserPreferences";}


@Html.Grid(Model).CollectionName("DistributionListGrid").Named("grdDistributionList").Columns(columns =>
{
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Key, new { id = "Key_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Id, new { id = "gridId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.OrgUnitId, new { id = "gridOrgUnitId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.UserId, new { id = "gridUserId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.OrgUnitName, new { id = "gridOrgUnitName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.UserName, new { id = "gridUserName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);

    columns.Add(model => model.Name.Where(s => s.CultureName == SessionInfo.CultureShortName).FirstOrDefault().Text).Titled(DbRes.TResource("User.UserPreferences.DistributionListName"));

    columns.Add().Titled("تعديل").Encoded(false).Sanitized(false).Css("fixed_col text-right site-danger action-icon").RenderValueAs(model => @Html.ClientLinkTag("", cssClass: "edit_link", title: DbRes.TResource("Grid.Edit"), clientFunctionToCall: "GetDistributionListById(" + model.Id + ")", permissionCode: UserClaims.UserPreferences.DistributionList, innerHtml: "<i class='fa fa-edit'></i>"));
    columns.Add().Titled("حذف").Encoded(false).Sanitized(false).Css("fixed_col text-right site-danger action-icon").RenderValueAs(model => @Html.ClientLinkTag("", cssClass: "edit_link", permissionCode: UserClaims.UserPreferences.DistributionList, clientFunctionToCall: "DeleteDistributionList(" + model.Id + ")", innerHtml: "<i class='glyphicon glyphicon-trash color-danger'></i>"));

})
