@{
    ViewBag.Title = "الملف الشخصي";
    Layout = "~/Areas/User/Views/Shared/_Layout.cshtml";
}
<div class="page-title">
    <h2><span class="fa fa-arrow-circle-o-left"></span> الملف الشخصي</h2>
</div>
<div class="page-content-wrap">

    <div class="row">
        <div class="col-md-3 col-sm-4 col-xs-5">
            <form action="#" class="form-horizontal form-row">
                <div class="panel panel-default panel-white">
                    <div class="panel-body">
                        <h3><span class="fa fa-user"></span> محمد تركي</h3>
                        <p>مصمم جرافيك ومواقع الكترونية</p>
                        <div class="text-center" id="user_image">
                            <img src="~/Content/User/lib/assets/images/users/no-image.png" class="img-thumbnail" />
                        </div>
                    </div>
                    <div class="panel-body form-group-separated">

                        <div class="form-group">
                            <div class="col-md-12 col-xs-12">
                                <a style="pointer-events: none;cursor: default;" class="change_your_picture btn btn-primary btn-block btn-rounded">تغيير صورتك</a>
                             
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 col-xs-5 control-label">#ID</label>
                            <div class="col-md-9 col-xs-7">
                                <input type="text" value="5221" class="form-control" disabled />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 col-xs-5 control-label">إسم الدخول</label>
                            <div class="col-md-9 col-xs-7">
                                <input type="text" value="johndoe" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 col-xs-5 control-label">الايميل</label>
                            <div class="col-md-9 col-xs-7">
                                <input type="text" value="johndoe@domain.com" class="form-control" />
                            </div>
                        </div>

                        @*<div class="form-group">
                            <div class="col-md-12 col-xs-12">
                                <a class="change_your_password btn btn-danger btn-block btn-rounded">تغيير رمز الدخول</a>                              
                                <script type="text/javascript">

                                    $('.change_your_password').on('click', function () {

                                        ShowDialogAjax('@Url.Action("RenderChangePasswordPartial")', {}, 'OpenChangePasswordDialogSuccess');
                                    });

                                    function OpenChangePasswordDialogSuccess(data, $obj) {

                                        $obj.setContent(data.View);
                                        jQuery.validator.unobtrusive.parse('#frmChangePassword');
                                    }

                                </script>

                            </div>
                        </div>*@

                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-6 col-sm-8 col-xs-7">
            <form action="#" class="form-horizontal form-row">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <h3><span class="fa fa-pencil"></span> المعلومات الاساسية</h3>
                        <p>هذه هي المعلومات الاساسية لكل مستخدم لهذا النظام يرجى عدم تغيير المعلومات الا في حالة الضرورة</p>
                    </div>
                    <div class="panel-body form-group-separated">
                        <div class="form-group">
                            <label class="col-md-3 col-xs-5 control-label">الإسم بالعربي</label>
                            <div class="col-md-9 col-xs-7">
                                <input type="text" value="محمد تركي" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 col-xs-5 control-label">الإسم بالانجليزي</label>
                            <div class="col-md-9 col-xs-7">
                                <input type="text" value="Mohammad Turki" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 col-xs-5 control-label">مسمى العمل</label>
                            <div class="col-md-9 col-xs-7">
                                <input type="text" value="مصمم جرافيك ومواقع الكترونية" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 col-xs-5 control-label">لمحة</label>
                            <div class="col-md-9 col-xs-7">
                                <textarea class="form-control" rows="5">شوية حكي عن الشخص صاحب الملف</textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12 col-xs-5">
                                <button class="btn btn-primary btn-rounded pull-left">حفظ</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-3">
            <div class="panel panel-default form-horizontal form-row">
                <div class="panel-body">
                    <h3><span class="fa fa-info-circle"></span> معلومات سريعة</h3>
                    <p>بعض المعلومات سريعة حول المستخدم</p>
                </div>
                <div class="panel-body form-group-separated">
                    <div class="form-group">
                        <label class="col-md-5 col-xs-5 control-label">آخر دخول</label>
                        <div class="col-md-7 col-xs-7 line-height-30">12:46 27.11.2015</div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-5 col-xs-5 control-label">تم التسجيل</label>
                        <div class="col-md-7 col-xs-7 line-height-30">01:15 21.11.2015</div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-5 col-xs-5 control-label">فئة الموظف</label>
                        <div class="col-md-7 col-xs-7">مدير قسم</div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-5 col-xs-5 control-label">تاريخ ميلاده</label>
                        <div class="col-md-7 col-xs-7 line-height-30">14.02.1989</div>
                    </div>
                </div>

            </div>

            <div class="panel panel-default">
                <div class="panel-body">
                    <h3><span class="fa fa-cog"></span> إعدادات</h3>
                    <p>بعض الاعدادات المهمة</p>
                </div>
                <div class="panel-body form-horizontal form-row form-group-separated">
                    <div class="form-group">
                        <label class="col-md-6 col-xs-6 control-label">التنبيهات</label>
                        <div class="col-md-6 col-xs-6">
                            <label class="switch">
                                <input type="checkbox" checked value="1" />
                                <span></span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-6 col-xs-6 control-label">السلال</label>
                        <div class="col-md-6 col-xs-6">
                            <label class="switch">
                                <input type="checkbox" checked value="1" />
                                <span></span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-6 col-xs-6 control-label">المهام</label>
                        <div class="col-md-6 col-xs-6">
                            <label class="switch">
                                <input type="checkbox" value="0" />
                                <span></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>