@model AjaxGrid<MCS.UI.Areas.User.Models.Transaction.TransactionCopyVM>

@{
    var operationType = ViewData["IsEnableAction"] ?? true;
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
    ViewData.TemplateInfo.HtmlFieldPrefix = "TransactionCopy";
}

@Html.Grid(Model).CollectionName("Copies").Named("grdCopies").Columns(columns =>
{
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Id, new { id = "Id_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Key, new { id = "Key_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.OrgUnitId, new { id = "OrgUnitId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.OrgUnitName, new { id = "OrgUnitName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.UserId, new { id = "UserId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.UserName, new { id = "UserName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.ActionId, new { id = "ActionId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.IsBcc, new { id = "hdn_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
 columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.ActionName, new { id = "ActionName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.SendEmail, new { id = "SendEmail_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.SentDate, new { id = "SentDate_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.UserList, new { id = "UserList_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
columns.Add(model => model.OrgUnitName).Titled(DbRes.TResource("User.Transaction.Copies.OrgUnit"));
//columns.Add(model => model.UserName).Titled(DbRes.TResource("User.Transaction.Copies.User"));
//columns.Add(model => model.ActionName).Titled(DbRes.TResource("User.Transaction.Assignment.ActionId"));


columns.Add().Encoded(false).Sanitized(false).Titled(DbRes.TResource("User.Transaction.Copies.User"))
                .RenderValueAs(o => @<div class="row">
            <span class="col-md-3"></span>
            <span class="col-md-9">
                @if (o.Id <= 0)
                {
                    @Html.AutoCompleteBuilder("ddlCopyOrgUnitUsers_" + o.Key, "UserId_" + o.Key, o.UserList.ToString(), o.UserId.ToString(), true, "form-control _ddlCopyOrgUnitUsers")
                }
                else
                {
                    @Html.AutoCompleteBuilder("ddlCopyOrgUnitUsers_" + o.Key, "UserId_" + o.Key, o.UserList.ToString(), o.UserId.ToString(), true, "form-control disabled")
                }

            </span>
        </div>);


columns.Add().Encoded(false).Sanitized(false).Titled(DbRes.TResource("User.Transaction.Assignment.ActionId"))
.RenderValueAs(o => @<div class="row">
    <span class="col-md-3"></span>
    <span class="col-md-9">
        @if (o.Id <= 0)
        {
            @Html.AutoCompleteBuilder("ddlActionId" + o.Key, "ActionId_" + o.Key, ViewData["AllActionsData"].ToString(), o.ActionId.ToString(), true, "form-control ddlActionIdGrid", "hdnActionType_" + o.Key)
        }
        else
        {
            @Html.AutoCompleteBuilder("ddlActionId" + o.Key, "ActionId_" + o.Key, ViewData["AllActionsData"].ToString(), o.ActionId.ToString(), true, "form-control disabled", "hdnActionType_" + o.Key)
        }

    </span>
</div>);

columns.Add(model => LookupsHelper.GetLookupItem(model.Status, SessionInfo.CultureShortName).Result.Text).Titled(DbRes.TResource("User.Transaction.Copy.Status"));

if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.CopiesInternal.BCC))
{
columns.Add().Encoded(false).Sanitized(false).Titled(DbRes.TResource("User.Copies.BlindCarbonCopy"))
.RenderValueAs(o => @<div class="row">
    <span class="col-md-3"></span>
    <span class="col-md-9">
        @if (o.Id > 0)
        {
            <input type="checkbox" id="ch_@o.Key.ToString()" onchange="UpdateIsBCC(this)" checked="@o.IsBcc" disabled="disabled">
        }
        else
        {
            <input type="checkbox" id="ch_@o.Key.ToString()" onchange="UpdateIsBCC(this)" checked="@o.IsBcc">
        }

    </span>
</div>);
}
if ((bool)operationType)
{

columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").RenderValueAs(model => model.Id <= 0 ? @Html.ClientLinkTag("", cssClass: "edit_link", permissionCode: UserClaims.CopiesInternal.Delete, clientFunctionToCall: "DeleteActionGrid(" + "'grdCopies'," + model.Key + ",'" + DbRes.TResource("Grid.DeleteMassage") + "','','ResetActionCopies')", innerHtml: "<i class='glyphicon glyphicon-trash color-danger'></i>") : @Html.ClientLinkTag(""));
}
})

