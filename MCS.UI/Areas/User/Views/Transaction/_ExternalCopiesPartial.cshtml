                    $("#ddlExternalCopyOrgUnitUsers").prop('disabled', false);
                    //$("#dvFilesUploader").removeClass("hidden_");
                }
        });
        $("#TransactionExtCopy_Email").val($("#dvExternalCopyDepartmentsTree_txtDepartmentEmail").val());
        return false;
    }

    $('.toggleEmailField').change(function () {
        var emailTextField = $('.emailTextField');
        if (event.currentTarget.checked) {
            $('.emailTextField').removeAttr('disabled');
        } else {
            $('.emailTextField').attr('disabled', true);
        }
    });

</script>

