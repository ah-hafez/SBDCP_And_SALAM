    function ExternalCheckboxChange(orgSelected, id, number, name) {
        var orgListString = $("#ExternalOrgSelectedList").val();
        var initialValue = [];
        if (orgListString != "") {
            initialValue = orgListString.split(',');
        }

     
        if (orgSelected.checked) {
            initialValue.push(id);
            $("#rightdvExternalCopyDepartmentsTree").val(number);
            $("#leftdvExternalCopyDepartmentsTree").val(name);
            $("#hdnExternalCopyOrgUnitName").val(name);
            $("#TransactionExtCopy_OrgUnitId").val(id);


        } else {

            initialValue.splice($.inArray(id, initialValue), 1);
        }
        if (initialValue.length == 0) {

            $("#rightdvCopyDepartmentsTree").val("");
        }

        $("#ExternalOrgSelectedList").val(initialValue.toString());

    }

    function SaveAttachements() {
        var files = $('#dvUploadFiles').find($("input:file")).get(0).files;
        var isValid = false;

        if (files.length <= 0) {
            return;
        }

        if (window.FormData !== undefined) {
            var data = new FormData();
            var fileExist = false;
            for (i = 0; i < files.length; i++) {
                $('.uploaded-files').find('.attachment_name').each(function () {
                    if ($(this).html() == files[i].name) {
                        fileExist = true;
                    }
                });
                if (!fileExist) {
                    var idxDot = files[i].name.lastIndexOf(".") + 1;
                    var extFile = files[i].name.substr(idxDot, files[i].name.length).toLowerCase();
                    //var isValidType = extFile != "" && $.inArray(extFile, typeFileValid) == -1;
                    isValid = true;
                    //if (isValidType) {
                    //    isValid = false;
                    //    break;
                    //}
                    data.append("file" + i, files[i], files[i].name);
                    $('.uploaded-files').append('<div class="file newAdded"><i class="uicon icon_attachments"></i><span class="attachment_name">' + files[i].name + '</span><a href="javascript:removeAttachemntPhysically()" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>');
                }
            }
            $('.col-uploadeed-files').fadeIn(200);
            if (isValid) {
                data.append('ExternalCopyVM', $("#dvExternalCopiesBody :input").serializeArray());
                data.append('EntityId', $("#dvExternalCopyDepartmentsTree_hdnDepartmentId").val());
                var jqXHR = $.ajax({
                    type: "post",
                    url: '@Url.Action("UploadExternalCopyAttachments", controller)',
                    data: data,
                    contentType: false,
                    processData: false,
                    dataType: 'json',
                    async: false,
                }).done(function (data) {
                    if (data.MessageType != 2) {
                        if ($("#hdnAttachmentNames").val() == "" || $("#hdnAttachmentNames").val() == null) {
                            $("#hdnAttachmentNames").val("[]");
                        }
                        var namesList = JSON.parse($("#hdnAttachmentNames").val());
                        var addedItems = JSON.parse(data.AddedFilesJson);
                        for (var i = 0; i < addedItems.length; i++) {
                            namesList.push(addedItems[i]);
                        }
                        $("#hdnAttachmentNames").val(JSON.stringify(namesList));
                    } else {
                        ShowErrorMessage(data.MessageText);
                    }
                }).fail(function (jqXHR, textStatus) {
                    alert("error");
                });
            }
            else {
                ShowErrorMessage('@DbRes.TResource("Task.File.MimeType")');
            }
        } else {
            alert("Your browser doesn't support HTML5 multiple file uploads! Please use some decent browser.");
            return;
        }

        var count = $("#UploadedFilesName  .file").length;
        $('#hdnExternalCopyAttachment').val(count);
        $('#hdnExternalCopiesAttachmentsCount').val(count);

        return;
    }

