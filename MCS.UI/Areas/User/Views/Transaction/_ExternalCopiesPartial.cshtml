    function removeAttachemntPhysically(key, AttachmentId) {
        var token = $("#dvExternalCopiesBody").parents("form").find("input[name='__RequestVerificationToken']").val();
        if (DeletedAttach && DeletedAttach != "" && key != undefined && AttachmentId != undefined) {
            updateDeletedExAttachments(key, AttachmentId);
        } else if (DeletedAttach && DeletedAttach != "" && key == undefined && AttachmentId == undefined){
            $.ajax({
                type: 'post',
                url: '@Url.Action("RemoveAttachemntPhysically", controller)',
                data: { "attachmentsToDelete": DeletedAttach, entityId: $("#dvExternalCopyDepartmentsTree .hdnDepartmentId").val() ,__RequestVerificationToken: token },
                success: function (data) {
                    if (data.MessageType != 2) {
                        updateDeletedExAttachmentsByName(DeletedAttach.split(",")[0]);
                    } else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
            });
        }
    }
    function updateDeletedExAttachmentsByName(name) {
        var totalCount = 0;
        var attachmentsNames = JSON.parse($("#hdnAttachmentNames").val());
        totalCount = attachmentsNames.length;
        for (var i = 0; i < attachmentsNames.length; i++) {
            if (attachmentsNames[i].Name == name) {
                var index = attachmentsNames.indexOf(attachmentsNames[i]);
                if (index > -1) {
                    attachmentsNames.splice(index, 1);
                    totalCount -= 1;
                }
            }
        }
        $("#hdnExternalCopyAttachment").val(totalCount);
        $("#hdnExternalCopiesAttachmentsCount").val(totalCount);
        $("#hdnAttachmentNames").val(JSON.stringify(attachmentsNames));
    }

    function updateDeletedExAttachments(key, AttachmentId) {
        var totalCount = 0;
        var attachmentsNames = JSON.parse($("#ExAttachmentsNames_" + key).val());
        totalCount = attachmentsNames.length;
        for (var i = 0; i < attachmentsNames.length; i++) {
            if (attachmentsNames[i].Id == AttachmentId) {
                attachmentsNames[i].IsDeleted = 1;
            }
            if (attachmentsNames[i].IsDeleted == 1) {
                totalCount -= 1;
            }
        }
        $("#hdnExternalCopyAttachment").val(totalCount);
        $("#hdnExternalCopiesAttachmentsCount").val(totalCount);
        $("#hdnAttachmentNames").val(JSON.stringify(attachmentsNames));
        $("#ExAttachmentsNames_" + key).val(JSON.stringify(attachmentsNames));
    }

