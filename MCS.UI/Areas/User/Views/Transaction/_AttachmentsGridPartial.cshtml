@model AjaxGrid<MCS.UI.Areas.User.Models.Transaction.TransactionAttachmentVM>

@{
    var operationType = ViewData["IsEnableAction"] ?? true;
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
    ViewData.TemplateInfo.HtmlFieldPrefix = "TransactionAttachment";
    var permissionValue = Convert.ToInt32(ViewData["TransactionCategoryId"]) == TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)? UserClaims.Inbound.DeleteAttachments : UserClaims.Outbound.DeleteAttachments;
}

@Html.Grid(Model).CollectionName("Attachments").Named("grdAttachments").Columns(columns =>
{
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Key, new { id = "Key_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Id, new { id = "Id_" + model.Id }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.TypeId, new { id = "TypeId_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.TypeName, new { id = "TypeName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Number, new { id = "Number_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.AttachmentName, new { id = "AttachmentName_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);
    columns.Add(true).RenderValueAs(model => Html.HiddenFor(mvcgridcolumn => model.Archivable, new { id = "Archivable_" + model.Key }).FixIDAndName("mvcgridcolumn.", "mvcgridcolumn_")).Sanitized(false).Encoded(false);

    columns.Add(model => model.TypeId, true);
    columns.Add(model => model.TypeName).Titled(DbRes.TResource("User.Transaction.Attachment.TypeId"));
    columns.Add(model => model.Number).Titled(DbRes.TResource("User.Transaction.Attachment.Number"));
    columns.Add(model => model.AttachmentName).Titled(DbRes.TResource("User.Transaction.Attachment.Attachments"));

    if ((bool)operationType)
    {
        columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").RenderValueAs(model => @Html.ClientLinkTag("", cssClass: "edit_link",
        permissionCode: permissionValue,
        clientFunctionToCall: "DeleteActionGrid(" + "'grdAttachments'," + model.Key + ",'" + DbRes.TResource("Grid.DeleteMassage") + "','dvAttachmentsForm','DeleteAttachmentSuccess','" + model.TypeId + "')",
        innerHtml: "<i class='glyphicon glyphicon-trash color-danger'></i>"));
    }
})
