@model MCS.UI.Areas.User.Models.Transaction.TransactionFollowUpVM
@using MCS.Common;
@using MCS.Framework.Controls
@using MCS.Framework.Localization
@using MCS.Framework.Controls.Mvc
@{
    /**/
    string controllerr = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();
    ViewData.TemplateInfo.HtmlFieldPrefix = "FollowUpTab";
    if (ViewData["FollowUpOrgId"] != null)
    {
        Model.FollowUpEntityId = Convert.ToInt32(ViewData["FollowUpOrgId"]);
    }
    if (ViewData["FollowUpUserId"] != null)
    {
        Model.FollowUpUserId = Convert.ToInt32(ViewData["FollowUpUserId"]);
    }
}

<div class="content_container" id="divFollowUpForm">
    <div>
        @*@if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.FollowUps.AddFollowUp) )*@
        {
            <div>
                <div class="form-horizontal form-row">
                    @{
                        Model.TransactionId = (int)ViewData["TransactionId"];
                    }
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                        <div id="divFollowUpEntityTreee">
                            @Html.DepartmentsTree(ViewData["FollowUpDepartmentsData"] as TreeViewModel, model => model.FollowUpEntityId, TreeMode.Single, "treeFollowUpToOrgUnit", true, "GetFollowUpUsersByOrgUnitId", "FollowUpValidation", "divFollowUpEntityTreee")
                            @Html.HiddenFor(model => model.FollowUpEntityId, new { id = "hdnFromEntityName" })
                        </div>
                    </div>
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                        <label class="w-100">@DbRes.TResource("User.Transaction.FollowUp.Employee")<span class="stark NotIndividual">*</span></label>
                        @Html.AutoCompleteBuilder("autoCompleteToUserId", "hdnFollowUpToUserIdFollowUp", ViewData["OrgUnitsUsersData"] != null ? ViewData["OrgUnitsUsersData"].ToString() : null, Model != null ? Model.FollowUpUserId.ToString() : null, true, "form-control")
                        @Html.HiddenGroupFor(model => model.FollowUpUserId, new { @Value = "", id = "hdnFollowUpToUserIdFollowUp" }, "FollowUpValidation")
                        @Html.HiddenFor(model => model.FollowUpUserName, new { id = "hdnEmployeeNameFollowUp", @class = "UserName" })
                    </div>
                    <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">

                        <label class="w-100">@DbRes.TResource("User.Transaction.FollowUp.EndDate")<span class="stark NotIndividual">*</span></label>
                        <div class="with-icon">
                            @Html.CalendarCustom("FollowUpDateCal", "hdnFolloupDateGreg", "hdnFollowUpDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), Model != null ? Model.DateToH : null, "form-control")
                            <a class=" date-icon2 " onclick="showCalender('FollowUpDateCal')"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                            @Html.HiddenGroupFor(model => model.DateTo, new { id = "hdnFolloupDateGreg", AutoComplete = "off" }, "")
                            @Html.HiddenGroupFor(model => model.DateToH, new { id = "hdnFollowUpDateUm", AutoComplete = "off" }, "")
                            <i id="FollowUpMessage" style="color:red" class="glyphicon glyphicon-exclamation-sign hidden_"></i>
                            <span id="FollowUpdateMessagee" style="color:red"></span>
                        </div>
                        @Html.StickyHiddenFor(model => model.TransactionId)

                    </div>
                    <div class="form-group col-lg-12 col-md-12 col-xs-12 col-sm-12">
                        <p class="stark">@DbRes.TResource("Admin.User.MustFill") * </p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="text-right">
                        @Html.ClientActionButton(DbRes.TResource("User.Transaction.FollowUp.Add"), Url.Action("AddFollowUp", controllerr), "divFollowUpContent", "OnAddFollowUpEmployeeSuccess", null, "FollowUpValidation", "btnAddFollowUp", "divFollowUpForm", " btn-site ", null, "CheckFollowUpDate", UserClaims.FollowUps.AddFollowUp, "<i class='glyphicon glyphicon-plus'></i>")
                    </div>
                </div>
                <hr />

            </div>
        }
    </div>
</div>
<script>
    function CheckFollowUpDate() {

        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        if ($("#FollowUpDateCal").val() != "") {
            if ($("#hdnFolloupDateGreg").val() != undefined) {
                var selectedDate = convertdate($("#hdnFolloupDateGreg").val());

                if (selectedDate < currentDate) {
                    $("#FollowUpMessage").removeClass("hidden_");
                    $("#FollowUpMessage").show();
                    $('#FollowUpDateCal').addClass('RedBorder');
                    $("#FollowUpdateMessage").html(' @Html.Raw(DbRes.TValidation("User.FollowUp.RemindDateCompare"))');
                    return false;
                }
                else {
                    $('#FollowUpDateCal').removeClass('RedBorder');
                    $("#FollowUpMessage").hide()
                    $("#FollowUpdateMessage").html('');
                    if ($('#ToEntityId_txtDepartmentNumber').val() == "") {
                        $('#ToEntityId_txtDepartmentNumber, #ToEntityId_txtDepartmentName').addClass('RedBorder');
                    }
                    else {
                        $('#ToEntityId_txtDepartmentNumber, #ToEntityId_txtDepartmentName').removeClass('RedBorder');
                    }
                    return true;
                }
            }
        }
        else {
              $("#FollowUpMessage").removeClass("hidden_");
                    $("#FollowUpMessage").show();
                    $('#FollowUpDateCal').addClass('RedBorder');
                    $("#FollowUpdateMessage").html(' @Html.Raw(DbRes.TValidation("User.Report.TransactionsDeliveryReport.DateToRequired"))');
            if ($('#divFollowUpForm .txtDepartmentNumber').val() == "")
            {
                $('#divFollowUpForm .txtDepartmentNumber ,#divFollowUpForm .txtDepartmentName ').addClass('RedBorder');
            }
            else
            {
                $('#divFollowUpForm .txtDepartmentNumber ,#divFollowUpForm   .txtDepartmentName ').removeClass('RedBorder');
            }
            return false;
        }
    }

    $(document).ready(function () {
        $('#FollowUpDateCal').attr('autocomplete', 'off');
        GetFollowUpUsersByOrgUnitId(callback);

    });
    function DeleteTransactionFollowUp(transactionFollowUpId) {///////////////////for _FollowUpGridPartial.cshtml//////////////////////////
        var token = $("input[name='__RequestVerificationToken']").val();
        $.ajax({
            type: 'post',
            data: { id: transactionFollowUpId, __RequestVerificationToken: token },
            url: '@Url.Action("FollowUpUpdateIsDeleted", controllerr)',
            success: function (data) {
                if (data.MessageType != 2) {
                    $("#divContainer__frmAddTransactionType").remove();
                    $("#divForm__frmAddTransactionType").html("");
                    $("#divForm__frmAddTransactionType").html(data.Html);
                    jQuery.validator.unobtrusive.parse('#divForm__frmAddTransactionType');
                    $('#transId').val("");
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
    }
    function GetFollowUpUsersByOrgUnitId(callback) { ///////////////////for _FollowUpPartial.cshtml//////////////////////////
     
        if ($("#ToEntityId_hdnDepartmentIdFollowUp").val() != "" && $("#ToEntityId_hdnDepartmentIdFollowUp").val() !=undefined)
        {

            //$("#hdnFromEntityIdFollowUp").val($("#ToEntityId_hdnDepartmentIdFollowUp").val());

            $.ajax({
                type: 'get',
                url: '@Url.Action("GetUnitUsers", controllerr)',
                data: { id: $("#FollowUpTab_ToEntityId").val() },
                success:
               function (data) {
                   $("#autoCompleteToUserId").val("");
                   $("#hdnFollowUpToUserIdFollowUp").val("");
                   AutoCompleteChangeList("autoCompleteToUserId", data);
                   $("#autoCompleteToUserId").prop('disabled', false);

                   if (typeof callback !== 'undefined' && $.isFunction(callback)) {
                       callback();
                   }
               }
            });
            return false;
        }
        else {
            $("#autoCompleteToUserId").prop('disabled', true);
            $("#autoCompleteToUserId").val("");
            $("#hdnFollowUpToUserIdFollowUp").val("");
            AutoCompleteChangeList("autoCompleteToUserId", "[]");
        }
    }
    function callback() {
         if ('@ViewData["FollowUpUserId"]' != null)
       {
             $("#hdnFollowUpToUserIdFollowUp").val('@ViewData["FollowUpUserId"]');
                $("#autoCompleteToUserId").trigger('change');
             $("#hdnFollowUpToUserIdFollowUp").trigger('change');
            }
    }
    function OnAddFollowUpEmployeeSuccess(data) { ///////////////////for _FollowUpPartial.cshtml//////////////////////////

        if (data.MessageType != 2) {
            $("#divFollowUpContent").html('');
            $("#divFollowUpContent").html(data);
            ClearInputs('divFollowUpForm');
            if ('@ViewData["FollowUpUserId"]' != null)
            {
                $("#ToEntityId_hdnDepartmentIdFollowUp").val("@ViewData["FollowUpOrgId"]");
                $("#hdnFromEntityIdFollowUp").val("@ViewData["FollowUpOrgId"]");

                SetTreeDefaultInfo("ToEntityId");
                GetFollowUpUsersByOrgUnitId(function () {
                    $("#hdnFollowUpToUserIdFollowUp").val('@ViewData["FollowUpUserId"]');
                $("#autoCompleteToUserId").trigger('change');
                    $("#hdnFollowUpToUserIdFollowUp").trigger('change');
                });
            }
            else
            {
                $("#ToEntityId_hdnDepartmentIdFollowUp").val("@ViewData["FollowUpOrgId"]");
                 $("#hdnFromEntityIdFollowUp").val("@ViewData["FollowUpOrgId"]");
                SetTreeDefaultInfo("ToEntityId");
            }
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
    function LoadFollowUpDetailsTab() {

        var id = $("#hdnTransactionID").val();
        $("#divTransactionFollowUp").removeAttr('onclick');
        $.ajax({
            url: '@Url.Action("FollowUpDetailsLoad", controllerr)',
                data: { transactionId: id },
            success: function (data) {
                $("#divFollowUpDetailsContent").html(data);

            }
        })
    }
</script>
<style>
    .RedBorder {
        border: 1px solid #fe0000 !important
    }
</style>
