    function EditArchiveButton(actionUrl, divId, onAjaxSuccess, onAjaxFaild, keyValue) {

        var transactionArchive = $(event.currentTarget).closest("tr").find("input").serializeObject();
        var index = transactionArchive["Archives.index"];
        var documentId = transactionArchive["Archives[" + index + "].DocumentId"];
        if (!documentId)
            documentId = 0;

        $.ajaxSetup({ cache: false });
        jQuery.support.cors = true;
        $.ajax({
            type: "POST",
            url: actionUrl,
            cache: false,
            data: { Key: keyValue, documentId: documentId },
            success: function (data) {
                if (data.MessageType !== 2) {
                    if (onAjaxSuccess != '') {
                        window[onAjaxSuccess](data.key);
                    }
                }
            },
            error: function (data) {
                if (onAjaxFaild != '') {
                    window[onAjaxFaild](data, divUpdatData);
                }
            }
        });
    }

    function UpdateArchiveButton(actionUrl, divUpdateContent, onAjaxSuccess, onAjaxFaild, buttonId, divId, clientFunctionToCall, frameViewerId) {
        if (!CheckArchiveData()) {
            return;
        }
        $('#hdnKey').removeAttr("disabled");
        $('#hdnId').removeAttr("disabled");

        var continueWork = true;
        if (gridOptions.IsArchivable != "False") {
            var docoNutFrameContent = $('#frameViewerAttachment').contents();
            var docoNutToken = $('#_hdnToken', docoNutFrameContent)[0].value;
        }

        continueWork = window["CheckArchiveData"]();
        if (!continueWork) {
            return false;
        }

        ClickedSubmit = $("#" + buttonId).attr("name");

        $.ajaxSetup({ cache: false });

        var UpdatedContentData = $("#dvAttachmentsForm :input").serialize();
        var GridContentData = $("#dvArchivingGrid :input").serialize();
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();

        var AllContentData = UpdatedContentData + "&" + GridContentData + "&hdnArchiveId=" + gridOptions.DocId + "&param="
            + docoNutToken + "&key=" + gridOptions.key + "&file=" + $("#FileName").val() + "&ArchiveingType=" + $("#ArchiveingType").val() + "&__RequestVerificationToken=" + token;

        $.ajax({
            type: 'post',
            cache: false,
            url: "@Url.Action("UpdateArchive", controller)",
            dataType: "json",
            contentType: "application/x-www-form-urlencoded; charset=UTF-8",
            data: AllContentData ,
            success: function (data) {
                $('#grid-table-grdArchiving').find('#Key_' + gridOptions.key).closest('tr').replaceWith(data.Html);
                if ($("#ArchiveingType").val()  == '@((int)AttachmentSource.Scanned)') {
                    document.getElementById('frameViewerAttachment').contentWindow.location.reload();
                }
                $("#btnAddArchive").show();
                $("#ArchiveUpdate").hide();
                $("#btnCancelArchive").hide();
                ClearInputs("dvAttachmentsForm");
                ClearInputs("uploadContainer");
                $("#uploadContainer .uploaded-files").html("");
                $('#scanningContainer').hide();
                $('#uploadContainer').hide();
                $('#UploadOptionsContainer').hide();
                $('#FileName').val("");
                $('#uploadContainer .uploaded-files').html("");

            },
            error: function (data) {
                //   eval(onAjaxSuccess)(data);
                if (onAjaxFaild != '') {
                    window[onAjaxFaild](data, divUpdateContent);
                }
            }

        });
    }

    function UploadDoconutFileSuccess()
    {
        $("#ArchiveUpdate").click();
    }
    function DeleteArchive(Sesstionkey) {
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
        $.ajaxSetup({ cache: false });
        $.ajax({
            type: 'post',
            cache: false,
            url: "@Url.Action("DeleteArchive", controller)",
            data: { hdnSessionKey: Sesstionkey, __RequestVerificationToken: token },
            success: function (data) {
                document.getElementById('frameViewerAttachment').contentWindow.location.reload();
                $("#btnAddArchive").show();
                $("#ArchiveUpdate").hide();
                $("#btnCancelArchive").hide();
            },
            error: function (data) {
                if (onAjaxFaild != '') {
                    window[onAjaxFaild](data, divUpdateContent);
                }
            }
        });
    }
    function ArchivingOnSuccess(data) {
        if (data.MessageType != 2) {
            $("#grid-table-grdArchiving > tbody > .grid-empty-text").remove();
            $("#grid-table-grdArchiving > tbody:last").append(data.Html);
            document.getElementById('frameViewerAttachment').contentWindow.location.reload();
        /*    $("#hdnArchivigdata").val(data.hdnValue);*/
            $("#hdnArchiveData").val(data.hdnValue);
            $("#hdnAttachments").val(data.hdnAttachmentsValue);
            ClearInputs("dvAttachmentsForm");
            ClearInputs("uploadContainer");
            $("#uploadContainer .uploaded-files").html("");
            $('#scanningContainer').hide();
            $('#uploadContainer').hide();
            $('#UploadOptionsContainer').hide();
            $('#ArchiveingType').val(@((int)AttachmentSource.Scanned));
        }
        else {
            ShowErrorMessage(data.Message);
        }
    }

    function GetArchive(data) {
        document.getElementById('frameViewerAttachment').contentWindow.location.reload();
        $("#TransactionArchive_ArchiveKey").val('');
        $("#TransactionArchive_ArchiveKey").val(data);
        $("#btnAddArchive").hide();
        $("#ArchiveUpdate").show();
        $("#btnCancelArchive").show();
    }

    function GetFile(data)
    {
        $("#TransactionArchive_ArchiveKey").val('');
        $("#TransactionArchive_ArchiveKey").val(data);
        $("#btnAddArchive").hide();
        $("#ArchiveUpdate").show();
        $("#btnCancelArchive").show();


    }

    function OnUdateArchiveSuccess(data) {
        document.getElementById('frameViewerAttachment').contentWindow.location.reload();
        $("#ArchiveKey").val("");
        $("#ArchiveUpdate").hide();
        $("#btnAddArchive").show();
        $("#btnCancelArchive").hide();
    }

    function CancelUpdate() {
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            type: 'post',
            url: '@Url.Action("CancelUpdate",controller)',
            data: { hdnSessionKey: $("#hdnSessionKey").val(), __RequestVerificationToken: token },
            success:
           function (data) {
               document.getElementById('frameViewerAttachment').contentWindow.location.reload();
               $("#btnAddArchive").show();
               $("#ArchiveUpdate").hide();
               $("#btnCancelArchive").hide();
               ClearInputs("dvAttachmentsForm");
               ClearInputs("uploadContainer");
               $("#uploadContainer .uploaded-files").html("");
               $('#scanningContainer').hide();
               $('#uploadContainer').hide();
               $('#UploadOptionsContainer').hide();
               $('#FileName').val("");
               $('#uploadContainer .uploaded-files').html("");
           }
        });
    }

    function CheckArchiveData() {
        var isArchivable = $("#hdnAttachmentTypeName").siblings('input')[1].value;
        if (isArchivable == "true") {
            var tokenValue = document.getElementById('frameViewerAttachment').contentDocument.getElementById("_hdnToken").value;
            var files = $('#uploadContainer').find(".attachment_name");

            if ($('#ArchiveingType').val() == @((int)AttachmentSource.Scanned)) {
                if (tokenValue == "") {
                    ShowErrorMessage('@Html.Raw(DbRes.TValidation("User.Transaction.Archive.ArchiveRequired"))');
                    return false;
                }
            }

            if ($('#ArchiveingType').val() == @((int)AttachmentSource.Uploaded)) {
                if (files.length <= 0) {
                    ShowErrorMessage('@Html.Raw(DbRes.TValidation("User.Transaction.Archive.ArchiveRequired"))');
                    return false;
                }
            }
        }
        if ($("#TransactionArchive_Number").val() == "" & $("#ddlAttachmentType").val() == "") {
            AddNumberValidation();
            AddTypeValidation();
            window.scrollTo(0, 0);
            return false;
        }
        if ($("#TransactionArchive_Number").val() != "" & (($("#ddlAttachmentType").val() == "") | isArchivable == "")) {
            removeNumberValidation();
            AddTypeValidation();
            window.scrollTo(0, 0);
            return false;
        }
        if ($("#TransactionArchive_Number").val() == "") {
            AddNumberValidation();
            removeTypeValidation();
            window.scrollTo(0, 0);
            return false;
        }

        removeTypeValidation();
        removeNumberValidation();
        return true;
    }
    function removeTypeValidation() {
        $("#AttachmentTypeglyphicon").addClass("hidden_");
        $("#AttachmentTypeglyphicon").hide();
        $("#ddlAttachmentType").removeClass("RedBorder");
        $("#AttachmentTypeMessage").html('');
    }
    function removeNumberValidation() {
        $("#Calglyphicon").addClass("hidden_");
        $("#Calglyphicon").hide();
        $("#TransactionArchive_Number").removeClass("RedBorder")
        $("#Message").html('');
    }
    function AddTypeValidation() {
        $("#AttachmentTypeglyphicon").removeClass("hidden_");
        $("#AttachmentTypeglyphicon").show();
        $("#ddlAttachmentType").addClass("RedBorder");
        $("#AttachmentTypeMessage").html('@Html.Raw(DbRes.TResource("User.Transaction.Archive.EnterAttachmentTypeErrorMsg"))');
    }
    function AddNumberValidation() {
           $("#Calglyphicon").removeClass("hidden_");
            $("#Calglyphicon").show();
            $("#TransactionArchive_Number").addClass("RedBorder");
            $("#Message").html('@Html.Raw(DbRes.TValidation("User.Transaction.Attachment.NumberRequired"))');

    }
    $(document).ready(function () {
        $('#scanningIconContainer').click(function () {
            $('#scanningContainer').show();
            $('#uploadContainer').hide();
            $('#ArchiveingType').val(@((int)AttachmentSource.Scanned));
            $('#scanningIconContainer')/*.css("background", "#dce3e9")*/;
            $('#txtEditorIconContainer')/*.css("background", "#f5f7fa")*/
            ClearInputs("scanningIconContainer");
        });

        $('#txtEditorIconContainer').click(function () {
            $('#scanningContainer').hide();
            $('#uploadContainer').show();
            $('#ArchiveingType').val(@((int)AttachmentSource.Uploaded));
            ClearInputs("txtEditorIconContainer");
            $('#txtEditorIconContainer')/*.css("background", "#dce3e9")*/;
            $('#scanningIconContainer')/*.css("background", "#f5f7fa")*/

        });
    });

    function SaveTransactionAttachements() {
       // showname();
        debugger;
        var name = document.getElementById('TransactionFiles');
        $('#uploadContainer .uploaded-files').children('.newAdded').remove();
        var fileExist = false;
        for (i = 0; i < name.files.length; i++) {
            $('#uploadContainer .uploaded-files').find('.attachment_name').each(function () {

                var S = $(this).html();
                if (S.includes(name.files.item(i).name)) {
                    fileExist = true;
                }
            });
            if (!fileExist) {
                $("#FileName").val(name.files.item(i).name);
                $('#uploadContainer .uploaded-files').append('<div class="file newAdded"><i class="uicon icon_attachments"></i><span class="attachment_name">' + name.files.item(i).name + '</span><a href="javascript:removeMainDocAttachemntPhysically()" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>');
            }
        }
        $('.col-uploadeed-files').fadeIn(200);

        var files = $('#uploadContainer').find($("input:file")).get(0).files;
        if (files.length <= 0) {
            return;
        }

        if (window.FormData !== undefined) {
            var data = new FormData();
            var fileExist = false;
            for (i = 0; i < files.length; i++) {
                $('#uploadContainer .uploaded-files').find('.attachment_name').each(function () {
                    if ($(this).html() == files[i].name) {
                        fileExist = true;
                    }
                });
                if (fileExist) {
                    data.append("file" + i, files[i], files[i].name);
                }
            }
            data.append('TransactionArchiveVM', $("#dvAttachmentsBody :input").serializeArray());
            data.append('AttachmentTypeId', $("#hdnAttachmentType").val());
            var jqXHR = $.ajax({
                type: "post",
                url: '@Url.Action("UploadMainDocAttachments", controller)',
                data: data,
                contentType: false,
                processData: false,
                dataType: 'json',
                async: false,
            }).done(function (data) {
                if (data.MessageType != 2)
                {
                    $("#JFile").val(data.AddedFilesJson);
                } else
                {
                    $('#FileName').val("");
                    $('#uploadContainer .uploaded-files').find('.attachment_name').html("");
                    alert(data.MessageText);
                }
            }).fail(function (jqXHR, textStatus) {
                alert("error");
            });
        } else {
            alert("Your browser doesn't support HTML5 multiple file uploads! Please use some decent browser.");
            return;
        }

        return;
    }

    function removeMainDocAttachemntPhysically(key, AttachmentId) {
        var token = $("#dvArchivingDataContainer").parents("form").find("input[name='__RequestVerificationToken']").val();
        if (DeletedAttach && DeletedAttach != "" && key != undefined && AttachmentId != undefined && AttachmentId != 0) {
            updateDeletedMainDocAttachments(key, AttachmentId);
        } else if (DeletedAttach && DeletedAttach != "" && key == undefined && AttachmentId == undefined || (key != undefined && AttachmentId == 0)) {
            $.ajax({
                type: 'post',
                url: '@Url.Action("RemoveAttachemntPhysically", controller)',
                data: { "attachmentsToDelete": DeletedAttach, entityId: $("#hdnAttachmentType").val() , __RequestVerificationToken: token },
                success: function (data) {
                    if (data.MessageType != 2) {
                        $('#downloadFile').html("");
                    } else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
            });
        }
    }

    function updateDeletedMainDocAttachments(key, AttachmentId) {

        var attachmentsName = JSON.parse($("#JFile_" + key).val());
        if (attachmentsName.Id == AttachmentId) {
            attachmentsName.IsDeleted = 1;
        }
        $('#downloadFile').html("");
        $("#JFile").val(JSON.stringify(attachmentsName));
    }
</script>
