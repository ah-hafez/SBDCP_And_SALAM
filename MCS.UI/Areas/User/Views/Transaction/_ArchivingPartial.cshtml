        var EncryptDocumentId = $('#dvArchivingGrid').find('#EncryptDocumentId_' + key).val();
        var JFile = $('#dvArchivingGrid').find('#JFile_' + key).val();
        var IsNewFile = $('#dvArchivingGrid').find('#IsNewFile_' + key).val();

        gridOptions.IsArchivable = $('#dvArchivingGrid').find("#Archivable_" + key).val();
        var FromUser = $('#dvArchivingGrid').find("#FromUserId_" + key).val();
        var FromEntity = $('#dvArchivingGrid').find("#FromEntityId_" + key).val();


        $("#ddlAttachmentType").val(ArcivingTypeName);
        $("#TransactionArchive_Number").val(Number);
        $("#TransactionArchive_AttachmentName").val(AttachmentName);
        $("#hdnArchivable").val(Archivable);
        $("#hdnAttachmentType").val(TypeId);
        $("#hdnAttachmentTypeName").val(ArcivingTypeName);
        $("#hdnId").val(modelId);
        $("#hdnKey").val(key);
        $("#ArchiveingType").val(AttachmentSource);
        $("#DocumentIdForAttachments").val(DocumentId);
        $("#EncryptDocumentIdForAttachments").val(EncryptDocumentId);
        $("#FromEntityIdForAttachments").val(FromEntity);
        $("#JFile").val(JFile);
        var attachedFile = JSON.parse(JFile);

        $("#FromUserIdForAttachments").val(FromUser);
        var token = $('form:first').find("input[name='__RequestVerificationToken']").val();

        if (Archivable == "true") {
            var url = "@Url.Action("ViewArchive", controller)";


            var data = { key: id, documentId: documentId, __RequestVerificationToken: token };
            $.ajax({
                type: "POST",
                url: url,
                cache: false,
                data: data,
                success: function (data) {
                    if (data.MessageType !== 2) {
                        if (AttachmentSource == @((int)AttachmentSource.Scanned)) {
                            $('#UploadOptionsContainer').show();
                            $('#uploadContainer').hide();
                            $('#scanningContainer').show();
                            GetArchive(data);
                        }
                        else
                        {
                            $('#UploadOptionsContainer').show();
                            $('#scanningContainer').hide();
                            $('#uploadContainer').show();
                            GetFile(data);
                            var download = '';
                            if (DocumentId != 0) {
                                download = '<a id="downloadFileLink" onClick="DownloadFile(' + $("#EncryptDocumentIdForAttachments").val() +')">تحميل</a>';
                            }
                            if (attachedFile.IsDeleted != 1) {
                                $('#uploadContainer .uploaded-files').html('<div class="file newAdded"><i class="uicon icon_attachments"></i><span class="attachment_name">' + FileName + '</span><a href="javascript:removeMainDocAttachemntPhysically(' + key + ', ' + attachedFile.Id + ')" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>&nbsp;<span id="downloadFile">' + download + '</span>');
                                $("#FileName").val(FileName);
                            }

                        }
                    }
                }
            });
        } else {
            $('#uploadContainer').hide();
            $('#scanningContainer').hide();
            $('#UploadOptionsContainer').hide();
            $("#btnAddArchive").hide();
            $("#ArchiveUpdate").show();
            $("#btnCancelArchive").show();
            $('#ArchiveingType').val(@((int)AttachmentSource.Scanned));
        }
    }

