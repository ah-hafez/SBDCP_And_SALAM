@using MCS.Framework.Localization
@using MCS.Common
@using MCS.UI.Common
@model MCS.UI.Areas.User.Models.Transaction.TransactionArchiveVM

@{
    bool isCreateCopyOutboundInternal = Request.Url.ToString().IndexOf("CreateCopyOutboundInternal/") != -1 || Request.Url.ToString().IndexOf("CreateCopyOutboundInternal?") != -1;
    string isWaterMark = Model.ReadOnly ? "true" : "false";
    string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();

    string doconutPermissions = string.Format("signaturePermission={0}&stampPermission={1}&annotationsPermission={2}&colorPermission={3}",
                                        Model.SignaturePermission.ToString(), Model.StampPermission.ToString(), Model.AnnotationsPermission.ToString(), Model.ColorScanningPermission.ToString());

    Model.ShowBarcode = true;

    var doconutIframeUrl = UIConfigurations.GetFullURl() + string.Format("{0}?sIncludedItemDoc=true&showwatermark={2}&{1}", SystemConfigurations.DoconutIframeUrl, doconutPermissions, isWaterMark);

    if (!Model.ShowBarcode)
    {
        doconutIframeUrl = UIConfigurations.GetFullURl() + string.Format("{0}?sIncludedItemDoc=true&showbarcode=false&{1}&showwatermark={2}", SystemConfigurations.DoconutIframeUrl, doconutPermissions, isWaterMark);
    }
    else if (Model.ReadOnly)
    {
        doconutIframeUrl = UIConfigurations.GetFullURl() + string.Format("{0}?sIncludedItemDoc=true&hidecontrols=true&{1}&showwatermark={2}", SystemConfigurations.DoconutIframeUrl, doconutPermissions, "true");
    }

    ViewData.TemplateInfo.HtmlFieldPrefix = "TransactionArchive";
}
@*<hr />*@
