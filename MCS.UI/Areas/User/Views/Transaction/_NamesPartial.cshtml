</div>
<script>
    $(document).ready(function () {
        SetAutoCompleteValue('TransactionName_ddlGender', "@genderValue");
        $('[name="TransactionName.SendSMS"][type="hidden"]').remove();

        var sendSMSCheckBox = $('#TransactionName_SendSMS')
        sendSMSCheckBox.change(function () {
            debugger
            sendSMSCheckBox.val(sendSMSCheckBox.is(":checked"));
        });
    });
    function CollapseDiv(divName) {
        if ($('#' + divName).css('display') == 'block') {
            $('#' + divName).css("display", "none");
            $('#' + divName + 'PlusIcon').css("display", "inline-block");
            $('#' + divName + 'DashIcon').css("display", "none");
        }
        else {
            $('#' + divName).css("display", "block");
            $('#' + divName + 'PlusIcon').css("display", "none");
            $('#' + divName + 'DashIcon').css("display", "inline-block");
        }
    }
    $(document).on("change", "#TransactionName_CivilID", function () {
        var htmlPrefix = '@ViewData.TemplateInfo.HtmlFieldPrefix';
        if ($(this).val().length == 10) {
            var token = $('form:first').find("input[name='__RequestVerificationToken']").val();
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetTransactionName",controller)',
                cache: false,
                data: { __RequestVerificationToken: token, civilId: $(this).val() },
                success:
                    function (data) {
                        var hasData = false;

                        if (data.Id != null) {
                            $.each(data, function (name, value) {

                                var x = $("#dvNamesBody #" + name);
                                if (x.length == 0) {
                                    $("#dvNamesBody #TransactionName_" + name).val(value);
                                }
                                else {

                                    $("#dvNamesBody #" + name).val(value);
                                    $("#dvNamesBody #" + name).trigger("change");

                                }
                                hasData = true;

                            });
                        }
                        if (hasData) {
                            $("#dvNamesBody #" + "NationalityId").trigger("change");
                            $("#dvNamesBody #" + "TitleId").trigger("change");
                            $("#dvNamesBody #" + "City").trigger("change");
                            $("#dvNamesBody #" + "RelativeRelation").trigger("change");
                            $("#dvNamesBody #" + "Gender").trigger("change");
                        }
                        else {
                            if ($("#btnNames").css("display") == "block") {
                                $("#dvNamesBody #Id").val("");
                            }
                        }
                        return;
                    }
            });
        }
    });

    function CancelEdit() {
        $("#btnNames").show();
        $("#btnResetName").show();
        $("#btnEditNames").hide();
        $("#aCancelName").hide();
        $('#grid-table-grdNames').find('#Key_' + $("#Key").val()).closest('tr').removeClass("grid-row-selected");
        ClearInputs('dvNamesForm');
        SetAutoCompleteValue('TransactionName_ddlGender', "@genderValue");
    }

    function NamesOnSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#grid-table-grdNames > tbody > .grid-empty-text").remove();
            $("#grid-table-grdNames > tbody:last").append(data.Html);
            ClearInputs('dvNamesForm');
            SetAutoCompleteValue('TransactionName_ddlGender', "@genderValue");
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    function NamesOnEditSuccess(data) {
        if (data.MessageType != 2) {
            if (data.Key != "") {
                $('#grid-table-grdNames').find('#Key_' + data.Key).closest('tr').replaceWith(data.Html);
            }
            ClearInputs('dvNamesForm');
            $("#hdnNames").val(data.hdnValue);
            $("#btnNames").show();
            $("#btnResetName").show();
            $("#btnEditNames").hide();
            $("#aCancelName").hide();
            SetAutoCompleteValue('TransactionName_ddlGender', "@genderValue");
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }
    function ResetActionName() {
        $("#btnNames").show();
        $("#btnEditNames").hide();
        $("#aCancelName").hide();
        SetAutoCompleteValue('TransactionName_ddlGender', "@genderValue");
    }
    function GetNameById(key) {
        $('#Key').val(key)
        $('#NationalityId').val($("#NationalityId_" + key).val());
        $('#NationalityId').trigger('change');
        SetAutoCompleteValue('TransactionName_ddlNationality', $("#NationalityName_" + key).val());

        SetAutoCompleteValue('TransactionName_ddlTitle', $("#TitleName_" + key).val());
        $('#TitleId').val($("#TitleId_" + key).val());
        $('#TitleId').trigger('change');
        $("#hdnTitleName").val($("#TitleName_" + key).val());

        SetAutoCompleteValue('TransactionName_ddlCity', $("#CityName_" + key).val());
        $('#City').val($("#City_" + key).val());
        $('#City').trigger('change');

        SetAutoCompleteValue('TransactionName_ddlRelativeRelation', $("#RelativeRelationName_" + key).val());
        $('#RelativeRelation').val($("#RelativeRelation_" + key).val());
        $('#RelativeRelation').trigger('change');

        SetAutoCompleteValue('TransactionName_ddlGender', $("#GenderName_" + key).val());
        $('#Gender').val($("#Gender_" + key).val());
        $('#Gender').trigger('change');

        $('#TransactionName_CivilID').val($("#CivilID_" + key).val());
        $('#TransactionName_FirstName').val($("#FirstName_" + key).val());
        $('#TransactionName_MobileNumber').val($("#MobileNumber_" + key).val());
        $('#TransactionName_Phone').val($("#Phone_" + key).val());
        $('#TransactionName_OtherInformation').val($("#OtherInformation_" + key).val());
        $('#TransactionName_Email').val($("#Email_" + key).val());
        $('#TransactionName_Address').val($("#Address_" + key).val());
        $("#dvNamesBody #chkMale").prop("checked", $("#Gender_" + key).val() == '1');
        $("#dvNamesBody #chkFemale").prop("checked", $("#Gender_" + key).val() == '2');

        $('#TransactionName_Id').val($("#Id_" + key).val());
        $('#TransactionName_Gender').val($("#Gender_" + key).val());
        $("#btnNames").hide();
        $("#btnResetName").hide();
        $("#btnEditNames").show();
        $("#aCancelName").show();
        $("#btnEditNames").removeClass("hidden_");
    }
</script>
