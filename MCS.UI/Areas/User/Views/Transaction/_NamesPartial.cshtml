                    @Html.ClientActionButton(DbRes.TResource("User.Transaction.Name.Edit"), Url.Action("EditName", controller), "dvNamesGrid", "NamesOnEditSuccess", null, "Names", "btnEditNames", "dvNamesBody", "btn-site hidden_", null, null, UserClaims.Names.Edit)
