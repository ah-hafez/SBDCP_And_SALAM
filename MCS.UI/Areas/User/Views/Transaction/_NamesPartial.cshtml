                </div>
            </div>
            @*<hr />*@
            <div class=" panel-body">
                <div id="dvNamesGrid">
                    @Html.Partial("~/Areas/User/Views/Transaction/_NamesGridPartial.cshtml", Model.Names, new ViewDataDictionary { { "IsEnableAction", Model.IsEnableAction }, { "TransactionCategoryId", ViewData["TransactionCategoryId"] } })
                </div>
            </div>
