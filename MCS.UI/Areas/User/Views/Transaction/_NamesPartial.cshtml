                            </div>



                            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                                <div class="TitleId">
                                    <label class="w-100">@DbRes.TResource("User.Transaction.Name.Title")</label>
                                    @Html.AutoCompleteBuilder(ViewData.TemplateInfo.HtmlFieldPrefix + "_ddlTitle", "TitleId", LookupCategory.Title, null, true, "form-control")
                                    @Html.HiddenGroupFor(model => model.TitleId, new { @Value = "", id = "TitleId" })
                                </div>
                            </div>

                            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                                <label class="w-100">@DbRes.TResource("User.Transaction.Name.RelativeRelation") </label>
                                @Html.AutoCompleteBuilder(ViewData.TemplateInfo.HtmlFieldPrefix + "_ddlRelativeRelation", "RelativeRelation", LookupCategory.RelativeRelation, null, true, "form-control")
                                @Html.HiddenGroupFor(model => model.RelativeRelation, new { @Value = "", id = "RelativeRelation" }, "Names")
                            </div>
                            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                                <label class="w-100">@DbRes.TResource("User.Transaction.Name.Address")</label>
                                @Html.TextBoxGroupFor(model => model.Address, "Names", new { @class = "form-control", maxlength = "255" }, "Names")
                            </div>


                            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                                <label class="w-100">@DbRes.TResource("User.Transaction.Name.City")</label>
                                @Html.AutoCompleteBuilder(ViewData.TemplateInfo.HtmlFieldPrefix + "_ddlCity", "City", ViewData["SettingCity"].ToString(), null, true, "form-control")
                                @Html.HiddenGroupFor(model => model.City, new { @Value = "", id = "City" }, "Names")
                            </div>


                            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
                                <label class="w-100">@DbRes.TResource("User.Transaction.Name.Gender") </label>
                                @Html.AutoCompleteBuilder(ViewData.TemplateInfo.HtmlFieldPrefix + "_ddlGender", "Gender", LookupCategory.Gender, null, true, "form-control")
                                @Html.HiddenGroupFor(model => model.Gender, new { @Value = "", id = "Gender" }, "")
                            </div>


                            <div class="form-group col-lg-2 col-md-4 col-sm-6 col-xs-12  mb-3" style="display:none">
                                @Html.LabelFor(model => model.OtherInformation, new { @class = "w-100" })
                                @Html.TextBoxGroupFor(model => model.OtherInformation, "Names", new { @class = "form-control", @Value = "", maxlength = "200" }, "Names")
