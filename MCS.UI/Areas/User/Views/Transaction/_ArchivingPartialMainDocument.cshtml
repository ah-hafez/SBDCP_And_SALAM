    }


</script>
<script>

    function ShowTextData2(id, documentId, key) {
        debugger;
        $.ajax({
            type: 'get',
            cache: false,
                        url: '@Url.Action("GetExplanationByDocumentId", "Inbound")',
            data: { id: documentId, hdnExplanationDocumentSessionKey: key },
            success: function (data) {
                debugger;

                if (data.Type == 3) {
                    debugger;
                    $("#archivetxtDescription").val(data.Content);
                    document.getElementById('explinationDateTime').innerText = data.Date;
                    document.getElementById('explinationFromUser').innerText = data.FromUser;
                    $('#dvexplanationsText').show();
                    $('.doconutContainerForArchiving').hide();
                    $('#dvScanningArchiving').hide();
                }
            }
        });
    }

    function checkIfHasMainDocument(isSecret)
    {
        var isReadOnly = $('#hdnDocumentReadOnly').val();
        if (isReadOnly == 'True')
        {
            $('#hdnMainDocToken').val('');
            return true;
        }
        window.checkIfHasMainArchiveURL = '@Url.Action("CheckIfHasMainArchive", controller)';
        var token = $("#dvArchivingMainDocumentBody").parents("form").find("input[name='__RequestVerificationToken']").val();
     var docoNutFrameContent = $('#frameViewer').contents();
    var isDraft=false;
      var isArchived = true;
    if (docoNutFrameContent.length > 0)
     {

     var __docViewerToken = $('#_hdnToken', docoNutFrameContent)[0].value;
        $('#hdnMainDocToken').val(__docViewerToken);

    }
    else
    {

    isArchived=false;
    isDraft=true;
    }


        if (isSecret) {
            return true;
        }
        $("#CalMessageForMainDoc").html('');
        $("#CalMessage2").hide();
        if ($('#dvTextEditor').is(":visible")) {
                return true;
        } else if(isDraft) {
      return true;

    }
    else {

            if (!isArchived) { // here

                $("#doconutViewer > #CalMessage2").removeClass("hidden_");
                $("#doconutViewer > #CalMessage2").show();
                $("#doconutViewer > #CalMessageForMainDoc").html('@Html.Raw(DbRes.TValidation("User.Inbound.MainDocument"))');
            }
            if ($('#doconutViewer > #CalMessageForMainDoc').html() == "")
                return true;
            else if ($('#doconutViewer > #CalMessageForMainDoc').html() != "" && $('#doconutViewer > #ddlInboundDocumentType').val() != "" && (!isArchived)) {
                $("#doconutViewer > #CalMessageForMainDoc").html('@Html.Raw(DbRes.TValidation("User.Inbound.MainDocument"))');
                return false;
            }
            else if ($('#doconutViewer > #CalMessageForMainDoc').html() != "" && $('#doconutViewer > #ddlInboundDocumentType').val() != "" && (isArchived)) {
                $("#doconutViewer > #CalMessageForMainDoc").html('');
                $("#doconutViewer > #CalMessage2").hide();
                return false;
            }
            else if ($('#doconutViewer > #CalMessageForMainDoc').html() != "" && (isArchived)) {
                $("#doconutViewer > #CalMessageForMainDoc").html('');
                $("#doconutViewer > #CalMessage2").hide();
                return false;
            }
            else {
                return true;
            }
        }
    }


    $(document).ready(function () {

        var dvContainer = document.getElementById("IncludeArchivingSection");
        var dvs = dvContainer.getElementsByClassName("dv");

        for (var i = 0; i < dvs.length; i++) {
            dvs[i].addEventListener("click", function () {
                debugger;
                var current = document.getElementsByClassName("activate");
                current[0].className = current[0].className.replace(" activate", "");
                this.className += " activate";
            });
        }
        $('.dvExp').on('click', function () {
            $('.activate').removeClass('activate')
            $(this).addClass('activate');
        });

        var dvContainer2 = document.getElementById("IncludeArchivingSection2");
        var dvs2 = dvContainer2.getElementsByClassName("dv");

        for (var i = 0; i < dvs2.length; i++) {
            dvs2[i].addEventListener("click", function () {
                debugger;
                var current = document.getElementsByClassName("activate");
                current[0].className = current[0].className.replace(" activate", "");
                this.className += " activate";
            });
        }

        if ($("#hdnArchiveMainDocumentId").val() != "") {
            $("#btnAddArchiveMainDocument").hide();
        }
        else {
            $("#btnUdateArchiveMainDocument").hide();
            $("#btnCancelArchiveMainDocument").hide();
        }
        function CreateBracodeImage() {
            if ($('#ImgBarcodeCanvas').attr('src') == undefined || $('#ImgBarcodeCanvas').attr('src') == null) {
                var ifr = $('<iframe/>', {
                    id: 'frameBarcode',
                    src: '@Url.Action("GetBarcodeImage","Shared")',
                    style: 'background-color: transparent; border: 0; z-index: -1; position: absolute; top: 0px; left: 0px; width: 250px; height: 180px;'

                });


                ifr.insertAfter('#divBarcodeCanvas');
                var iframe = document.getElementById('frameBarcode');
                iframe.onload = function () { iframLoaded(); };
            }
            if ($('#hdnShowBarcode').val() != 'true') {
                document.getElementById("frameBarcode").style.visibility = "hidden";
            }

        }

        function iframLoaded() {
            html2canvas($('#frameBarcode').contents().find('body'), {
                onrendered: function (canvas) {
                    $('#frameBarcode').show();
                    $(canvas).prependTo('#divBarcodeCanvas');
                    $('#frameBarcode').hide();
                    $('<img id="ImgBarcodeCanvas">').appendTo($('#divBarcodeCanvas'));
                    $('#ImgBarcodeCanvas').attr("src", $(canvas)[0].toDataURL("Image/png"));
                },
                background: '#ffffff',
                width: 250,
                height: 180,
                letterRendering: true,
                scale: 1000
            });
        }
        if ($('#ImgBarcodeCanvas').attr('src') == null || $('#ImgBarcodeCanvas').attr('src') == undefined) {

                CreateBracodeImage();
            }
    })

    function ShowTransactionEditorEplain() {
        debugger
        $("#dvUserTransactionEditorArchiving").removeClass('d-flex');
        $("#dvUserTransactionEditorLink").removeClass('d-flex');
        $("#dvUserTransactionEditorExplain").addClass('d-flex');
    }

    function ShowTransactionEditorArchiving() {
        debugger
        $("#dvUserTransactionEditorArchiving").addClass('d-flex');
        $("#dvUserTransactionEditorLink").removeClass('d-flex');
        $("#dvUserTransactionEditorExplain").removeClass('d-flex');
        $("#DivtxtControls").hide();


    }
