    //    debugger
    //    $("#dvUserTransactionEditorArchiving").removeClass('d-flex');
    //    $("#dvUserTransactionEditorLink").addClass('d-flex');
    //    $("#dvUserTransactionEditorExplain").removeClass('d-flex');
    //    $("#DivtxtControls").hide();


    //}
    function ShowScannerForArchiving() {
        debugger
        $("#dvUserTransactionEditorArchiving").removeClass('d-flex');
        $("#dvUserTransactionEditorLink").removeClass('d-flex');
        $("#dvUserTransactionEditorExplain").removeClass('d-flex');
        $("#DivtxtControls").show();
        $("#dvScanningArchiving").hide();

    }

    $(document).on("change", "#ddlArcivingType", function () {
        $("#hdnArcivingTypeName").val($(this).val());
    });

    function OnDeleteArchiveMainDocumentSuccess(data, div) {
        $("#hdnArchivigMainDocumentdata").val(data.hdnValue);
        document.getElementById('frameViewer').contentWindow.location.reload();
        $("#btnAddArchiveMainDocument").show();
        $("#btnUdateArchiveMainDocument").hide();
        $("#btnCancelArchiveMainDocument").hide();
    }

    function ArchivingMainDocumentOnSuccess(data, div) {
        if (data.MessageType != 2) {
            $("#" + div).html("");
            $("#" + div).html(data.Html);
            $("#hdnArchivigMainDocumentdata").val(data.hdnValue);
            $("#hdnAttachments").val(data.hdnAttachmentsValue);
        }
        else {
            ShowErrorMessage(data.Message);
        }
    }

    function GetArchiveMainDocument(data) {
        document.getElementById('frameViewer').contentWindow.location.reload();
        $("#hdnArchiveMainDocumentId").val(data);
        $("#btnAddArchiveMainDocument").hide();
        $("#btnUdateArchiveMainDocument").show();
        $("#btnCancelArchiveMainDocument").show();
    }

    function OnUpdateArchiveMainDocumentSuccess(data) {
        $("#btnUdateArchiveMainDocument").hide();
        $("#btnAddArchiveMainDocument").show();
        $("#btnCancelArchiveMainDocument").hide();
    }

    function CancelUpdateMainDocument() {
        $.ajax({
            type: 'post',
            url: '@Url.Action("CancelUpdate", "Inbound")',
            data: { hdnMainDocumentSessionKey: $("#hdnMainDocumentSessionKey").val() },
            success:
                function (data) {
                    document.getElementById('frameViewer').contentWindow.location.reload();
               $("#btnAddArchiveMainDocument").show();
               $("#btnUdateArchiveMainDocument").hide();
               $("#btnCancelArchiveMainDocument").hide();
                }
            });
    }

    function CheckArchiveMainDocumentData() {
        if ($('#btnUdateArchiveMainDocument').is(':visible')) {
            return true;
        }
        var tokenValue = document.getElementById('frameViewer').contentDocument.getElementById("_hdnToken").value;

        if (tokenValue == "") {
            $("#doconutViewer > #CalMessage2").removeClass("hidden_");
            $("#doconutViewer > #CalMessage2").show();
            $("#doconutViewer > #CalMessageForMainDoc").html('@Html.Raw(DbRes.TValidation("User.Transaction.Archive.ArchiveRequired"))');
            return false;
        }
        return true;
    }
    function refreshDoconut() {
        document.getElementById('frameViewer').contentWindow.location.reload();
    }


    function InsertSignature(sig)
    {
        OpenCloseEditModeDoconut(true);

        if (sig =='@(((int)SigntureType.Electronic).ToString())')
        {
            debugger;

                 setTimeout(function ()
                 {
                     document.getElementById('frameViewer').contentWindow.ImageSignature();
                 }, 100);

        }
        else if (sig =='@(((int)SigntureType.Message).ToString())')
        {
            debugger;

                 setTimeout(function ()
                 {
                     document.getElementById('frameViewer').contentWindow.ImageMessage();
                 }, 100);

        }
        else
        {
                 setTimeout(function ()
                 {
                     document.getElementById('frameViewer').contentWindow.ImageStamp();
                 }, 100);
        }


        setTimeout(function ()
        {
            OpenCloseEditModeDoconut(true);
        }, 200);



    }






</script>
