@model AjaxGrid<MCS.UI.Areas.User.Models.Transaction.TransactionArchiveVM>

@{string controller = TempData.Peek("ControllerName") != null ? TempData.Peek("ControllerName").ToString() : ViewContext.RouteData.Values["controller"].ToString();}

@Html.Grid(Model).Named("grdArchivingBasicInfo").Columns(columns =>
    {
        columns.Add(m => m.Id, true);
        columns.Add(model => model.ArcivingTypeName).Titled(DbRes.TResource("User.Transaction.Archive.ArchiveType"));

        columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").RenderValueAs(model => @Html.GridImageButton(Url.Action("ViewArchive",controller), "grdArchiving", 0, OperationType.Update, "dvEdit", "dvArchivingBody :input", null, "GetArchive", "", "get", UserClaims.Archiving.EditArchiving));
        columns.Add().Encoded(false).Sanitized(false).Css("fixed_col").RenderValueAs(model => @Html.ConfirmImageButton(Url.Action("DeleteArchive",controller), "grdArchiving", 0, "dvArchivingGrid", "dvArchivingBody :input", null, "OnDeleteArchiveSuccess", null, "post", null, UserClaims.Archiving.DeleteArchiving));

    })
