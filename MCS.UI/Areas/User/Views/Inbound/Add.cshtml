<div class="white-container mx-md-5 mx-3 tab-content">
        @using (Html.BeginForm("AddInbound", "Inbound", FormMethod.Post, new { id = "frmAddInbound" }))
        {
            @Html.AntiForgeryToken()
            @Html.StickyHiddenFor(model => model.Id, new { id = "hdnInboundId" })
            @Html.StickyHiddenFor(model => model.HijriRecordDate, new { id = "hdnHijriRecordDate" })
            @Html.StickyHiddenFor(model => model.InboundBasicInfo.IsAcknowledged, new { id = "hdnIsAcknowledged" })
            @Html.StickyHidden("EncryptedModelId")
            @Html.Hidden("isConfirmed", "false", new { id = "isConfirmedId" })
            {
                Html.ViewData.TemplateInfo.HtmlFieldPrefix = "InboundBasicInfo";
                Html.ViewData.Add("HijriDate", string.Empty);
                Html.ViewData.Add("HijriDateTitle", DbRes.TResource("User.Inbound.BasicInfo.RecordDate"));
                Html.ViewData.Add("TransactionNumber", string.Empty);
                Html.ViewData.Add("TransactionNumberTitle", DbRes.TResource("User.Inbound.BasicInfo.InboundNumber"));
            }
            <div role="tabpanel" class="tab-pane active" id="first-tab">
                <div id="dvBasicInfo">
                    @Html.Partial("~/Areas/User/Views/Inbound/_BasicInfoAddPartial.cshtml", Model.InboundBasicInfo, Html.ViewData)
                </div>
            </div>




            <div role="tabpanel" class="tab-pane hidden_" id="third-tab">
                <div>
                    @{Html.ViewData.TemplateInfo.HtmlFieldPrefix = null;}
                    @Html.Partial("~/Areas/User/Views/Transaction/_NamesPartial.cshtml", new TransactionNameVM(), Html.ViewData)
                </div>
            </div>


            <div role="tabpanel" class="tab-pane hidden_" id="sixth-tab">
                <div>
                    @{Html.ViewData.TemplateInfo.HtmlFieldPrefix = null;}
                    @Html.Partial("~/Areas/User/Views/Shared/_LinksPartial.cshtml", new TransactionLinkVM(), Html.ViewData)
                </div>
            </div>
        }
    </div>
<div class="row text-right mr-5 mt-4 ml-xs-3 mb-4">
    @Html.ConfirmAction(OperationType.Save, "btnSaveInbound", DbRes.TResource("User.OutboundExternal.Save"), "AddInbound", null, null, null, "OnSuccess", null, DbRes.TResource("User.Inbound.SaveMessage"), "post", "frmAddInbound", "BasicInformation", "btn btn-st2 btn-lg pull-right", "CheckPriorityIfHasDate", UserClaims.Inbound.CreateInbound, "NotValid")
</div>
