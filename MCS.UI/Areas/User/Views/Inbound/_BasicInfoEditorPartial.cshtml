<script>


    $(document).ready(function () {
        $('html, body').animate({
            scrollTop: $('#ArchivingPartial').offset().top
        }, 'slow');
        onChangeDeliveryMethod();

        $('#HasInboundDateCal').attr('autocomplete', 'off');
        if ($(".withAppointment").val() == 0) {
            $('#datePicker').hide();
        }
        $('.disabled').prop('disabled', true);
        $('#divForm__treeDirectedToOrgUnit').find('.txtDepartmentNumber').prop('disabled', true);
        $('#divForm__treeDirectedToOrgUnit').find('.txtDepartmentName').prop('disabled', true);
        $('#divForm__treeDirectedToOrgUnit').find('a').prop("onclick", null).off('click');

        $('#HasDateCal').attr('autocomplete', 'off');

        if ($('#hdnHasDateGreg').val() == "") {
            $('.withoutAppointment').trigger('change');
            $('.withoutAppointment').attr('checked', 'checked');
        } else {
            FillDateAndTime();
        }


        $.validator.unobtrusive.parseDynamicContent = function (selector) {
            var $selector = $(selector),
                $jqValUnob = $.validator.unobtrusive,
                selectorsDataValAttr = $selector.attr('data-val'),
                $validationInputs = $selector.find(':input[data-val=true]');

            if ((selectorsDataValAttr !== 'true') &&
                ($validationInputs.length === 0)) {
                return;
            }

            if (selectorsDataValAttr === 'true') {
                $jqValUnob.parseElement(selector, true);
            }

            $validationInputs.each(function () {
                $jqValUnob.parseElement(this, true);
            });

            //get the relevant form
            var $form = $selector.first().closest('form');

            $jqValUnob.syncValdators($form);
        };

        /* synchronizes the unobtrusive validation with jquery validator */
        $.validator.unobtrusive.syncValdators = function ($form) {
            if ($.hasData($form[0])) {
                var unobtrusiveValidation = $form.data('unobtrusiveValidation'),
                    validator = $form.validate();

                // add validation rules from unobtrusive to jquery
                $.each(unobtrusiveValidation.options.rules, function (elname, elrules) {
                    if (validator.settings.rules[elname] == undefined) {
                        var args = {};
                        $.extend(args, elrules);
                        args.messages = unobtrusiveValidation.options.messages[elname];
                        $("[name='" + elname + "']").rules("add", args);
                    } else {
                        $.each(elrules, function (rulename, data) {
                            if (validator.settings.rules[elname][rulename] == undefined) {
                                var args = {};
                                args[rulename] = data;
                                args.messages = unobtrusiveValidation.options.messages[elname][rulename];
                                $("[name='" + elname + "']").rules("add", args);
                            }
                        });
                    }
                });
                // remove all validation rules from jquery that arn't in unobtrusive
                $.each(validator.settings.rules, function (elname, elrules) {
                    if (unobtrusiveValidation.options.rules[elname] === undefined) {
                        delete validator.settings.rules[elname];
                    } else {
                        $.each(elrules, function (rulename, data) {
                            if (rulename !== "messages" && unobtrusiveValidation.options.rules[elname][rulename] === undefined) {
                                delete validator.settings.rules[elname][rulename];
                            }
                        });
                    }
                });
            }
        };

        $.validator.unobtrusive.unparseContent = function (selector) {
            var $selector = $(selector);

            // if its  a text node, then exit
            if ($selector && $selector.length > 0 && $selector[0].nodeType === 3) {
                return;
            }

            var $form = $selector.first().closest('form'),
                unobtrusiveValidation = $form.data('unobtrusiveValidation');

            $selector.find(":input[data-val=true]").each(function () {
                removeValidation($(this), unobtrusiveValidation);
            });
            if ($selector.attr('data-val') === 'true') {
                removeValidation($selector, unobtrusiveValidation);
            }
            $.validator.unobtrusive.syncValdators($form);
        };

        function removeValidation($element, unobtrusiveValidation) {
            var elname = $element.attr('name');
            if (elname !== undefined) {
                $element.rules('remove');
                if (unobtrusiveValidation) {
                    if (unobtrusiveValidation.options.rules[elname]) {
                        delete unobtrusiveValidation.options.rules[elname];
                    }
                    if (unobtrusiveValidation.options.messages[elname]) {
                        delete unobtrusiveValidation.options.messages[elname];
                    }
                }
            }
        }

        SetEntityDestinationFields();

        AppendArchives();



    });




    function onChangeDeliveryMethod() {
        var value = $('#hdnBasicDeliveryMethod').val();
        switch (parseInt(value)) {
            case DeliveryMethodType.Paper:
                ShowHideReporterContent(true);
                break;
            case DeliveryMethodType.Electronic:
                ShowHideReporterContent(false);
                break;
            case DeliveryMethodType.ElectronicPaper:
                ShowHideReporterContent(true);
                break;
            default:
        }
    }

    function ShowHideReporterContent(isShow) {
        if (isShow) {
            $('#ReporterContent').removeClass('hide');
            $('#ddlBasicReporter').prop('disabled', false);
            $('#hdnBasicReporter').prop('disabled', false);
        } else {
            $('#ReporterContent').addClass('hide');
            $('#ddlBasicReporter').prop('disabled', 'disabled');
            $('#hdnBasicReporter').prop('disabled', 'disabled');
        }
    }
    function SetEntityDestinationFields()
    {
        if ($('#ForIndividual').is(':checked')) {
            $.validator.unobtrusive.unparseContent('.hdnDepartmentId');
            $.validator.unobtrusive.unparseContent('#hdnSignedById');
            $.validator.unobtrusive.unparseContent('#InboundBasicInfoEdit_InboundDocumentNumber');
            $.validator.unobtrusive.unparseContent('#hdnEditHasDateInboundUm');
            $("#ddlSignedById").trigger('change');
            $("#ddlSignedById").prop('disabled', true);
            $('#divContainerExternalParties .txtDepartmentNumber').prop('disabled', true);
            $('#divContainerExternalParties .txtDepartmentName').prop('disabled', true);
            $('.NotIndividual').hide();
        }
        else {
            $.validator.unobtrusive.parseDynamicContent('#BasicInfoPartial');
            $("#ddlSignedById").prop('disabled', false);
            $('#divContainerExternalParties .txtDepartmentNumber').prop('disabled', false);
            $('#divContainerExternalParties .txtDepartmentName').prop('disabled', false);
            $('.NotIndividual').show();
        }
        $('#inboundDestDv input[type=radio]').prop('disabled', true);
    }

    $(document).on("change", "#radio1", function () {
        if ($(this).val() == 0) {
            $('#hdnHasDateUm').val("");
            $('#hdnHasDateGreg').val("");
            $('#hdnMinute').val("");
            $('#hdnHour').val("");
            $('#datePicker').hide();
            $("#CalMessage").html('');
            $("#CalMessage1").addClass("hidden_");
        } else {
            $('#datePicker').show();
            $('#hdnHasDateGreg').val('@Model.RemindDate')
            $('#hdnHour').val('@Model.Hour')
            $('#hdnMinute').val('@Model.Minute')
            FillDateAndTime();
        }

    });

    $(document).on("click", "span[data-node-id]", function () {
        var elemnt = $(this);
        if ($(this).hasClass('fa-plus') && $(this).hasClass('LoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetExternalPartyNodes")',
                data: { parentId: $(this).data("node-id"), letterId: $("#hdnInboundDocumentType").val(), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
                    function (data) {

                        $(elemnt).closest('li').children('ul').last().empty()

                        $(elemnt).closest('li').children('ul').last().append(data);

                        if ($(elemnt).attr('data-isRefreshEnabled').toLowerCase() == 'false') {

                            $(elemnt).removeClass("LoadedData")
                        }
                    }
            });
        }
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsNodes")',
                data: { parentId: $(this).data("node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
                    function (data) {

                        $(elemnt).closest('li').children('ul').last().empty()

                        $(elemnt).closest('li').children('ul').last().append(data);

                        $(elemnt).removeClass("InternalLoadedData");
                    }
            });
        }
    });
        $(document).on("click", "span[data-multi-node-id]", function () {
        var elemnt = $(this);

        if ($(this).hasClass('fa-plus') && $(this).hasClass('LoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetExternalPartyMultyNodes")',
                data: { parentId: $(this).data("multi-node-id"), letterId: $("#hdnInboundDocumentType").val(), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func'), checkboxFunction: "ExternalCheckboxChange" },
                success:
               function (data) {
                   $(elemnt).closest('li').children('ul').last().empty()

                   $(elemnt).closest('li').children('ul').last().append(data);

                   if ($(elemnt).attr('data-isRefreshEnabled').toLowerCase() == 'false') {

                       $(elemnt).removeClass("LoadedData")

                   }

               }
            });
        }
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsMultiNodes")',
                data: { parentId: $(this).data("multi-node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
               function (data) {
                   $(elemnt).closest('li').children('ul').last().empty()

                   $(elemnt).closest('li').children('ul').last().append(data);

                   $(elemnt).removeClass("InternalLoadedData");
               }
            });
        }
    });

    function FillDateAndTime() {
        if ($(".withAppointment").length == 0) {
            return
        }
        $(".withAppointment").click();
        $('#ddlHour').val($('#hdnHour').val());
        if ($('#hdnMinute').val().length == 1) {
            $('#ddlMinute').val("0" + $('#hdnMinute').val());
        }
        else {
            $('#ddlMinute').val($('#hdnMinute').val());
        }
    }

    function CheckPriorityIfHasDate()
    {
            $('#hdnHour').val($('#ddlHour').val());
            $('#hdnMinute').val($('#ddlMinute').val());
        var individualIsChecked = $('#ForIndividual').is(":checked") ? true : false;
        if ($('#divContainerExternalParties .InboundDepName').val() == "" && individualIsChecked == false) {
            $('#divContainerExternalParties .InboundDepNum ,  #divContainerExternalParties .InboundDepName ').addClass('RedBorder');
            return false;
        }
        else {
            $('#divContainerExternalParties .InboundDepNum ,  #divContainerExternalParties .InboundDepName ').removeClass('RedBorder');
        }

         if ($('#datePicker').css('display') == 'block' && $("#hdnHasDateGreg").val() == "") {
             $("#CalMessage1").removeClass("hidden_");
             $("#CalMessage1").show();
             $('#HasDateCal, .date-icon2').addClass("RedBorder");

             $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateRequired"))');
            return false;
         }

        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        if ($("#hdnHasDateGreg").val() != "") {

            $('#hdnHour').val($('#ddlHour').val())
            $('#hdnMinute').val($('#ddlMinute').val())
            if ($("#hdnHasDateGreg").val() != undefined) {
                 var selectedDate = convertdate($("#hdnHasDateGreg").val());

                if (selectedDate < currentDate) {
                    $("#CalMessage1").removeClass("hidden_");
                    $("#CalMessage1").show();
                    $('#HasDateCal, .date-icon2').addClass("RedBorder");
                    $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.RemindDateCompare"))');
                return false;
                }
            }
        }
        if ($('#datePicker').css('display') == 'block') {
            var time = new Date();
            if (convertdate($("#hdnHasDateGreg").val()) > currentDate) {
                $("#CalMessage").html("");
                $('#HasDateCal, .date-icon2').removeClass("RedBorder");
                return CheckIfHasInboundDate();
            }
            else if ($("#hdnHasDateGreg").val() > convertdate($("#hdnHasDateGreg").val())) {
                $("#CalMessage").html("");

                $('#HasDateCal, .date-icon2').removeClass("RedBorder");

                return CheckIfHasInboundDate();
            }
            else {
                 $("#CalMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.WrongRemindTime"))');
                 return false;
            }
        }
         if (!ValidateCopy()) {
            return false;
        }

         return CheckIfHasInboundDate();
    }


    function CheckIfHasInboundDate() {
        var individualIsChecked = $('#ForIndividual').is(":checked") ? true : false;
        if ($("#HasInboundDateCal").val() == "" && individualIsChecked == false) {
            $('#HasInboundDateCal, .date-icon1').addClass('RedBorder');
        }
        else {
            $('#HasInboundDateCal, .date-icon1').removeClass('RedBorder');
        }

        if ($("#HasInboundDateCal").val() != "") {
            var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
            var currentDate = convertdate(dateNow);
            if ($("#HasInboundDateCal").val() != undefined) {
                 var selectedDate = convertdate($("#HasInboundDateCal").val());

                 if (selectedDate > currentDate) {
                    $("#CalMessage11").removeClass("hidden_");
                    $("#CalMessage11").show();
                    $("#dateMessage").html('@Html.Raw(DbRes.TValidation("User.Inbound.InboundDateCompare"))');
                    $("#CalMessage1").addClass("hidden_");
                    $("#CalMessage1").hide();
                    $('#HasInboundDateCal').addClass('invalid-input');
                    $('.date-icon1').addClass('RedBorder');
                    return false;
                }
                else {
                     $("#CalMessage1, #CalMessage11").addClass("hidden_");
                     $("#CalMessage1, #CalMessage11").hide();
                     $("#dateMessage").html('');
                     $('#HasInboundDateCal, .date-icon1').removeClass('RedBorder');
                     return checkIfHasMainDocument(true);
                }
            }
         }
         else if ($('#hdnArchivigMainDocumentdata').val() != "[]")
         {
             $("#dateMessage").html('');
             $("#CalMessage11").addClass("hidden_");
             $("#CalMessage11").hide();
            if ( individualIsChecked == false)
             $('#HasInboundDateCal, .date-icon1').addClass('RedBorder');
         }
         $("#dateMessage").html('');

        return CheckIfHasName();
    }

    function CheckIfHasName() {

        var isChecked = $('#ForIndividual:checked').val() ? true : false;
        if (isChecked) {
            var emptylength = $("#grid-table-grdNames > tbody > .grid-empty-text").length;
            if (emptylength === 1) {
                ShowErrorMessage('@Html.Raw(DbRes.TValidation("User.Inbound.NameReq"))');
                checkIfHasMainDocument(true);
            }
            else {
                return checkIfHasMainDocument(true);
            }
        }
        else {
            return checkIfHasMainDocument(true);
        }
    }


    function saveTransLetter() {
        var letterText = document.getElementById("viewer");
        alert(letterText.innerText);
    }

    function GetExternalParties(selectedNode) {
        $("#divForm__dvDestinationTree").find(".hdnDepartmentId").val(selectedNode);

        $.ajax({
            cache: false,
            type: 'get',
            url: '@Url.Action("GetExternalParties")',
            data: {
                selectedParty: selectedNode },
            success:
           function (data) {

               if ($('#divContainer__dvDestinationTree').css('display') == 'block') {

                   ShowHideTree('#divContainer__dvDestinationTree');
               }

               $('#divContainer__dvDestinationTree').remove();

               $("#divContainerExternalParties").html("");

               $("#divContainerExternalParties").html(data);

               GetDestinationUsersByOrgUnitId()
           }
        });
        return false;
    }

</script>


