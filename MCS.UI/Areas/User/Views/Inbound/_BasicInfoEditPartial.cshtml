<script>
 var mainReportId;
function getMainTransactionReportId() {
    return new Promise(function (resolve, reject) {
        var inboundId = $("#hdnInboundId").val();
        var token = $("#frmAddOutboundExternal").find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetDeliveryReportByTransactionIdV2", "Inbound")',
            data: {
                transactionId: inboundId,
                type: '@TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)',
                __RequestVerificationToken: token,
                isConfirmed: $("#isConfirmedId").val(),
            },
            success: function (data) {
                debugger;
                mainReportId = JSON.parse(data.ReportsIds);
                resolve();
            },
            error: function (err) {
                reject(err);
            }
        });
    });
}

    async function PrimaryPrintTransactionsDeliveryReportV2() {
    debugger;
    try {
        await getMainTransactionReportId();

        deliveryReportArray = [];

        var transactionId = $("#hdnInboundId").val();

        if (mainReportId.length == 0) {
            ShowErrorMessage('يجب إحالة المعاملة لكي تتكمن من طباعة بيان التسليم');
        }

        mainReportId.forEach(function (id) {
            deliveryReportArray.push({
                TransactionId: transactionId,
                ReportsIds: [id]
            });
        });

        if (deliveryReportArray.length !== 0) {
