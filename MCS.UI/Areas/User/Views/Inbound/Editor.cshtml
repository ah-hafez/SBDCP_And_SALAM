    function PrintTransaction(TransactionId) {
        var Number = $('#hdnNumber').val();

       @*var url= '@Url.Action("GetTransactionExplanationsForPrint", "Editor")' + '?transactionId=' + TransactionId

        ShowDialog(url, 'dialogbox col-md-12 ');*@

        //var data = { transactionId: TransactionId  ,__RequestVerificationToken: token };
        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("PrintTransaction", "Shared")' + '?transactionId=' + TransactionId + "&transactionNumber=" + Number,
            //data: data,
            cache: false,
            success:

                function (data) {
                    if (data.MessageType != 2) {
                        var TransactionWindow = window.open('', '_blank', 'width=900,height=500');

                        TransactionWindow.document.write(data);
                        TransactionWindow.document.close();
                        TransactionWindow.focus();

                        //setTimeout(function () {
                        //    TransactionExplanationsWindow.print();
                        //    TransactionExplanationsWindow.close();
                        //}, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }

