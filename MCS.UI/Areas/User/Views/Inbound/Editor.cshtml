    $(document).ready(function () {
        @*if ('@Model.defaultTabId' != null) {
            $("#@Model.defaultTabId").click();
        }*@

        $("#hdnTransactionId").val('@Model.Id');
        $("#hdnInboundId").val('@Model.Id');
        $('.SignedBy').hide();

        $('#draftAnchor').click(function () {
               var trxId = EncryptionKey('@Model.Id');
             window.open("@Url.Action("Add", "OutboundExternal")?baseTransactionId=" + trxId, '_self').focus();
        });


        $('#btnDirectReply').click(function () {
            var token = $('form:first').find("input[name='__RequestVerificationToken']").val();

            var replyTxtAreaContent = $('#replyTxtArea').val();
            if (replyTxtAreaContent.length == 0) {
                $('#replyValidationlabel').show();
            } else {
                $('#replyValidationlabel').hide();

                $.ajax({
                    type: 'Post',
                    url: '@Url.Action("TransactionDirectReply", "OutboundInternal")',
                    data: { transactionId: @Model.Id, remarks: replyTxtAreaContent, __RequestVerificationToken: token },
                    success: function (data) {
                        if (data.MessageType != 2) {
                            if (data.result == false) {
                                ShowErrorMessage('المعاملة عند نفس المستخدم بالفعل.');
                                return;
                            }
                            window.location.href = '@Url.Action("MyTransactions", "File")'
                        }
                        else {
                            ShowErrorMessage(data.MessageText);
                        }
                    }
                });
            }
        });
        EnableDisableControls();
      
    });

    function EnableDisableControls() {
        var editMode = '@EditMode';
        if (editMode.toLowerCase() != 'true') {
            $("#dvBasicInfo .BasicInfo .disabledByPrivilege").prop("disabled", true);
            $("#dvBasicInfo .BasicInfo .readonlyByPrivilege").prop("readonly", true);
            $('#dvBasicInfo .BasicInfo .readonlyByPrivilege').find(':input').attr('readonly', 'true');
            $('#dvBasicInfo .BasicInfo .readonlyByPrivilege').find('.ShowHideOrgHierarchyDialog').hide();
            $('#dvBasicInfo .BasicInfo .readonlyByPrivilege').find('.la-plus').parent().hide();
            $('#dvBasicInfo .BasicInfo').find('.icon_calendar').parent().hide();
        }
    }
       function ShowPrintDialog()
    {
           var params = { transactionId: $("#hdnInboundId").val() };
        ShowDialogAjaxPrintingBarcodes('@Url.Action("PrinttingBarcodes","Shared")' + "?" + $.param(params), {}, 'OpenPrintDialogSuccess', 'dialogbox col-md-12 ');
    }


    function OpenPrintDialogSuccess(data, $obj)
    {
        if (data.MessageType != 2) {
            $obj.setContent(data.Html);
        }
        else {
            __dialog.close();
            ShowErrorMessage(data.MessageText);
        }
    }

    function NotValid() {
        $('#dvBasicInfo input').each(function () {

            if ($('#dvBasicInfo input').hasClass('invalid-input')) {

                $('div, a').removeClass('selected');

                if (!$('#first').hasClass('selected'))
                    $('#first').addClass('active');

                $(".tabscontent").addClass("hidden_");
                $("#first-tab").removeClass("hidden_");

                $(".boardered-circle-transparent").removeClass("active");
                $('#first').addClass('active');

                $(window).scrollTop(0);
            }
        });
    }
                function NavigateToTransaction(Id, IsNext) {

        $.ajax({

            type: 'get',
            url: '@Url.Action("InboundNavigateTransactions","Inbound")',
            data: { CurrentId: Id, IsNext: IsNext },
            success:
                function (data) {
                    if (data.MessageType != 2) {
                       if (data.TransactionCategoryId == '@TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)') {

                            window.location.href = '@Url.Action("Editor", "OutboundInternal", new { area="User"} )' + "?id=" + EncryptionKey(data.Id);
                        } else {
                             window.location.href = '@Url.Action("Editor", "Inbound", new { area="User"} )' + "?id=" + EncryptionKey(data.Id);
                        }
                    }
                    else {
                        ShowErrorMessage(data.Message);
                    }
                }
        });
    }
    function OnSuccess(data) {
        debugger
        if (data.MessageType != 2)
        {
            ShowSuccesMessage(data.MessageText);
            if (data.ArchivingHtml) {
                $("#grid-table-grdArchiving > tbody > .grid-empty-text").remove();
                $("#grid-table-grdArchiving > tbody > tr").remove();
                $("#grid-table-grdArchiving > tbody:last").append(data.ArchivingHtml);
            }
            if (data.AttachmentHtml) {
                $("#grid-table-grdAttachments > tbody > .grid-empty-text").remove();
                $("#grid-table-grdAttachments > tbody > tr").remove();
                $("#grid-table-grdAttachments > tbody:last").append(data.AttachmentHtml);
            }
            if (data.ExternalCopiesHtml) {
                $("#grid-table-grdExternalCopies > tbody > .grid-empty-text").remove();
                $("#grid-table-grdExternalCopies > tbody > tr").remove();
                $("#grid-table-grdExternalCopies > tbody:last").append(data.ExternalCopiesHtml);
            }
            if (data.CopiesHtml) {
                $("#grid-table-grdCopies > tbody > .grid-empty-text").remove();
                $("#grid-table-grdCopies > tbody > tr").remove();
                $("#grid-table-grdCopies > tbody:last").append(data.CopiesHtml);
            }
            refreshDoconut();
            UpdateMenuFileInformation('@Url.Action("GetMenuFile", "Shared")');
            if (data.TransactionNotFound != undefined && data.TransactionNotFound == true) {
                window.location.href = '@(MCS.UI.UrlHelper.GetBaseUri() + "/User/File/MyTransactions")';
            }
            document.getElementById('ExplanationframeViewer').contentWindow.location.reload();
        }
        else {

            ShowErrorMessage(data.MessageText);
        }

        $('#officeIframe').hide();
       // window.location.reload();
    }

