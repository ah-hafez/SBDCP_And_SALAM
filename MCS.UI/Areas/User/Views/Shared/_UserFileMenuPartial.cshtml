</div>
<style>


    .icon-menu-1 .path1:before {
        content: "\e911";
        color: rgb(23, 101, 62);
    }

    .icon-menu-1 .path2:before {
        content: "\e912";
        margin-left: -1em;
        color: rgb(136, 177, 75);
    }

    .icon-menu-1 .path3:before {
        content: "\e913";
        margin-left: -1em;
        color: rgb(23, 101, 62);
    }

    .icon-menu-1 .path4:before {
        content: "\e914";
        margin-left: -1em;
        color: rgb(136, 177, 75);
    }

    .icon-menu-10:before {
        content: "\e92f";
        color: #17653e;
    }


   
</style>

<script>
    $(document).ready(function () {
        var actionUrl = window.location.pathname.split("/")[4];
        var OutboundEditUrl = window.location.pathname.split("/")[3];
        switch (actionUrl) {
            case 'MyTransactions':
                $("#selected").addClass("active");
                break;
            case 'DraftOutbound':
                $("#selected2").addClass("active");
                break;
            case 'SentTransactions':
                $("#selected3").addClass("active");
                break;
            case 'Saved':
                $("#selected4").addClass("active");
                break;
            case 'Manager':
                $("#selected5").addClass("active");
                break;
            case 'Copies': case 'Index':
                $("#selected6").addClass("active");
                break;
            case 'Tasks':
                $("#selected7").addClass("active");
                break;
            case 'FollowUp':
                $("#selected8").addClass("active");
                break;
            case 'Reservation':
                $("#selected9").addClass("active");
                break;
            default:
                $("#selected").addClass("active");
                break;
        }
        switch (OutboundEditUrl) {
            case 'OutboundExternal':
                $("#selected2").addClass("active");
                $("#selected").removeClass("active");
                break;
            case 'Reservation':
                $("#selected9").addClass("active");
                $("#selected").removeClass("active");
                break;
        }

        GetTraysCount();
    });

</script>
