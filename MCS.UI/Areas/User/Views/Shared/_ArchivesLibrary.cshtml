@model MCS.UI.Areas.User.Models.Shared.ArchivesLibrary
@using MCS.Common;
@using MCS.Framework.Localization
@using MCS.Framework.Controls;
@using MCS.UI.Helpers
@using MCS.UI.Areas.User.Models.ExternalParties
@using MCS.UI.Areas.User.Models.Transaction
@{
    /**/

    ViewBag.Title = DbRes.TResource("مكتبة الوثائق");
    Layout = "~/Areas/User/Views/Shared/LayoutOne.cshtml";

}


<div style="display:flex; place-content:space-between">
    <h2 class="mt-3" style="margin-right:44px;">مكتبة الوثائق</h2>
    @*<div class="pl-0 pr-0 nav-button">
        <a href="@Url.Action("Systems","Shared")" data-bs-toggle="tooltip" data-placement="bottom" title="@DbRes.TResource("Global.Logout")">
            <i class="la la-arrow-left"></i>
        </a>
    </div>*@
</div>
    <div class="white-container mx-5 mx-xs-3">
        <div class="single-wrapper">
            @using (Html.BeginForm("", "", FormMethod.Post, new { id = "frmAddArchivesLibrary", @class = "tab-content" }))
            {
                @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("رقم الوثيقة") <span class="stark">*</span></label>
                    <div>
                        @Html.TextBoxGroupFor(model => model.DocumentNum, "BasicInformation", new { @Value = "", @class = "form-control" })
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                    <label class="w-100">@DbRes.TResource("الجهة") </label>
                    <div>
                        @Html.TextBoxGroupFor(model => model.Orgnization, "BasicInformation" , new { @Value = "", @class = "form-control" })
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                    <div class="form-group">
                        <label class="w-100">@DbRes.TResource("عدد الصفحات")</label>
                        <div>
                            @Html.NumericTextBoxFor(model => model.PagesNum, new { @Value = "", @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                    <div class="form-group">
                        <label class="w-100">@DbRes.TResource("نوع الوثيقة") <span class="stark">*</span></label>
                        <div>
                            @Html.AutoCompleteBuilder("ddlTypeId", "hdnTypeId", ViewData["LetterTypeData"].ToString(), Model != null ? ViewData["LetterTypeData"].ToString() : null, true, "form-control", "hdnTypeIsPopularization", "", "", true)
                            @Html.HiddenGroupFor(model => model.DocumentType, new { @Value = "", id = "hdnTypeId" }, "BasicInformation")
                            @Html.Hidden("hdnTypeIsPopularization", null, new { id = "hdnTypeIsPopularization" })
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                    <div class="form-group">
                        <label class="w-100">@DbRes.TResource("User.Transaction.ConfidentialityLevel") <span class="stark">*</span></label>
                        <div>
                            @Html.AutoCompleteBuilder("ddlConfedentiality", "hdnConfedentiality", ViewData["ConfidentialityData"].ToString(), Model != null ? ViewData["ConfidentialityData"].ToString() : null, true, "form-control", "", "", "", true)
                            @Html.HiddenGroupFor(model => model.ConfidentialityLevel, new { @Value = "", id = "hdnConfedentiality" }, "BasicInformation")
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                    <div class="form-group">
                        <label class="w-100">@DbRes.TResource("المنطوق") </label>
                        <div>
                            @Html.TextBoxGroupFor(model => model.Operative, "BasicInformation", new { @Value = "", @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                    <div class="form-group">
                        <label class="w-100">@DbRes.TResource("كلمات مفتاحية") <span class="stark">*</span></label>
                        <div>
                            @Html.TextBoxGroupFor(model => model.Keywords, "BasicInformation", new { @Value = "", @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3 with-icon">
                    <label>@DbRes.TResource("تاريخ الوثيقة") <span class="stark">*</span> </label>
                    @Html.CalendarCustom("HasInboundDateCal", "hdnHasInboundDateGreg", "hdnHasDateInboundUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), Model != null ? Model.Date.ToString() : null, "form-control")
                    <a class=" date-icon2 " onclick="showCalender('HasInboundDateCal')"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                    @Html.StickyHidden("hdnHasInboundDateGreg", null, new { id = "hdnHasInboundDateGreg" })
                    @Html.HiddenGroupFor(model => model.Date, new { id = "hdnHasDateInboundUm", AutoComplete = "off" }, "BasicInformation")
                </div>
            </div>
                <div style="display:flex; place-content:space-between">
                    <div style="display: flex; gap: 12px; padding-right: 12px; border-radius: 25px; width: 160px; margin-right: 33px; background: #e9e9e9; height:45px;">
                        <a id="dvScanningIcon">
                            <div class="" style="display:flex; margin-top:10px; gap:6px; padding-right:5px;">
                                <div class="">
                                    <i class="fas fa-print" style="font-size:24px; color:black;"></i>
                                </div>
                                <span style="font-weight:bold">الماسح الضوئي</span>
                            </div>
                        </a>
                    </div>
                    <div style="display:flex;">
                        <div class="panel-body row text-right">
                            <input type="button" value="@DbRes.TResource("User.Search.SubmitSearch")" class="btn btn-st1 btn-lg pull-right" onclick="FilterBy()" />
                        </div>
                        <div class="panel-body row text-right">
                            @Html.ConfirmAction(OperationType.Save, "btnSaveOutboundExternal", DbRes.TResource("User.OutboundDraft.Edit"), "AddArchivesLibrary", null, null, null, "OnSuccess", null, DbRes.TResource("User.OutboundExternal.SaveMessage"), "post", "frmAddArchivesLibrary", "BasicInformation", "btn btn-st1 btn-lg pull-right", "", UserClaims.Outbound.CreateExternalOutbound, "NotValid")
                            <input class="btnSendOutbound btn-site" style="display:none;" type="button" value="إرسال" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-12" style="display:none" id="archiveDocu">
                    @Html.Partial("~/Areas/User/Views/Transaction/_ArchivingPartialMainDocument.cshtml", new TransactionArchiveVM(TransactionAttachmentType.Main, true, false, false,
                                                       bStampPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Mark),
                                                       bSignaturePermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Signature),
                                                       bAnnotationsPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.Archiving.Annotations),
                                                       bColorScanningPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.Archiving.ColorScanning)), Html.ViewData)
                </div>

            }

        </div>


        @*<div class="row text-right mr-5 mt-4 ml-xs-3 mb-4">
                @Html.ConfirmAction(OperationType.Save, "btnSaveOutboundExternal", DbRes.TResource("User.OutboundDraft.Edit"), "AddArchivesLibrary", null, null, null, "OnSuccess", null, DbRes.TResource("User.OutboundExternal.SaveMessage"), "post", "frmAddArchivesLibrary", "BasicInformation", "btn btn-st1 btn-lg pull-right", "CheckPriorityIfHasDate", UserClaims.Outbound.CreateExternalOutbound, "NotValid")
                <input class="btnSendOutbound btn-site" style="display:none;" type="button" value="إرسال" />
            </div>*@

        @*<div id="dvEditorPartialContainer" style="position:absolute;">
                @Html.Partial("~/Areas/User/Views/Transaction/_ArchivingPartialMainDocument.cshtml", new TransactionArchiveVM(TransactionAttachmentType.Main, true, false, false,
                                                     bStampPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Mark),
                                                     bSignaturePermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Signature),
                                                     bAnnotationsPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.Archiving.Annotations),
                                                     bColorScanningPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.Archiving.ColorScanning)), Html.ViewData)
            </div>*@
    </div>



<script>
    var dvScanningIcon = document.querySelector('#dvScanningIcon');
    var archiveDocu = document.querySelector('#archiveDocu');

    dvScanningIcon.addEventListener('click', () => {
        debugger
        if (archiveDocu.style.display === "none") {
            archiveDocu.style.display = "block";
        } else {
            archiveDocu.style.display = "none";
        }
    });
</script>