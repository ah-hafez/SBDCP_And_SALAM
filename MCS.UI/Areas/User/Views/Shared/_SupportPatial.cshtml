<script>
    var emptyMessageFile = '@Html.Raw(DbRes.TResource("User.Support.Attachment"))';
    function ValidateAttachmentFile() {

        var count = $("#UploadedFilesName  .file").length;
        if (count == 0)
        {
            return true;
        }
        else if (count > 0) {
            $("#glyphiconSupport").hide();
            $("#CalMessageSupport").html('');
            $('.btn-upload').removeClass("RedBorder");
            var name = document.getElementById('files');
            var FilesName = [];
            for (i = 0; i < name.files.length; i++) {
                var fileOption = document.getElementById('files').files[i];
                var isValidSize = Math.round(fileOption.size / 1024 / 1024) >= 1;//Convert Byte to MB => (fileOption.size / 1024 / 1024) =
                if (isValidSize) {
                    $("#CalMessageSupport").html('@Html.Raw(DbRes.TValidation("User.Support.FileExceedOneMB"))');
                    FilesName.push(i+1 + '- ' + name.files[i].name + '  ');
            }
            }
            if (FilesName.length > 0)
                $("#FileNameSupport").html('@Html.Raw(DbRes.TResource("User.Support.UploadFileName"))' + FilesName);
            else {
                $("#FileNameSupport").html('');
                return true;
            }
        }
        else {
            ShowErrorFile(emptyMessageFile);
            return true;
        }
    }

