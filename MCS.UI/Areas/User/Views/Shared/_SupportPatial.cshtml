                                @Html.AutoCompleteBuilder("ddlSubProblem", "Category", ViewData["SubProblem"].ToString(), Model != null ? " " : null, true, "form-control", "", "", "", false)
                                @Html.HiddenGroupFor(model => model.Category, new { @Value = "", id = "Category" }, "BasicInformation")
                            </div>
                        </div>
