                            @Html.LabelFor(model => model.Category, new { @class = "control-label" })<span class="stark">*</span>
                            <div>
                                @Html.AutoCompleteBuilder("ddlSubInquery", "Category", ViewData["SubInquery"].ToString(), Model != null ? " " : null, true, "form-control", "", "", "", false)
                                @Html.HiddenGroupFor(model => model.Category, new { @Value = "", id = "Category" }, "BasicInformation")
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <fieldset>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Description, new { @class = "control-label" })<span class="stark">*</span>
                            <div>
                                @Html.TextAreaGroupFor(model => model.Description, new { @class = "form-control", @maxlength = "2000" }, "BasicInformation")
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="content_container content_container--footer">
                <div class="row">
                    <div class="col-xs-12 text-center">
                        @Html.ActionButton(buttonText: DbRes.TResource("User.Transaction.Send"), actionUrl: "ReceiveSupport", divUpdatData: "", paramObj: null, contentType: "multipart/form-data",
                        onAjaxSuccess: "showResponeMssge", cssClass: "btn-site", formId: "mainform", validationGroup: "BasicInformation", actionType: "post", clientFunctionToCall: "ValidateAttachmentFile", buttonID: "Send")
