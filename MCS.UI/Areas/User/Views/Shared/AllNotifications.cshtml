<script>
    $(document).ready(function () {
        $('#fromDateCal').attr('autocomplete', 'off');
        $('#toDateCal').attr('autocomplete', 'off');
    });
    function DeleteNote(id) {
        $.ajax({
            type: 'Post',
            url: '@Url.Action("DeleteNotifications","Home")',
            data: { ids: id },
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        $.each(data.ids, function (index, value) {
                            $("#note_" + value).remove();
                        });
                    }
                }
        });
    }

    function MarkAsReadNotification(id) {
        $.ajax({
            type: 'get',
            url: '@Url.Action("MarkAsReadNotification", "Home")',
            data: { ids: id },
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        $.each(data.ids, function (index, value) {
                            $("#note_" + value).removeClass("bgchange new-notification");
                        });
                    }
                }
        });
    }
</script>

