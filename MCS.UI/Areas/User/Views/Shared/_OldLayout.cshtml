</script>
<script>
    $('.change_your_password').click(function () {

        ShowDialogAjax('@Url.Action("RenderChangePasswordPartial","UserProfile")', {}, 'OpenChangePasswordDialogSuccess');
    });

    function OpenChangePasswordDialogSuccess(data, $obj) {

        $obj.setContent(data.View);
        jQuery.validator.unobtrusive.parse('#frmChangePassword');
    }


    $("#searchCertificate").keydown(function (e) {
        if (e.keyCode == 13)
        {
            getCertificate();

            return false;
        }
    });

    function getCertificate()
    {
        var codeValue = $('#searchCertificate').val();
        if (codeValue != "") {
            ShowDialogAjax('@Url.Action("GetCertificate")', { transactionCode: codeValue }, 'OpenCertificateDialog');
            $('#searchCertificate').val("");
        }
    }

    function OpenCertificateDialog(data, $obj)
    {
        if (data.MessageType != 2)
        {
            $obj.setContent(data.Html);
        }
        else{
            __dialog.close();
            ShowErrorMessage(data.MessageText);
            return false
        }
    }

    function CallHomePage(id) {
        $.ajax({
            url: '@Url.Action("SetOrgUnit", "Home")',
            type: 'POST',
            data: { 'orgUnitId': id },
            success: function (data) {
                window.location.href = '@(YESSER.NCS.MCS.UI.UrlHelper.GetBaseUri() + "/User/Home/Index")';
            },
            error: function (a) {
            }
        });
    }

    function ChangeCulture(name) {
        $.ajax({
            url: '@Url.Action("SetCultureName", "Home")',
            type: 'POST',
            data: { 'cultureName': name },
            success: function (data) {
                window.location.href = data.ReturnUrl;
            },
            error: function (a) {
            }
        });
    }
</script>
<script>
    var custom_templatePlugins = function () {

        var custom_tp_clock = function () {

            function custom_tp_clock_time() {
                var now = new Date();
                var hour = now.getHours();
                var minutes = now.getMinutes();
                var suffix = (hour >= 12) ? '@DbRes.TResource("Global.Time.PM")' : '@DbRes.TResource("Global.Time.AM")';

                hour = ((hour + 11) % 12 + 1);
                hour = hour < 10 ? '0' + hour : hour;
                minutes = minutes < 10 ? '0' + minutes : minutes;

                $(".timeplugin-clock").html(hour + "<span>:</span>" + minutes + " " + suffix);
            }
            if ($(".timeplugin-clock").length > 0) {

                custom_tp_clock_time();

                window.setInterval(function () {
                    custom_tp_clock_time();
                }, 10000);

            }
        }

        return {
            init: function () {
                custom_tp_clock();
            }
        }
    }();

    $(function () {
        custom_templatePlugins.init();
    });

</script>

