            url: '@Url.Action("GetCollaborationUsers")',
            data: { },
            Async:true,
            global: false,
            success:
               function (data)
               {
                   data.Users.Result.forEach(function(entry) {
                       var id= @userVM.Id;

                       if(entry.UserId != id ){

                           if ( $( "#User"+ entry.UserId).length < 1 )
                           {
                               CreateNewUserOffline(entry.UserName,entry.UserId, entry.NotificationCount);

                               AllUsers.push($('.onlineUser[data-online-userid="' + entry.UserId + '"]'));

                           }

                           InitializeUserNotifysCount(entry.UserId,entry.NotificationCount);
                       }

                   });
               }
        });

    }


    function GetInitialNotifications()
    {
        if(pageIndex==0)
            return false;

        $.ajax({
            type: 'get',
            url: '@Url.Action("GetNotifications")',
            data: { index : pageIndex , pageSize: notificationPageSize},
            Async:true,
            global: false,
            success:
               function (data) {
                   if(data.Notifications==undefined)
                   {
                       return ;
                   }

                   if(data.Notifications.length==0)
                   {
                       pageIndex=0;
                       return false ;
                   }
                   data.Notifications.forEach(function(body) {
                       $("#mCSB_2_container").append(body);
                   });
                   pageIndex= pageIndex + 1;
               }
        });
    }


    function GetNotifications()
    {
        if(pageIndex==0)
            return false;

        if(AllowSend)
        {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetNotifications")',
                data: { index : pageIndex , pageSize: notificationPageSize},
                Async:true,
                global: false,
                success:
                   function (data) {

                       if(data.Notifications==undefined){
                           return ;
                       }
                       if(data.Notifications.length==0)
                       {
                           pageIndex=0;
                           return false ;
                       }
                       data.Notifications.forEach(function(body) {
                           $("#mCSB_2_container").append(body);
                           AllowSend=true;
                       });
                       pageIndex= pageIndex + 1;
                   }
            });

        }
    }

    function SetNotification(text)
    {
        var htmlNotification = $(".informer-danger").html();

        var notificationCount=parseInt(htmlNotification)

        notificationCount=notificationCount + 1

        $(".redBullon").html( notificationCount);

        $(".redBullon").show();

        SetNotificationCookies(notificationCount);

        $("#mCSB_2_container").prepend(text);
    }

    function CreateNewNotification(text)
    {
        var row="<a href='#' class='list-group-item'><div class='list-group-status status-online'></div><p>"+ text + "</p></a>";

        return row;
    }

    function SetScrollToTop(elemnt)
    {
        $(elemnt).scrollTop($(elemnt)[0].scrollHeight);
    }

    function AppearOnlineUser(userId)
    {
        $('.appear[data-online-userid="' + userId + '"]').addClass("online").addClass("onlineUser");
    }

    function DisabledOnlineUser(userId)
    {
        $('.appear[data-online-userid="' + userId + '"]').removeClass("online");
    }

    function ComfirmBindingChat(transactionId)
    {

        SelectedTransactionId=transactionId;
        IsBindingWithTransaction= true;
    }

    function ResetChatBinding()
    {
        IsBindingWithTransaction= false;
    }

    function SetChatAsExplanation(userId)
    {
        var element=$('.messageRow[data-userid-chat-window="' + userId + '"]');
        element.addClass("TransactionRowMessage");
        element.removeClass("messageRow");
    }

    function SetChatBinding(userId, transactionId)
    {
        var element=$('.messageRow[data-userid-chat-window="' + userId + '"]');
        element.addClass("TransactionRowMessage");
        element.removeClass("messageRow");
        element.data("transactionId",transactionId)
        element.attr('data-transactionId', transactionId);
        $('.TransactionRowMessage[data-userid-chat-window="' + userId + '"]').data("transactionId",transactionId);
        $('.TransactionRowMessage[data-userid-chat-window="' + userId + '"]').attr('data-transactionId', transactionId);
    }

    $(function () {

        var connection = $.hubConnection('@SystemConfigurations.WebApiUrl');

        connection.start({jsonp:true}).done(function () {
            messageBroadCastHub=messageBroadCast
            messageBroadCast.invoke("onConnected",@userVM.Id ,"@userVM.LoclizationName.Where(l => l.CultureName == SessionInfo.CultureShortName).FirstOrDefault().Text" , @SessionInfo.OrgUnitId);

            $(document).on("click",".onlineUser",function(message) {

                var userId=$(this).data("online-userid");

                if(IsUserChatWindowOpened(userId))
                    return;

                var notificationCount=GetUserNotifysCount(userId);

                ResetUserNotifysCount(userId);

                DecreaseChatNotification(notificationCount);

                var chatWindow=$('*[data-userid-chat-window="' + userId + '"]');

                var userName=$(this).data("online-username");

                GetIntitialChatHistory(UrlInitChatData,userId, userName, function(){

                    SetChatBinding(userId, SelectedTransactionId)
                    SelectedTransactionId=null;
                });

                messageBroadCast.invoke("AddChatWindow",userId);

            });

            $(document).on("click",".close_conversation",function(message) {
                var userId = $(this).data("userid-close-chat-window");
                $('*[data-userid-chat-window="' + userId + '"]').hide();

                messageBroadCast.invoke("RemoveChatWindow",userId);
            });


            $(document).on("keypress",".TransactionRowMessage",function(message) {

                var key = window.event.keyCode;

                var textValue=$(this).val();

                textValue=textValue.trim()

                if (key == 13 && textValue !="") {
                    var userId= $(this).data("userid-chat-window");
                    var transactionId= $(this).data("transactionId");
                    messageBroadCast.invoke("onSendChatMessage",userId,textValue,transactionId);
                    var instanceMessageDesign=CreateInstanceMessageDesign("@userVM.Name",textValue,new Date().toLocaleString());
                    AddInstanceMessageToChatWindow(userId,instanceMessageDesign);
                    $(this).val("");

                    SetScrollToTop("stage_chat_userId_" + userId)
                }

            });

            $(document).on("keypress",".messageRow",function(message) {

                var key = window.event.keyCode;

                var textValue=$(this).val();

                textValue=textValue.trim()

                if (key == 13 && textValue !="") {
                    var userId= $(this).data("userid-chat-window");
                    messageBroadCast.invoke("onSendChatMessage",userId,textValue,null);
                    var instanceMessageDesign=CreateInstanceMessageDesign("@userVM.Name",textValue,new Date().toLocaleString());
                    AddInstanceMessageToChatWindow(userId,instanceMessageDesign);
                    $(this).val("");

                    SetScrollToTop("stage_chat_userId_" + userId)
                }

            });
        });

        var messageBroadCast = connection.createHubProxy('notificationService');

        var messageBroadCast2 = connection.createHubProxy('signalRNotificationService');

        messageBroadCast.on("displayNotification", function (message) {


            showSuccessToast(message.Body);

        });

        messageBroadCast2.on("displayNotification", function (message) {

            message.Body = message.Body.replace("{BaseUrl}", "@YESSER.NCS.MCS.UI.UrlHelper.GetBaseUri()");
            showSuccessToast(message.Body);
            SetNotification(message.Body);
        });


        messageBroadCast.on("showMessage", function (fromUser,message, date , transactionId) {

            if(!IsUserChatWindowOpened(fromUser.UserId)){

                if(GetUserNotifysCount(fromUser.UserId) == 0 ){
                    IncreaseChatNotification();
                }
                IncreaseUserNotifysCount(fromUser.UserId);
                return ;
            }
            var stageChat=  $("#stage_chat_userId_" + fromUser.UserId);
            var instanceMessageDesign=CreateInstanceMessageDesign(fromUser.UserName,message,date);
            AddInstanceMessageToChatWindow(fromUser.UserId,instanceMessageDesign);
            SetScrollToTop("stage_chat_userId_" + fromUser.UserId)

            if(transactionId > 0){
                SetChatBinding(fromUser.UserId,transactionId);
            }

        });

        messageBroadCast.on("getOnlineUsers", function (message) {
            message=eval(message)
            message.forEach(function(entry) {

                var id= @userVM.Id;

                if(entry.UserId != id ){

                    if ( $( "#User"+ entry.UserId).length < 1 )
                    {
                        CreateNewUserOnline(entry.UserName,entry.UserId);

                        AllUsers.push($('.onlineUser[data-online-userid="' + entry.UserId + '"]'));
                    }
                    else {

                        $( "#name_other_"+ entry.UserId).val("");

                        $( "#name_other_"+ entry.UserId).val(entry.UserName);
                    }

                    AppearOnlineUser(entry.UserId);
                }

            });

        });

        messageBroadCast.on("newUserConnected", function (message) {

            message=eval(message)
            $( "#name_other_"+ message.UserId).html("");
            $( "#name_other_"+ message.UserId).html(message.UserName+'<div class="appear online"></div>');
            AppearOnlineUser(message.UserId);
        });

        messageBroadCast.on("ShowMessageDate", function (date) {

            $('.time_other').each(function (index, value) {

                var text=$(this).text().trim();
                if(text == "") {
                    $(this).text(date)
                }
            });

        });

        messageBroadCast.on("disconnectUser", function (userId) {

            $("#name_other_"+ userId).html($("#name_other_"+ userId).html() + '<div class="appear"></div>');
            DisabledOnlineUser(userId);
        });

    });

    function showSuccessToast(message) {

        $().toastmessage({
            text: message,
            sticky:false,
            stayTime:10000,
            position : 'top-right',
            type     : 'success',
            closeText: '',
            close    : function () {
                console.log("toast is closed ...");
            }});

        $().toastmessage('showSuccessToast', message);
    }
</script>