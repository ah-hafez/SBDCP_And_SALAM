@using MCS.UI.Areas.User.Models.Notifications
@model AjaxGrid<NotificationVM>

@{
    Layout = null;
}
<div>
    <div class="d-flex mb-3 mx-5 mx-xs-3 header-container">
        <h3 class="site-color">
            @DbRes.TResource("Global.Notifications")
            <span class="new-notifications-count ml-2">
                (<i>@Model.ItemsCount</i>) @DbRes.TResource("Global.NewNotifications")
            </span>
        </h3>
    </div>
    <div class="white-container  mx-5 mx-xs-3">
        @{Html.RenderPartial("~/Areas/User/Views/Shared/_NotificationGridPartial.cshtml", Model);}
    </div>
</div>

<script>
    var myNotificationGridEventHandler = "@Url.Action("AllNotification", "Home")";
    function prepareNotificationGrid() {
        if (!pageGrids.NotificationGrid) {
            $(".grid-mvc").gridmvc();
        }
        pageGrids.NotificationGrid.ajaxify({
            getPagedData: myNotificationGridEventHandler,
            getData: myNotificationGridEventHandler,
            //callbackClientFunctionAfter: ["goToViewAfterPaging"]
        });
    }

    $(document).ready(function () {
        prepareNotificationGrid();
    });

</script>