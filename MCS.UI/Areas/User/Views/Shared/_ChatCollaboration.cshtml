
<div class="carddiv" id="carddiv">
    <div class="firstcard">
        <div class="card-header purple">
            <i class="la la-close"></i>
        </div>
        <div class="topnav py-3 px-3">
            <span id="chatTransNumber" class="py-1">@DbRes.TResource("User.Transaction.Chat.TransNumber") {0}</span>
            <div id="chatUserSearchDiv" class="input-group">
                <input type="text" class="form-control" id="chatUserSearch">
                <div class="input-group-append">
                    <span class="input-group-text hyperlink2">
                        <a href="#"><i class="fa fa-search"></i></a>
                    </span>
                </div>
            </div>
        </div>
        <div id="chatUsers" style="display:none;" class="chat_list">
            <div class="" id="chatUsersList">
            </div>
            <label id="chatUsersNoResultLabel" style="display:none;">@DbRes.TResource("User.Transaction.Chat.NoResults")</label>
        </div>
        <div id="chatConversationsShare" style="display:none;" class="chat_list">
            <div class="" id="chatConversationsShareList">
            </div>
        </div>
        <div id="chatConversations" class="chat_list">
            <div class="" id="chatConversationsList">
            </div>
        </div>
    </div>

        <div class="popchat">
            <div class="card-header2 purple2">
                <i class="fas fa-times"></i>
            </div>
            <div class="the_user d-flex align-items-center">
                <div class="circle-img mr-2">
                    <img src="~/Content/User/lib/images/avatar.svg">
                </div>
                <span id="popChatUserName">
                    @DbRes.TResource("User.Transaction.Chat.User")
                </span>
                <div class="ml-auto" style="display:none;" id="chatTransSave">
                    <button id="btnSaveTransChat" type="submit" class="btn  btn-st2">@DbRes.TResource("User.Transaction.Chat.SaveTransactionChat")</button>
                </div>
            </div>
            <div class="for-scroll" id="messageListContainer">
                <div class="" id="messageList">
                </div>
            </div>

            <div class="message-input">
                <textarea id="txtChatMessage" placeholder="@DbRes.TResource("User.Transaction.Chat.TextArea")" type="text" class="form-control" maxlength="500"></textarea>
                <i id="btnSendChatMessage" class="la la-send la-flip-horizontal"></i>
            </div>
        </div>
</div>

<div class="modal fade" id="shareEmpModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h3 class="dark-color w-auto d-inline-block m-0">@DbRes.TResource("User.Transaction.Chat.UsersList")</h3>
            </div>
            <div class="modal-body">
                <div class="content_container">
                    <div class="search-employee-input d-inline-block">
                        <div class="input-group mb-3">
                            <input id="chatModalUserSearch" type="text" class="form-control" placeholder="@DbRes.TResource("User.Transaction.Chat.Search")">
                            <div class="input-group-append">
                                <span class="input-group-text hyperlink2">
                                    <a href="#"><i class="fa fa-search"></i></a>
                                </span>
                            </div>
                        </div>
                    </div>
                    @*<div class="correspondence-icon bg-white d-inline-block px-0 mx-1">
                        <a class="circle color-light-gray border-box2" href="#"><i class="la la-close gray-color font-22P"></i></a>
                    </div>*@
                    <div class="">
                        <div id="chatModalUsersList" style="overflow-y:auto; max-height:400px;">
                            <div class="chat-row">
                            </div>
                        </div>
                    </div>
                    <div id="chatModalInviteStatus" style="display:none;">
                        <p id="chatModalInviteStatusText"></p>
                    </div>
                </div>
                <div class="text-right chat_button py-2">
                    <button class="btn btn-st2 btn-lg mx-1" data-dismiss="modal">@DbRes.TResource("User.Transaction.Chat.Cancel")</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="shareLetterModal" role="dialog">
    <div class="modal-dialog" style="width:90%">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h3 class="dark-color w-auto d-inline-block m-0">@DbRes.TResource("User.Transaction.Chat.ShareTitle")</h3>
            </div>
            <div class="modal-body">
                <div class="content_container">
                    <div class="white-container bg-lightest-gray mx-5 mx-xs-1 height-co-100">
                        <div class="d-flex h-100">
                            <div class="chat-section col-lg-4 col-sm-12 col-xs-12 align-self-stretch px-0">
                                <div class="d-flex align-items-center">
                                    <div class="circle-img">
                                        <img class="w-100" src="~/Content/User/lib/images/avatar.svg">
                                    </div>
                                    <span id="shareChatFromUserName" class="dark-color mx-3"></span>
                                    <div class="ml-auto">
                                        <button class="btn btn-st1 d-inline-block d-sm-none w-100" data-toggle="modal" data-target="#ChatModal">
                                            @DbRes.TResource("User.Transaction.Chat.ShareDisplayTitle")

                                        </button>
                                    </div>
                                </div>
                                <hr class="my-2">
                                <div class="day_message mb-2 for-scroll" id="shareChatMessageContainer">
                                    <div class="" id="shareChatMessageList">
                                    </div>
                                </div>
                                <div class="message-input">
                                    <textarea id="txtShareChateMessage" placeholder="@DbRes.TResource("User.Transaction.Chat.TextArea")" type="text" class="form-control" row="1"></textarea>
                                    <i id="btnSendShareChatMessage" class="la la-send la-flip-horizontal"></i>
                                </div>
                            </div>
                            <div class="note-section col-lg-8  col-sm-12 col-xs-12 p-0 d-flex align-self-stretch bg-white tse-scrollable demo1">
                                <div class="border-box p-2 px-3 align-self-stretch tse-content">
                                    <i class="full-screen-icon la la-expand dark-color p-2 border-box mb-1 cursor-pointer"></i>
                                    <i class="full-screen-icon fa fa-compress dark-color p-2 border-box mb-1 cursor-pointer"></i>
                                    <p class="shareChatLetterText">
                                    </p>
                                </div>
                            </div>
                            <div class="modal fade in" id="ChatModal" role="dialog">
                                <div class="modal-dialog small-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <button type="button" class="close" data-dismiss="modal">×</button>
                                        </div>
                                        <div class="modal-body saves">
                                            <p class="shareChatLetterText">
                                            </p>

                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-right chat_button py-2">
                    <button class="btn btn-st2 btn-lg mx-1" data-dismiss="modal">@DbRes.TResource("User.Transaction.Chat.Cancel")</button>
                </div>
            </div>
        </div>
    </div>
</div>
