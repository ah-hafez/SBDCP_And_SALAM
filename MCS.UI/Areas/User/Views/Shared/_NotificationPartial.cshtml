@using MCS.Framework.Localization

<div class="notifications dropdown px-2">
    <a id="dropdownMenuLink" href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="false"
       aria-expanded="true" data-toggle-second="tooltip" data-placement="bottom" title="@DbRes.TResource("Global.Notifications")">
        <img src="~/Content/User/lib/images/SystemIcon/main bar-07.svg" width="30" />
        <span class="informer informer-danger notice" style="background:red">0</span>

    </a>
    <ul id="singnalRMessage" class="dropdown-menu dropdown-menu-left notification-dropdown" aria-labelledby="drop1"></ul>
</div>



<style>
    .redBullon {
        width: inherit !important;
        height: inherit !important;
    }
</style>
<script>
    function MarkAsReadNotificationHeader(id) {
        event.preventDefault();
        $.ajax({
            type: 'get',
            url: '@Url.Action("MarkAsReadNotification", "Home")',
            data: { ids: id },
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        var href = $("#UnRead_" + data.ids[0]).attr('href');
                        $("#UnRead_" + data.ids[0]).removeClass("bgchange new-notification");
                        if (href != "" && href != undefined) {
                            window.location.href = href;
                        }
                    }
                }
        });
    }
</script>