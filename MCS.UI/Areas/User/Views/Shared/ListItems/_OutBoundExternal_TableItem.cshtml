                        <a class="" data-id="@Model.TransactionDetailsInfoVM.Id" onclick="PrintManifest()" data-tray="@trayId" data-type="@Model.TransactionDetailsInfoVM.TransactionCategoryId" title="@DbRes.TResource("User.ELcOutbound.PrintManifest")">
                            <img src="~/Content/User/lib/images/SystemIcon/printer.svg" width="25" />
                        </a>
                    }
                    @Html.StickyHidden("transId")
                }
            }
            else
            {
                @*<a class="circle color-delet" title="@DbRes.TResource("Global.DrafOutbound")" onclick="javascript:showRejectionPopup(@Model.TransactionDetailsInfoVM.Id)"><i class="demo-icon icon-return"></i></a>*@
                @Html.StickyHidden("transId")
            }
            @*<div class="ml-auto">
                    <div class="info">
