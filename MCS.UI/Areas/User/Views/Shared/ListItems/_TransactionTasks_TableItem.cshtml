@using MCS.UI.Helpers
@using MCS.Common
@using MCS.UI.Areas.User.Models.File
@using MCS.UI.Areas.User.Models.Transaction
@model ReceivedTaskVM


<tr class="bg-white" style="cursor: pointer; " data-id="@Model.Id">
    <td>
            <div id="Number_@Model.Id">@Model.TransactionNumber</div>
    </td>
    <td>
        <div class="title" id="entityName_@Model.Id">@Model.FromOrgUnit</div>
    </td>
    <td>
        <div class="date" style="text-align: right;">
            @DateHelper.GetDate(@Model.DeliveryDateH)
            @Model.DeliveryDate.ToShortTimeString()
        </div>
    </td>
    <td class="title" id="entityName_5306">
        <div class="w-full f-w-full">
            <div class="name3" id="Employee_@Model.Id">@Model.FromUser</div>
        </div>
    </td>


    <td class="subject-td">
        <div class="w-full w-f-40">
            <div class="heading"></div>
            @if (Model.Subject != null && Model.Subject != "")
            {
                
                    <div class="Tabledescription">
                        @Model.Subject
                    </div>
                
            }
        </div>
    </td>
    <td>
        <div class="w-full w-f-40">
            @if (Model.TaskDescription != null && Model.TaskDescription != "")
            {
                if (Model.TaskDescription.Length > 20)
                {
                    <div id="example" class="" data-bs-toggle="tooltip" data-placement="bottom" title="@Model.TaskDescription">
                        @Model.TaskDescription.Substring(0, 20)
                        ...
                    </div>
                }
                else
                {
                    <div class="">
                        @Model.TaskDescription
                    </div>
                }
            }
        </div>
    </td>
    <td>
        <div class="">
            <div>
                @DateHelper.GetDate(@Model.DeliveryDateH)
            </div>
        </div>
    </td>
    
    <td class="">
        <div class="correspondence-icon-table w-100 d-flex p-0">

            @if (Model.ReceivedTaskType == ReceivedTasksType.NewTasks)
            {
                <div class="w-50">
                    <button type="button" class="w-100 btn btn-light-blue border-0 border-radius-0 p-3" onclick="AcceptTask(@Model.Id)">@DbRes.TResource("User.Task.TaskAdd.Accept")</button>
                </div>
                <div class="w-50">
                    <button type="button" class="w-100 btn btn-gray border-0 border-radius-0 p-3" onclick="showRejectionPopup(@Model.Id)">@DbRes.TResource("User.Task.TaskAdd.Reject")</button>
                </div>
            }


            @if (Model.ReceivedTaskType == ReceivedTasksType.AcceptedTasks)
            {
                <div class="mr-auto d-flex">
                    <a data-bs-toggle="tooltip" title=" @DbRes.TResource("User.Task.TaskAdd.ViewTransaction")"
                       onclick="ViewTransaction(@Model.TransactionId , @Model.TransactionCategoryId.LookupInternalID(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))">
                        <img src="~/Content/User/lib/images/SystemIcon/main bar-14.svg" width="30" />
                    </a>
                    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Tasks.Edit))
                    {
                        <a data-bs-toggle="tooltip" title=" @DbRes.TResource("User.Task.TaskAdd.AssignToUser")"
                           onclick="AssignToUser(@Model.Id)">
                            <img src="~/Content/User/lib/images/SystemIcon/main bar-28.svg" width="35" />
                        </a>
                    }

                    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Tasks.Replay))
                    {
                        <a data-bs-toggle="tooltip" title=" @DbRes.TResource("User.Task.TaskAdd.Reply")"
                           onclick="showReplyTaskPopup(@Model.Id)">
                            <img src="~/Content/User/lib/images/SystemIcon/main bar-36.svg" width="25" />
                        </a>
                    }
                </div>
            }

            @if (Model.ReceivedTaskType == ReceivedTasksType.EndTasks)
            {
                <div class="mr-auto d-flex">
                    <a data-bs-toggle="tooltip" title=" @DbRes.TResource("User.Task.TaskAdd.ViewTransaction")"
                       onclick="ViewTransaction(@Model.TransactionId , @Model.TransactionCategoryId.LookupInternalID(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))">
                        <img src="~/Content/User/lib/images/SystemIcon/main bar-14.svg" width="30" />
                    </a>
                </div>
            }

        </div>
    </td>
</tr>
