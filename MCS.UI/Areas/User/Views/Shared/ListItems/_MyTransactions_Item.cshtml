@using MCS.UI.Helpers
@using MCS.Common
@using MCS.UI.Areas.User.Models.File
@model TransactionTrayInfoVM
@{



    ViewData["dateType"] = ViewData["dateType"] ?? TransactionDateType.Any;

    string colorType = string.Empty;
    string colorPriority = string.Empty;
    string transType = string.Empty;
    // TransactionCategories

    if (Model.TransactionDetailsInfoVM.TransactionCategoryId == (int)TransactionCategorieColor.InternalOutbound)
    {

        transType = "InternalOutboundLine";

    }
    else if (Model.TransactionDetailsInfoVM.TransactionCategoryId == (int)TransactionCategorieColor.Inbound)
    {

        transType = "InboundLine";


    }
    else
    {
        transType = "none";
    }

    if (Model.TransactionDetailsInfoVM.PriorityId == (int)PriorityType.Normal)
    {
        colorPriority = "gray";


    }
    else if (Model.TransactionDetailsInfoVM.PriorityId == (int)PriorityType.HasDate)
    {

        colorPriority = "redLate";
        //colorType = "blue";


    }
    else if (Model.TransactionDetailsInfoVM.PriorityId == (int)PriorityType.Urgent)
    {
        colorPriority = "redLate";
    }
    else if (Model.TransactionDetailsInfoVM.PriorityId == (int)PriorityType.VeryUrgent)
    {
        colorPriority = "redLate";
    }

    else if (Model.TransactionDetailsInfoVM.PriorityId == (int)PriorityType.Immediately)
    {
        colorPriority = "redLate";
    }

    int rejectedId = TransactionStatus.Rejected.LookupIdentity(LookupCategory.TransactionStatus, string.Empty);

    string isRevert = string.Empty; ;
    if (Model.TransactionDetailsInfoVM.StatusId == rejectedId)
    {
        isRevert = "True";
    }



    string remindDate = (((TransactionDateType)ViewData["dateType"] == TransactionDateType.HasDate)
? @DateHelper.GetDate(@Model.TransactionDetailsInfoVM.RemindDateH) + " - " + Model.TransactionDetailsInfoVM.RemindDate.Value.ToString("hh:mm tt")
: (TransactionDateType)ViewData["dateType"] == TransactionDateType.Any
? DateTime.Now.Date >= Model.TransactionDetailsInfoVM.Date.Date.AddDays(0)
? (Int32.Parse((DateTime.Now.Date - Model.TransactionDetailsInfoVM.Date.Date.AddDays(0)).Days.ToString())).ToString()
: Model.TransactionDetailsInfoVM.RemindDate.ToString() != ""
? (Int32.Parse((DateTime.Now.Date - Model.TransactionDetailsInfoVM.Date.Date).Days.ToString())).ToString()
: "---"
: "");
    string remindDatelate = (((TransactionDateType)ViewData["dateType"] == TransactionDateType.HasDate)
                       ? (Int32.Parse((DateTime.Now.Date - Model.TransactionDetailsInfoVM.Date.Date.AddDays(0)).Days.ToString()) + 0).ToString()
                       : ((TransactionDateType)ViewData["dateType"] == TransactionDateType.Late)
                       ? DateTime.Now.Date >= Model.TransactionDetailsInfoVM.Date.Date.AddDays(0)
                       ? (Int32.Parse((DateTime.Now.Date - Model.TransactionDetailsInfoVM.Date.Date.AddDays(0)).Days.ToString()) + 0).ToString()
                       : (Model.TransactionDetailsInfoVM.RemindDate.ToString() != "")
                       ? (Int32.Parse((DateTime.Now.Date - Model.TransactionDetailsInfoVM.Date.Date).Days.ToString()) + 0).ToString()
                       : "---"
                       : "");

    int remindDatelateInt = 0;
    int.TryParse(remindDatelate, out remindDatelateInt);

    int remindDateInt = 0;
    int.TryParse(remindDate, out remindDateInt);

    if (!string.IsNullOrWhiteSpace(remindDatelate) && remindDatelate != "---" && remindDatelate.Length > 0 && remindDatelateInt > 0)
    {
        colorType = "redLate";
    }
    if (!string.IsNullOrWhiteSpace(remindDate) && remindDate != "---" && remindDate.Length > 0 && Convert.ToInt32(remindDateInt) > 0)
    {
        colorType = "red";
    }
    else
    {
        colorType = "green";
    }

    bool HasPermissionToOpenEncrypted = true;
    if (Model.TransactionDetailsInfoVM.Encrypted)
    {
        if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.GeneralPermissions.OpenEncryptTransaction))
        {
            HasPermissionToOpenEncrypted = true;
        }
        else
        {

            HasPermissionToOpenEncrypted = false;
        }

    }
    //if (Model.TransactionDetailsInfoVM.IsLate == true)
    //{
    //colorType = "red";
    // }
    string isIndivisualText = Model.TransactionDetailsInfoVM.TransactionCategoryId == TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName) ? Model.TransactionDetailsInfoVM.IsIndividual ? string.Format("({0})", DbRes.TResource("User.Inbound.BasicInfo.InboundDestination.Individual")) : string.Format("({0})", DbRes.TResource("User.Inbound.BasicInfo.InboundDestination.Entities")) : string.Empty;

    bool isViewed = false;
    string isViewedHeaderClass = "correspondence-t";
    if (Model.TransactionAssignmentInfoVMs != null && Model.TransactionAssignmentInfoVMs.Count > 0)
    {
        isViewed = Model.TransactionAssignmentInfoVMs.FirstOrDefault().Viewed;
    }
    isViewedHeaderClass = isViewed ? "correspondence-t" : "correspondence-t correspondence-t-notviewed bold ";


    bool isPermition = false;
    string Confidentiality = "ConfidentialityNormal";
    string ConfidentialityBac = "ConfidentialityNormalBackg";

    switch (Model.TransactionDetailsInfoVM.ConfidentialityId)
    {
        case (int)Confedentiality.HandDelivered:
            {
                Confidentiality = "ConfidentialityVeryRed";
                ConfidentialityBac = "ConfidentialityVeryRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.HighConfidential:
            {
                Confidentiality = "ConfidentialityMidRed";
                ConfidentialityBac = "ConfidentialityMidRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.ExtremlyConfidential))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.Secret:
            {
                Confidentiality = "ConfidentialityRed";
                ConfidentialityBac = "ConfidentialityRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.ExtremlyConfidential) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.Secret))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.Normal:
            {
                isPermition = true;
                break;
            }
    }

}
