                                    </a>
                                </div>
                                <div style="border-left: 3px solid white;"></div>

                            }
                            if (!Model.IsVIPUser)
                            {
                                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Inbound.Editor))
                                {
                                    <div>
                                        <a id="OpenEditor" class="" title="المحرر" data-Viewed="@isViewed"
                                           data-DeliveryMethodId="@Model.TransactionDetailsInfoVM.DeliveryMethodId"
                                           onclick="OpenEditors(@Model.TransactionDetailsInfoVM.Id,'@Model.TransactionDetailsInfoVM.EncryptedId')">
                                            @*<i class="demo-icon icon-preview"></i>*@
                                            <img src="~/Content/User/lib/images/SystemIcon/main bar-22.svg" width="30" />
                                        </a>
                                    </div>
                                    <div style="border-left: 3px solid white;"></div>
                                }

                            }
                            if (Model.IsVIPUser)
                            {
                                <div>
                                    <a class="" title="@DbRes.TResource("Global.Return")"
                                       onclick="javascript:showRejectionPopup(@Model.TransactionDetailsInfoVM.Id)">
                                        <img src="~/Content/User/lib/images/SystemIcon/main bar-36.svg" width="25" />
                                    </a>
                                </div>
                            }


                        }
                        else if ((TransactionCategory)Model.TransactionDetailsInfoVM.TransactionCategoryId == (TransactionCategory)TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName))
                        {
                            if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Outbound.EditInternalOutbound) || Model.IsVIPUser)
                            {
                                <div>
                                    <a class="" id="OpenVipEditor" title=" @DbRes.TResource("User.OutboundInternal.EditOutboundInternal")" data-Viewed="@isViewed"
                                       data-DeliveryMethodId="@Model.TransactionDetailsInfoVM.DeliveryMethodId"
                                       onclick="Open(@Model.TransactionDetailsInfoVM.Id,'@Model.TransactionDetailsInfoVM.EncryptedId')">
                                        @if (!Model.IsVIPUser)
                                        {
                                            <img src="~/Content/User/lib/images/SystemIcon/main bar-24.svg" width="30" />
                                        }
                                        else
                                        {
                                            <img src="~/Content/User/lib/images/SystemIcon/main bar-22.svg" width="30" />
                                        }
                                    </a>
                                </div>

                                <div style="border-left: 3px solid white;"></div>

                            }
                            if (!Model.IsVIPUser)
                            {
                                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Outbound.EditorInternalOutbound))
                                {
                                    <div>
                                        <a id="OpenEditor" class="" title="المحرر" data-Viewed="@isViewed"
                                           data-DeliveryMethodId="@Model.TransactionDetailsInfoVM.DeliveryMethodId"
                                           onclick="OpenEditors(@Model.TransactionDetailsInfoVM.Id,'@Model.TransactionDetailsInfoVM.EncryptedId')">
                                            <img src="~/Content/User/lib/images/SystemIcon/main bar-22.svg" width="30" />
                                        </a>
                                    </div>
                                    <div style="border-left: 3px solid white;"></div>
                                }
                            }
                            if (Model.IsVIPUser)
                            {
                                <div>
                                    <a class="" title="@DbRes.TResource("Global.Return")"
                                       onclick="javascript:showRejectionPopup(@Model.TransactionDetailsInfoVM.Id)">
                                        <img src="~/Content/User/lib/images/SystemIcon/main bar-36.svg" width="25" />
                                    </a>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div>
                            <a title="@DbRes.TResource("Global.Return")"
                               onclick="javascript:showRejectionPopup(@Model.TransactionDetailsInfoVM.Id)">
                                <img src="~/Content/User/lib/images/SystemIcon/main bar-36.svg" width="25" />
                            </a>
                        </div>


                        if (!Model.IsVIPUser)
                        {
                            if (isPermition)
                            {
                                <div>
                                    <a id="OpenEditor" class="" title="المحرر" data-Viewed="@isViewed"
                                       data-DeliveryMethodId="@Model.TransactionDetailsInfoVM.DeliveryMethodId"
                                       onclick="OpenEditors(@Model.TransactionDetailsInfoVM.Id,'@Model.TransactionDetailsInfoVM.EncryptedId')">
                                        <img src="~/Content/User/lib/images/SystemIcon/main bar-22.svg" width="40" />
                                    </a>
                                </div>

                            }
                            else
                            {
                                <div>
                                    <a id="OpenEditor" class="" title="المحرر" data-Viewed="@isViewed"
                                       data-DeliveryMethodId="@Model.TransactionDetailsInfoVM.DeliveryMethodId"
                                       onclick="OpenPupUp()">
                                        <img src="~/Content/User/lib/images/SystemIcon/main bar-22.svg" width="40" />
                                    </a>
                                </div>
                            }


                        }
                        @Html.StickyHidden("transId")
                    }

                }
                else
                {
                    <div>
                        <a title="@DbRes.TResource("Global.Return")"
                           onclick="javascript:showRejectionPopup(@Model.TransactionDetailsInfoVM.Id)">
                            <img src="~/Content/User/lib/images/SystemIcon/undo.svg" width="25" />
                        </a>
                    </div>
                }

                <div class="ml-auto">
                    <div class="info">
                        <i class="la la-paperclip"></i>
                        <span>
                            <span>
                                @Model.TransactionDetailsInfoVM.AttachmentCount
                            </span>
                            @DbRes.TResource("User.Transaction.Attachments")
                        </span>
                        @if (Model.TransactionDetailsInfoVM.HasLinks)
                        {
                            <i class="la la-link"></i>
                            <span>
                                @DbRes.TResource("Admin.TransactionLink.Link")
                            </span>
                        }
                    </div>
                </div>
            </div>

        </div>
        @Html.StickyHidden("TransactionType", ((TransactionCategory)Model.TransactionDetailsInfoVM.TransactionCategoryId.LookupInternalID(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)).ToString(), new { id = "hdnTransactionType_" + Model.TransactionDetailsInfoVM.Id })
        @Html.StickyHidden("Type", Model.TransactionDetailsInfoVM.TransactionCategoryId.ToString(), new { id = "hdnType_" + Model.TransactionDetailsInfoVM.Id })
        @Html.StickyHidden("hdnEncrypted", Model.TransactionDetailsInfoVM.Encrypted.ToString(), new { id = "hdnEncrypted_" + Model.TransactionDetailsInfoVM.Id })

    </div>
</div>


<script>
    function redirect() {
        @if (!Model.IsVIPUser)
        {
            @:$(event.currentTarget).parent().find('#OpenEditor').click();
        }
        else
        {
            @:$(event.currentTarget).parent().find('#OpenVipEditor').click();
        }
    }
</script>
