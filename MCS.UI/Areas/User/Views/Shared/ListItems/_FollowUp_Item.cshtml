                                <div title="@Model.TransactionDetailsInfoVM.ExternalPartyName">
                                    @Model.TransactionDetailsInfoVM.ExternalPartyName.Substring(0, 15) ...
                                </div>
                            }
                            else
                            {
                                @Model.TransactionDetailsInfoVM.ExternalPartyName
                            }

                        }
                        else
                        {
                            if (Model.TransactionDetailsInfoVM.EntityName.Length > 20)
                            {
                                <div title="@Model.TransactionDetailsInfoVM.EntityName">
                                    @Model.TransactionDetailsInfoVM.EntityName.Substring(0, 15) ...
                                </div>
                            }
                            else
                            {
                                @Model.TransactionDetailsInfoVM.EntityName
                            }

