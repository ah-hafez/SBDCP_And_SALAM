                                <label>
                                    <input type="checkbox" value="" onchange="holdDataFromBox(this)" id="ch_@Model.TransactionDetailsInfoVM.Id" data-id="@Model.TransactionDetailsInfoVM.Id" class="FillIds">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            }
                        </div>
                        <div class="pl-2">@Model.TransactionDetailsInfoVM.Number</div>

                        @if (Model.TransactionDetailsInfoVM.isImportant)
                        {
                            <div class="badgeReject">
                                <span>@DbRes.TResource("هام")</span>
                            </div>
                        }

                    </div>
                    <div class="title" id="entityName_@Model.TransactionDetailsInfoVM.Id">
                        @if (Model.TransactionDetailsInfoVM.EncryptedTransactionCategoryId != TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString())
                        {
                            if (Model.TransactionDetailsInfoVM.ExternalPartyName.Length > 20)
