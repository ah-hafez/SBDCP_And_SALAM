                                       data-IsDraft="@Model.TransactionDetailsInfoVM.EncryptedIsDraft">
                                        <i class="icon-outline-subtitles"></i>
                                    </a>*@
                            </div>
                        }


                        @*if (Model.TransactionDetailsInfoVM.DeliveryMethodId == DeliveryMethodType.Paper.LookupIdentity(LookupCategory.DeliveryMethod,SessionInfo.CultureShortName) ||
                            Model.TransactionDetailsInfoVM.DeliveryMethodId == DeliveryMethodType.ElectronicPaper.LookupIdentity(LookupCategory.DeliveryMethod,SessionInfo.CultureShortName))
                            {
                            <a title="@DbRes.TResource(" User.Transaction.PrintAddress")" data-EncryptedId="@Model.TransactionDetailsInfoVM.EncryptedId"
                               onclick="PrintOutBoundAddress()" class="circle color-green">
                                <i class='la la-print'></i>
                            </a>
                            }*@
                    }

                    if ((TransactionCategory)Model.TransactionDetailsInfoVM.TransactionCategoryId == (TransactionCategory)TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName))
                    {

                        if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.GeneralPermissions.DeletedDraftOutbound) && HasPermissionToOpenEncrypted)
                        {
                            <div style="border-left: 3px solid white;"></div>

                            <a data-bs-toggle="tooltip" data-placement="top" title="حذف" onclick="DeleteTransaction(@Model.TransactionDetailsInfoVM.Id, 'true')">
                                <img src="~/Content/User/lib/images/SystemIcon/delete.svg" width="28" />
                            </a>

                        }

                    }
                }
                else
                {
                    if ((TransactionCategory)Model.TransactionDetailsInfoVM.TransactionCategoryId == (TransactionCategory)TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName))
                    {
                        if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.GeneralPermissions.UndoDeletedDraftOutbound))
                        {
                            <a title="تراجع" style="cursor:initial" onclick="DeleteTransaction(@Model.TransactionDetailsInfoVM.Id, 'false')">
                                <img src="~/Content/User/lib/images/SystemIcon/main bar-36.svg" width="25" />
                            </a>
                        }
                    }

                }

                <div class="ml-auto">
                    <div class="info">
                        <i class="la la-paperclip"></i>
                        <span>
                            @Model.TransactionDetailsInfoVM.AttachmentCount
                            @DbRes.TResource("User.Transaction.Attachments")
                        </span>
                        @if (Model.TransactionDetailsInfoVM.HasLinks)
                        {
                            <i class="la la-link"></i>
                            <span>
                                @DbRes.TResource("Admin.TransactionLink.Link")
                            </span>
                        }
                    </div>
                </div>


                @*<div class="note @colorType">
                        <div class="headerAddress" data-bs-toggle="tooltip" data-placement="bottom" title="@DbRes.TResource("User.File.FinishTime")">
                            @DbRes.TResource("")
                        </div>
                        <div class="result" id="resultNote" style="margin-top:29px">
                            @if (@Model.TransactionDetailsInfoVM.RemindDateH != null && @Model.TransactionDetailsInfoVM.RemindDateH != "")
                            {
                                @DateHelper.GetDate(@Model.TransactionDetailsInfoVM.RemindDateH)
                            }
                            else
                            {
                                @DateTimeUtility.ConvertToUmAlQuraCalendar(Model.TransactionDetailsInfoVM.Date.Date.AddDays(2))
                            }
                        </div>
                    </div>*@
                @Html.StickyHidden("hdnEncrypted", Model.TransactionDetailsInfoVM.Encrypted.ToString(), new { id = "hdnEncrypted_" + Model.TransactionDetailsInfoVM.Id })

            </div>
        </div>

    </div>
</div>
