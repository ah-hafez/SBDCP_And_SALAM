    function showRejectionPopup(transId) {
        $('#transId').val(transId);
        ShowRejectTransactionPopup('@DbRes.TResource("Transaction.Reject")', '', '@DbRes.TResource("Reason.Reject")','', '@DbRes.TResource("Global.Return")')
    }
</script>
