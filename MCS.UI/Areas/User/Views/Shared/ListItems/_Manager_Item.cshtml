@using MCS.Common
@using MCS.UI.Helpers
@using MCS.UI.Areas.User.Models.File
@model TransactionTrayInfoVM

@{

    string colorType = string.Empty;
    string className = "result";
    string classNameTo = "result";
    if (Model.TransactionDetailsInfoVM.ConfidentialityId == 28 || Model.TransactionDetailsInfoVM.ConfidentialityId == 29)
    {
        className = "resultReed";
    }
    if (Model.TransactionDetailsInfoVM.TransactionTypeId == 2)
    {
        classNameTo = "resultReed";
    }


    if (Model.TransactionDetailsInfoVM.TransactionTypeColorId == Color.Red.LookupIdentity(LookupCategory.Color, SessionInfo.CultureShortName))
    {

        colorType = "red";

    }
    else if (Model.TransactionDetailsInfoVM.TransactionTypeColorId == Color.Blue.LookupIdentity(LookupCategory.Color, SessionInfo.CultureShortName))
    {

        colorType = "green";


    }
    else
    {
        colorType = "green";
    }

    bool isPermition = false;
    string Confidentiality = "ConfidentialityNormal";
    string ConfidentialityBac = "ConfidentialityNormalBackg";

    switch (Model.TransactionDetailsInfoVM.ConfidentialityId)
    {
        case (int)Confedentiality.HandDelivered:
            {
                Confidentiality = "ConfidentialityVeryRed";
                ConfidentialityBac = "ConfidentialityVeryRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.HighConfidential:
            {
                Confidentiality = "ConfidentialityMidRed";
                ConfidentialityBac = "ConfidentialityMidRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.ExtremlyConfidential))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.Secret:
            {
                Confidentiality = "ConfidentialityRed";
                ConfidentialityBac = "ConfidentialityRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.ExtremlyConfidential) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.Secret))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.Normal:
            {
                isPermition = true;
                break;
            }
    }

    string isIndivisualText = Model.TransactionDetailsInfoVM.TransactionCategoryId == TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName) ? Model.TransactionDetailsInfoVM.IsIndividual ? string.Format("({0})", DbRes.TResource("User.Inbound.BasicInfo.InboundDestination.Individual")) : string.Format("({0})", DbRes.TResource("User.Inbound.BasicInfo.InboundDestination.Entities")) : string.Empty;


    <style>
        .description {
            text-align: center;
            color: white;
        }

        .cardTable {
            max-height: 200px;
            min-height: 197px;
        }

            .cardTable .table.section2 {
                transform: translateY(-169px);
                background: white;
                display: none;
            }

            .cardTable:hover .table.section2 {
                transform: translateY(-169px);
                display: inline-table;
                min-height: 197px;
            }

        .ConfidentialityNormalBackg {
            border: 2px solid #869AB7;
        }

        .ConfidentialityVeryRedBackg, .ConfidentialityRedBackg, .ConfidentialityMidRedBackg {
            border: 2px solid #c41c0e;
        }

        .correspondence-icon .info {
            color: white !important;
        }
    </style>
}
<div class="box-grid" data-id="@Model.TransactionDetailsInfoVM.Id">
    <div class="box no_sorting animated zoomIn buttons-action @ConfidentialityBac">
        <div class="correspondence-t">
            <div class="d-flex">
                @*<div class="treaty-name">
                        @Model.TransactionDetailsInfoVM.TransactionCategory @isIndivisualText
                    </div>*@
                <div class="col-lg-9">
                    <div class="mr-auto d-flex">
                        <div class="checkbox">
                            @if (Model.TransactionDetailsInfoVM.HasPermission)
                            {
                                <label>
                                    <input type="checkbox" value="" onchange="holdDataFromBox(this)" id="ch_@Model.TransactionDetailsInfoVM.Id" data-id="@Model.TransactionDetailsInfoVM.Id" data-encryptedid="@Model.TransactionDetailsInfoVM.EncryptedId" class="FillIds">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            }
                        </div>
                        <div class="pl-2" id="Number_@Model.TransactionDetailsInfoVM.Id">@Model.TransactionDetailsInfoVM.Number</div>
                    </div>
                    <div class="title" id="entityName_@Model.TransactionDetailsInfoVM.Id">
                        @if (Model.TransactionDetailsInfoVM.EntityName.Length > 18)
                        {
                            <div>
                                @Model.TransactionDetailsInfoVM.EntityName.Substring(0, 18)...
                            </div>
                        }
                        else
                        {
                            @Model.TransactionDetailsInfoVM.EntityName
                        }
                    </div>
                    <div class=" correspondence-h">
                        <div class="" style="margin-top:-10px;">
                            @DateHelper.GetDate(@Model.TransactionDetailsInfoVM.DateH)
                            @Model.TransactionDetailsInfoVM.Date.ToShortTimeString()
                        </div>
                    </div>
                </div>

                <div class="col-lg-3" style="margin-top:18px; margin-left:7px;">
                    <div class="circleDateLate @colorType">
                        <div>
                            <div class="result-delay">
                                @{ string delayCount = DateTime.Now.Date >= Model.TransactionDetailsInfoVM.Date.Date.AddDays(2)
? (Int32.Parse((DateTime.Now.Date - Model.TransactionDetailsInfoVM.Date.Date.AddDays(2)).Days.ToString()) + 1).ToString()
: Model.TransactionDetailsInfoVM.RemindDate.ToString() != ""
? (Int32.Parse((DateTime.Now.Date - Model.TransactionDetailsInfoVM.Date.Date).Days.ToString()) + 1).ToString()
: "---";
                                }
                                @delayCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr style="margin-top:-8px;" />
        <div class="correspondence-t">
            @if (Model.TransactionDetailsInfoVM.HasPermission)
            {

                <div class="correspondence-b d-flex flex-wrap" style="background: #0E8270;">
                    <div class="f-line w-full w-f-50">
                        @*@if (Model.TransactionDetailsInfoVM.HasPermission)
                            {*@

                        @if (Model.TransactionDetailsInfoVM.Subject != null && Model.TransactionDetailsInfoVM.Subject.Length > 20)
                        {
                            <div id="example" class="description" data-bs-toggle="tooltip" data-placement="bottom" title="@Model.TransactionDetailsInfoVM.Subject">
                                @Model.TransactionDetailsInfoVM.Subject.Substring(0, 20)
                                ...
                            </div>
                        }
                        else
                        {
                            <div class="description">
                                @Model.TransactionDetailsInfoVM.Subject
                            </div>

                        }
                        @*}
                            else
                            {
                                <div class=" description">***</div>
                            }*@
                    </div>
                </div>
            }

            else
            {
                <div class="correspondence-b d-flex flex-wrap" style="background: red;">
                    <div class="f-line w-full w-f-50 description" style="color:white">
                        غير مصرح لك
                    </div>
