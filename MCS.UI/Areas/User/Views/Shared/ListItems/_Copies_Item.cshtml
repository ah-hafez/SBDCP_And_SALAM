@using MCS.UI.Areas.User.Models.File
@using MCS.UI.Helpers
@using MCS.Common
@model TransactionTrayInfoVM

@{
    /**/

    string colorType = string.Empty;
    string className = "result";
    string classNameTo = "result";
    if (Model.TransactionDetailsInfoVM.ConfidentialityId == 28 || Model.TransactionDetailsInfoVM.ConfidentialityId == 29)
    {
        className = "resultReed";
    }
    if (Model.TransactionDetailsInfoVM.TransactionTypeId == 2)
    {
        classNameTo = "resultReed";
    }
    if (Model.TransactionDetailsInfoVM.TransactionTypeColorId == Color.Red.LookupIdentity(LookupCategory.Color, SessionInfo.CultureShortName))
    {

        colorType = "reddark";

    }
    else if (Model.TransactionDetailsInfoVM.TransactionTypeColorId == Color.Blue.LookupIdentity(LookupCategory.Color, SessionInfo.CultureShortName))
    {

        colorType = "green";


    }
    else
    {
        colorType = "red";
    }

    bool isPermition = false;
    string Confidentiality = "ConfidentialityNormal";
    string ConfidentialityBac = "ConfidentialityNormalBackg";

    switch (Model.TransactionDetailsInfoVM.ConfidentialityId)
    {
        case (int)Confedentiality.HandDelivered:
            {
                Confidentiality = "ConfidentialityVeryRed";
                ConfidentialityBac = "ConfidentialityVeryRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.HighConfidential:
            {
                Confidentiality = "ConfidentialityMidRed";
                ConfidentialityBac = "ConfidentialityMidRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.ExtremlyConfidential))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.Secret:
            {
                Confidentiality = "ConfidentialityRed";
                ConfidentialityBac = "ConfidentialityRedBackg";

                if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.HandDelivered) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.ExtremlyConfidential) || SessionInfo.CurrentUser.Claims.Contains(UserClaims.ConfidentialityOfTransactions.Secret))
                {
                    isPermition = true;
                }

                break;
            }
        case (int)Confedentiality.Normal:
            {
                isPermition = true;
                break;
            }
    }

    string isIndivisualText = Model.TransactionDetailsInfoVM.TransactionCategoryId == TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName) ? Model.TransactionDetailsInfoVM.IsIndividual ? string.Format("({0})", DbRes.TResource("User.Inbound.BasicInfo.InboundDestination.Individual")) : string.Format("({0})", DbRes.TResource("User.Inbound.BasicInfo.InboundDestination.Entities")) : string.Empty;


}

<style>
    .description {
        text-align: center;
        color: white;
    }

    .cardTable {
        max-height: 200px;
        min-height: 197px;
    }

        .cardTable .table.section2 {
            transform: translateY(-169px);
            background: white;
            display: none;
        }

        .cardTable:hover .table.section2 {
            transform: translateY(-188px);
            display: inline-table;
            min-height: 197px;
        }

    .Viewed {
        font-weight: bold;
    }

    .ConfidentialityNormalBackg {
        border: 2px solid #869AB7;
    }

    .ConfidentialityVeryRedBackg, .ConfidentialityRedBackg, .ConfidentialityMidRedBackg {
        border: 2px solid #c41c0e;
    }

    .correspondence-icon .info {
        color: white !important;
    }
</style>

<script>
    function redirect()
    {
        var link = $(event.currentTarget).parent().find('#link');
        link.click();
    }

    $(document).ready(function ()
    {
        if ($('#selectAll').is(":checked"))
        {
            $('#selectAll').click();
        }
    });
</script>
<script src="~/Scripts/Transaction.js"></script>
<!-- #Start# BOX -->
<div class="box-grid three grid-item" data-id="@Model.TransactionDetailsInfoVM.Id" data-copyId="@Model.TransactionDetailsInfoVM.TransactionCopyId">
    @*<div class="@string.Format("box animated zoomIn hover-area buttons-action {0}", colorType)">*@
    <div class="@string.Format("box animated zoomIn hover-area buttons-action") @ConfidentialityBac">

        <div>
            <div class="correspondence-t">

                <div class="d-flex">
                    @*<div class="treaty-name">
                            @Model.TransactionDetailsInfoVM.TransactionCategory @isIndivisualText
                        </div>*@
                    <div class="col-lg-9">
                        <div class="mr-auto d-flex">
                            <div class="checkbox">
                                <div>
                                    <label>
                                        @if (Model.TransactionDetailsInfoVM.CopyStatus != TransCopyStatus.Delete.LookupIdentity(LookupCategory.TransCopyStatus, SessionInfo.CultureShortName))
                                        {
                                            <input type="checkbox" value="" onchange="holdDataFromBox(this); CheckCopyStatus(@Model.TransactionDetailsInfoVM.CopyStatus);" id="ch_@Model.TransactionDetailsInfoVM.TransactionCopyId" data-id="@Model.TransactionDetailsInfoVM.TransactionCopyId" data-status="@Model.TransactionDetailsInfoVM.CopyStatus" class="FillIds">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        }
                                    </label>

                                </div>
                            </div>
                            @if (Model.TransactionDetailsInfoVM.IsOpr)
                            {
                                <div class="pl-2" id="Number_@Model.TransactionDetailsInfoVM.Id">@Model.TransactionDetailsInfoVM.Number </div>
                                <div class="pl-2"><span>OPR</span></div>

                            }
                            else
                            {
                                <div class="pl-2" id="Number_@Model.TransactionDetailsInfoVM.Id">@Model.TransactionDetailsInfoVM.Number</div>

                            }

                            @*@if (Model.TransactionDetailsInfoVM.ToUserName != null && Model.TransactionDetailsInfoVM.ToUserName != "")
                                {
                                    <div class="pl-2"><i class="fas fa-user" data-bs-toggle="tooltip" data-placement="bottom" title="@DbRes.TResource("User.Transaction.SendedToPerson")"></i></div>
                                }*@
                        </div>
                        <div class="title" id="entityName_@Model.TransactionDetailsInfoVM.Id">
                            @if (Model.TransactionDetailsInfoVM.EntityName.Length > 20)
                            {
                                <div title="@Model.TransactionDetailsInfoVM.EntityName">
                                    @Model.TransactionDetailsInfoVM.EntityName.Substring(0, 18)...
                                </div>
                            }
                            else
                            {
                                @Model.TransactionDetailsInfoVM.EntityName
                            }

                        </div>
                        <div class="correspondence-h">
                            <div class="" style="margin-top:-10px;">
                                @DateHelper.GetDate(@Model.TransactionDetailsInfoVM.DateH)
                                @Model.TransactionDetailsInfoVM.Date.ToShortTimeString()
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr style="margin-top:-8px;" />

            @*<div class="correspondence-h">
                    <div class="title" id="entityName_@Model.TransactionDetailsInfoVM.Id">
                        @Model.TransactionDetailsInfoVM.EntityName
                    </div>
                    <div class="date">
                        @DateHelper.GetDate(@Model.TransactionDetailsInfoVM.DateH)
                        @Model.TransactionDetailsInfoVM.Date.ToShortTimeString()
                    </div>
                </div>*@
        </div>

        <div onclick='redirect()'>
            <div class="correspondence-t">

                @if (Model.TransactionDetailsInfoVM.HasPermission)
                {
                    <div class="correspondence-b d-flex flex-wrap">
                        <div class="f-line w-full w-f-50">

                            @if (Model.TransactionDetailsInfoVM.Subject != null && Model.TransactionDetailsInfoVM.Subject.Length > 25)
                            {
                                <div id="example" style="word-break:break-all" class="description" data-bs-toggle="tooltip" data-placement="bottom" title="@Model.TransactionDetailsInfoVM.Subject" data-original-title="@Model.TransactionDetailsInfoVM.Subject">
                                    @Model.TransactionDetailsInfoVM.Subject
                                </div>
                            }
                            else
                            {
                                <div id="example" style="word-break:break-all" class="description" data-bs-toggle="tooltip" data-placement="bottom" title="@Model.TransactionDetailsInfoVM.Subject" data-original-title="@Model.TransactionDetailsInfoVM.Subject">
                                    @Model.TransactionDetailsInfoVM.Subject
                                </div>
                            }

                        </div>
                    </div>
                }

                else
                {
                    <div class="correspondence-b d-flex flex-wrap" style="background: red;">
                        <div class="f-line w-full w-f-50 description" style="color:white">
                            غير مصرح لك
                        </div>
                    </div>
                }

                @if (Model.TransactionDetailsInfoVM.HasPermission)
                {
                    <div class=" correspondence-b d-flex flex-wrap cardTable">
                        <table class="table table-bordered section1" style="margin-top:10px;">
                            <tbody>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("User.Transaction.Sender")</th>
                                    <td class="result">
                                        @Model.TransactionDetailsInfoVM.User
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("User.File.Priority")</th>
                                    <td class="result">
                                        @Model.TransactionDetailsInfoVM.PriorityName
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("User.File.Confidentiality")</th>
                                    <td class="@className">
                                        @Model.TransactionDetailsInfoVM.ConfidentialityName
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("Admin.AssignmentPaperActions.Action")</th>
                                    <td>
                                        @if (Model.TransactionAssignmentInfoVMs != null && Model.TransactionAssignmentInfoVMs.Count > 0)
                                        {
                                            <div class="result">

                                                @Model.TransactionAssignmentInfoVMs.FirstOrDefault().Action
                                                @if (Model.TransactionAssignmentInfoVMs.FirstOrDefault().Action == null)
                                                {
                                                    <div class="result">
                                                        ---
                                                    </div>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="result">
                                                ---
                                            </div>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-bordered section2">
                            <tbody>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("User.Inbound.BasicInfo.InboundType")</th>
                                    <td class="result">
                                        @Model.TransactionDetailsInfoVM.TransactionTypeName
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("User.File.Cards.Classification")</th>
                                    <td class="result">
                                        @if (Model.TransactionDetailsInfoVM.LetterTypeName != null && Model.TransactionDetailsInfoVM.LetterTypeName.Length > 15)
                                        {
                                            <div class="result">
                                                @Model.TransactionDetailsInfoVM.LetterTypeName
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="result">
                                                @Model.TransactionDetailsInfoVM.LetterTypeName
                                            </div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("User.File.AssignDate")</th>
                                    <td class="result">
                                        @if (Model.TransactionAssignmentInfoVMs != null)
                                        {
                                            <div class="result">
                                                @if (Model.TransactionAssignmentInfoVMs.FirstOrDefault().Date.ToString().Length > 10)
                                                {
                                                    @Model.TransactionAssignmentInfoVMs.FirstOrDefault().Date.ToString().Substring(0, 10)
                                                }
                                                else
                                                {
                                                    @Model.TransactionAssignmentInfoVMs.FirstOrDefault().Date.ToString()
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="result">
                                                ---
                                            </div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("User.Transaction.AssignmentFromEntity")</th>
                                    <td>
                                        @if (Model.TransactionAssignmentInfoVMs != null)
                                        {
                                            <div class="result">

                                                @if (Model.TransactionAssignmentInfoVMs.FirstOrDefault().FromEntity.Length > 15)
                                                {
                                                    @Model.TransactionAssignmentInfoVMs.FirstOrDefault().FromEntity.Substring(0, 10)
                                                }
                                                else
                                                {
                                                    @Model.TransactionAssignmentInfoVMs.FirstOrDefault().FromEntity
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="result">
                                                ---
                                            </div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="headerAddress">@DbRes.TResource("تاريخ الانجاز")</th>
                                    <td class="result">
                                        @if (@Model.TransactionDetailsInfoVM.RemindDateH != null && @Model.TransactionDetailsInfoVM.RemindDateH != "")
                                        {
                                            @DateHelper.GetDate(@Model.TransactionDetailsInfoVM.RemindDateH)
                                        }
                                        else
                                        {
                                            @DateTimeUtility.ConvertToUmAlQuraCalendar(Model.TransactionDetailsInfoVM.Date.Date.AddDays(2))
                                        }
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                }
                else
                {
                    <div class=" correspondence-b d-flex flex-wrap cardTable" @*style=" filter: blur(8px); -webkit-filter: blur(8px);"*@>
                        <table class="table table-bordered section1" style="margin-top:10px; border:none">
                            <tbody>
                                <tr>
                                    <td style="text-align: center; border-color: transparent; ">
                                        <img src="~/Content/User/lib/images/warning1.svg" width="150" />

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>

        <div class="correspondence-t">
            <div class="correspondence-icon d-flex" style="padding-right: 2px;">
                @if (Model.TransactionDetailsInfoVM.CopyStatus != TransCopyStatus.Delete.LookupIdentity(LookupCategory.TransCopyStatus, SessionInfo.CultureShortName))
                {
                    if (Model.TransactionDetailsInfoVM.HasPermission)
                    {
                        <a id="link" href="#" title="@DbRes.TResource("User.Copies.Show")" data-id="@Model.TransactionDetailsInfoVM.EncryptedId" data-tray="@Model.TransactionDetailsInfoVM.TransactionCategoryId" data-encrypttray="@Model.TransactionDetailsInfoVM.EncryptedTransactionCategoryId" data-copyId="@Model.TransactionDetailsInfoVM.TransactionCopyId" class="aView" data-type="@Model.TransactionDetailsInfoVM.TransactionCategoryId">
                            <img src="~/Content/User/lib/images/SystemIcon/main bar-22.svg" width="30" />
                        </a>
                        if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Outbound.CreateInternalOutboundFromCopy) && !Model.IsVIPUser)
                        {
                            <div style="border-left: 3px solid white;"></div>
                            <a href="#" title="@DbRes.TResource("User.Copies.CreateOutboundInternal")" data-id="@Model.TransactionDetailsInfoVM.EncryptedId" data-tray="@Model.TransactionDetailsInfoVM.EncryptedTransactionCategoryId" data- class="CreateInternalOutbound" data-type="@TrayActionType.CreateOutbound">
                                <img src="~/Content/User/lib/images/SystemIcon/add.svg" width="30" />
                            </a>
                        }
                        <a id="link" href="#" title="@DbRes.TResource("User.InboundSearch.InboundCertificate")" data-id="@Model.TransactionDetailsInfoVM.Id" onclick="ShowTransactionLog(@Model.TransactionDetailsInfoVM.Id)">
                            <img src="~/Content/User/lib/images/SystemIcon/main bar-14.svg" width="30" />
                        </a>
                    }

                    if (Model.TransactionDetailsInfoVM.CopyStatus == TransCopyStatus.NotViewed.LookupIdentity(LookupCategory.TransCopyStatus, SessionInfo.CultureShortName))
                    {
                        <div style="border-left: 3px solid white;"></div>
                        <a href="#" title="@DbRes.TResource("User.File.Viewed")" data-id="@Model.TransactionDetailsInfoVM.TransactionCopyId" data-tray="@Model.TransactionDetailsInfoVM.TransactionCategoryId" data- class="aMarkSeen" data-type="@TrayActionType.Viewed">
                            <img src="~/Content/User/lib/images/SystemIcon/main bar-27.svg" width="30" />
                        </a>
                    }
                    else
                    {
                        <div style="border-left: 3px solid white;"></div>

                        <a href="#" title="@DbRes.TResource("User.File.Delete")" data-id="@Model.TransactionDetailsInfoVM.TransactionCopyId" data-tray="@Model.TransactionDetailsInfoVM.TransactionCategoryId" data- class="aMarkDelete" data-type="@TrayActionType.DeleteCopy">
                            <img src="~/Content/User/lib/images/SystemIcon/delete.svg" width="28" />
                        </a>
                    }

                }
                else
                {
                    <a href="#" title="@DbRes.TResource("User.File.SaveRevert")" data-id="@Model.TransactionDetailsInfoVM.Id" data- class="aSaveCopyRevert" data-type="@TrayActionType.UndoDeleteCopy">
                        <img src="~/Content/User/lib/images/SystemIcon/main bar-36.svg" width="25" />
                    </a>
                }
            </div>
        </div>


    </div>
</div>
<script>
    $(".CreateInternalOutbound").click(function () {

        var EncryptedId = $(this).data("id");
        var type = $(this).data("tray");
        window.location.href = '@Url.Action("CreateCopyOutboundInternal","OutboundInternal")' + "?transactionId=" + EncryptionKey(EncryptedId)  + "&transactionType=" + type;
    });

    $('.aView').unbind('click').on('click', function (e) {
        var isVIPUser = '@SessionInfo.GetObjectFromSession(Constants.IsVIPUser)';
        var type = $(this).data("type");
        var trayId = $(this).data("tray");
        var id = $(this).data("id");
        var copyId = $(this).data("copyid");
        var encrypttype = $(this).data("encrypttray");


        if (type == @(TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))|| type == @(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))) {
            encrypttrayId =' @MCS.Framework.Encryption.AESEncrytDecry.Base64Encode(((int)TrayType.Copies).ToString())';
        }
        else if ((type == @(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)) || type == @(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)))) {
            encrypttrayId = '@MCS.Framework.Encryption.AESEncrytDecry.Base64Encode(((int)TrayType.CopiesOutbound).ToString())';
        }

        if ($(e.target).hasClass('aViewed'))
            return;
        var url = '';
        if (isVIPUser =="True")
        {
            url = '@Url.Action("VipCopy","Vip",new { area="user"} )?transactionId='+ EncryptionKey(id) + "&transactionCopyId="+ EncryptionKey(copyId);
        } else
        {
            url = '@Url.Action("Index","Editor",new { area="user"} )?transactionId=' + EncryptionKey(id) +"&transactionCopyId="+ EncryptionKey(copyId)+ '&trayId=' + encrypttrayId + "&transactionCategoryId=" + encrypttype;
        }

        window.location.href = url;
    });
    $(".aSaveCopyRevert").unbind('click').click(function (e) {
        debugger
        e.stopPropagation();
        _this = this;
        ShowConfirmMessage('هل انت متأكد من التراجع من الحفظ ؟', "ViewedTransaction");
    })


    $(".aMarkSeen").unbind('click').click(function (e)
    {
        e.stopPropagation();
        _this = this;
        ShowConfirmMessage('@(DbRes.TResource("User.File.View"))', "ViewedTransaction");
    })
    $(".aMarkDelete").unbind('click').click(function (e)
    {
        e.stopPropagation();
        _this = this;
        ShowConfirmMessage('@(DbRes.TResource("User.File.Deleted"))', "ViewedTransaction");
    })



</script>
