@model MCS.UI.Areas.User.Models.Shared.RulesAndRegulations
@using MCS.Common;
@using MCS.Framework.Localization
@using MCS.Framework.Controls;
@using MCS.UI.Helpers
@using MCS.UI.Areas.User.Models.ExternalParties
@using MCS.UI.Areas.User.Models.Transaction
@{
    /**/

    ViewBag.Title = DbRes.TResource("انظمة ولوائح");
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";

}


<h2 class="mt-3" style="margin-right:44px; ">الأنظمة واللوائح</h2>
<div class="white-container mx-5 mx-xs-3">
    <div class="single-wrapper">
        <div class="form-row">
            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                <label class="w-100">@DbRes.TResource("الرقم") <span class="stark">*</span></label>
                <div>
                    @Html.NumericTextBoxFor(model => model.Number, new { @Value = "", @class = "form-control" })
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                <div class="form-group">
                    <label class="w-100">@DbRes.TResource("المادة")</label>
                    <div>
                        @Html.TextBoxGroupFor(model => model.Subject, "BasicInformation", new { @Value = "", @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-12 col-xs-12 mb-3">
                <div class="form-group">
                    <label class="w-100">@DbRes.TResource("كلمات مفتاحية") </label>
                    <div>
                        @Html.TextBoxGroupFor(model => model.Keywords, "BasicInformation", new { @Value = "", @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3 with-icon">
                <label>@DbRes.TResource("التاريخ") </label>
                @Html.CalendarCustom("HasInboundDateCal", "hdnHasInboundDateGreg", "hdnHasDateInboundUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), Model != null ? Model.Date.ToString() : null, "form-control")
                <a class=" date-icon2 " onclick="showCalender('HasInboundDateCal')"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                @Html.StickyHidden("hdnHasInboundDateGreg", null, new { id = "hdnHasInboundDateGreg" })
                @Html.HiddenGroupFor(model => model.Date, new { id = "hdnHasDateInboundUm", AutoComplete = "off" }, "BasicInformation")
            </div>
            <div class="form-group col-lg-6 col-md-6 col-sm-12 col-xs-12  mb-3">
                <div class="input-group w-100">
                    <div class="form-group w-100">
                        <label class="w-100">@DbRes.TResource("User.OutboundExternal.BasicInfo.Subject") <span class="stark">*</span></label>
                        @Html.TextAreaGroupFor(model => model.Description, new { id = "txtAreaSubject", @class = "form-control long-textarea2", @rows = "5" }, "BasicInformation")
                    </div>
                </div>
            </div>

            <div class="form-group col-lg-6 col-md-6 col-sm-12 col-xs-12  mb-3">
                <div class="input-group w-100">
                    <div class="w-100">
                        <label class="w-100">@DbRes.TResource("التعديل") </label>
                        @Html.TextAreaGroupFor(model => model.Amendment, new { @class = "form-control long-textarea2", @rows = "5" })
                    </div>
                </div>
            </div>
        </div>

        <div class="" style="display: flex; gap: 12px; padding-right: 12px; border-radius: 25px; width: 160px; margin-right: 33px; background: #e9e9e9;">
            <div class="" style="display:flex; margin-top:10px; gap:6px; padding-right:5px;">
                <div class="" id="dvScanningIcon">
                    <a id="aScanning">
                        <i class="fas fa-print" style="font-size:24px; color:black;" data-bs-toggle="tooltip" data-placement="bottom" title=" @DbRes.TResource("الماسح الضوئي")"></i>

                    </a>
                </div>
                <span style="font-weight:bold">الماسح الضوئي</span>
            </div>
        </div>
        <div style="display:flex">
            <div class="panel-body row text-right">
                <input type="button" value="@DbRes.TResource("User.Search.SubmitSearch")" class="btn btn-st1" onclick="FilterBy()" />
            </div>
            <div class="panel-body row text-right">
                @Html.ConfirmAction(OperationType.Save, "btnSaveOutboundExternal", DbRes.TResource("User.OutboundDraft.Edit"), "AddRulesAndRegulations", null, null, null, "OnSuccess", null, DbRes.TResource("User.OutboundExternal.SaveMessage"), "post", "frmAddArchivesLibrary", "BasicInformation", "btn btn-st1 btn-lg pull-right", "CheckPriorityIfHasDate", UserClaims.Outbound.CreateExternalOutbound, "NotValid")
                <input class="btnSendOutbound btn-site" style="display:none;" type="button" value="إرسال" />
            </div>
        </div>
        <div class="col-xs-12">
            @Html.Partial("~/Areas/User/Views/Transaction/_ArchivingPartialMainDocument.cshtml", new TransactionArchiveVM(TransactionAttachmentType.Main, true, false, false,
                                              bStampPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Mark),
                                              bSignaturePermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.UserPreferences.Signature),
                                              bAnnotationsPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.Archiving.Annotations),
                                              bColorScanningPermission: SessionInfo.CurrentUser.Claims.Contains(UserClaims.Archiving.ColorScanning)), Html.ViewData)
        </div>

    </div>


                        

                    </div>
