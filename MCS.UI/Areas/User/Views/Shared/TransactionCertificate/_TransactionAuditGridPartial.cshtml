                        //PrintAuditWindow.focus();



                        //setTimeout(function () {
                        //    PrintAuditWindow.print();
                        //    PrintAuditWindow.close();
                        //}, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }

                },
            error: function (data) {

            }

        });

    }

</script>