<script>
        function SearchICByTransactionID(transactionId, element) {
    var id = transactionId;

    $.ajax({
        type: 'Get',
        cache: false,
        url: '@Url.Action("SearchByTransactionID", "IC")',
        data: { transactionId: id},
        success:
            function (data) {
                debugger
                UpdateDivContent(data.Html, element, false);
            }
    });
}
    $("div.anchor a").click(function () {
        $("div.anchor a").removeClass("active");
        $("div.anchor a").addClass("disabled");
        $(this).addClass("active");
        var id = $(this).data("id");
        $("#" + id).addClass("active");
        // $(".tabscontent").addClass("hidden_");
        //var divId = $(this).data("divid");
        //$("#" + divId).removeClass("hidden_");
    });

    $('.tab_editor').click(function () {

        var url;
        var data = new Array();

        $('.tab_editor').removeClass('select_but');
        $(this).addClass('select_but');

        $("._views").hide();

        switch ($(this)[0].id) {

            case "btnBasicInfo":
                $("#dvEditorBasicInfo").show();
                break;

            case "btnExplanation":
                $("#dvEditorExplanation").show();
                break;
        }
        return false;
    });

    function InsertPrintButton() {
        $('#printElectronicreceipt').append('<input type="button" onclick="PrintElectronicreceipt()" id="Print" class="btn btn-site mr-auto" value="طباعة" />');
    }
</script>

<script>
    var urlPrintTicket = '@Url.Action("PrintTicket","Shared")' + '?transactionId=' + @Model.Id;


    function ShowTransactionCertificate(id, transactionType) {
        debugger
        var url;

        switch (transactionType) {

            case '@TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString()':

                url = '@Url.Action("InboundCertificate", "Shared")' + '?transactionId=' + id;
                break;

            case '@TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString()':

                url = '@Url.Action("InboundCertificate", "Shared")' + '?transactionId=' + id;
                break;

            case '@TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString()':
            case '@TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString()':

                url = '@Url.Action("OutboundCertificate", "Shared")' + '?transactionId=' + id;
                break;
        }
        debugger

         $.ajax({
            type: 'Get',
            cache: false,
            url: url,
            data: { transactionId: id},
            success:
                function (data) {

                    if (data.MessageType != 2) {
                        ShowDialog(url);
                    }
                    else {
                        //__dialog.close();
                       // ShowErrorMessage("@DbRes.TResource("PermissionAssignTo")");
                        ShowErrorMessage('"@DbRes.TResource("PermissionAssignTo")"');
                    }

                }
        });

    }
    function ShowPrintDialog(id) {
        var params = { transactionId: id };
        ShowDialogAjaxPrintingBarcodes('@Url.Action("PrinttingBarcodes","Shared")' + "?" + $.param(params), {}, 'OpenPrintDialogSuccess', 'dialogbox col-md-12 ');
    }

    function OpenPrintDialogSuccess(data, $obj) {
        if (data.MessageType != 2) {
            $obj.setContent(data.Html);
        }
        else {
            __dialog.close();
            ShowErrorMessage(data.MessageText);
        }
    }
    function CloseDialog()
    {
        $(".closeIcon").click();
        __dialog.close();

    }
</script>

<script>
    function GetCertificateBasicInfo(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetInternalOutboundBasicInfo", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element, false);
                }
        });
    }

    function GetCertificateNames(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionNames", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element, true);
                }
        });
    }

            function GetCertificateAssignments_New(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionAssignmentHistories", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element, false);
                 /*   InsertPrintButton();*/
                }
        });
    }

    function GetCertificateAssignments(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionAssignmentHistories", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element);
                }
        });
    }
    function GetCertificateLinks(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionLinks", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element);
                }
        });
    }
    function GetCertificateAttachments(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionAttachments", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element, false);
                }
        });
    }
    function GetCertificateCopies(transactionId, element, isAppend) {
            var id = transactionId;

            $.ajax({
                type: 'Get',
                cache: false,
                url: '@Url.Action("GetTransactionCopiesByTransactionId", "TransactionLog")',
                data: { transactionId: id },
                success:
                    function (data) {
                        UpdateDivContent(data, element, isAppend);
                    }
            });
    }
    function GetCertificateExternalCopies(transactionId, element) {

            var id = transactionId;

            $.ajax({
                type: 'Get',
                cache: false,
                url: '@Url.Action("GetTransactionExternalCopiesByTransactionId", "TransactionLog")',
                data: { transactionId: id },
                success:
                    function (data) {
                        UpdateDivContent(data, element, true);
                    }
            });
        
    }
    function GetCertificateExplanations(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetExplanationsByTransactionId", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element, true);
                }
        });
    }
    function GetCertificateTasks(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionTasks", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element, true);
                }
        });
    }
    function GetCertificateFollowUp(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionFollowUp", "TransactionLog")',
            data: { transactionId: id },
            success:
                function (data) {
                    UpdateDivContent(data, element, false);
                }
        });
    }

    function UpdateDivContent(data, element, doAppend) {
        if (doAppend) {
            $("#dvContent_" + $(element).parent().parent().parent().find(".hdnGUID:first").val()).append(data);
        }
        else {
            $("#dvContent_" + $(element).parent().parent().parent().find(".hdnGUID:first").val()).html("");
            $("#dvContent_" + $(element).parent().parent().parent().find(".hdnGUID:first").val()).html(data);
        }
    }
      function PrintExplanations(TransactionId) {


        var data = { transactionId: TransactionId  ,__RequestVerificationToken: token };
        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetTransactionExplanationsForPrint", "Editor")' + '?transactionId=' + TransactionId,
            data: data,
            cache: false,
            success:

                function (data) {
                    if (data.MessageType != 2) {
                        var TransactionExplanationsWindow = window.open('', '_blank', 'width=900,height=500');

                        TransactionExplanationsWindow.document.write(data);
                        TransactionExplanationsWindow.document.close();
                        TransactionExplanationsWindow.focus();
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }
</script>
