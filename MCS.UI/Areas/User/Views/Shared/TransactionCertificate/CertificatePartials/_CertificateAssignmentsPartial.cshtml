@model TransactionAssignmentVM
@using MCS.UI.Areas.User.Models.Assignment;
@using MCS.UI.Helpers

    <div id="dvCerAssignments" class="tabscontent">
        <div id="printElectronicreceipt">
        </div>
        <div class="tab-content">
            <div class="where">
                <br />
                <br />

                <div class="form-row BasicInfo ml-3">
                    <div class="col-lg-12">

                        <div class="pl-5 col-lg-4">
                            <span class="gray3">@DbRes.TResource("User.Transaction.Link.TransactionNumber") : </span>
                            <span class="date-value Editor-lable">
                                @ViewData["TransactionsNumber"]
                            </span>
                        </div>
                        <div class="pl-sm-5 col-lg-4">
                            <span class="gray3">@DbRes.TResource("User.Transaction.PriorityLevel") :</span>
                            <span class="transaction-number Editor-lable" style="word-break:break-all">@ViewData["PriorityLevel"]</span>
                        </div>

                        <div class="pl-5 col-lg-4">
                            <span class="gray3">@DbRes.TResource("User.Transaction.ConfidentialityLevel") :</span>
                            <span class="date-value Editor-lable">
                                @ViewData["ConfidentialityName"]
                            </span>
                        </div>
                        <div class="pl-5 col-lg-6">
                            <span class="gray3">  @DbRes.TResource("User.InboundCertificate.TransactionFound") :</span>
                            <span class="date-value Editor-lable">
                                @Model.ToOrgUnitName
                            </span>
                        </div>

                        <div class="pl-sm-5 col-lg-6">
                            <span class="gray3">@DbRes.TResource("User.Inbound.BasicInfo.Subject")</span>
                            <span class="transaction-number Editor-lable">@ViewData["Subject"]</span>
                        </div>

                    </div>
                </div>
                <br />
                <br />
                @*<div class="row group_where">
                    <span class="col-sm-3">
                        @DbRes.TResource("User.InboundCertificate.PhysicalTransactionFound")
                    </span>
                    @if (Model != null)
                    {
                        <span class="col-sm-2">@Model.PhysicalEntityName</span>
                        <span class="col-sm-2">
                            @DateHelper.GetDate(Model.PhysicalDateH) - @Model.PhysicalDate.ToString("hh:mm tt")
                        </span>
                    }
                </div>*@
            </div>
        </div>
        <div class="row ">
            <div class="col-md-12">
                @Html.Partial("~/Areas/User/Views/Shared/TransactionCertificate/_AssignmentGridPartial.cshtml", ViewData["AssignmentsData"], new ViewDataDictionary { { "TransactionId", ViewData["TransactionId"] } })
            </div>
        </div>


        <div class="text-right panel-body">

            <button id="TransactionPrint" class="btn btn-site" onclick="PrintAssignmentTransactionReport(@ViewData["TransactionId"])"><i class="la la-print"></i> @DbRes.TResource("User.Transaction.Assignment.PrintAssignment")</button>

        </div>

    </div>
<script>

        function PrintAssignmentTransactionReport(TransactionId) {
        var data = { transactionId: TransactionId  };
        event.preventDefault();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetTransactionAssignmentHistoryWithContent", "TransactionLog")' + '?transactionId=' + TransactionId,
            data: data,
            cache: false,
            success:

                function (data) {
                    if (data.MessageType != 2) {
                        
                        var TransactionAssignmentWindow = window.open('', '_blank', 'width=900,height=500');

                        TransactionAssignmentWindow.document.write(data);
                        TransactionAssignmentWindow.document.close();
                        TransactionAssignmentWindow.focus();

                        setTimeout(function () {
                            TransactionAssignmentWindow.print();
                            TransactionAssignmentWindow.close();
                        }, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }

</script>