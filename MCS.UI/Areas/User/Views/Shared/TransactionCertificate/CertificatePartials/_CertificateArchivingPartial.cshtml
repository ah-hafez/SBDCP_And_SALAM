@model MCS.UI.Areas.User.Models.Search.TransactionCertificate.InboundCertificateVM
@using MCS.Common
@using MCS.UI.Helpers
@using MCS.Framework.Localization

@{
    string GUID = Guid.NewGuid().ToString();
}

<div id="dvCerArchiving" class="tabscontent archiving">
    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.TransactionCertificate.Attachments))
    {
        <ul class="nav nav-tabs custom-sub-nav-tabs mb-3" role="tablist">
            @Html.StickyHidden("hdnGUID", GUID, new { @class = "hdnGUID" })
            <li role="presentation" class="active">
                <a href="@("#" + GUID + "_sub-tab-1")" aria-controls="@(GUID + "_sub-tab-1")" role="tab" data-toggle="tab">
                    @DbRes.TResource("User.Audit.TransactionLog.CurrentAttachmentsData")
                </a>
            </li>
            <li role="presentation" class="hidden_">
                <a href="@("#" + GUID + "_sub-tab-2")" aria-controls="@(GUID + "_sub-tab-2")" role="tab" data-toggle="tab">
                    @DbRes.TResource("User.Audit.TransactionLog.Edits")
                </a>
            </li>
        </ul>
    }
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="@(GUID + "_sub-tab-1")">
        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.TransactionCertificate.Attachments))
        {
            if (Model.DocumentVM != null)
            {
                <div class="archiving_group">
                    @*<div class="archiving_group_title">
                            @DbRes.TResource("User.InboundCertificate.MainDocument")
                        </div>*@
                    <div class="archiving_group_content">
                        <a href="" onclick="ShowDocumentViewer('@Model.DocumentVM.Id','@ViewData["DocumentSessionKey"]'); return false;">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="col-md-4" style="font-weight:700">
                                        <i class="la la-paperclip"></i>
                                        @Html.DisplayFor(model => model.LetterType) -
                                        رقم @Html.DisplayFor(model => model.InboundNumber) -
                                        @DateHelper.GetDate(Model.HijriDate)

                                    </div>
                                    @*<div class="col-md-4">
                                            @Html.DisplayFor(model => model.LetterType)
                                        </div>*@
                                    @*<div class="col-md-4">
                                            @DateHelper.GetDate(Model.HijriDate)
                                        </div>*@
                                </div><br /><hr />
                            </div>
                        </a>
                    </div>
                </div>
            }
            if (Model.Attachments.Count > 0)
            {
                <div class="archiving_group ml-5">
                    <div class="archiving_group_title">
                        @DbRes.TResource("User.InboundCertificate.Attachments")
                    </div>
                    @for (int i = 0; i < Model.Attachments.Count; i++)
                    {
                        <div class="archiving_group_content">

                            <span class="" style="font-weight:700">
                                <a href="" onclick="ShowAttachmentViewer('@Model.Attachments[i].DocumentVM.Id','@Model.Attachments[i].Key'); return false;">
                                    <i class="fa fa-download"></i>
                                    @DbRes.TResource("User.InboundCertificate.AttachmentNumber") @(i + 1)
                                </a>
                            </span>
                        </div>
                    }
                </div>
            }
        }
        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.TransactionCertificate.Explanations))
        {
            <div role="tabpanel" class="tab-pane" id="@(GUID + "_sub-tab-2")">
                <div class="row">
                    <div class="col-md-12">
                        <label>@DbRes.TResource("User.Search.OriginExtensions")</label>
                    </div>
                </div>
                @Html.Partial("~/Areas/User/Views/Shared/TransactionCertificate/CertificatePartials/_ExplanationsCretificatePartial.cshtml", ViewData["ExplanationsData"])
                <hr />
            </div>
        }
    </div>
    @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.TransactionCertificate.Attachments))
    {
        <div role="tabpanel" class="tab-pane" id="@(GUID + "_sub-tab-3")">
            <div class="row">
                <div class="col-md-12">
                    <label>@DbRes.TResource("User.Search.OriginExtensions")</label>
                </div>
            </div>
            @Html.Partial("~/Areas/User/Views/Shared/TransactionCertificate/_TransationAuditPartial.cshtml", ViewData["AttachmentsAudits"])
            <hr />
        </div>
    }
    </div>
    </div>
