@model MCS.UI.Areas.User.Models.Search.TransactionCertificate.InboundCertificateVM
@using MCS.Common
@using MCS.Framework.Localization
@{
    /**/

    Layout = "~/Views/Shared/_DialogLayout.cshtml";
    int id = Model.Id;
}

<div class="content-rtl panel panel-default dialogbox_panel">
    <div class="content_container content_container--body transparent-bg">
        <div class="options-list row anchor">
            <div class="col-xs-4 col-sm-2 text-center">
                <a id="first" class="boardered-circle-transparent active" data-divid="dvCerBasicInfo" onclick="GetCertificateBasicInfo(@id)"><i class="uicon icon_folder1"></i></a>
                <a data-id="first" data-divid="dvCerBasicInfo" onclick="GetCertificateBasicInfo(@id)">  @DbRes.TResource("User.TransactionCertificate.TransactionData")</a>
            </div>
            <div class="col-xs-4 col-sm-2 text-center">
                <a id="second" class="boardered-circle-transparent" data-divid="dvCerNames" onclick="GetCertificateNames(@id)"><i class="uicon icon_folder3"></i></a>
