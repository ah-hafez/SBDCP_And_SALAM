@using MCS.Common
@using MCS.UI.Common
@model MCS.UI.Areas.User.Models.Shared.DocumentVM
@{
    Layout = "~/Views/Shared/_DialogLayout.cshtml";
    var doconutIframeUrl = UIConfigurations.GetFullURl() + string.Format("{0}?hidecontrols=true&showwatermark=false", SystemConfigurations.DoconutIframeUrl);
    //var doconutIframeWrd = UIConfigurations.GetFullURl() + string.Format("{0}?hidecontrols=true&showwatermark=true", "/DocoNut/ConvertWordToPdf");
    Session["DocoNutDocument"] = Model.Content;
    //ConvertWordToPdf


}

<div class="panel-body">
    <div class="text-center">
      
    </div>


    @if (Model.MimeType == System.Net.Mime.MediaTypeNames.Application.Pdf)
    {
        <div id="doconutContainer">
            <iframe src="@doconutIframeUrl" class="" style="width:100%; height:600px;" id="frameViewer" sandbox="allow-modals allow-same-origin allow-scripts allow-popups allow-forms allow-downloads"></iframe>
        </div>
    }
    else if (Model.MimeType == System.Net.Mime.MediaTypeNames.Application.Octet)
    {
<div id="doconutContainer">
    <iframe src="@doconutIframeUrl" class="" style="width:100%; height:1200px;" id="frameViewer" sandbox="allow-modals allow-same-origin allow-scripts allow-popups allow-forms allow-downloads"></iframe>
</div>
         @*@Html.TextEditor("txtEditor", "hdnContent", true, SessionInfo.CultureShortName.ToString(), Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode((Model.Content != null ? System.Text.Encoding.UTF8.GetString(Model.Content) : string.Empty), false)).ToString(), null, null, null)*@
    }
</div>
