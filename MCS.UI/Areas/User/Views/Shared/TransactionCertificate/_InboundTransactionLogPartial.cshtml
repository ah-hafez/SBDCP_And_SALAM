<script>

    function InsertPrintButton() {
        $('#printElectronicreceipt').append('<input type="button" onclick="PrintElectronicreceipt()" id="Print" class="btn btn-site mr-auto" value="طباعة" />');
    }




    $("div.anchor a").click(function () {
        $("div.anchor a").removeClass("active");
        $("div.anchor a").addClass("disabled");
        $(this).addClass("active");
        var id = $(this).data("id");
        $("#" + id).addClass("active");
        // $(".tabscontent").addClass("hidden_");
        //var divId = $(this).data("divid");
        //$("#" + divId).removeClass("hidden_");
    });

    $('.tab_editor').click(function () {

        var url;
        var data = new Array();

        $('.tab_editor').removeClass('select_but');
        $(this).addClass('select_but');

        $("._views").hide();

        switch ($(this)[0].id) {

            case "btnBasicInfo":
                $("#dvEditorBasicInfo").show();
                break;

            case "btnExplanation":
                $("#dvEditorExplanation").show();
                break;
        }
        return false;
    });

</script>

<script>
    function PrintElectronicreceipt() {
        var url = '@Url.Action("GetElectronicreceipt", "TransactionLog")' + '?transactionId=' + @Model.Id;
        ShowDialog(url, 'dialogbox col-md-12');
    }

    var urlPrintTicket = '@Url.Action("PrintTicket","Shared")' + '?transactionId=' + @Model.Id;




    function ShowTransactionCertificate(id, transactionType) {
        var url;
        debugger
        switch (transactionType) {

            case '@TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName).ToString()':

                url = '@Url.Action("InboundCertificate", "Shared")' + '?transactionId=' + id;
                break;

            case '@TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString()':

                url = '@Url.Action("InboundCertificate", "Shared")' + '?transactionId=' + id;
                break;

            case '@TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString()':
            case '@TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName).ToString()':

                url = '@Url.Action("OutboundCertificate", "Shared")' + '?transactionId=' + id;
                break;
        }

        ShowDialog(url);
    }
    function ShowPrintDialog(id) {
        var params = { transactionId: id };
        ShowDialogAjaxPrintingBarcodes('@Url.Action("PrinttingBarcodes","Shared")' + "?" + $.param(params), {}, 'OpenPrintDialogSuccess', 'dialogbox col-md-12 ');
    }

    function OpenPrintDialogSuccess(data, $obj) {
        if (data.MessageType != 2) {
            $obj.setContent(data.Html);
        }
        else {
            __dialog.close();
            ShowErrorMessage(data.MessageText);
        }
    }
    function CloseDialog()
    {
        $(".closeIcon").click();
        __dialog.close();

    }
</script>

<script>
    function GetCertificateBasicInfo(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetInboundBasicInfo", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element,false);
                }
        });
    }

    function GetCertificateNames(transactionId, element) {
        var id = transactionId;

        $.ajax({
            type: 'Get',
            cache: false,
            url: '@Url.Action("GetTransactionNames", "TransactionLog")',
            data: { transactionId: id},
            success:
                function (data) {
                    UpdateDivContent(data, element, true);
                }
        });
    }

