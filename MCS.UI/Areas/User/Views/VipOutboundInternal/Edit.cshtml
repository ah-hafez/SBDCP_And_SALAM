                        <div class="gray3">@DbRes.TResource("User.OutboundInternal.Number") :</div>

                        <div class="transaction-number Editor-lable">
                            @Model.OutboundInternalBasicInfoEdit.Number
                        </div>
                        @Html.Hidden("hdnNumber", @Model.OutboundInternalBasicInfoEdit.Number)
                    </div>
                    <div class="pl-5 Editor-div">
