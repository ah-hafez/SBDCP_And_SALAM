                                    <label for="ctl00_MainPlaceHolder_chkAgree">@DbRes.TResource("User.Transaction.Agree")</label>
                                </label>
                                @*@Html.CheckBox("ctl00MainPlaceHolderchkAgree", new { @id = "ctl00_MainPlaceHolder_chkAgree" })
                                    @Html.Label(@DbRes.TResource("User.Transaction.Agree"), new { @for = "ctl00_MainPlaceHolder_chkAgree" })*@

