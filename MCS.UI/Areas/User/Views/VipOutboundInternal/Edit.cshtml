                    else
                    {
                        @Html.Partial("~/Areas/User/Views/Vip/AssignmentPaper/_AssignmentPaperPartialNew2.cshtml", new VIPAssignmentVM { ToOrgUnitId = SessionInfo.OrgUnitId }, Html.ViewData)
                    }
                </div>
