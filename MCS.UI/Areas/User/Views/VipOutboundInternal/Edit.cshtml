                                <label>
                                    <input type="checkbox" id="ctl00_MainPlaceHolder_chkNotAgree" name="ctl00MainPlaceHolderchkNotAgree" />
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    <label for="ctl00_MainPlaceHolder_chkNotAgree">@DbRes.TResource("User.Transaction.disagree")</label>
                                </label>

                                @*@Html.CheckBox("ctl00MainPlaceHolderchkNotAgree", new { @id = "ctl00_MainPlaceHolder_chkNotAgree" })
                                    @Html.Label(@DbRes.TResource("User.Transaction.disagree"), new { @for = "ctl00_MainPlaceHolder_chkNotAgree" })*@
                            </span>
                            <span onchange="DirectionTypeChange(3);" style="padding-right: 10px" class="checkbox mt-2">
                                <label>
                                    <input type="checkbox" id="ctl00_MainPlaceHolder_chkAcknowledge" name="ctl00MainPlaceHolderchkAcknowledge" />
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    <label for="ctl00_MainPlaceHolder_chkAcknowledge">@DbRes.TResource("User.Transaction.seen")</label>
                                </label>
                                @*@Html.CheckBox("ctl00MainPlaceHolderchkAcknowledge", new { @id = "ctl00_MainPlaceHolder_chkAcknowledge" })
                                    @Html.Label(@DbRes.TResource("User.Transaction.seen"), new { @for = "ctl00_MainPlaceHolder_chkAcknowledge" })*@
                            </span>
                        </div>
                        <div class="corr-details-section">
                            @Html.TextAreaFor(x => x.Notes, new { rows = 3, cols = 20, @id = "ctl00_MainPlaceHolder_txtData", @class = "form-control", @name = "Notes" })
                        </div>

                    </div>
                </div>
            </div>
        }
        <div role="tabpanel" class="tab-pane hidden_" id="CertificateAssignment-tab">
            <div class="">

            </div>
        </div>
    </div>
</div>
<div id="dvButtonFooter" class="row text-right mr-5 mt-4 ml-xs-3 mb-4">

