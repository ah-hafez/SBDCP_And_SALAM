    ViewBag.Title = DbRes.TResource("User.OutboundInternal.EditTitle");
    var linkVM = new TransactionLinkVM { Links = (AjaxGrid<TransactionLinkVM>)new AjaxGridFactory().CreateAjaxGrid(Model.Links, 1, Model.Links.Count, false) };
    var followUpVM = new TransactionFollowUpVM() { FollowUps = (AjaxGrid<TransactionFollowUpVM>)new AjaxGridFactory().CreateAjaxGrid(Model.FollowUps, 1, Model.FollowUps.Count, false) };
}


@Html.StickyHidden("ConfidentialityItems", ViewData["ConfidentialityData"].ToString())
<script src="~/Scripts/VipCommon.js"></script>
<script src="~/Scripts/VipTransaction.js"></script>
<div class="d-flex flex-column flex-sm-row mx-5 mx-xs-3 mb-3 header-container">

</div>
<a href="@Url.Action("MyTransactions", "File", new { area = "user" })">
