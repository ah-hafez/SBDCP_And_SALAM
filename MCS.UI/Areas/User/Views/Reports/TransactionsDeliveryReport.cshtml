<script>

    $('input:radio[name=RePrint]').change(function () {
        debugger;
        if ($("input[name='RePrint']:checked").val() == 'false') {
            $("#dvDeliveryReportNumber").addClass("hidden");
        } else {
              $("#dvDeliveryReportNumber").removeClass("hidden");
            }
        });

    var additinalFileds = document.querySelector('#morefildes');
    var feilds = document.querySelector('.moreFields');
    additinalFileds.addEventListener('change', function () {
        if (this.checked) {
            feilds.style = "display:block;";
        }
        else {
            feilds.style = "display:none;";
        }
    })

    function ExportTransactionReportToPdf() {
        deliveryReportArray = new Array();
        var group;
        if ($('.checkbox input:checked').length > 1)
            group = true
        else
            group = false;
        $('.checkbox input:checked').each(function () {
            var transactionId = $(this).data("transid");
            var deliveryReportId = $(this).data("id");
            var add = true;
            var index;

            for (var i = 0; i < deliveryReportArray.length; i++) {
                if (deliveryReportArray[i].TransactionId == transactionId) {
                    add = false;
                    index = i;
                }
            }
            if (add) {
                deliveryReportArray.push({ TransactionId: transactionId, ReportsIds: [] });
                deliveryReportArray[deliveryReportArray.length - 1].ReportsIds.push(deliveryReportId);
            }
            else {
