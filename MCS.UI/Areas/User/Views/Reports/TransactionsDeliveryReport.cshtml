    function GetTransactionType(transactionTypeId) {

        $('#hdnTransactionTypeId').val(transactionTypeId);
        var transactionType;
        switch (transactionTypeId) {
            case @(TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)) :
                $('#dvInboundInputs').show();
                $('#dvExternalParty').hide();
                $('#divContainerExternalParties .txtDepartmentNumber').val('');
                $('#divContainerExternalParties .txtDepartmentName').val('');
                transactionType = '@TransactionCategory.Inbound.LookupIdentity(LookupCategory.TransactionCategory, SessionInfo.CultureShortName)';
                GetLetterTypeByTransactionType(transactionType);
                GetTypeByTransactionType(transactionType);
                break;
            case @(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)) :
                $('#dvInboundInputs').show();
                $('#dvExternalParty').hide();
                $('#divContainerExternalParties .txtDepartmentNumber').val('');
                $('#divContainerExternalParties .txtDepartmentName').val('');
                transactionType = '@(TransactionCategory.InternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))';
                GetLetterTypeByTransactionType(transactionType);
                GetTypeByTransactionType(transactionType);
                break;
            case @(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)) :
                $('#dvInboundInputs').hide();
                $('#dvExternalParty').show();
                $('#dvSourceType').hide();
                ClearInputs('dvInboundInputs');
                transactionType = '@(TransactionCategory.ExternalOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))';
                GetLetterTypeByTransactionType(transactionType);
                GetTypeByTransactionType(transactionType);
                break;
            case @(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName)) :
                $('#dvInboundInputs').show();
                $('#dvExternalParty').hide();
                $('#dvSourceType').hide();
                ClearInputs('dvInboundInputs');
                transactionType = '@(TransactionCategory.DraftOutbound.LookupIdentity(LookupCategory.TransactionCategory,SessionInfo.CultureShortName))';
                GetLetterTypeByTransactionType(transactionType);
                GetTypeByTransactionType(transactionType);
                break;
        }

        $.ajax({
            type: 'Get',
            url: '@Url.Action("GetPriorities")',
            data: { transactionCategory: transactionType },
            success:
                function (data) {
                    $("#ddlPriorityLevel").val("");
                    $("#hdnPriorityLevel").val("");
                    AutoCompleteChangeList("ddlPriorityLevel", data);
                }
        });
        return false;
    }

