@using MCS.Framework.Controls;
@using MCS.Framework.Controls.Mvc;
@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Report;
@using MCS.UI.Helpers;

@model PerformanceMeasurementReportVM
@{
    ViewBag.Title = "";
    Layout = "~/Areas/User/Views/Shared/_TransactionReportLayout.cshtml";
    string currentDateUmmalqura = DateHelper.ConvertDateCalendar(DateTime.Now.AddDays(-1), CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString());
    string currentDateGregorian = DateHelper.ConvertDateCalendar(DateTime.Now, CalenderType.Gregorian, SessionInfo.CultureShortName.ToString());
}
<div class="content_container  mt-5">
    <h2 class="site-color main-title">@DbRes.TResource("User.Layout.PerformanceMeasurementReport")</h2>
    @using (Html.BeginForm("PerformanceSearch", "Reports", FormMethod.Post, new { id = "FormPerformanceSearch" }))
    {
        @Html.AntiForgeryToken()
        <div id="PerformanceSearchContent" class="panel panel-body">
            <div class="form-row">
                <div id="ColumnsToGridContent"></div>
                <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <label class="control-label">@DbRes.TResource("User.File.ReportType")</label> <span class="stark">*</span>
                    @Html.AutoCompleteBuilder("ReportTypeId", "hdnReportTypeId", ViewData["ReportType"].ToString(), null, true, "form-control", "", "", "", true, onChangeCallback: "onTransactionReportTypeChange")
                    @Html.HiddenGroupFor(model => model.ReportTypeId, new { @Value = "", id = "hdnReportTypeId" }, "Search")
                </div>
                <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-12" style="display:none;">
                    <label class="control-label">@DbRes.TResource("User.File.RepresentationStyle")</label> <span class="stark">*</span>
                    @Html.AutoCompleteBuilder("RepresentationTypeId", "hdnRepresentationTypeId", ViewData["RepresentationType"].ToString(), null, true, "form-control", "", "", "", true)
                    @Html.HiddenGroupFor(model => model.RepresentationTypeId, new { @Value = "", id = "hdnRepresentationTypeId" }, "Search")
                </div>
            
                <div id="Columns1ToGridContent" class="form-group col-lg-4 col-md-4 col-sm-6 col-xs-12">
                    <div class="col-sm-6 px-0 pl-md-2">
                        <label>@DbRes.TResource("User.OutboundSearch.FromDate")</label>
                        <div class="with-icon" >
                            @Html.StickyHidden("hdnFromDateUm", "", new { id = "hdnFromDateUm" })
                            @Html.Calendar("fromDateCal", "hdnFromDateGreg", "hdnFromDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), currentDateUmmalqura, "form-control")
                            <a class=" date-icon2 " onclick="showCalender('fromDateCal')"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                            @Html.HiddenGroupFor(model => model.From, new { id = "hdnFromDateGreg" }, "Search")
                            <i id="FromIcon" style="color:red" class="glyphicon glyphicon-exclamation-sign hidden_"></i>
                            <span id="FromMessage" style="color:red"></span>
                        </div>
                    </div>
                    <div class="col-sm-6 px-0 pl-md-2">
                        <label>@DbRes.TResource("User.OutboundSearch.ToDate")</label>
                        <div class="with-icon">
                            @Html.StickyHidden("hdnToDateUm", "", new { id = "hdnToDateUm" })
                            @Html.Calendar("toDateCal", "hdnToDateGreg", "hdnToDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), currentDateUmmalqura, "form-control")
                            <a class=" date-icon2 " onclick="showCalender('toDateCal')"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                            @Html.HiddenGroupFor(model => model.To, new { id = "hdnToDateGreg" }, "Search")
                            <i id="ToIcon" style="color:red" class="glyphicon glyphicon-exclamation-sign hidden_"></i>
                            <span id="ToMessage" style="color:red"></span>
                        </div>
                    </div>
                    @Html.HiddenGroupFor(model => model.DepartmentId, new { id = "hdnDepartmentId" })
                </div>
                @if (Model.Level != 1 && Model.Level != 2)
                {
                    if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Reports.ViewOrganizationUnit))
                    {
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-12">
                            <div id="dvDepartmentsTree_1">
                                @Html.DepartmentsTree(ViewData["DepartmentsData"] as TreeViewModel, model => model.OrgUnitId, TreeMode.Single, "TreeFromOrgUnit", true,
                               "GetDirectedToUsersByOrgUnitIdOne", "", "dvDepartmentsTree_1")

                                @*<label>@Html.DisplayNameFor(model => model.OrgUnitId)<span class="stark">*</span></label>
                                    @Html.EditorFor(model => model.OrgUnitId, "OrgHierarchyCaller", additionalViewData: new { treeId = "TreeFromOrgUnit", GetChildrenActionURL = @Url.Action("GetInternalPartyChildren", "Shared"), GetNodeInfoByIdActionURL = @Url.Action("GetInternalPartyInfoById", "Shared"), GetNodeInfoByNumActionURL = @Url.Action("GetInternalPartyInfoByNumber", "Shared"), onClickfunction = "GetDirectedToUsersByOrgUnitIdOne", ValidationGroup = "", ShowAddPartyButton = false })*@
                            </div>
                        </div>
                    }
                    <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <div id="dvDepartmentsTree_1" style="display: none;">
                            @Html.DepartmentsTree(ViewData["DepartmentsData"] as TreeViewModel, model => model.OrgUnitId, TreeMode.Single, "TreeFromOrgUnit", true,
                           "GetDirectedToUsersByOrgUnitIdOne", "", "dvDepartmentsTree_1")


                            @*<label>@Html.DisplayNameFor(model => model.OrgUnitId)<span class="stark">*</span></label>
                                @Html.EditorFor(model => model.OrgUnitId, "OrgHierarchyCaller", additionalViewData: new { treeId = "TreeFromOrgUnit", GetChildrenActionURL = @Url.Action("GetInternalPartyChildren", "Shared"), GetNodeInfoByIdActionURL = @Url.Action("GetInternalPartyInfoById", "Shared"), GetNodeInfoByNumActionURL = @Url.Action("GetInternalPartyInfoByNumber", "Shared"), onClickfunction = "GetDirectedToUsersByOrgUnitIdOne", ValidationGroup = "", ShowAddPartyButton = false })*@




                        </div>
                    </div>
                }
                @Html.StickyHiddenFor(model => model.OrgUnitId)
                @Html.StickyHiddenFor(model => model.Level, new { id = "levelNumber" })
                @*<hr />*@
            </div>
            <div id="PerformanceMeasurementDepartmentContent" style="display:none;">
                <h3 class="site-color ml-3">@DbRes.TResource("User.Transaction.Search.AdditionalFields")</h3>
                <div class="form-row pb-3">
                    <label class="container_checkbox mx-2">
                        @DbRes.TResource("User.Transaction.Search.Common")
                        <input type="checkbox" name="" data-trigger="hidden_fields_one" data-typechosser="@Convert.ToInt32(SearchChosser.Common)" class="trigger">
                        <span class="checkmark"></span>
                    </label>
                </div>
                <hr />
            </div>
            <div id="PerformanceMeasurementStaffContent" style="display:none;">
                <h3 class="site-color ml-3">@DbRes.TResource("User.Transaction.Search.AdditionalFields")</h3>
                <div class="form-row pb-3">
                    <label class="container_checkbox mx-2">
                        @DbRes.TResource("User.Transaction.Search.Common")
                        <input type="checkbox" name="" data-trigger="hidden_fields_one" data-typechosser="@Convert.ToInt32(SearchChosser.Common)" class="trigger">
                        <span class="checkmark"></span>
                    </label>
                    @if (Model.Level != 1)
                    {
                        <label class="container_checkbox mx-2">
                            @DbRes.TResource("User.File.Employees")
                            <input type="checkbox" name="" data-trigger="hidden_fields_two" data-typechosser="@Convert.ToInt32(SearchChosser.Employees)" class="trigger">
                            <span class="checkmark"></span>
                        </label>
                    }
                </div>
                @*<hr />*@
            </div>
            <div id="Common" style="display:none;"></div>
            <div id="Employees" style="display:none;">Employees</div>
            <div id="ClassificationOfFields" style="display:none;">
                <div id="ClassificationOfFieldsContent">
                </div>
            </div>
        </div>
        <span class="float-right">
            @Html.ClientActionButton(@DbRes.TResource("User.Transaction.Search.DisplayResport"), "PerformanceSearch", "resultDiv", "OnSuccess", "", "Search", "btnSearch",
                "PerformanceSearchContent", " btn btn-st2 btn-lg", null, "VerifyTransaction", "")
        </span>
    }
    <div id="ResultContent"></div>
</div>

<script>

       $(document).ready(function () {
        $('#fromDateCal').attr('autocomplete', 'off');
        $('#toDateCal').attr('autocomplete', 'off');

    var year = @DateTimeUtility.GetHijriYear(DateTime.Now).ToString();
        var type = '@CalenderType.Ummalqura.ToString().ToLower()';
        //SetStartEndDate(year, 'fromDateCal', 'toDateCal', type);
    });


    $(document).ready(function () {
        ResetValidationForm();
        $('#ReportTypeId').trigger('change');
        var type = '@CalenderType.Ummalqura.ToString().ToLower()';
        $('#hdnFromDateGreg').val('@currentDateGregorian');
        $('#hdnToDateGreg').val('@currentDateGregorian');
        $('#fromDateCal').attr('autocomplete', 'off');
        $('#toDateCal').attr('autocomplete', 'off');

        $('.hide_trigger').hide();

        $('.trigger').change(function () {
            var hide_triggerId = $(this).attr("data-trigger");
            var type = parseInt($(this).data('typechosser'));
            var isChecked = $(this).is(':checked');
            GetSearchSection(type, isChecked, hide_triggerId);
        });
    });

    $(document).on("click", "span[data-node-id]", function () {
        var elemnt = $(this);
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsNodes")',
                data: { parentId: $(this).data("node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success: function (data) {
                    $(elemnt).closest('li').children('ul').last().empty()
                    $(elemnt).closest('li').children('ul').last().append(data);
                    $(elemnt).removeClass("InternalLoadedData");
                }
            });
        }
    });

    function GetDirectedToUsersByOrgUnitIdOne() {
        var orgUnitId = $('#OrgUnitId').val();
        var levelNumber = $('#levelNumber').val();
        if (orgUnitId != "") {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetUsersByOrgUnitId","Reports")',
                data: { id: orgUnitId, level: levelNumber},
                success: function (data) {
                    if ($('#ddlEmployeeId').length > 0) {
                        $("#ddlEmployeeId").val("");
                        $("#EmployeeVM_EmployeeId").val("");
                        AutoCompleteChangeList("ddlEmployeeId", data);
                    }
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
            return false;
        }
        else {
            if ($('#ddlEmployeeId').length > 0) {
                $("#ddlEmployeeId").val("");
                $("#EmployeeVM_EmployeeId").val("");
                AutoCompleteChangeList("ddlEmployeeId", "[]");
            }
        }
    }

    function ShowHideContent(value, triggerId) {
        if (value) {
            $("#" + triggerId).fadeIn();
        } else {
            $("#" + triggerId).fadeOut();
        }
    }

    function GetSearchSection(value, isChecked, hideTriggerId) {
        var htmlResult = "";
        if (isChecked) {
            $.ajax({
                type: 'get',
                cache: false,
                async: false,
                url: '@Url.Action("GetSearchSection", "Reports")',
                data: { type: value },
                success: function (data) {
                    if (data.Html) {
                        htmlResult = data.Html;
                    }
                }
            });
        }

        switch (value) {
            case @Convert.ToInt32(SearchChosser.Common):

                $('#Common').show();
                $('#Common').html(htmlResult);
                ShowHideContent(isChecked, hideTriggerId)
                break;
            case @Convert.ToInt32(SearchChosser.Employees):

                $('#Employees').show();
                $('#Employees').html(htmlResult);
                ShowHideContent(isChecked, hideTriggerId)
                GetDirectedToUsersByOrgUnitIdOne();
                break;
        }
    }

    function BuildColumnsToGrid() {
        var arrayIds = [];
        $('#ColumnsToGridContent').html('');
        var reportTypeId = parseInt($('#hdnReportTypeId').val());
        switch (reportTypeId) {
            case @Convert.ToInt32(TransactionReportType.PerformanceMeasurementStaff):
                arrayIds.push('@Convert.ToInt32(TransactionReportGridColumn.UserProfile)');
                break;
        }
        for (var index = 0; index < arrayIds.length; index++) {
            var item = arrayIds[index];
            $('#ColumnsToGridContent').append("<input name='ColumnsToGrid[" + index + "]' value=" + item + " type='hidden'/>");
        }
    }

    function ResetValidationForm() {
        var form = $("#FormPerformanceSearch");
        $.validator.unobtrusive.parse(form);
    }

    function OnSuccess(data) {
        if (data.MessageType != 2) {
            $('#ResultContent').html(data.Html);
            $('html, body').animate({ scrollTop: $(document).height() }, 'slow');
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    var searchCriteria = { data: '' };
    function VerifyTransaction() {
        searchCriteria = { data: '' };
        var FromDateGreg = CheckDateUm('From', 'hdnFromDateGreg');
        var ToDateGreg = CheckDateUm('To', 'hdnToDateGreg');
        var RemindDateGreg = (($('#CommonVM_IsAppointment') != undefined && $('#CommonVM_IsAppointment').length > 0 &&
            $('#CommonVM_IsAppointment').is(":checked")) ? CheckDateUm('AppointmentDate', 'hdnAppointmentDateGreg') : true);
        var isValid = FromDateGreg & ToDateGreg & RemindDateGreg;
        if (isValid) {
            BuildColumnsToGrid();
            searchCriteria.data = $("#PerformanceSearchContent :input").serializeArray();
        }
        return isValid;
    }

    function CheckDateUm(selectorToValidation, selectorToCheckValue) {
        var isValid = true;
        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        $("#" + selectorToValidation + "Icon").addClass("hidden_");
        $("#" + selectorToValidation + "Icon").hide();
        $("#" + selectorToValidation + "Message").html('');
        if ($("#" + selectorToCheckValue).val() != undefined && $("#" + selectorToCheckValue).length > 0 && $("#" + selectorToCheckValue).val() != '') {
            var selectedDate = convertdate($("#" + selectorToCheckValue).val());
            if (selectedDate > currentDate) {
                $("#" + selectorToValidation + "Icon").removeClass("hidden_");
                $("#" + selectorToValidation + "Icon").show();
                $("#" + selectorToValidation + "Message").html('يجب أن يكون التاريخ يساوي او أقل من تاريخ اليوم');
                isValid =  false;
            }
        }
        return isValid;
    }

    function onTransactionReportTypeChange() {
        var reportTypeId = parseInt($('#hdnReportTypeId').val());

        if (reportTypeId == 470) {
            $('#dvDepartmentsTree_1').hide();
        } else {
            $('#dvDepartmentsTree_1').show();
        }

        $('#PerformanceMeasurementDepartmentContent').hide();
        $('#PerformanceMeasurementStaffContent').hide();
        $('#Common').hide();
        $('#Employees').hide();
        ClearInputs("Common");
        ClearInputs("Employees");
        $(".trigger").each(function (obj) {
            var isChecked = $(this).is(':checked');
            if (isChecked) {
                $(this).prop("checked" , false);
            }
        });
        switch (reportTypeId) {
            case @Convert.ToInt32(TransactionReportType.PerformanceMeasurementDepartment):
                $('#PerformanceMeasurementDepartmentContent').show();
                $('#PerformanceMeasurementStaffContent').hide();
                break;
            case @Convert.ToInt32(TransactionReportType.PerformanceMeasurementStaff):
                $('#PerformanceMeasurementStaffContent').show();
                $('#PerformanceMeasurementDepartmentContent').hide();
                break;
        }
    }

    function GetTranactionSearchChooser(type) {
        $.ajax({
            type: 'get',
            cache: false,
            url: '@Url.Action("GetTransactionSearchChooser", "Reports")',
            data: { transactionCategory: type },
            success: function (data) {
                if (data.Html) {
                    $('#AdditionalFileds').html(data.Html);
                }
            },
            error: function (data) { }
        });
    }

    function DateTimeValidation() {
        var isValid = true;
        var fromDate = $("#hdnFromDateGreg").val();
        var toDate = $("#hdnToDateGreg").val();

        if (fromDate == null || fromDate == '' || toDate == null || toDate == '') {
            isValid = false;
        }
        return isValid;
    }

    function ResetSections() {
        $('#Common').html('');
    }
</script>