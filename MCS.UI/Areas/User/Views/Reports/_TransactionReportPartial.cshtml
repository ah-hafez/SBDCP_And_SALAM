                    @Html.LabelFor(model => model.Number, @DbRes.TResource("User.Reports.TransactionNo"), new { @class = "w-100" })
                    @Html.TextBoxFor(model => model.Number, new { maxlength = 10, onkeypress = "return IsNumeric(event);", @Value = "", @class = "form-control" })
                </div>
                <div class="form-group col-lg-2 col-md-4 col-sm-6 col-xs-12 mb-3">

