    <div id="ResultContent"></div>
</div>
<script>

    var Classificationfeild = document.querySelector('#Classificationfeild');
    var ClassificationContente = document.querySelector('.ClassificationContente');

    Classificationfeild.addEventListener('click', () => {
        debugger
        if (ClassificationContente.style.display === "none") {
            ClassificationContente.style.display = "block";
        } else {
            ClassificationContente.style.display = "none";
        }
    });

       $(document).ready(function () {
        $('#fromDateCal').attr('autocomplete', 'off');
        $('#toDateCal').attr('autocomplete', 'off');

        var year = @DateTimeUtility.GetHijriYear(DateTime.Now).ToString();
        var type = '@CalenderType.Ummalqura.ToString().ToLower()';
           //SetStartEndDate(year, 'fromDateCal', 'toDateCal', type);

    });

    $(document).ready(function () {

        ResetValidationForm();
        $('#TransactionType').trigger('change');
        var type = '@CalenderType.Ummalqura.ToString().ToLower()';
        $('#hdnFromDateGreg').val('@currentDateGregorian');
        $('#hdnToDateGreg').val('@currentDateGregorian');
        $('#fromDateCal').attr('autocomplete', 'off');
        $('#toDateCal').attr('autocomplete', 'off');
        //$('#hdnFromDateGreg').val($('#fromDateCal').val());

        $('#inbounddate').click();
    });


    document.addEventListener('readystatechange', (event) => {
        if (document.readyState == "complete") {
            $("#btnSearch").removeClass("hidden_");
        }
    });


    function StopChecked() {
        debugger;
        var currentElement = $(event.currentTarget);
        var newValue = currentElement.is(':checked');
        var transactionTypeValue = parseInt($('#hdnTransactionTypeId').val());
        var count;
        switch (transactionTypeValue) {
            case TransactionCategory.Inbound:
                count = $('#TransactionTypeInbound').find('input:checkbox:checked').length;
                break;
            case TransactionCategory.ExternalOutbound:
                count = $('#TransactionTypeExternal').find('input:checkbox:checked').length;
                break;
            case TransactionCategory.DraftOutbound:
                count = $('#TransactionTypeDraft').find('input:checkbox:checked').length;
                break;
            case TransactionCategory.InternalOutbound:
                count = $('#TransactionTypeInternal').find('input:checkbox:checked').length;
                break;
            default:
                count = $('#TransactionTypeAll').find('input:checkbox:checked').length;
                break;
        }
        if (count > 10 && newValue) {
            event.preventDefault();
            event.stopPropagation();
        }
    }

    function BuildColumnsToGrid() {
        var transactionTypeValue = parseInt($('#hdnTransactionTypeId').val());
        var arrayIds = [];
        $('#ColumnsToGridContent').html('');
        switch (transactionTypeValue) {
            case TransactionCategory.Inbound:
                $('#TransactionTypeInbound').find('input:checkbox').each(function (index) {
                    var item = $(this);
                    var type = item.data('type');
                    if (item.is(":checked")) {
                        arrayIds.push(type);
                    }
                });
                break;
            case TransactionCategory.ExternalOutbound:
                $('#TransactionTypeExternal').find('input:checkbox').each(function (index) {
                    var item = $(this);
                    var type = item.data('type');
                    if (item.is(":checked")) {
                        arrayIds.push(type);
                    }
                });
                break;
            case TransactionCategory.DraftOutbound:
                $('#TransactionTypeDraft').find('input:checkbox').each(function (index) {
                    var item = $(this);
                    var type = item.data('type');
                    if (item.is(":checked")) {
                        arrayIds.push(type);
                    }
                });
                break;
            case TransactionCategory.InternalOutbound:
                $('#TransactionTypeInternal').find('input:checkbox').each(function (index) {
                    var item = $(this);
                    var type = item.data('type');
                    if (item.is(":checked")) {
                        arrayIds.push(type);
                    }
                });
                break;
            default:
                $('#TransactionTypeAll').find('input:checkbox').each(function (index) {
                    var item = $(this);
                    var type = item.data('type');
                    if (item.is(":checked")) {
                        arrayIds.push(type);
                    }
                });
                break;
        }
        for (var index = 0; index < arrayIds.length; index++) {
            var item = arrayIds[index];
            $('#ColumnsToGridContent').append("<input name='ColumnsToGrid[" + index + "]' value=" + item + " type='hidden'/>");
        }
    }

    function ResetValidationForm() {
        var form = $("#FormTransactionSearch");
        $.validator.unobtrusive.parse(form);
    }

    function OnSuccess(data) {
        if (data.MessageType != 2) {
            $('#ResultContent').html(data.Html);
            $('html, body').animate({ scrollTop: $(document).height() }, 'slow');
        }
        else {
            ShowErrorMessage(data.MessageText);
        }
    }

    var searchCriteria = { data: '' };
    function VerifyTransaction() {
        debugger
        $('#hdnExternalPartiesId').val($('#divContainerExternalParties .hdnDepartmentId').val());
        searchCriteria = { data: '' };
        var FromDateGreg = CheckDateUm('From', 'hdnFromDateGreg');
        var ToDateGreg = CheckDateUm('To', 'hdnToDateGreg');
        var RemindDateGreg = (($('#CommonVM_IsAppointment') != undefined && $('#CommonVM_IsAppointment').length > 0 &&
            $('#CommonVM_IsAppointment').is(":checked")) ? CheckDateUm('AppointmentDate', 'hdnAppointmentDateGreg') : true);
        var InboundDateGreg = CheckDateUm('InboundDateH', 'hdnHasInboundDateGreg');
        var OutboundDateGreg = CheckDateUm('OutboundDateH', 'hdnHasOutboundDateGreg');
        var isValid = FromDateGreg & ToDateGreg & RemindDateGreg & InboundDateGreg & OutboundDateGreg;
        if (isValid) {
            BuildColumnsToGrid();
            searchCriteria.data = $("#TransactionSearchContent :input").serializeArray();
        }
        return isValid;
    }

    function CheckDateUm(selectorToValidation, selectorToCheckValue) {
        var isValid = true;
        var dateNow = $.datepicker.formatDate('dd/mm/yy', new Date($.now()));
        var currentDate = convertdate(dateNow);
        $("#" + selectorToValidation + "Icon").addClass("hidden_");
        $("#" + selectorToValidation + "Icon").hide();
        $("#" + selectorToValidation + "Message").html('');
        if ($("#" + selectorToCheckValue).val() != undefined && $("#" + selectorToCheckValue).length > 0 && $("#" + selectorToCheckValue).val() != '') {
            var selectedDate = convertdate($("#" + selectorToCheckValue).val());
            if (selectedDate > currentDate) {
                $("#" + selectorToValidation + "Icon").removeClass("hidden_");
                $("#" + selectorToValidation + "Icon").show();
                $("#" + selectorToValidation + "Message").html('يجب أن يكون التاريخ يساوي او أقل من تاريخ اليوم');
                isValid =  false;
            }
        }
        return isValid;
    }

    function onTransactionTypeChange() {
        ResetSections();
        $('#ClassificationOfFields').show();
        $('#TransactionTypeAll').hide();
        $('#TransactionTypeInbound').hide();
        $('#TransactionTypeInternal').hide();
        $('#TransactionTypeExternal').hide();
        $('#TransactionTypeDraft').hide();
        var transactionTypeValue = parseInt($('#hdnTransactionTypeId').val());
        switch (transactionTypeValue) {
            case TransactionCategory.Inbound:
                $('#TransactionTypeInbound').show();
                GetTranactionSearchChooser(TransactionCategory.Inbound);
                $('#hdnTransactionCategoryId').val(TransactionCategory.Inbound);
                break;
            case TransactionCategory.ExternalOutbound:
                $('#TransactionTypeExternal').show();
                GetTranactionSearchChooser(TransactionCategory.ExternalOutbound);
                $('#hdnTransactionCategoryId').val(TransactionCategory.ExternalOutbound);
                break;
            case TransactionCategory.DraftOutbound:
                $('#TransactionTypeDraft').show();
                GetTranactionSearchChooser(TransactionCategory.DraftOutbound);
                $('#hdnTransactionCategoryId').val(TransactionCategory.DraftOutbound);
                break;
            case TransactionCategory.InternalOutbound:
                $('#TransactionTypeInternal').show();
                GetTranactionSearchChooser(TransactionCategory.InternalOutbound);
                $('#hdnTransactionCategoryId').val(TransactionCategory.InternalOutbound);
                break;
            default:
                $('#TransactionTypeAll').show();
                GetTranactionSearchChooser(TransactionCategory.None);
                $('#hdnTransactionCategoryId').val(TransactionCategory.None);
                break;
        }
    }

    function GetTranactionSearchChooser(type) {
        $.ajax({
            type: 'get',
            cache: false,
            url: '@Url.Action("GetTransactionSearchChooser", "Reports")',
            data: { transactionCategory: type },
            success: function (data) {
                if (data.Html) {
                    $('#AdditionalFileds').html(data.Html);

                }
            },
            error: function (data) { }
        });
    }

    function DateTimeValidation() {
        var isValid = true;
        var fromDate = $("#hdnFromDateGreg").val();
        var toDate = $("#hdnToDateGreg").val();

        if (fromDate == null || fromDate == '' || toDate == null || toDate == '') {
            isValid = false;
        }
        return isValid;
    }

    function ResetSections() {
        $('#Common').html('');
        $('#Names').html('');
        $('#InboundOrInternalOrDraft').html('');
        $('#External').html('');
        $('#Transferrd').html('');
    }
</script>