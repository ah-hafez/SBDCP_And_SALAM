@using MCS.Framework.Controls;
@using MCS.Framework.Controls.Mvc;
@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Report;
@using MCS.UI.Helpers;

@model TransactionReportVM
@{
    ViewBag.Title = "";
    Layout = "~/Areas/User/Views/Shared/_TransactionReportLayout.cshtml";
    string currentDateUmmalqura = DateHelper.ConvertDateCalendar(DateTime.Now.AddDays(-1), CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString());
    string currentDateGregorian = DateHelper.ConvertDateCalendar(DateTime.Now, CalenderType.Gregorian, SessionInfo.CultureShortName.ToString());
    MCS.UI.Areas.Admin.Models.Shared.SettingVM dateType = SessionInfo.GetObjectFromSession(Constants.SettingDate) as MCS.UI.Areas.Admin.Models.Shared.SettingVM;
    var settingDateType = Convert.ToInt32(dateType.Value);
    var DateValue = (int)DateType.Gregorian;
    ViewBag.Title = DbRes.TResource("User.Reports.TransactionReport");
}
