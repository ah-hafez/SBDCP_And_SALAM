                    @Html.AutoCompleteBuilder("TransactionType", "hdnTransactionTypeId", ViewData["TransactionCategoriesForFilters"].ToString(), null, true, "form-control", "", "", "", true, onChangeCallback: "onTransactionTypeChange")
