                    @Html.HiddenFor(model => model.TransactionCategory, new { id = "hdnTransactionCategoryId" })
                </div>
                <div class="form-group col-lg-2 col-md-4 col-sm-6 col-xs-12 mb-3">

                    @Html.LabelFor(model => model.Subject, new { @class = "w-100" })
                    @Html.TextBoxGroupFor(model => model.Subject, "", new { @Value = "", @class = "form-control", maxlength = 20 })
