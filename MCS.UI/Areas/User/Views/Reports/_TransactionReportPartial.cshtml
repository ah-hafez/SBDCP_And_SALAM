        <span class="float-right">
            @Html.ClientActionButton(@DbRes.TResource("User.Transaction.Search.DisplayResport"), "TransactionSearch", "resultDiv", "OnSuccess", "", "Search", "btnSearch",
                "TransactionSearchContent", "btn btn-st2 btn-lg hidden_", null, "VerifyTransaction", "")
        </span>
