    columns.Add(model => model.TransactioDescription, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactioDescription))).Titled(DbRes.TResource("User.SubjectSearch.Subject"));
    columns.Add(model => model.PriorityText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Priority))).Titled(DbRes.TResource("User.Transaction.PriorityLevel"));
    columns.Add(model => model.ConfidentialityText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Confidentiality))).Titled(DbRes.TResource("User.Transaction.ConfidentialityLevel"));
    columns.Add(model => model.TransactionTypeText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.SubjectClassification))).Titled(DbRes.TResource("User.Transaction.BasicInfo.SubjectClassifications"));
    columns.Add(model => model.Remarks, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Remarks))).Titled(DbRes.TResource("User.Inbound.BasicInfo.Remarks"));
    columns.Add(model => model.DeliveryMethodText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.DeliveryMethod))).Titled(DbRes.TResource("User.Inbound.BasicInfo.ReceiveMethod"));
    columns.Add(model => model.FirstName, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FullName))).Titled(DbRes.TResource("User.Transaction.Name.FullName"));
    columns.Add(model => model.CivilID, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.CivilID))).Titled(DbRes.TResource("User.Transaction.Name.CivilID"));
    columns.Add(model => model.MobileNumber, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.MobileNumber))).Titled(DbRes.TResource("User.Transaction.Name.MobileNumber"));
    columns.Add(model => model.ExternalPartyText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ExternalParty))).Titled(DbRes.TResource("User.OutboundAdvancedSearch.ExternaParty"));
    columns.Add(model => model.InboundDateH, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.InboundDateH))).Titled(DbRes.TResource("User.Inbound.BasicInfo.InboundDateH"));
    columns.Add(model => model.FromEntityText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FromEntity))).Titled(DbRes.TResource("User.Transaction.Search.FromOrg"));
    columns.Add(model => model.FromUserText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FromUser))).Titled(DbRes.TResource("User.Transaction.Search.FromEmployee"));
    columns.Add(model => model.CreatedOn, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.CreatedOn))).Titled(DbRes.TResource("User.OutboundInternal.RecordDate"));
    columns.Add(model => model.RemindDate, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.RemindDate))).Titled(DbRes.TResource("Admin.Priority.HasDate"));
    columns.Add(model => model.TransactionStatus, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactionStatus))).Titled(DbRes.TResource("User.SubjectSearch.TransactionStatus"));
    columns.Add(model => model.DelayedDaysCount, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactionStatus))).Titled(DbRes.TResource("User.Transaction.Report.LateDays"));
    //columns.Add().Encoded(false).Sanitized(false).RenderValueAs(model => (@"<div class='correspondence-icon d-flex flex-column flex-sm-row'>
    //<a data-toggle = 'tooltip' class='circle color-red' title='" + @DbRes.TResource("User.InboundSearch.InboundCertificate") + "' onclick='InboundCertificate(" + model.TransactionCategoryId + "," + model.TransactionId + ")' data-original-title='" + @DbRes.TResource("User.InboundSearch.InboundCertificate") + "'>" +
    //    "<i class='la la-file-text'></i></a></div>"));
}).WithPaging(UIHelper.PageSize)
<style>
    .correspondence-icon {
        background-color: transparent;
        padding: 0px;
    }
</style>

<script>
    var isHubEditable = '@AESEncrytDecry.Base64Encode("false")';
    var myManagerGridEventHandler = "@Url.Action("SecretaryTransactionSearch", "Reports")";
    function prepareTransactionReportGrid() {
        $(".grid-mvc").gridmvc();
        var token = $("#FormTransactionSearch").find("input[name='__RequestVerificationToken']").val();
        var searchCriteriaData = JSON.parse(JSON.stringify(searchCriteria.data));
        searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });
        pageGrids.GridTransactionReport.ajaxify({
            getPagedData: myManagerGridEventHandler,
            requestType: "post",
            getData: myManagerGridEventHandler,
            optionalData: searchCriteriaData
        });
    }

    $(document).ready(function () {
        prepareTransactionReportGrid();
    });

    function EditTransactionByTypeId(transactionCategory, EncryptedId, EncryptedDraft) {
        var url;
        switch (transactionCategory) {
            case TransactionCategory.Inbound:
                url = '@Url.Action("Edit", "Inbound")' + "?id=-1";
                break;
            case TransactionCategory.ExternalOutbound:
                url = '@Url.Action("Edit", "OutboundExternal")' + "?id=-1&IsFromDraft=" + EncryptedDraft + "&isHubEditable=" + isHubEditable;
                break;
            case TransactionCategory.InternalOutbound:
                url = '@Url.Action("Edit", "OutboundInternal")' + "?id=-1";
                break;
            case TransactionCategory.DraftOutbound:
                url = '@Url.Action("Edit", "OutboundExternal")' + "?id=-1&IsFromDraft=" + EncryptedDraft + "&isHubEditable=" + isHubEditable;
                break;
        }
        url = url.replace("-1", EncryptedId);
        window.location.href = url;
    }

    

    function ShowPrintDialog(id) {
        var params = { transactionId: id };
        ShowDialogAjaxPrintingBarcodes('@Url.Action("PrinttingBarcodes","Shared")' + "?" + $.param(params), {}, 'OpenPrintDialogSuccess', 'dialogbox col-md-12 ');
    }

    function OpenPrintDialogSuccess(data, $obj) {
        if (data.MessageType != 2) {
            $obj.setContent(data.Html);
        }
        else {
            __dialog.close();
            ShowErrorMessage(data.MessageText);
        }
    }

    function ShowVisitTickect(id) {
        var actionUrl = '@Url.Action("PrintTicket", "Shared")' + "?transactionId=" + id;
        PrintButton(actionUrl);
    }
</script>