@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Report;
@using MCS.Framework.Encryption;
@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<TransactionGridResultVM>
@using MCS.UI.Helpers

@{
    List<int> columnsToGrid = ViewData["ColumnsToGrid"] == null ? new List<int>() : (List<int>)ViewData["ColumnsToGrid"];
    columnsToGrid.Add((int)TransactionReportGridColumn.ToEntity);
    columnsToGrid.Add((int)TransactionReportGridColumn.TransactionStatus);
    columnsToGrid.Add((int)TransactionReportGridColumn.ToUser);
}

@Html.Grid(Model).Named("GridTransactionReport").CollectionName("TransactionResults").Columns(columns =>
{
    //columns.Add(model => model.NumberWithDate, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.NumberWithDate))).Titled(DbRes.TResource("User.SubjectSearch.NumberWithDate"));
    columns.Add(model => model.Number, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Number))).Titled(DbRes.TResource("User.Inbound.Open.InboundNumber"));
    //columns.Add(model => model.OrgUnitText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.OrgUnit))).Titled("الإدارة المنشئة");
    columns.Add(model => model.LetterTypeText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.SourceType))).Titled(DbRes.TResource("User.OutboundExternal.BasicInfo.Type"));
    columns.Add(model => model.ToEntityText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ToEntity))).Titled(DbRes.TResource("User.Transaction.Search.TransactionPlace"));
    columns.Add(model => model.ToUserText, !columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ToUser))).Titled(DbRes.TResource("الموظف"));
