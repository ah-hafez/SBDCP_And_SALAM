@using System.Reflection;

@model TransactionReportResult
@{
    string BarchartId = Guid.NewGuid().ToString();
    string[] ItemsExcluded = { "OrgUnitsID", "OrgUnitName", "UserProfilesID", "UserProfileName" };
    List<List<int>> DataList = new List<List<int>>();
    Model.PerformanceMeasurementGridResultVMs.GridItems.ToList().ForEach(i =>
    {
        DataList.Add(new List<int>() { i.OutboundCount, i.OutboundDraftCountCreated, i.OutboundDraftCountAssigned, i.InboundCountCreated, i.InboundCountAssigned, i.InternalOutboundCountCreated, i.InternalOutboundCountAssigned, i.DelayedCount });
    });
    List<int> columnsToGrid = ViewData["ColumnsToGrid"] == null ? new List<int>() : (List<int>)ViewData["ColumnsToGrid"];

    string imagePath = Server.MapPath("~/Content/User/lib/images/GAMI_Logo_Color-01.svg");
    byte[] imageBytes = System.IO.File.ReadAllBytes(imagePath);
    string base64String = Convert.ToBase64String(imageBytes);
    string imageSource = "data:image/png;base64," + base64String;

}


