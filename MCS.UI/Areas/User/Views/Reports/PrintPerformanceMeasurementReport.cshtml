<script>
    $(function () {
                                        var dataT = {
                                            labels: ['', '', '', '', '', '', '', ''],
            datasets: [
                @foreach (List<int> dataset in DataList)
                {
                    @:{
                        @:label: '@Model.PerformanceMeasurementGridResultVMs.GridItems.ToList()[DataList.IndexOf(dataset)].OrgUnitName',
                        @:data: '@string.Join(",", dataset.ToArray())'.split(','),
                        @:fill: false,
                        @:backgroundColor: ['#387AC5', '#8FE1A1', '#C3C538', '#C56E38', '#E1D38F', '#8D38C5', '#E73232', '#4A38C5'],
                        @:borderColor: 'rgb(0, 0, 0, 0)',
                        @:borderWidth: 1
                    @:},
                }

            ]
                                        };
                                        var ctx = $("#@BarchartId").get(0).getContext("2d");
                                        var myNewChart = new Chart(ctx, {
                                            type: 'bar',
                                            data: dataT,
                                            options: {
                                                responsive: true,
                title: { display: false, text: '' },
                                                legend: { display: false },
                                                scales: {
                                                    xAxes: [{
                                                        display: false,
                                                        ticks: { beginAtZero: true }
                                                    }],
                                                    yAxes: [{
                                                        display: true,
                                                        ticks: { beginAtZero: true }
                                                    }],
                                                }
                                            }
                                        });
    });
                                    </script>

<script>
    $(document).ready(function () {
        var colorsElement = '<tr>';

        

        for (var i = 1; i <= 8; i++) {
            switch (i) {
                case 5:
                    colorsElement += '<td style="background-color:yellow !important;"></td>';
                    break;
                case 6:
                    colorsElement += '<td style="background-color:gray !important;"></td>';
                    break;
                case 7:
                    colorsElement += '<td style="background-color:green !important;"></td>';
                    break;
                case 8:
                    colorsElement += '<td style="background-color:red !important;"></td>';
                    break;
                default:
                    colorsElement += '<td></td>';
                    break;
                                }
                            }
        colorsElement += '</tr>';
        $('.rprtGrid').find('tr').first().after(colorsElement);
    });
</script>
