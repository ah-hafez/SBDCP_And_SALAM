<script>
    document.querySelector('.InputReportNumber').addEventListener('keypress', function (e) {
        var key = e.which || e.keyCode;
        if (key === 13) {
            e.preventDefault();
            $("#btnSearch").click();
        }
    });
    function OnSuccessPrint() {
        __dialog.close();
    }

    function UploadSignedReport() {
        if (!checkIfHasMainDocument(false)) {
            return false;
        }
        var token = $('#frmTransactionsDeliveryReport').find("input[name='__RequestVerificationToken']").val();
        $.ajax({
            type: 'Post',
            url: '@Url.Action("UploadSignedDeliveryReport")',
            data: {
                deliveryReportNumber: $('#hdnDeliveryReportNumber').val(),
                mainDocumentToken: $('#hdnMainDocToken').val(),
                date: $('#hdnDateGreg').val(),
                __RequestVerificationToken: token
            },
            success:
                function (data) {

                    $('#dvDocumentPartial').hide();
                    $("#dvDeliveryReportGridContener").html('لا يوجد بيانات للعرض');
                    ShowSuccesMessage(data.MessageText);
                }
        });
        return false;
    }

    function OnSuccess(data) {

        //
        //if(data.MessageType != 2){

        if (data.Html.includes('grid-empty-text')) {
            $('#pValidation').show();
            $('.InputReportNumber').addClass('RedBorder')
        } else {
            $('#pValidation').hide();
            $('.InputReportNumber').removeClass('RedBorder')
        }

        isPrint = $('#ckPrint').is(':checked');
        $('#hdnDeliveryReportNumber').val(data.DeliveryReportNumber);
        $('#dvDeliveryReportGridContener').html(data.Html);
        $('#dvDeliveryReportGridContener').show();
        $('#btnPrintTransactionsDeliveryReport').show();

        if (data.DeliveryReportNumber != "") {

            $('#dvDocumentPartial').show();
            $('#dvResultType').show();
        }
        else {
            $('#dvDocumentPartial').hide();
        }

        //$(".checkbox").hide();
        //document.getElementById('frameViewer').contentWindow.location.reload();

        //}
        //else{

        //ShowErrorMessage(data.MessageText);
        //}
    }

    $(document).ready(function () {

        $('#dvDocumentPartial').hide();
    });

    function uploadTransactionDeliveryReport(obj) {

        window.location.href = '@Url.Action("UploadTransactionDeliveryReport", "Reports")'
    }

    function printTransactionDeliveryReport(obj) {

        window.location.href = '@Url.Action("TransactionsDeliveryReport", "Reports")'
    }

    function searchDeliveryReport(obj) {

        window.location.href = '@Url.Action("searchDeliveryReport", "Reports")'
    }
     $(document).on("click", "span[data-node-id]", function () {
        var elemnt = $(this);
        if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsNodes")',
                data: { parentId: $(this).data("node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success: function (data) {
                    $(elemnt).closest('li').children('ul').last().empty()
                    $(elemnt).closest('li').children('ul').last().append(data);
                    $(elemnt).removeClass("InternalLoadedData");
                }
            });
        }
    });
</script>
<style>
    .RedBorder {
        border: 1px solid #fe0000 !important
    }
