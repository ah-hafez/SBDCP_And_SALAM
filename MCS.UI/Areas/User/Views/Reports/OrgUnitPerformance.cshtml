@using MCS.Framework.Localization
@using MCS.Common
@using MCS.Framework.Controls;
@using MCS.Framework.Controls.Mvc;
@model MCS.UI.Areas.User.Models.OrgUnitPerformanceReportViewModel

@{
    ViewBag.Title = DbRes.TResource("User.Report.OrgUnitPerformance.Reports");
    Layout = "~/Areas/User/Views/Shared/_Layout.cshtml";
}

<div id="dvContainer">
    <div class="page-title">
        <h2><span class="fa fa-arrow-circle-o-left"></span>@DbRes.TResource("User.Report.UsersPerformance.Reports")</h2>
    </div>
    <div class="page-content-wrap">
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmInputsReportUsersAchievement", @class = "form-horizontal form-row" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3 class="panel-title">@DbRes.TResource("User.Report.OrgUnitPerformance.Reports")</h3>
                        </div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-md-6">
                                    @Html.DepartmentsTree(ViewData["DepartmentsData"] as TreeViewModel, model => model.OrgUnitId, TreeMode.Single, "dvOrgUnitsTree", true, "SetOrgUnitText", "UserPerformance")
                                    <div class="form-group">
                                        <label class="col-md-4 control-label">@DbRes.TResource("User.Report.UsersPerformance.DateBetween")</label>
                                        <div class="col-md-8">
                                            <div class="input-group">
                                                @Html.Hidden("FromDateH", "", new { id = "hdnFromDateUm", @Class = "formField" })
                                                @Html.Calendar("fromDateCal", "hdnFromDateGreg", "hdnFromDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), null, "form-control")
                                                <span class="input-group-addon add-on"> - </span>
                                                @Html.Hidden("ToDateH", "", new { id = "hdnToDateUm", @Class = "formField" })
                                                @Html.Calendar("toDateCal", "hdnToDateGreg", "hdnToDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), null, "form-control")
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                        </div>
                                        <div class="col-md-4">
                                            @Html.HiddenGroupFor(model => model.FromDateTime, new { id = "hdnFromDateGreg", @Value = "", @Class = "formField form-control" }, "UserPerformance")
                                        </div>
                                        <div class="col-md-4">
                                            @Html.HiddenGroupFor(model => model.ToDateTime, new { id = "hdnToDateGreg", @Value = "", @Class = "formField form-control" }, "UserPerformance")
                                        </div>
                                    </div>


                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="col-md-4 control-label">@DbRes.TResource("User.Report.UsersPerformance.ReportType")</label>
                                        <div class="col-md-8">
                                            @Html.RadioButtonFor(model => model.IsStatusTransactionReport, true, new { id = "GeneralReport" })
                                            @DbRes.TResource("User.Report.OrgUnitPerformance.ByTransactionStatus")
                                            @Html.RadioButtonFor(model => model.IsStatusTransactionReport, false, new { id = "DetailedReport" })
                                            @DbRes.TResource("User.Report.OrgUnitPerformance.ByTransactionType")
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label">@DbRes.TResource("User.Report.UsersPerformance.TimeBetween")</label>
                                        <div class="col-md-8">
                                            <div class="input-group">
                                                @Html.AutoCompleteBuilder("ddlMinuteFrom", "hdnMinuteFromId", LookupCategory.Minute, null, true, "form-control time", null, null, false, null, DbRes.TResource("Global.MinuteSymbole"), 20)
                                                @Html.HiddenGroupFor(model => model.MinuteFrom, new { @Value = "", id = "hdnMinuteFrom" })
                                                @Html.Hidden("hdnMinuteFromId", new { @Value = "", id = "hdnMinuteFromId" }, "")
                                                <span class="input-group-addon add-on anchored">:</span>
                                                @Html.AutoCompleteBuilder("ddlHourFrom", "hdnHourFromId", LookupCategory.Hour, null, true, "form-control time", null, null, false, null, DbRes.TResource("Global.HourSymbole"), 20)
                                                @Html.HiddenGroupFor(model => model.HourFrom, new { @Value = "", id = "hdnHourFrom" })
                                                @Html.Hidden("hdnHourFromId", new { @Value = "", id = "hdnHourFromId" }, "")
                                                <span class="input-group-addon add-on"> - </span>
                                                @Html.AutoCompleteBuilder("ddlMinuteTo", "hdnMinuteToId", LookupCategory.Minute, null, true, "form-control time", null, null, false, null, DbRes.TResource("Global.MinuteSymbole"), 20)
                                                @Html.HiddenGroupFor(model => model.MinuteTo, new { @Value = "", id = "hdnMinuteTo" }, "")
                                                @Html.Hidden("hdnMinuteToId", new { @Value = "", id = "hdnMinuteToId" }, "")
                                                <span class="input-group-addon anchored">:</span>
                                                @Html.AutoCompleteBuilder("ddlHourTo", "hdnHourToId", LookupCategory.Hour, null, true, "form-control time", null, null, false, null, DbRes.TResource("Global.HourSymbole"), 20)
                                                @Html.HiddenGroupFor(model => model.HourTo, new { @Value = "", id = "hdnHourTo" }, "")
                                                @Html.Hidden("hdnHourToId", new { @Value = "", id = "hdnHourToId" }, "")
                                            </div>
                                            @Html.HiddenTimeSpanFor(model => model.TimeFrom, "ddlHourFrom", "ddlMinuteFrom", "UserPerformance")
                                            @Html.HiddenTimeSpanFor(model => model.TimeTo, "ddlHourTo", "ddlMinuteTo", "UserPerformance")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel-footer">
                            @*@Html.ActionButton(DbRes.TResource("User.Report.UsersPerformance.Search"), "UserPerformanceSearch", "dvContainer", null, null, "OnSuccess", null, "post", "UserPerformance", "btnSearch", "frmReportUserPerformance", "btn btn-permissions pull-left", "DateTimeValidation")*@
                            @Html.ClientButton(DbRes.TResource("User.Report.UsersPerformance.Search"), "btnSearch", "btn btn-permissions pull-right", "Redirect")

                        </div>
                        <div class="panel-body" id="dvReportContainer" style="position:absolute; visibility:hidden; display:block;">
                            <div class="row">
                                <div class="col-md-12">
                                    <iframe id="frameViewer" style="width: 100%; height: 800px" frameborder="0"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    @Html.Hidden("SelectedOrgUnitName", null, new { @class = "formField" })
    @Html.Hidden("CultureName", SessionInfo.CultureShortName, new { @class = "formField" })
    @Html.Hidden("UserId", SessionInfo.CurrentUser.Id, new { @class = "formField" })
</div>
<form class="form-horizontal form-row" target="_blank" action="@(MCS.UI.UrlHelper.GetBaseUri() + "/ReportViewer.aspx?ReportName=OrgUnitAchievement")" method="post" id="frmReportUsersAchievement"></form>

<script>

    $(function () {
        $("#SelectedOrgUnitName").val($("#divForm__dvOrgUnitsTree .txtDepartmentName").val());
    })


    function Redirect() {


        ClickedSubmit = "UserPerformance";
        $("#frmReportUsersAchievement").html("");

        DateTimeValidation();

        if ($('#frmInputsReportUsersAchievement').valid()) {


            if ($("#hdnToDateGreg").val() != "") {
                var ToDate = $("#hdnToDateGreg").val().split(' ')[0];
                $("#hdnToDateGreg").val(ToDate + " " + $("#hdnTimeSpanTimeTo").val());
            }

            if ($("#hdnFromDateGreg").val() != "") {

                var FromDate = $("#hdnFromDateGreg").val().split(' ')[0];
                $("#hdnFromDateGreg").val(FromDate + " " + $("#hdnTimeSpanTimeFrom").val());
            }


            $("#OrgUnitId").addClass("formField");
            $("#frmReportUsersAchievement").append($("#dvContainer .formField").clone());
            //$("#frmReportUsersAchievement").submit();
            var url = '';

            if ($("#DetailedReport").is(":checked")) {
                url = "@(MCS.UI.UrlHelper.GetBaseUri() + "/ReportViewer.aspx?ReportName=OrgUnitAchievementByTransactionType")";
            }
            else {
                url = "@(MCS.UI.UrlHelper.GetBaseUri() + "/ReportViewer.aspx?ReportName=OrgUnitAchievement")";
            }

            var iframe = document.getElementById('frameViewer');//.contentWindow.location.reload();
            iframe.src = url + "&" + $("#frmReportUsersAchievement").serialize();
            iframe.contentWindow.location = url + "&" + $("#frmReportUsersAchievement").serialize();
            iframe.setAttribute("src", url + "&" + $("#frmReportUsersAchievement").serialize());

            $("#dvReportContainer").attr("style", "");

        }
    }

    function SetOrgUnitText() {
        $("#SelectedOrgUnitName").val($("#divForm__dvOrgUnitsTree .txtDepartmentName").val());
    }

    function DateTimeValidation() {

        var fromDate = $("#hdnFromDateGreg").val();
        var toDate = $("#hdnToDateGreg").val();

        if (fromDate == null || fromDate == '' || toDate == null || toDate == '')
            return true;

        var date1 = convertdate(fromDate);
        var date2 = convertdate(toDate);

        if (date1 != date2) {

            $("#hdnTimeSpanTimeFrom").val('');
            $("#hdnTimeSpanTimeTo").val('');
        }
        else {

            AppendHours('hdnTimeSpanTimeFrom', 'ddlHourFrom');
            AppendMinutes('hdnTimeSpanTimeFrom', 'ddlMinuteFrom');

            AppendHours('hdnTimeSpanTimeTo', 'ddlHourTo');
            AppendMinutes('hdnTimeSpanTimeTo', 'ddlMinuteTo');
        }

        return true;
    }

    $('#ddlHourTo').change(function () {

        $('#hdnHourTo').val($('#ddlHourTo').val());
    });

    $('#ddlMinuteTo').change(function () {

        $('#hdnMinuteTo').val($('#ddlMinuteTo').val());
    });

    $('#ddlHourFrom').change(function () {

        $('#hdnHourFrom').val($('#ddlHourFrom').val());
    });

    $('#ddlMinuteFrom').change(function () {

        $('#hdnMinuteFrom').val($('#ddlMinuteFrom').val());
    });

</script>

