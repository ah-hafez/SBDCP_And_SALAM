@using MCS.UI.Areas.User.Models.Report;
@using MCS.Framework.Localization;
@using MCS.Framework.Controls;
@using MCS.UI.Helpers;
@using MCS.UI.Common;

@model TransactionReportResult
@{
    Layout = null;
    List<int> columnsToGrid = ViewData["ColumnsToGrid"] == null ? new List<int>() : (List<int>)ViewData["ColumnsToGrid"];
    columnsToGrid = new List<int>();
    //columnsToGrid.Add((int)TransactionReportGridColumn.ToEntity);
    //columnsToGrid.Add((int)TransactionReportGridColumn.TransactionStatus);
}

<DOCTYPE html>
    <html lang="ar">
    <head>
        <title></title>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" type="text/css" id="theme" href="@UIConfigurations.GetFullURl()/Content/User/lib/css/theme_@(SessionInfo.CultureShortName).css" />
        @if (SessionInfo.CultureShortName == "ar")
        {
            <link rel="stylesheet" type="text/css" id="theme" href="@UIConfigurations.GetFullURl()/Content/User/lib/css/rtl.css" />
        }
        <link type="image/x-icon" rel="shortcut icon" href="@UIConfigurations.GetFullURl()/Content/User/lib/favicon.png">
        <meta name="description" content="">
        <meta name="author" content="">
        <meta name="theme-color" content="#0c7c5a">
        <title>@ViewBag.Title</title>
        <!-- New -->
        <link href="@UIConfigurations.GetFullURl()/Content/User/lib/css/new.css" rel="stylesheet" />
        <!-- Select2 CSS -->
        <link href="@UIConfigurations.GetFullURl()/Content/User/lib/plugins/select2/select2.min.css" rel="stylesheet" />
        <link href="@UIConfigurations.GetFullURl()/Content/User/lib/css/dawood-style.css" rel="stylesheet" />
        <script src="@UIConfigurations.GetFullURl()/Scripts/jquery.min.js"></script>
        <style>
            .pagebreak {
                page-break-after: always;
            }

            table.rprt {
                width: 100%;
            }

                table.rprt td {
                    padding: 5px;
                    text-align: center;
                }

            table.rprtGrid {
                width: 100%;
                border: 1px solid #000000;
            }

                table.rprtGrid td {
                    padding: 5px;
                    border-bottom: 1px dashed #CCCCCC;
                }

            .center {
                display: block;
                margin-left: auto;
                margin-right: auto;
                /*width: 50%;*/
                max-height: 43px;
                max-width: 214px;
            }
        </style>
    </head>
    <body>
        @*<div style="margin:3px;">

            </div>*@
        <table class="rprt">
            <tr>
                <td>
                    <img class="" width="200" src="~/Content/User/lib/images/GAMI_Logo_Color-01.svg" />

                    <h3 class="dark-color mx-1 d-inline-block">@Model.TransactionBasicResultVM.TenantName</h3>
                    <img class="main_logo img center" src="~/Content/User/lib/images/GAMI_Logo_Color-01.svg" />
                    <br>
                </td>
            </tr>
            <tr>
                <td>تاريخ انشاء التقرير</td>
                <td>التاريخ من/الى</td>
            </tr>
            <tr>
                <td>@DateHelper.ConvertDateCalendar(Model.TransactionBasicResultVM.CreateOn, CalenderType.Ummalqura, SessionInfo.CultureShortName)</td>
                <td>@Model.TransactionBasicResultVM.FromTo</td>
            </tr>
            <tr>
                <td>نوع المعاملة</td>
                <td>اسم الموظف المنشئ</td>
            </tr>
            <tr>
                <td>@Model.TransactionBasicResultVM.TransactionType</td>
                <td>@Model.TransactionBasicResultVM.CreatedBy</td>
            </tr>
            <tr>
                <td><span>جدول المعاملات</span> (سجلات @Model.TransactionBasicResultVM.TotalCount)</td>
                <td></td>
                <td></td>
                <td></td>
            </tr>

            <tr>
                <td colspan="2">
                    <div class="row">
                        <table class="rprtGrid">
                            <tr>

                                <td><b>@DbRes.TResource("User.Inbound.Open.InboundNumber")</b></td>
                                <td><b>@DbRes.TResource("User.OutboundExternal.BasicInfo.Type")</b></td>
                                <td><b>@DbRes.TResource("User.Transaction.Search.TransactionPlace")</b></td>
                                <td><b>@DbRes.TResource("الموظف")</b></td>
                                <td><b>@DbRes.TResource("User.File.AssignDate")</b></td>
                                <td><b>@DbRes.TResource("User.SubjectSearch.Subject")</b></td>
                                <td><b>@DbRes.TResource("User.Transaction.PriorityLevel")</b></td>
                                <td><b>@DbRes.TResource("User.Transaction.ConfidentialityLevel")</b></td>
                                <td><b>@DbRes.TResource("User.SubjectSearch.TransactionStatus")</b></td>
                                <td><b>@DbRes.TResource("User.Transaction.Report.LateDays")</b></td>


                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.NumberWithDate)))
                                {
                                    <td><b>@DbRes.TResource("User.SubjectSearch.NumberWithDate")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactionType)))
                                {
                                }
                                @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.OrgUnit)))
                                    {
                                        <td><b>@DbRes.TResource("الإدارة المنشئة")</b></td>
                                    }*@
                                @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Date)))
                                    {
                                        <td><b>@DbRes.TResource("User.InboundSearch.Date")</b></td>
                                    }*@
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.SourceType)))
                                {
                                    <td><b>@DbRes.TResource("User.OutboundExternal.BasicInfo.Type")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactioDescription)))
                                {
                                    <td><b>@DbRes.TResource("User.SubjectSearch.Subject")</b></td>
                                }

                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Priority)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.PriorityLevel")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.SubjectClassification)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.BasicInfo.SubjectClassifications")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Remarks)))
                                {
                                    <td><b>@DbRes.TResource("User.Inbound.BasicInfo.Remarks")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.DeliveryMethod)))
                                {
                                    <td><b>@DbRes.TResource("User.Inbound.BasicInfo.ReceiveMethod")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FullName)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.Name.FullName")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.CivilID)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.Name.CivilID")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.MobileNumber)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.Name.MobileNumber")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ExternalParty)))
                                {
                                    <td><b>@DbRes.TResource("User.OutboundAdvancedSearch.ExternaParty")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.InboundDateH)))
                                {
                                    <td><b>@DbRes.TResource("User.Inbound.BasicInfo.InboundDateH")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FromEntity)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.Search.FromOrg")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FromUser)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.Search.FromEmployee")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ToEntity)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.Search.TransactionPlace")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ToUser)))
                                {
                                    <td><b>@DbRes.TResource("User.Transaction.Search.ToEmployee")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.CreatedOn)))
                                {
                                    <td><b>@DbRes.TResource("User.OutboundInternal.RecordDate")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.RemindDate)))
                                {
                                    <td><b>@DbRes.TResource("Admin.Priority.HasDate")</b></td>
                                }
                                @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactionStatus)))
                                {
                                    <td><b>@DbRes.TResource("User.SubjectSearch.TransactionStatus")</b></td>
                                }

                            </tr>
                            @{ var results = Model.TransactionPrintResultVMs; }
                            @if (results != null && results.Count > 0)
                            {
                                foreach (var m in results)
                                {
                                    <tr>
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.NumberWithDate)))*@
                                        @{
                                            <td>@m.Number</td>
                                            <td>@m.LetterTypeText</td>
                                            <td>@m.ToEntityText</td>
                                            <td>@m.ToUserText</td>
                                            <td>@DateHelper.DateCalendar(m.AssignDate, SessionInfo.CultureShortName, true)</td>
                                            <td>@m.TransactioDescription</td>
                                            <td>@m.PriorityText</td>
                                            <td>@m.ConfidentialityText</td>
                                            <td>@m.TransactionStatus</td>
                                            <td>@m.DelayedDaysCount</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactionType)))
                                        {
                                            <td>@m.TransactionCategoryText</td>
                                        }
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.OrgUnit)))
                                            {
                                                <td>@m.OrgUnitText</td>
                                            }*@
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Date)))
                                            {
                                                <td>@m.DateText</td>
                                            }*@
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.SourceType)))
                                        {
                                            <td>@m.LetterTypeText</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactioDescription)))
                                        {
                                            <td>@m.TransactioDescription</td>
                                        }
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Confidentiality)))*@
                                        @{
                                        }
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Priority)))*@
                                        @{
                                        }
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.SubjectClassification)))*@
                                        @{
                                        }
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.Remarks)))*@
                                        @{
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.DeliveryMethod)))
                                        {
                                            <td>@m.DeliveryMethodText</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FullName)))
                                        {
                                            <td>@m.FirstName</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.CivilID)))
                                        {
                                            <td>@m.CivilID</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.MobileNumber)))
                                        {
                                            <td>@m.MobileNumber</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ExternalParty)))
                                        {
                                            <td>@m.ExternalPartyText</td>
                                        }
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.InboundDateH)))*@
                                        @{
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FromEntity)))
                                        {
                                            <td>@m.FromEntityText</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.FromUser)))
                                        {
                                            <td>@m.FromUserText</td>
                                        }
                                        @*@if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ToEntity)))*@
                                        @{
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.ToUser)))
                                        {
                                            <td>@m.ToUserText</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.CreatedOn)))
                                        {
                                            <td>@m.CreatedOn</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.RemindDate)))
                                        {
                                            <td>@m.RemindDate</td>
                                        }
                                        @if (columnsToGrid.Contains(Convert.ToInt32(TransactionReportGridColumn.TransactionStatus)))
                                        {
                                        }

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>لا يوجد بيانات للعرض</td>
                                </tr>
                            }
                        </table>
                    </div>
                </td>
            </tr>
        </table>
    </body>
</html>
