@using MCS.UI.Areas.User.Models.Report;
@model TransactionReportResult
<div class="content_container">
    <div class="content_container content_container--header">
        <div class="d-flex flex-column flex-lg-row">
            <div class="mr-auto filter-link">
                <h3 class="site-color ml-3">@DbRes.TResource("User.Reports.ReportsResualt")</h3>
            </div>
        </div>
        <div class="white-container">
            @Html.Partial("_TransactionBasicResultPartial", Model.TransactionBasicResultVM)
            <div class="row m-0">
                <div class="col-xs-12">
                    @Html.Partial("_TransactionGridResultPartial", Model.TransactionGridResultVMs, ViewData)
                </div>
            </div>
        </div>
    </div>
    <div class="text-right panel-body">
        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Reports.PrintReports))
        {
            <button id="TransactionPrint" class="btn btn-st1 btn-lg" onclick="PrintTransactionReport()"><i class="la la-print"></i> @DbRes.TResource("User.Transaction.Reports.Prints")</button>
        }
        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Reports.SaveReports))
        {
            <button class="btn btn-st1 btn-lg" onclick="ExportTransactionReportToPdf()"><i class="la la-file-pdf-o"></i> @DbRes.TResource("User.Transaction.Reports.Export")</button>
            @*<button class="btn btn-st1 btn-lg" onclick="Export2Word()"><i class="la la-file-pdf-o"></i> Word</button>*@
        }
        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Reports.PrintReports))
        {
            <button class="btn btn-st1 btn-lg" onclick="ExportTransactionReportToExcel()"><i class="la la-file-pdf-o"></i> تصدير Excel</button>
        }

    </div>
</div>
<script>
    var token = $("#FormTransactionSearch").find("input[name='__RequestVerificationToken']").val();
    function PrintTransactionReport() {
        event.preventDefault();
        var searchCriteriaData = JSON.parse(JSON.stringify(searchCriteria.data));
        searchCriteriaData.push({ name: 'TotalCount', value: $('#TotalCount').val() });
        searchCriteriaData.push({ name: 'IsPrint', value: true });
        searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });

        $.ajax({
            type: "post",
            url: '@Url.Action("TransactionSearch", "Reports")',
            data: searchCriteriaData,
            cache: false,
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        var TransactionReportWindow = window.open('', '_blank', 'width=900,height=500');

                        TransactionReportWindow.document.write(data.Html);
                        TransactionReportWindow.document.close();
                        TransactionReportWindow.focus();

                        setTimeout(function () {
                            TransactionReportWindow.print();
                            TransactionReportWindow.close();
                        }, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }
    function ExportTransactionReportToPdf() {
        event.preventDefault();
        var searchCriteriaData = searchCriteria.data;
        searchCriteriaData.push({ name: 'TotalCount', value: $('#TotalCount').val() });
        searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });
        $.ajax({
            type: "post",
            url: '@Url.Action("ExportToPdf", "Reports")',
            data: searchCriteriaData,
            cache: false,
            success: function (data) {
                if (data) {
                    if (data.MessageType != 2) {
                        var url = '@Url.Action("Download", "Reports")';
                        window.location.href = url + '?fileGuid=' + data.FileGuid + '&filename=' + data.FileName;
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
            }
        });
    }
     function ExportTransactionReportToExcel() {
        event.preventDefault();
        var searchCriteriaData = searchCriteria.data;
         searchCriteriaData.push({ name: 'TotalCount', value: $('#TotalCount').val() });
         searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });
        $.ajax({
            type: "post",
            url: '@Url.Action("ExportToExcel", "Reports")',
            data: searchCriteriaData,
            cache: false,
            success: function (data) {
                if (data) {
                    if (data.MessageType != 2) {
                        var url = '@Url.Action("Download", "Reports")';
                        window.location.href = url + '?fileGuid=' + data.FileGuid + '&filename=' + data.FileName;
                    }
                    else {

                        ShowErrorMessage('@DbRes.TValidation("User.Report.ExportActionMsg")');

                    }
                }
            }
        });
    }
    function encodeImageFileAsURL(image) {

        var imgCanvas = document.createElement("canvas"),
            imgContext = imgCanvas.getContext("2d");

        // Make sure canvas is as big as the picture
        imgCanvas.width = image.naturalWidth;
        imgCanvas.height = image.naturalHeight;

        // Draw image into canvas element
        imgContext.drawImage(image, 0, 0);
        // Save image as a data URL
        imgInfom = imgCanvas.toDataURL("image/png");
        /*document.body.removeChild(imgCanvas);*/
        return imgInfom;
    }

    function Export2Word(filename = '') {
        var preHtml = "<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Export HTML To Doc</title></head><body>";
        var postHtml = "</body></html>";

        $('.white-container img').each(function () {
            $(this).attr('src', encodeImageFileAsURL($(this)[0]))
            $(this).css('width', $(this).css('width'));
        });

        var html = preHtml + $('.white-container').html() + postHtml;

        var blob = new Blob(['\ufeff', html], {
            type: 'application/msword'
        });

        // Specify link url
        var url = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent(html);

        // Specify file name
        filename = filename ? filename + '.doc' : 'document.doc';

        // Create download link element
        var downloadLink = document.createElement("a");

        document.body.appendChild(downloadLink);

        if (navigator.msSaveOrOpenBlob) {
            navigator.msSaveOrOpenBlob(blob, filename);
        } else {
            // Create a link to the file
            downloadLink.href = url;

            // Setting the file name
            downloadLink.download = filename;

            //triggering the function
            downloadLink.click();
        }

        document.body.removeChild(downloadLink);
    }
</script>