@using MCS.UI.Areas.User.Models.Report;
@model TransactionReportResult
<div class="content_container">
    <div class="content_container content_container--header">
        <div class="d-flex flex-column flex-lg-row">
            <div class="mr-auto filter-link">
                <h3 class="site-color ml-3">@DbRes.TResource("User.Reports.ReportsResualt")</h3>
            </div>
        </div>
        <div class="white-container">
            @Html.Partial("_TransactionBasicResultPartial", Model.TransactionBasicResultVM)
            <div class="row m-0">
                <div class="col-xs-12">
                    @Html.Partial("_PerformanceMeasurementGridResultPartial", Model.PerformanceMeasurementGridResultVMs, ViewData)

                    @if (ViewData["ReportType"] != null && (int)ViewData["ReportType"] == 1)
                    {
                        @Html.Partial("_PerformanceMeasurementBarchartGridResultPartial", Model.PerformanceMeasurementGridResultVMs.GridItems, ViewData);
                    }

                    @*@if (Model.RepresentationReportType == RepresentationReportType.Table)
                    {

                    }
                    else if (Model.RepresentationReportType == RepresentationReportType.Barchart)
                    {
                    }*@
                </div>
            </div>
        </div>
    </div>
    <div class="text-right">

        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Reports.PrintReports))
        {
            <button id="TransactionPrint" class="btn btn-st1 btn-lg" onclick="PrintPerformanceMeasurementReport()">@DbRes.TResource("User.Transaction.Reports.Prints")</button>
        }
        @if (SessionInfo.CurrentUser.Claims.Contains(UserClaims.Reports.SaveReports))
        {
            <button class="btn btn-st1 btn-lg" onclick="ExportPerformanceMeasurementReportToPdf()">@DbRes.TResource("User.Transaction.Reports.Export")</button>
        }
    </div>
</div>
<script>
    function PrintPerformanceMeasurementReport() {
        event.preventDefault();
        var searchCriteriaData = [];
        var token = $("#FormPerformanceSearch").find("input[name='__RequestVerificationToken']").val();
        searchCriteriaData = JSON.parse(JSON.stringify(searchCriteria.data));
        searchCriteriaData.push({ name: 'TotalCount', value: $('#TotalCount').val() });
        searchCriteriaData.push({ name: 'IsPrint', value: true });
        searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });

        $.ajax({
            type: "post",
            url: '@Url.Action("PerformanceSearch", "Reports")',
            data: searchCriteriaData,
            cache: false,
            success:
                function (data) {
                    if (data.MessageType != 2) {
                        var TransactionReportWindow = window.open('', '_blank', 'width=900,height=500');
                        TransactionReportWindow.document.write(data.Html);
                        TransactionReportWindow.document.close();
                        TransactionReportWindow.focus();

                        setTimeout(function () {
                            TransactionReportWindow.print();
                            TransactionReportWindow.close();
                        }, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }

    function ExportPerformanceMeasurementReportToPdf() {
        event.preventDefault();
        var token = $("#FormPerformanceSearch").find("input[name='__RequestVerificationToken']").val();
        var searchCriteriaData = [];
        searchCriteriaData = JSON.parse(JSON.stringify(searchCriteria.data));
        searchCriteriaData.push({ name: 'TotalCount', value: $('#TotalCount').val() });
        searchCriteriaData.push({ name: '__RequestVerificationToken', value: token });
        $.ajax({
            type: "post",
            url: '@Url.Action("PerformanceMeasurementExportToPdf", "Reports")',
            data: searchCriteriaData,
            cache: false,
            success: function (data) {
                if (data) {
                    if (data.MessageType != 2) {
                        var url = '@Url.Action("Download", "Reports")';
                        window.location.href = url + '?fileGuid=' + data.FileGuid + '&filename=' + data.FileName;
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
            }
        });
    }
</script>
