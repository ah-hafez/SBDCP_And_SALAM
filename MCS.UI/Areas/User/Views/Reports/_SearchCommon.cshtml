        <div class="form-group col-sm-6 col-xs-12 mb-3">

            <label class="w-100">@DbRes.TResource("User.OutboundInternal.BasicInfo.Remarks") </label>
            @Html.TextAreaGroupFor(model => model.Remarks, new { @class = "form-control long-textarea2" })
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
            <div>
                <label class="check">
                    <div class="checkbox">
                        <label>
                            <input id="IsAppointment" type="checkbox" value="">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                        @Html.LabelFor(model => model.IsAppointment, new { @class = "dark-color p-0" })
                    </div>
                </label>
                @Html.Hidden("IsAppointment")
            </div>
            <div id="AppointmentDateContent" style="display:none;" class="with-icon">
                @Html.Hidden("hdnAppointmentDateHDateUm", "", new { id = "hdnAppointmentDateHDateUm" })
                @Html.Calendar("AppointmentDateCal", "hdnAppointmentDateGreg", "hdnAppointmentDateHDateUm", CalenderType.Ummalqura, SessionInfo.CultureShortName.ToString(), null, "form-control")
                <a href="javascript:void(0)" class="date-icon date-icon1"><img src="~/Content/User/lib/images/SystemIcon/main bar-08.svg" width="30" /></a>
                @Html.HiddenGroupFor(model => model.AppointmentDate, new { id = "hdnAppointmentDateGreg" })
                <i id="AppointmentDateIcon" style="color:red" class="glyphicon glyphicon-exclamation-sign hidden_"></i>
                <span id="AppointmentDateMessage" style="color:red"></span>
            </div>
        </div>
    </div>
</div>
<hr />
<script>
    $(document).ready(function () {
        $('#AppointmentDateCal').attr('autocomplete', 'off');
        $('#IsAppointment').off().on("change", onChangeAppointment);
    });
    function onChangeAppointment() {
        $('#CommonVM_IsAppointment').val($('#IsAppointment').is(":checked"));
        if ($('#IsAppointment').is(":checked")) {
            $('#AppointmentDateContent').show();
        }
        else {
            $('#AppointmentDateContent').hide();
        }

        ClearInputs("AppointmentDateContent");
    }
</script>