@using MCS.Framework.Controls;
@using MCS.Framework.Controls.Mvc;
@using MCS.Framework.Localization;
@using MCS.UI.Areas.User.Models.Report;
@model CommonVM
@{
    Html.ViewData.TemplateInfo.HtmlFieldPrefix = "CommonVM";
}
<style>
    .border_top_input {
        margin-top: -20px;
    }
</style>
<div id="hidden_fields_one" style="display: none;">
    <h3 class="site-color sub-title ml-3">@DbRes.TResource("User.Transaction.Search.Common")</h3>
    <div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
            @Html.LabelFor(model => model.TransactionTypeId, new { @class = "w-100" })
            @Html.AutoCompleteBuilder("ddlTransactionSourceType", "hdnTransactionSourceType", ViewData["TransactionTypesData"].ToString(), Model.TransactionTypeId.ToString(), true,
           "form-control", "", "", "", false)
            @Html.HiddenGroupFor(model => model.TransactionTypeId, new { id = "hdnTransactionSourceType" }, "BasicInformation")
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
            @Html.LabelFor(model => model.ConfidentialityLevelId, new { @class = "w-100" })
            @Html.AutoCompleteBuilder("ddlConfedentiality", "hdnConfedentiality", ViewData["ConfidentialityData"].ToString(), Model != null ? Model.ConfidentialityLevelId.ToString() : null, true, "form-control select2 trans-input", "", "", "", false)
            @Html.HiddenGroupFor(model => model.ConfidentialityLevelId, new { @Value = "", id = "hdnConfedentiality" }, "BasicInformation")
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
            @Html.LabelFor(model => model.PriorityLevelId, new { @class = "w-100" })
            @Html.AutoCompleteBuilder("ddlPriorityLevel", "hdnPriorityLevel", ViewData["PrioritiesData"].ToString(), Model != null ? Model.PriorityLevelId.ToString() : null, true, "form-control", "hdnPriorityHasDate", "", "", false)
            @Html.HiddenFor(a => a.PriorityLevelId, new { id = "hdnPriorityLevel" })
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
            @Html.LabelFor(model => model.LetterTypeId, new { @class = "w-100" })
            @Html.AutoCompleteBuilder("ddlOutboundExternalDocumentType", "hdnOutboundExternalDocumentType", ViewData["LetterTypeData"].ToString(), Model != null ? Model.LetterTypeId.ToString() : null, true, "form-control")
            @Html.HiddenFor(model => model.LetterTypeId, new { id = "hdnOutboundExternalDocumentType" })
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
            @Html.LabelFor(model => model.ReceiveId, new { @class = " w-100" })
            @Html.AutoCompleteBuilder("ddlReceiveMethod", "hdnReceiveId", ViewData["DeliveryMethod"].ToString(), Model != null ? Model.ReceiveId.ToString() : null, true, "form-control")
            @Html.HiddenFor(model => model.ReceiveId, new { id = "hdnReceiveId" })
        </div>

        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12 mb-3">
            @Html.LabelFor(model => model.TransactionStatusId, new { @class = "w-100" })
            @Html.AutoCompleteBuilder("ddlTransactionStatus", "hdnTransactionStatus", ViewData["TransactionStatus"].ToString(), Model.TransactionStatusId.ToString(), true,
           "form-control", "", "", "", false)
            @Html.HiddenGroupFor(model => model.TransactionStatusId, new { id = "hdnTransactionStatus" }, "BasicInformation")
        </div>

