                                                    <tr>
                                                        <td colspan="5">
                                                            ملخص الكشف / البيانات الرسمية
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="3">
                                                            عدد المطبوعات
                                                        </td>
                                                        <td colspan="2">
                                                            الفئة والرسوم
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td width="20%">
                                                            داخلي
                                                        </td>
                                                        <td width="20%">
                                                            عربي
                                                        </td>
                                                        <td width="20%">
                                                            أجنبي
                                                        </td>
                                                        <td width="20%">
                                                            الفئة
