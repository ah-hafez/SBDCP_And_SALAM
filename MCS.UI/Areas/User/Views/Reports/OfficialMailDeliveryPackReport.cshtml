                                                    </tr>
                                                    <tr>
                                                        <td width="20%">&nbsp;</td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                    </tr>
                                                    <tr>
                                                        <td width="20%">&nbsp;</td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                    </tr>
                                                    <tr>
                                                        <td width="20%">&nbsp;</td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                    </tr>
                                                    <tr>
                                                        <td width="20%">&nbsp;</td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                    </tr>
                                                    <tr>
                                                        <td width="20%">&nbsp;</td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                        <td width="20%"></td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="3">
                                                            إجمالي رسوم الكشف
                                                        </td>
                                                        <td colspan="2" align="left">
                                                            ريال
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td width="30%">
                                    <div class="row rowReport">
                                        اسم مدخل البيانات :
                                    </div>
                                    <div class="row rowReport">
                                        التوقيع :
                                    </div>
                                    <div class="row rowReport">
                                        التاريخ :&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;/
                                    </div>
                                    <div class="row rowReport">
                                        <br />
                                        رقم القيد :
                                        <br />
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>
    }
</body>
</html>
