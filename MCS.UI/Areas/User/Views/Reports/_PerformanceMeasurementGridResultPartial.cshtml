    columns.Add(model => model.OrgUnitName).Titled(DbRes.TResource("User.Copy.OrgUnitName"));
    columns.Add(model => model.UserProfileName, ViewData["ReportType"].ToString()=="1").Titled(DbRes.TResource("User.Employee"));
