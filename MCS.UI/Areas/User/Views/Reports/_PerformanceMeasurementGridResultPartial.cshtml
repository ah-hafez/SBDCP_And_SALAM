@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.Report;
@model MCS.GridMvc.Ajax.GridExtensions.AjaxGrid<PerformanceMeasurementGridResultVM>
@{
    List<int> columnsToGrid = ViewData["ColumnsToGrid"] == null ? new List<int>() : (List<int>)ViewData["ColumnsToGrid"];
    bool showUserName = ViewData["ShowReportUser"] == null ? false : (bool)ViewData["ShowReportUser"];
}


@Html.Grid(Model).Named("GridPerformanceMeasurementReport").CollectionName("PerformanceMeasurementResults").Columns(columns =>
{
