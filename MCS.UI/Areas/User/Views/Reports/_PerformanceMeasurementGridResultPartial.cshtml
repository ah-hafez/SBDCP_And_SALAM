    columns.Add().Encoded(false).Sanitized(false).Titled("", "عدد المعاملات (تحت الاجراء)").RenderValueAs(a => @"<div class='text-center' onclick='showInProgressTransactions(" + a.OrgUnitsID + ")'>" + a.InProgressCount + "</div>");
    columns.Add().Encoded(false).Sanitized(false).Titled("", "عدد المعاملات المعلقة").RenderValueAs(a => @"<div class='text-center'>" + a.SavedCount + "</div>");
