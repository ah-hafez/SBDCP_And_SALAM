<script>

    function assignmentPaper() {
        $("#assigmentpaper").show();
        $("#ArchivingPartial").hide();
        $("#divAddExplanation").hide();
        $("#divFollow").hide();
        $("#divContentAssignmement").hide();

    }
    function basicInfo() {
        $("#assigmentpaper").hide();
        $("#ArchivingPartial").show();
        $("#divAddExplanation").show();
        $("#divFollow").show();
        $("#divContentAssignmement").show();
    }

     function PrintTransaction(TransactionId) {
         debugger;
        $("#Loader").show();
         checkIfHasMainDocument();
        var Number = $('#hdnNumber').val();
        var IsDecisionDraft = $("#IsDecisionDraft").val();
        var token = $("input[name='__RequestVerificationToken']").val();
        var data = { transactionId: TransactionId, __RequestVerificationToken: token, hdnMainDocToken: $("#hdnMainDocToken").val(), transactionNumber: Number, isDecisionDraft: IsDecisionDraft };
        event.preventDefault();
        $.ajax({
            type: "POST",
            url: '@Url.Action("PrintDraftOutboundTransaction", "Shared")',
            data: data,
            cache: false,
            success:

                function (data) {
                    if (data.MessageType != 2) {
                        var TransactionWindow = window.open('', '_blank', 'width=900,height=500');

                        TransactionWindow.document.write(data);
                        TransactionWindow.document.close();
                        TransactionWindow.focus();
                        $("#Loader").hide();
                        //setTimeout(function () {
                        //    TransactionExplanationsWindow.print();
                        //    TransactionExplanationsWindow.close();
                        //}, 2000);
                    }
                    else {
                        ShowErrorMessage(data.MessageText);
                    }
                }
        });
    }


    function ConvertDraftToExternal()
    {

        checkIfHasMainDocument();

        $("#hdnIsSigned").val(true);
        return true;
    }


    function goToNext(data)
    {
        debugger;
        var redirectUrl = '@Url.Action("DraftOutbound", "File", new { Area = "user" })';
        var nextId = data.NextId;
        if (nextId != undefined && nextId != null && nextId > 0)
        {
             redirectUrl = '@Url.Action("Edit", "VipOutboundDraft")?id=' + EncryptionKey(nextId);

        }

     setTimeout(function () {
            window.location.href = redirectUrl;
        }, 2000);

    }

    var token = $('form:first').find("input[name='__RequestVerificationToken']").val();


          function checkIfHasMainDocument()
          {
              debugger;
              var isSecret = false;
        var isReadOnly = $('#hdnDocumentReadOnly').val();
        if (isReadOnly == 'True')
        {
            $('#hdnMainDocToken').val('');
            return true;
        }
        window.checkIfHasMainArchiveURL = '@Url.Action("CheckIfHasMainArchive", "VipOutboundDraft")';
        var token = $("#dvArchivingMainDocumentBody").parents("form").find("input[name='__RequestVerificationToken']").val();
     var docoNutFrameContent = $('#frameViewer').contents();
    var isDraft=false;
      var isArchived = true;
    if (docoNutFrameContent.length > 0)
     {

     var __docViewerToken = $('#_hdnToken', docoNutFrameContent)[0].value;
        $('#hdnMainDocToken').val(__docViewerToken);

    }
    else
    {

    isArchived=false;
    isDraft=true;
    }


        if (isSecret) {
            return true;
        }
        $("#CalMessageForMainDoc").html('');
        $("#CalMessage2").hide();
        if ($('#dvTextEditor').is(":visible")) {
                return true;
        } else if(isDraft) {
      return true;

    }
    else {

            if (!isArchived) { // here

                $("#doconutViewer > #CalMessage2").removeClass("hidden_");
                $("#doconutViewer > #CalMessage2").show();
                $("#doconutViewer > #CalMessageForMainDoc").html('@Html.Raw(DbRes.TValidation("User.Inbound.MainDocument"))');
            }
            if ($('#doconutViewer > #CalMessageForMainDoc').html() == "")
                return true;
            else if ($('#doconutViewer > #CalMessageForMainDoc').html() != "" && $('#doconutViewer > #ddlInboundDocumentType').val() != "" && (!isArchived)) {
                $("#doconutViewer > #CalMessageForMainDoc").html('@Html.Raw(DbRes.TValidation("User.Inbound.MainDocument"))');
                return false;
            }
            else if ($('#doconutViewer > #CalMessageForMainDoc').html() != "" && $('#doconutViewer > #ddlInboundDocumentType').val() != "" && (isArchived)) {
                $("#doconutViewer > #CalMessageForMainDoc").html('');
                $("#doconutViewer > #CalMessage2").hide();
                return false;
            }
            else if ($('#doconutViewer > #CalMessageForMainDoc').html() != "" && (isArchived)) {
                $("#doconutViewer > #CalMessageForMainDoc").html('');
                $("#doconutViewer > #CalMessage2").hide();
                return false;
            }
            else {
                return true;
            }
        }
    }


</script>

