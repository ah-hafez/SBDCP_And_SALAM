@model List<MCS.DTO.Shared.OnlineUserDTO>

@{

    ViewBag.Title = "Online Users";
    Layout = "~/Areas/User/Views/Shared/_SearchLayout.cshtml";

}
<div class="d-flex flex-column flex-sm-row mx-5 mx-xs-3 mb-3 header-container">
    <h3 class="site-color">المستخدمين المتصلين</h3>
</div>

<div class="white-container mx-5 mx-xs-3">
    <div class="tab-content">
        <div class=" white-bg">
            <div class="row">
                <div class="col-lg-12">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    اسم المستخدم
                                </th>
                                <th> الادارة</th>
                                <th>
                                    الحالة
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.UserFullName</td>
                                    <td>@user.OrgUnitName</td>

                                     
                                    <td>
                                        <img title="متصل" style="width:25px;" src="@Url.Content("~/Content/User/lib/images/icononlineusers.svg")" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>


