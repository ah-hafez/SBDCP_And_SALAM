@model TemplateAddVM
@using MCS.UI.Areas.User.Models.Lookups
@using UserLookups = MCS.UI.Areas.User.Models.Lookups
@using MCS.Common;
@using MCS.Framework.Localization;

@using MCS.Framework.Controls.Mvc;
@{
    /**/
    ViewBag.Title = "_FormAddParial";
    Layout = null;
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmAddForm", @class = "" }))
{
    @Html.AntiForgeryToken()
    <div id="formAdd" class="form-row">

        @*<p>@DbRes.TResource("Global.Forms.MandatoryFields")</p>*@

        @{List<UserLookups.CultureVM> cultureVMs = ViewData["Culture"] as List<UserLookups.CultureVM>;}

        @if (cultureVMs != null)
        {
            for (int m = 0; m < cultureVMs.Count; m++)
            {
                <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                    @Html.CustomLabelFor(model => model.Description[m].CultureName, new { @class = "" }, DbRes.TResource(string.Format("Admin.Form.TemplateName.{0}", cultureVMs[m].ShortName)))<span class="stark">*</span>
                    @Html.StickyHiddenFor(model => model.Description[m].CultureId, new { Value = cultureVMs[m].Id })
                    @Html.TextBoxGroupFor(model => model.Description[m].Text, "", new { @class = "form-control" }, DbRes.TValidation("Admin.Forms.TemplateNameRequired." + cultureVMs[m].ShortName))
                </div>
            }
        }

        <div class="form-group col-lg-6 col-md-4 col-sm-6 col-xs-12" id="TransTypes" hidden>
            @Html.CustomLabelFor(model => model.TransactionCategories, new { @class = "w-100" }, DbRes.TResource("Admin.Form.TransactionType"))
            @Html.Partial("~/Areas/User/Views/Lookups/Template/_TransactionSourcePartial.cshtml", Model.TransactionCategories, new ViewDataDictionary { TemplateInfo = new TemplateInfo { HtmlFieldPrefix = Html.NameFor(model => model.TransactionCategories).ToString() } })
            <label id="noTransTypeselectedValidationMessage" style="display:none; color:red">@DbRes.TValidation("Admin.Form.AtLeastOneTransactionTypeValidation")</label>
        </div>

        @Html.HiddenFor(model => model.FileName, new { id = "hdnFileName" })
        @Html.HiddenFor(x => x.FileContent)
        <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12" hidden>
            <div class="form-check form-check-inline">
                @Html.CheckBoxFor(model => model.AllOrgUnitsSelected, new { id = "AllOrgUnits", @class = "form-check-input" })
                @Html.StickyHidden("hdnIsSelected")
                @Html.Label(DbRes.TResource("Admin.Form.AllDepartment"), new { @class = "form-check-label" })
            </div>
        </div>
    </div>


    @*@Html.Partial("~/Areas/Admin/Views/Lookups/_FormTextEditorPartial.cshtml", new FormContentVM(), new ViewDataDictionary { TemplateInfo = new TemplateInfo { HtmlFieldPrefix = Html.NameFor(model => model.FormContentVM).ToString() } })*@
    <div id="dvUploadFile">
        @Html.Partial("~/Areas/User/Views/Lookups/Template/_UploadFile.cshtml")
        <br />
    </div>




    <br />
    <br />
    <br />
    <div class="mx-3 mx-md-5 mb-4 d-flex">
        <br />
        <div class="ml-auto">
            @Html.ActionButton(DbRes.TResource("Admin.Form.Add"), "AddTemplate", "dvGrid", null, null, "OnAddSuccess", null, "post", null, "btnAdd", "frmAddForm", "btn btn-lg btn-st3 mx-1", "")
            @Html.ResetButton("ClearFormData('formAdd')")
        </div>

    </div>
}

<script>

     function SaveTransactionAttachements(obj) {
       // showname();
        //var name = document.getElementById('TransactionFiles');

         var parent = $(obj).closest('form');
         var name =  parent.find('#TransactionFiles')[0];
         parent.find('#uploadContainer .uploaded-files').children('.newAdded').remove();
         console.log(parent);
        var fileExist = false;
        for (i = 0; i < name.files.length; i++) {
            parent.find('#uploadContainer .uploaded-files').find('.attachment_name').each(function () {

                var S = $(this).html();
                if (S.includes(name.files.item(i).name)) {
                    fileExist = true;
                }
            });
            if (!fileExist) {
                parent.find("#FileName").val(name.files.item(i).name);
                parent.find('#uploadContainer .uploaded-files').append('<div class="file newAdded"><i class="uicon icon_attachments"></i><span class="attachment_name">' + name.files.item(i).name + '</span><a href="javascript:removeMainDocAttachemntPhysically()" class="color-danger remove-mini"><i class="uicon icon_recycle"></i></a></div>');
            }
        }
         parent.find('.col-uploadeed-files').fadeIn(200);

         var files = parent.find('#uploadContainer').find(parent.find("input:file")).get(0).files;
        if (files.length <= 0) {
            return;
        }

        if (window.FormData !== undefined) {
            var data = new FormData();
            var fileExist = false;
            for (i = 0; i < files.length; i++) {
                parent.find('#uploadContainer .uploaded-files').find('.attachment_name').each(function () {
                    if ($(this).html() == files[i].name) {
                        fileExist = true;
                    }
                });
                if (fileExist) {
                    data.append("file" + i, files[i], files[i].name);
                }
            }
            data.append('TransactionArchiveVM', parent.find("#dvAttachmentsBody :input").serializeArray());
            data.append('AttachmentTypeId', parent.find("#hdnAttachmentType").val());
            var jqXHR = $.ajax({
                type: "post",
                url: '@Url.Action("UploadMainDocAttachments", "Inbound")',
                data: data,
                contentType: false,
                processData: false,
                dataType: 'json',
                async: false,
            }).done(function (data) {
                if (data.MessageType != 2)
                {
                    parent.find("#JFile").val(data.AddedFilesJson);
                } else
                {
                    $('#FileName').val("");
                    $('#uploadContainer .uploaded-files').find('.attachment_name').html("");
                    alert(data.MessageText);
                  
                }
            }).fail(function (jqXHR, textStatus) {
                alert("error");
            });
        } else {
            alert("Your browser doesn't support HTML5 multiple file uploads! Please use some decent browser.");
            return;
        }

        return;
    }

    $("#AllOrgUnits").on("change", function () {
        if ($(this).prop("checked") == true) {
            $("#dvDepartmentsTree .txtDepartmentNumber").attr("disabled", true);
            $("#dvDepartmentsTree .txtDepartmentName").attr("disabled", true);
            $("#btnAddOrgUnit").attr("disabled", true);
            $("#dvOrgUnitItems").html("");
            AddedOrgunitsIds = [];
        } else {
            $("#dvDepartmentsTree input").attr("disabled", false);
            $("#btnAddOrgUnit").attr("disabled", false);
        }
    });

    function ClearFormData(id) {
        ClearInputs(id);
        var txtEditorId = "";
        var hdnEditorContentId = "";
        $("#dvOrgUnitItems").html("");
        AddedOrgunitsIds = [];
        $("#dvDepartmentsTree input").attr("disabled", false);
        $("#btnAddOrgUnit").attr("disabled", false);
        $('#' + id + ' iframe[id^="txtEditor"]').filter(
            function () {
                txtEditorId = this.id.substring(0, this.id.length - 4);
            });
        $('#' + id+' input[id^="hdnContent"]').filter(
            function () {

                hdnEditorContentId = this.id;
            })
        ChangeTextEditorContent(txtEditorId, hdnEditorContentId, "");

    }

    function CheckContentOnAdd() {

        var hdnEditorContentId = "";
        var NoMissingData = true;
        var noOfSelectedCheckedBoxes = $("#TransTypes input[type=checkbox]:checked").length
        $('#frmAddForm input[id^="hdnContent"]').filter(
           function () {

               hdnEditorContentId = this.id;
            })
        if ($("#AllOrgUnits").prop("checked") == false && $(".added_item").length < 1) {
            $("#OrgUnitValidationMessage").hide();
            $("#AtLeastOneOrgUnitValidationMessage").show();


            NoMissingData = false;
        }
        if (noOfSelectedCheckedBoxes == 0) {
            $("#noTransTypeselectedValidationMessage").show();
            NoMissingData = false;
        } else {
            $("#noTransTypeselectedValidationMessage").hide();
        }

    }
    var AddedOrgunitsIds = [];
    $('#btnAddOrgUnit').on('click', function () {

        var id = $('#OrgUnitIds_hdnDepartmentId').val();
        var orgunitName = $('#OrgUnitIds_txtDepartmentName').val();
        var exist = false;

        if (id == "" && orgunitName == "") {
            $("#OrgUnitValidationMessage").show();
            return;
        }
        $("#OrgUnitValidationMessage").hide();
        $("#AtLeastOneOrgUnitValidationMessage").hide();
        AddedOrgunitsIds.forEach(function (item) {
            if (item == id) {
                ShowErrorMessage("Already exist");
                exist = true;
                return false;
            }
        });


        if (!exist) {
            var itemsCount = $(".added_item").length;
            var OrgUnitItem = "<div id='div_" + id + "' class='added_item mr-4 mb-3'>";
            OrgUnitItem += "<span class='added-class d-flex'>";
            OrgUnitItem += "<span>" + orgunitName + "</span>";
            OrgUnitItem += "<a onclick='DeleteOrgUnitItem(" + id + ")' class='color-burgundy ml-2'><i class='icon-tables-delete'></i></a>";
            OrgUnitItem += "</span>";
            OrgUnitItem += "<input type='hidden' name='OrgUnitIds' value='" + id + "'/>";
            OrgUnitItem += "</div>";

            $("#dvOrgUnitItems").append(OrgUnitItem);
            AddedOrgunitsIds.push(id);

            ClearInputs("dvDepartmentsTree");
        }
    });

    function DeleteOrgUnitItem(OrgUnitItemId) {

        var index = AddedOrgunitsIds.indexOf(OrgUnitItemId + "");
        if (index > -1) {
            AddedOrgunitsIds.splice(index, 1);
        }

        $("#div_" + OrgUnitItemId).remove();
    }

     $(document).on("click", "span[data-node-id]", function () {

        var elemnt = $(this);

        if ($(this).hasClass('fa-plus') && $(this).hasClass('LoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetExternalPartyNodes")',
                data: { parentId: $(this).data("node-id"), letterId: $("#hdnInboundDocumentType").val(), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
               function (data) {

                   $(elemnt).closest('li').children('ul').last().empty()

                   $(elemnt).closest('li').children('ul').last().append(data);

                   if ($(elemnt).attr('data-isRefreshEnabled').toLowerCase() == 'false') {

                       $(elemnt).removeClass("LoadedData")

                   }

               }
            });
            }
            if ($(this).hasClass('fa-plus') && $(this).hasClass('InternalLoadedData')) {
            $.ajax({
                type: 'get',
                url: '@Url.Action("GetOrgUnitsNodes")',
                data: { parentId: $(this).data("node-id"), containerName: $(this).data('node-container'), onClickFunc: $(this).data('func') },
                success:
               function (data) {

                   $(elemnt).closest('li').children('ul').last().empty()

                   $(elemnt).closest('li').children('ul').last().append(data);

                   $(elemnt).removeClass("InternalLoadedData");
               }
            });
        }
    });


