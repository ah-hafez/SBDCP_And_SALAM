
@using TXTextControl.Web.MVC

<div style="direction:ltr">

    <div class="alert alert-info mt-3" role="alert">

        <span class="alert-text"></span>

    </div>
    <div style="height: 100%" id="tx-editor">

        @Html.TXTextControl().TextControl().Render()

    </div>
   
</div>

<script>


    function checkSettings()
    {
        // store Text Control settings
        var settings = document.querySelector("#__txSettings");
        txSettings = JSON.parse(settings.textContent);
    }
    checkSettings();

    function toggleRibbonElement(group, tab, highlight)
    {
        if (tab != null)
            TXTextControl.ribbon.selectedTab = tab;

        if (highlight == true)
            highlightRibbonElement(group);

        setTimeout(function ()
        {
            var ribbonGroup = $("#" + group);

            if (ribbonGroup.css("display") == "none")
                ribbonGroup.css("display", "block");
            else
                ribbonGroup.css("display", "none");
        }, 500)
    }

    TXTextControl.addEventListener("ribbonTabsLoaded", function (e)
    {

        toggleRibbonElement('tabFile', 'tabDefault', false);
        toggleRibbonElement('tabReports', 'tabDefault', false);
        toggleRibbonElement('tabPermissions', 'tabDefault', false);
        toggleRibbonElement('tabProofing', 'tabDefault', false);
        toggleRibbonElement('ribbonGroupIllustrations', 'tabDefault', false);
        toggleRibbonElement('btnPageSetup', 'tabDefault', false);
        toggleRibbonElement('tabPageLayout', 'tabDefault', false);
        toggleRibbonElement('tabReferences', 'tabDefault', false);
        toggleRibbonElement('tabFormFields', 'tabDefault', false);
        toggleRibbonElement('txTglBtnSideBars', 'tabDefault', false);
        $("#txTemplateDesignerContainer").parent().css('height', '1000px')
        TXTextControl.showVerticalRuler(false);
        TXTextControl.showHorizontalRuler(false);



        if ($("#FileContent").val() != '')
        {
            TXTextControl.loadDocument(TXTextControl.StreamType.WordprocessingML, $("#hdnBinaryDocument").val());
        }
        TXTextControl.addEventListener("changed", function (l)
        {

            TXTextControl.saveDocument(TXTextControl.streamType.WordprocessingML, function (e)
            {

                $("#FileContent").val(e.data);

            });
        });
        TXTextControl.addEventListener("documentLoaded", function (l)
        {

            TXTextControl.saveDocument(TXTextControl.streamType.WordprocessingML, function (e)
            {

                $("#FileContent").val(e.data);

            });

        });


        $("#Loader").hide();
    });

    function FillDocument(data)
    {
     
        if (data != '')
        {
            TXTextControl.loadDocument(TXTextControl.StreamType.WordprocessingML, data);
        } else
        {
            TXTextControl.loadDocument(TXTextControl.StreamType.PlainText, '');
        }
      
    }
    function readDocument(input)
    {
        if (input.files && input.files[0])
        {
            var fileReader = new FileReader();
            fileReader.onload = function (e)
            {
                var streamType = TXTextControl.streamType.PlainText;
                // set the StreamType based on the lower case extension
                switch (input.value.split('.').pop().toLowerCase())
                {
                    case 'doc':
                        streamType = TXTextControl.streamType.MSWord;
                        break;
                    case 'docx':
                        streamType = TXTextControl.streamType.WordprocessingML;
                        break;
                    case 'rtf':
                        streamType = TXTextControl.streamType.RichTextFormat;
                        break;
                    case 'htm':
                        streamType = TXTextControl.streamType.HTMLFormat;
                        break;
                    case 'tx':
                        streamType = TXTextControl.streamType.InternalUnicodeFormat;
                        break;
                    case 'pdf':
                        streamType = TXTextControl.streamType.AdobePDF;
                        break;
                }
                // load the document beginning at the Base64 data (split at comma)
                TXTextControl.loadDocument(streamType, e.target.result.split(',')[1]);
            };
            // read the file and convert it to Base64
            fileReader.readAsDataURL(input.files[0]);
        }
    }
    // call readDocument when a new document has been selected
    function CheckDocument()
    {
        TXTextControl.saveDocument(TXTextControl.streamType.WordprocessingML, function (e)
        {

            $("#FileContent").val(e.data);

        });
        return true;
    }
</script>