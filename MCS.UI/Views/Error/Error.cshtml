@using MCS.Framework.Localization;
@{
    Layout = "~/Views/Shared/_EmptyLayout.cshtml";
    var mainPageUrl = MCS.UI.UrlHelper.GetBaseUri() + "/User/File/MyTransactions";
}
<script type="text/javascript">
    function PageHistory() {
        window.history.back();
    }
</script>

<style>

    .ErrorMsg {
        color: #c0c0c0;
        font-size: 16px;
        font-weight: 700;
    }

    .circle {
        width: 230px;
        height: 230px;
        background: #e6e6e6;
        border-radius: 120px;
    }
</style>
<div class="error-container">
    <div style="text-align:center" class="mt-5">
        <img src="~/Content/User/lib/images/GAMI_Logo_Color-01.svg" width="250" style="margin:auto">
    </div>
    <div class="d-flex mt-5" style="justify-content: center">
        <div class="col-lg-7 ml-5 mt-5" style="text-align:center">

            <h2 style="color: #0E8270; font-weight: 700"> مستخدم نظام مراسلات  </h2>

            <span class="ErrorMsg">نأسف لوجود عطل فني حدث اثناء معالجة طلبك ! </span>
            <br />
            <span class="ErrorMsg"> الرجاء التأكد بأنه تم اتمام طلبك والعودة الى الشاشة الرئيسية وفي حال تكرار حدوث الخطأ يرجى ارسال طلب دعم فني لمدير النظام من خلال ايقونة الدعم الفني في الشاشة الرئيسية</span>
            <div class="row mt-5">
                @if (Request.UrlReferrer == null)
                {
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <button class="btn btn-info btn-block btn-lg btn-error_01" onclick="document.location.href = '@mainPageUrl'">@DbRes.TResource("Shared.Error.BackToMainPage")</button>
                    </div>
                    <div class="col-md-3"></div>
                }
                else
                {
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <button class="btn btn-info btn-block btn-lg btn-error_02" onclick="PageHistory()">@DbRes.TResource("Shared.Error.PreviousPage")</button>
                    </div>
                    <div class="col-md-3"></div>
                }
            </div>
        </div>

        <div class="col-lg-3 ml-5 mt-5">
            <div class="circle">
                <img src="/MCS.UI/Content/User/lib/images/warning.png" style="margin-top:30px; margin-right:37px;" width="150">
            </div>
        </div>
    </div>
    

   

</div>
