    <script>
        function ViewMoreDelegations() {
            if ($("#UserDelegationsList").find('Ul').hasClass('oneItem')) {
                $('.ViewMoreDelegations').find('i').removeClass('fa-angle-down').addClass('fa-angle-up');
                $("#UserDelegationsList").find('Ul').removeClass('oneItem');
            }
            else {
                $('.ViewMoreDelegations').find('i').removeClass('fa-angle-up').addClass('fa-angle-down');
                $("#UserDelegationsList").find('Ul').addClass('oneItem');
            }
        }
        $(function () {
            var DelegationsList = '';
            var del = "أنت مفوض بالعمل عن الموظف  {0} من تاريخ {1} إلى تاريخ {2} ."
             $.ajax({
                   url: '@Url.Action("GetLoggedInUserDelegations" , "Shared")',
                   type: 'GET',

                 success: function (data) {
                     if (data.result != null) {
                         if (data.result.length > 0) {
                             data.result.forEach(element => {
                                 var Msg = del;
                                 Msg = Msg.replace('{0}', element.UserPreferenceName);
                                 Msg = Msg.replace('{1}', new Date(parseInt(element.FromDate.replace('/Date(', '').replace(')/', ''))).toLocaleDateString());
                                 Msg = Msg.replace('{2}', new Date(parseInt(element.ToDate.replace('/Date(', '').replace(')/', ''))).toLocaleDateString());

                                 DelegationsList = DelegationsList + '<li>' + Msg + '</li>'
                             });
                             $("#UserDelegationsList").show();
                             $("#UserDelegationsList").find('Ul').append(DelegationsList);
                         }
                         else {
                             $("#UserDelegationsList").hide();
                         }
                         if (data.result.length == 1) {
                             $('.ViewMoreDelegations').hide();
                         }
                     }



            },
            error: function (a) {
            }
        });
    });

    </script>
