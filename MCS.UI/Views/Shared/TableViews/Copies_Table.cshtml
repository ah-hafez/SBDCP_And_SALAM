@using MCS.Framework.Localization
@using MCS.UI.Areas.User.Models.File

<div id="TransactionTable" class="d-flex flex-wrap mx-auto mx-md-4">
    <table class="table tbody-shadow tables-view">
        <thead class="thead-light">
            <tr>
                <th scope="col" class="text-primary"></th>
                <th scope="col" class="text-primary">الرقم</th>
                @*<th class="text-primary" scope="col">نوع المعاملة</th>*@
                <th class="text-primary">الإدارة المنشأة/ واردة من</th>
                <th class="text-primary" scope="col">الموضوع</th>
                <th class="text-primary" style="width:150px">التاريخ</th>
                <th class="text-primary">
                    @DbRes.TResource("User.Transaction.Sender")
                </th>
                <th class="text-primary" scope="col">@DbRes.TResource("User.File.Priority")</th>
                <th class="text-primary" scope="col">@DbRes.TResource("User.File.Confidentiality")</th>
                @*<th class="text-primary" scope="col"> @DbRes.TResource("User.File.Cards.Classification")</th>*@
                @*<th class="text-primary">
                        @DbRes.TResource("Admin.AssignmentPaperActions.Action")
                    </th>
                    <th class="text-primary">
                        @DbRes.TResource("User.File.AssignDate")
                    </th>*@
                @*<th class="text-primary" scope="col">المرفقات</th>*@
                <th class="text-primary" scope="col">اجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (TransactionTrayInfoVM transaction in (List<TransactionTrayInfoVM>)Session["tableGridItems"])
            {
                {
                    string className = "result";
                    string classNameTo = "result";
                    if (transaction.TransactionDetailsInfoVM.ConfidentialityId == 28 || transaction.TransactionDetailsInfoVM.ConfidentialityId == 29)
                    {
                        className = "resultReed";
                    }
                    if (transaction.TransactionDetailsInfoVM.TransactionTypeId == 2)
                    {
                        classNameTo = "resultReed";
                    }
                    ViewData["className"] = className;
                    ViewData["classNameTo"] = classNameTo;
                }

                bool isViewed = false;
                string isViewedHeaderClass = "correspondence-t";
                if (transaction.TransactionAssignmentInfoVMs != null && transaction.TransactionAssignmentInfoVMs.Count > 0)
                {
                    isViewed = transaction.TransactionAssignmentInfoVMs.FirstOrDefault().Viewed;
                }
                isViewedHeaderClass = isViewed ? "correspondence-t" : "correspondence-t correspondence-t-notviewed bold ";

                ViewData["isViewed"] = isViewed;
                ViewData["isViewedHeaderClass"] = isViewedHeaderClass;

                @Html.Partial("~/Areas/User/Views/Shared/ListItems/_Copies_TableItem.cshtml", transaction)
            }
        </tbody>
    </table>
</div>

<script>
    function redirect() {
        debugger
        var link = $(event.currentTarget).parent().find('.aView');
        link.click();
    }

    $(document).ready(function () {
        if ($('#selectAll').is(":checked")) {
            $('#selectAll').click();
        }
    });
</script>

<script src="~/Scripts/Transaction.js"></script>

<script>
    $(".CreateInternalOutbound").click(function () {

        var EncryptedId = $(this).data("id");
        var type = $(this).data("tray");
        window.location.href = '@Url.Action("CreateCopyOutboundInternal","OutboundInternal")' + "?transactionId=" + EncryptedId + "&transactionType=" + type;
    });




    $(".aMarkSeen").unbind('click').click(function (e)
    {
        e.stopPropagation();
        _this = this;
        ShowConfirmMessage('@(DbRes.TResource("User.File.View"))', "ViewedTransaction");
    })
    $(".aMarkDelete").unbind('click').click(function (e)
    {
        e.stopPropagation();
        _this = this;
        ShowConfirmMessage('@(DbRes.TResource("User.File.Deleted"))', "ViewedTransaction");
    })


</script>
