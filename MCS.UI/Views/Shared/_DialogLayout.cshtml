    <script>
               function ShowAttachmentViewer(documentId, documentSessionKey) {
        var url = '@Url.Action("ShowAttatchmentViewer", "Shared")' + '?documentId=' + documentId + "&documentSessionKey=" + documentSessionKey;
        ShowDialog(url,'dialogbox col-md-12');
        }

        function EncryptionKey(value)
        {
            var key = CryptoJS.enc.Utf8.parse('8080808080818181');
            var iv = CryptoJS.enc.Utf8.parse('8080808080818181');//8080808080808080
            var encryptedlogin = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(value), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            return encryptedlogin;

        }
    </script>
