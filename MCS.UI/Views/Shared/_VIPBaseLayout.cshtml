             function fncprintArchive(transId, withRelated) {
        //const win = window.open("PrintArchivedAndRelated.aspx","_blank");
                 var trxId = EncryptionKey(transId);
                 var dataObj = { transId: trxId.toString(), withRelated: withRelated };

        $.ajax({
            type: "GET",
            url: '@Url.Action("PrintTransactions", "Shared")' + '?transId=' + trxId.toString() + "&withRelated=" + withRelated,
            cache: false,
            success: function (data) {

                if (data.MessageType != 2) {
                    var TransactionWindow = window.open('', '_blank', 'width=900,height=500');

                    TransactionWindow.document.write(data);
                    TransactionWindow.document.close();
                    TransactionWindow.focus();
                }
                else {
                    ShowErrorMessage(data.MessageText);
                }
            }
        });
        }

