       function OpenUrlMenu(Url) {
            window.location.href = Url;
        }

        function OpenUrlMenuPermission(menuType) {
            if (menuType == 1) {
                if ('@myTransactionPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("MyTransactions", "File", new { area = "user" })');
                }
                else if ('@draftPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("DraftOutbound", "File", new { area = "user" })');
                }
                else if ('@sentPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("SentTransactions", "File", new { area = "user" })');
                }
                else if ('@savedPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("Saved", "File", new { area = "user" })');
                }
                else if ('@managerPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("Manager", "File", new { area = "user" })');
                }
                else if ('@copiesPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("Copies", "File", new { area = "user" })');
                }
                else if ('@tasksPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("Tasks", "File", new { area = "user" })');
                }
                else if ('@followupPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("FollowUp", "File", new { area = "user" })');
                }
                else if ('@reservationPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("Reservation", "File", new { area = "user" })');
                }
            }
            else if (menuType == 2) {
                if ('@orgUnitPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("OrgUnit","File",new { area = "user" })');
                }
                else {
                    OpenUrlMenu('@Url.Action("GetAll","Hub",new { area = "user" })');
                }
            }
            else if (menuType == 3) {
                if ('@transactionReportPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("TransactionReport", "Reports",new { area = "user" })');
                }
                else if ('@performanceReportPermission' == 'True') {
                    OpenUrlMenu('@Url.Action("PerformanceMeasurementReport", "Reports",new { area = "user" })');
                }
            }
        }

        function setMenuState()
        {
            if ($("body").hasClass("menu-expanded")) {
                $.cookie('currentMenuState', 'invisible', { path: '/' });
            }
            else {
                 $.cookie('currentMenuState', 'visible', { path: '/' });
            }
        }

        function getMenuState() {
                if ($.cookie('currentMenuState') === 'invisible') {
                    $.app.menu.collapse();
                }
                else {
                   $.app.menu.expand();
                }
        }

        var inactiveTimer;

        function setInactiveTimer() {
            clearTimeout(inactiveTimer);
            inactiveTimer = setTimeout(function () {
                $('.la-power-off').parent()[0].click()
            }, 1200000); // 20mins of inactive will leade to logout
        }

        $(document).ready(function () {
            setInactiveTimer();

            $(document).mousemove(function () {
                setInactiveTimer();
            });

            $(document).keydown(function () {
                setInactiveTimer();
            });
        });



            function EncryptionKey(value) {
            var key = CryptoJS.enc.Utf8.parse('8080808080818181');
            var iv = CryptoJS.enc.Utf8.parse('8080808080818181');
            var encryptedlogin = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(value), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            return encryptedlogin;

        }

    </script>
