        window.location.href = '@Url.Action("AdvancedQuery", "Search")' + '?inquirySearch=' + document.getElementById("txtInquiry").value + '&inquiryType=' + document.getElementById("InquiryType").value + '&hdnYear=' + document.getElementById("hdnYearH").value;
    }
